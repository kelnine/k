# ─── SAFETY LOCK ──────────────────────────────────────────────────────────────
# MUST remain "false". Changing to "true" triggers a manual confirmation prompt
# and is intentionally difficult. This bot is designed for paper trading only.
LIVE_TRADING=false

# ─── BROKER ───────────────────────────────────────────────────────────────────
# Choose: "tradier" or "alpaca"
BROKER=tradier

# Tradier Sandbox (https://developer.tradier.com → Sandbox)
TRADIER_TOKEN=your_tradier_sandbox_token_here
TRADIER_ACCOUNT_ID=your_tradier_sandbox_account_id_here

# Alpaca Paper (https://alpaca.markets → Paper Trading)
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here

# ─── UNUSUAL WHALES ───────────────────────────────────────────────────────────
# Get your key at https://unusualwhales.com/api
UNUSUAL_WHALES_TOKEN=your_unusual_whales_api_key_here

# ─── TELEGRAM ─────────────────────────────────────────────────────────────────
# 1. Create a bot via @BotFather → copy the token
# 2. Start a chat with your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  to find your chat_id
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
