//@version=6
indicator("FRVP + ORB + 9/20 EMA", shorttitle = "FRVP ORB EMA", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ═══ Inputs ═══════════════════════════════════════════════════════════════
const string G_VP  = "Volume Profile"
const string G_OR  = "Opening Range Breakout"
const string G_EMA = "EMAs"

string tz = input.string("America/New_York", "Timezone", tooltip = "Used for the opening range and the session profile.")

bool   showVP     = input.bool(true, "Show volume profile", group = G_VP)
string vpMode     = input.string("Latest session", "Range", options = ["Latest session", "Previous session", "Last N bars", "Pick on chart"], group = G_VP, tooltip = "Latest session: the session in progress, or the last one if the market is closed.\nPick on chart: uses Range start / end below.")
string vpSess     = input.session("0930-1600", "Session", group = G_VP, tooltip = "For the two session modes. 0930-1600 = NY regular hours, 1800-1700 = full futures day.")
int    vpBars     = input.int(200, "Last N bars", minval = 10, maxval = 5000, group = G_VP)
int    vpStart    = input.time(timestamp("29 Sep 2026 09:30 -0400"), "Range start", group = G_VP, tooltip = "Pick on chart mode only. Date and time of the first bar.")
int    vpEnd      = input.time(timestamp("29 Sep 2026 16:00 -0400"), "Range end", group = G_VP, tooltip = "Pick on chart mode only. Date and time of the last bar.")
bool   vpToLive   = input.bool(false, "Extend picked range to the live bar", group = G_VP)
int    vpRows     = input.int(24, "Rows", minval = 5, maxval = 100, group = G_VP)
float  vpVAPct    = input.float(70.0, "Value area %", minval = 10.0, maxval = 100.0, step = 5.0, group = G_VP)
int    vpWidthPct = input.int(30, "Histogram width (% of range)", minval = 5, maxval = 100, group = G_VP)
string vpSide     = input.string("Left", "Placement", options = ["Left", "Right"], group = G_VP)
bool   vpSplit    = input.bool(true, "Split up / down volume", group = G_VP)
bool   vpExtend   = input.bool(true, "Extend POC / VAH / VAL to the right", group = G_VP)
color  vpUpCol    = input.color(#26a69a, "Up volume", inline = "vpc", group = G_VP)
color  vpDnCol    = input.color(#ef5350, "Down volume", inline = "vpc", group = G_VP)
color  pocCol     = input.color(#ff9800, "POC", inline = "lvl", group = G_VP)
color  vaCol      = input.color(#2962ff, "VAH / VAL", inline = "lvl", group = G_VP)

bool   showOR    = input.bool(true, "Show opening range", group = G_OR)
string orSess    = input.session("0930-0945", "Opening range", group = G_OR, tooltip = "0930-0935 = 5 min, 0930-0945 = 15 min, 0930-1000 = 30 min. Use a chart timeframe no bigger than the range (1m, 2m, 5m).")
string lvlSess   = input.session("0930-1600", "Levels active during", group = G_OR, tooltip = "OR levels stop extending and signals stop firing when this session ends.")
int    orKeep    = input.int(3, "Days to keep", minval = 1, maxval = 20, group = G_OR)
bool   orSignals = input.bool(true, "Breakout signals", group = G_OR, tooltip = "First candle close outside the range after it forms. At most one long and one short per day.")
bool   orFilter  = input.bool(true, "Only in the direction of the EMAs", group = G_OR, tooltip = "Longs need the fast EMA above the slow EMA, shorts need it below.")
color  orCol     = input.color(#b2b5be, "Range color", group = G_OR)

bool  showEma = input.bool(true, "Show EMAs", group = G_EMA)
int   fastLen = input.int(9, "Fast", minval = 1, inline = "fast", group = G_EMA)
color fastCol = input.color(#00bcd4, "", inline = "fast", group = G_EMA)
int   slowLen = input.int(20, "Slow", minval = 1, inline = "slow", group = G_EMA)
color slowCol = input.color(#ffeb3b, "", inline = "slow", group = G_EMA)
bool  emaFill = input.bool(true, "Trend fill between EMAs", group = G_EMA)

// ═══ Types & helpers ══════════════════════════════════════════════════════
type ORDay
    float hi
    float lo
    int   left
    box   zone
    line  hiLine
    line  loLine
    line  midLine
    label hiLabel
    label loLabel
    bool  formed    = false
    bool  longDone  = false
    bool  shortDone = false

type Profile
    array<float> h
    array<float> l
    array<float> v
    array<bool>  up
    int          startBar = na
    int          endBar   = na

method erase(ORDay d) =>
    d.zone.delete()
    d.hiLine.delete()
    d.loLine.delete()
    d.midLine.delete()
    d.hiLabel.delete()
    d.loLabel.delete()

newProfile() =>
    Profile.new(array.new<float>(), array.new<float>(), array.new<float>(), array.new<bool>())

method addBar(Profile p) =>
    p.h.push(high)
    p.l.push(low)
    p.v.push(nz(volume))
    p.up.push(close >= open)
    if na(p.startBar)
        p.startBar := bar_index
    p.endBar := bar_index

method trim(Profile p, int n) =>
    while p.h.size() > n
        p.h.shift()
        p.l.shift()
        p.v.shift()
        p.up.shift()
    p.startBar := p.endBar - p.h.size() + 1

// Black or white text, whichever reads better on the label color
textOn(color c) =>
    0.299 * color.r(c) + 0.587 * color.g(c) + 0.114 * color.b(c) > 150 ? color.black : color.white

// ═══ 9/20 EMA ═════════════════════════════════════════════════════════════
float emaFast = ta.ema(close, fastLen)
float emaSlow = ta.ema(close, slowLen)
bool  bull    = emaFast > emaSlow
bool  bear    = emaFast < emaSlow

pFast = plot(showEma ? emaFast : na, "Fast EMA", fastCol, 2)
pSlow = plot(showEma ? emaSlow : na, "Slow EMA", slowCol, 2)
fill(pFast, pSlow, showEma and emaFill ? (bull ? color.new(#26a69a, 88) : color.new(#ef5350, 88)) : na, "EMA trend fill")

// ═══ Opening range ════════════════════════════════════════════════════════
var array<ORDay> orDays = array.new<ORDay>()
var ORDay        cur    = na

bool inOR    = timeframe.isintraday and not na(time(timeframe.period, orSess, tz))
bool inLvls  = timeframe.isintraday and not na(time(timeframe.period, lvlSess, tz))
bool orStart = inOR and not inOR[1]
bool orEnd   = not inOR and inOR[1]
bool orLong  = false
bool orShort = false

if showOR
    if orStart
        cur := ORDay.new(high, low, bar_index)
        cur.zone := box.new(bar_index, high, bar_index, low, border_color = color.new(orCol, 40), bgcolor = color.new(orCol, 88))
        orDays.push(cur)
        if orDays.size() > orKeep
            orDays.shift().erase()
    else if inOR and not na(cur)
        cur.hi := math.max(cur.hi, high)
        cur.lo := math.min(cur.lo, low)
        cur.zone.set_top(cur.hi)
        cur.zone.set_bottom(cur.lo)
        cur.zone.set_right(bar_index)

    if orEnd and not na(cur)
        float mid = math.avg(cur.hi, cur.lo)
        cur.formed  := true
        cur.hiLine  := line.new(cur.left, cur.hi, bar_index, cur.hi, color = orCol, width = 2)
        cur.loLine  := line.new(cur.left, cur.lo, bar_index, cur.lo, color = orCol, width = 2)
        cur.midLine := line.new(cur.left, mid, bar_index, mid, color = color.new(orCol, 50), style = line.style_dotted)
        cur.hiLabel := label.new(bar_index, cur.hi, "ORH " + str.tostring(cur.hi, format.mintick), style = label.style_label_lower_left, color = orCol, textcolor = textOn(orCol), size = size.small)
        cur.loLabel := label.new(bar_index, cur.lo, "ORL " + str.tostring(cur.lo, format.mintick), style = label.style_label_upper_left, color = orCol, textcolor = textOn(orCol), size = size.small)

    if not na(cur) and cur.formed and inLvls
        cur.hiLine.set_x2(bar_index)
        cur.loLine.set_x2(bar_index)
        cur.midLine.set_x2(bar_index)
        cur.hiLabel.set_x(bar_index)
        cur.loLabel.set_x(bar_index)
        // Signals only on a closed candle, so they don't repaint
        if orSignals and barstate.isconfirmed
            if not cur.longDone and close > cur.hi and (not orFilter or bull)
                orLong       := true
                cur.longDone := true
            if not cur.shortDone and close < cur.lo and (not orFilter or bear)
                orShort       := true
                cur.shortDone := true

plotshape(orLong,  "ORB long",  shape.triangleup,   location.belowbar, #26a69a, text = "ORB", textcolor = #26a69a, size = size.small)
plotshape(orShort, "ORB short", shape.triangledown, location.abovebar, #ef5350, text = "ORB", textcolor = #ef5350, size = size.small)

alertcondition(orLong,  "ORB long",       "{{ticker}} closed above the opening range high")
alertcondition(orShort, "ORB short",      "{{ticker}} closed below the opening range low")
alertcondition(ta.crossover(emaFast, emaSlow),  "EMA cross up",   "{{ticker}} fast EMA crossed above slow EMA")
alertcondition(ta.crossunder(emaFast, emaSlow), "EMA cross down", "{{ticker}} fast EMA crossed below slow EMA")

// ═══ Volume profile ═══════════════════════════════════════════════════════
var Profile pickP   = newProfile()
var Profile latestP = newProfile()
var Profile prevP   = newProfile()
var Profile lastNP  = newProfile()

var array<box>   vpBoxes  = array.new<box>()
var array<line>  vpLines  = array.new<line>()
var array<label> vpLabels = array.new<label>()

int  t0        = math.min(vpStart, vpEnd)
int  t1        = math.max(vpStart, vpEnd)
bool inVPSess  = timeframe.isintraday and not na(time(timeframe.period, vpSess, tz))
bool vpNewSess = inVPSess and not inVPSess[1]

if showVP
    switch vpMode
        "Pick on chart" =>
            if time >= t0 and (vpToLive or time <= t1)
                pickP.addBar()
        "Last N bars" =>
            if bar_index > last_bar_index - vpBars
                lastNP.addBar()
                lastNP.trim(vpBars)
        =>
            if vpNewSess
                prevP   := latestP
                latestP := newProfile()
            if inVPSess
                latestP.addBar()

Profile prof = switch vpMode
    "Pick on chart"    => pickP
    "Last N bars"      => lastNP
    "Previous session" => prevP
    =>                    latestP

if barstate.islast
    for b in vpBoxes
        b.delete()
    for ln in vpLines
        ln.delete()
    for lb in vpLabels
        lb.delete()
    vpBoxes.clear()
    vpLines.clear()
    vpLabels.clear()

    if showVP and prof.h.size() == 0
        string msg = vpMode == "Pick on chart" ? "FRVP: the picked range isn't on the chart.\nSet Range start / end in Settings." : not timeframe.isintraday and vpMode != "Last N bars" ? "FRVP: session modes need an intraday chart." : "FRVP: no bars in range yet."
        vpLabels.push(label.new(bar_index, high, msg, style = label.style_label_down, color = color.new(color.gray, 20), textcolor = color.white, size = size.small))
    else if showVP
        float vpTop = prof.h.max()
        float vpBot = prof.l.min()
        float step  = (vpTop - vpBot) / vpRows
        array<float> upVol  = array.new<float>(vpRows, 0.0)
        array<float> dnVol  = array.new<float>(vpRows, 0.0)
        array<float> totVol = array.new<float>(vpRows, 0.0)

        // Spread each bar's volume across the rows its high-low range covers
        if step > 0
            for i = 0 to prof.h.size() - 1
                float h  = prof.h.get(i)
                float lo = prof.l.get(i)
                float v  = prof.v.get(i)
                if v > 0
                    int r0 = math.max(0, math.min(vpRows - 1, math.floor((lo - vpBot) / step)))
                    int r1 = math.max(0, math.min(vpRows - 1, math.floor((h - vpBot) / step)))
                    for r = r0 to r1
                        float share = h > lo ? (math.min(h, vpBot + (r + 1) * step) - math.max(lo, vpBot + r * step)) / (h - lo) : 1.0
                        if share > 0
                            float part = v * share
                            totVol.set(r, totVol.get(r) + part)
                            if prof.up.get(i)
                                upVol.set(r, upVol.get(r) + part)
                            else
                                dnVol.set(r, dnVol.get(r) + part)

        float total = totVol.sum()
        if total > 0
            int   poc    = totVol.indexof(totVol.max())
            int   vaLo   = poc
            int   vaHi   = poc
            float acc    = totVol.get(poc)
            float target = total * vpVAPct / 100.0
            // Grow the value area out from the POC toward the busier neighbour
            while acc < target and (vaLo > 0 or vaHi < vpRows - 1)
                float above = vaHi < vpRows - 1 ? totVol.get(vaHi + 1) : -1.0
                float below = vaLo > 0 ? totVol.get(vaLo - 1) : -1.0
                if above >= below
                    vaHi += 1
                    acc  += above
                else
                    vaLo -= 1
                    acc  += below

            float pocPx = math.round_to_mintick(vpBot + (poc + 0.5) * step)
            float vahPx = math.round_to_mintick(vpBot + (vaHi + 1) * step)
            float valPx = math.round_to_mintick(vpBot + vaLo * step)
            int   x0    = prof.startBar
            int   x1    = prof.endBar

            // Value area background first so the histogram draws on top
            vpBoxes.push(box.new(x0, vahPx, x1, valPx, border_color = color.new(vaCol, 75), bgcolor = color.new(vaCol, 94)))

            int   span   = x1 - x0 + 1
            int   maxW   = math.max(2, math.round(span * vpWidthPct / 100.0))
            float maxV   = totVol.max()
            float gap    = step * 0.08
            int   anchor = vpSide == "Left" ? x0 : x1
            int   dir    = vpSide == "Left" ? 1 : -1
            for r = 0 to vpRows - 1
                float rv = totVol.get(r)
                if rv > 0
                    int   w   = math.max(1, math.round(maxW * rv / maxV))
                    int   wUp = vpSplit ? math.round(w * upVol.get(r) / rv) : w
                    int   tr  = r >= vaLo and r <= vaHi ? 40 : 75
                    float yT  = vpBot + (r + 1) * step - gap
                    float yB  = vpBot + r * step + gap
                    if wUp > 0
                        int xa = anchor
                        int xb = anchor + dir * wUp
                        vpBoxes.push(box.new(math.min(xa, xb), yT, math.max(xa, xb), yB, border_color = color(na), bgcolor = color.new(vpUpCol, tr)))
                    if w > wUp
                        int xa = anchor + dir * wUp
                        int xb = anchor + dir * w
                        vpBoxes.push(box.new(math.min(xa, xb), yT, math.max(xa, xb), yB, border_color = color(na), bgcolor = color.new(vpDnCol, tr)))

            string ext = vpExtend ? extend.right : extend.none
            vpLines.push(line.new(x0, pocPx, x1, pocPx, color = pocCol, width = 2, extend = ext))
            vpLines.push(line.new(x0, vahPx, x1, vahPx, color = vaCol, style = line.style_dashed, extend = ext))
            vpLines.push(line.new(x0, valPx, x1, valPx, color = vaCol, style = line.style_dashed, extend = ext))

            // VAH sits above its line and VAL below, so neither covers the POC
            int lx = vpExtend ? bar_index + 4 : x1
            vpLabels.push(label.new(lx, vahPx, "VAH " + str.tostring(vahPx, format.mintick), style = label.style_label_lower_left, color = vaCol, textcolor = textOn(vaCol), size = size.small))
            vpLabels.push(label.new(lx, pocPx, "POC " + str.tostring(pocPx, format.mintick), style = label.style_label_left, color = pocCol, textcolor = textOn(pocCol), size = size.small))
            vpLabels.push(label.new(lx, valPx, "VAL " + str.tostring(valPx, format.mintick), style = label.style_label_upper_left, color = vaCol, textcolor = textOn(vaCol), size = size.small))
        else
            vpLabels.push(label.new(bar_index, high, "FRVP: no volume data on this symbol.", style = label.style_label_down, color = color.new(color.gray, 20), textcolor = color.white, size = size.small))
