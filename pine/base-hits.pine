var Lvl lPmM = Lvl.new(name = "PMM", col = pmCol)

var float drHi   = na
var float drLo   = na
var int   drHiAt = na
var int   drLoAt = na
var float dr2Hi   = na
var float dr2Lo   = na
var int   dr2HiAt = na
var int   dr2LoAt = na
var DRange dr1 = DRange.new()
var DRange dr2 = DRange.new()

var box   htfBody = na
var line  htfWick = na
var label htfTag  = na
var label htfCd   = na

var array<float> pivHi  = array.new<float>()
var array<float> pivLo  = array.new<float>()
var array<bool>  inFlag = array.new<bool>(4, false)
var Trade tr     = Trade.new()
var int   wins   = 0
var int   losses = 0
var int   bes    = 0
var int   tp1s   = 0
var int   lastSig = -100000
var label cdLb   = na
var table tbl    = na

// ───────────────────────── MARKET CONTEXT ─────────────────────────────────
float atrv = ta.atr(atrLen)
[stVal, stDir] = ta.supertrend(stMult, atrLen)
int trendDir = stDir < 0 ? 1 : -1

[pdH, pdL, pdC] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)
[pwH, pwL]      = request.security(syminfo.tickerid, "W", [high[1], low[1]],           lookahead = barmerge.lookahead_on)
[pmH, pmL]      = request.security(syminfo.tickerid, "M", [high[1], low[1]],           lookahead = barmerge.lookahead_on)

// the higher-timeframe candle currently being built, drawn beside price
[hO, hH, hL, hC, hTc] = request.security(syminfo.tickerid, htfTf, [open, high, low, close, time_close])
string htfLbl = str.contains(htfTf, "S") or str.contains(htfTf, "D") or str.contains(htfTf, "W") or str.contains(htfTf, "M") ? htfTf : htfTf + "m"

bool newD = nz(ta.change(time("D")), 0) != 0
bool newW = nz(ta.change(time("W")), 0) != 0
bool newM = nz(ta.change(time("M")), 0) != 0

inFlag.set(0, asiaOn and not na(time(timeframe.period, asiaSpec, tzIn)))
inFlag.set(1, lndnOn and not na(time(timeframe.period, lndnSpec, tzIn)))
inFlag.set(2, nyamOn and not na(time(timeframe.period, nyamSpec, tzIn)))
inFlag.set(3, nypmOn and not na(time(timeframe.period, nypmSpec, tzIn)))

// ───────────────────────── BIAS OF THE DAY ────────────────────────────────
// One direction per day. It is set once — by the first sweep of the chosen
// session range, or from prior-day context — and then locked until the next
// day, so only signals that agree with it are allowed to print.
[pdO, pdCl] = request.security(syminfo.tickerid, "D", [open[1], close[1]], lookahead = barmerge.lookahead_on)
float dEma  = request.security(syminfo.tickerid, "D", ta.ema(close, biasEma)[1], lookahead = barmerge.lookahead_on)
float pdMid = na(pdH) or na(pdL) ? na : (pdH + pdL) / 2

// The range whose sweep decides the day (read before this bar's session update,
// so the very bar that grabs the liquidity is already on the right side).
float bsHi = biasSrc == "ASIA" ? sAsia.pHi : biasSrc == "LNDN" ? sLndn.pHi : biasSrc == "NYAM" ? sNyam.pHi : biasSrc == "NYPM" ? sNypm.pHi : pdH
float bsLo = biasSrc == "ASIA" ? sAsia.pLo : biasSrc == "LNDN" ? sLndn.pLo : biasSrc == "NYAM" ? sNyam.pLo : biasSrc == "NYPM" ? sNypm.pLo : pdL
int   bsAt = biasSrc == "ASIA" ? sAsia.pAt : biasSrc == "LNDN" ? sLndn.pAt : biasSrc == "NYAM" ? sNyam.pAt : biasSrc == "NYPM" ? sNypm.pAt : na

var int dayStart = 0
if newD
    dayStart := bar_index

// Yesterday's session range is not today's bias — the range has to have closed
// inside the current day before its sweep counts.
bool bsFresh = biasSrc == "Prior day" or (not na(bsAt) and bsAt >= dayStart)

var int    biasDir = 0
var string biasWhy = "not set yet"

if newD
    biasDir := 0
    biasWhy := "not set yet"

if biasMode == "Manual"
    biasDir := manBias == "Buy only" ? 1 : manBias == "Sell only" ? -1 : 0
    biasWhy := "set manually"

// A grab of the low is buy-side fuel, a grab of the high is sell-side fuel.
if biasMode == "Sweep of a session" and biasDir == 0 and bsFresh and not na(bsHi) and not na(bsLo)
    bool tookLo = low < bsLo
    bool tookHi = high > bsHi
    if tookLo and not tookHi
        biasDir := 1
        biasWhy := biasSrc + " low swept → buys only"
    if tookHi and not tookLo
        biasDir := -1
        biasWhy := biasSrc + " high swept → sells only"
    if tookHi and tookLo
        biasDir := close > (bsHi + bsLo) / 2 ? 1 : -1
        biasWhy := biasSrc + " range swept both ways → closed " + (close > (bsHi + bsLo) / 2 ? "up" : "down")

if biasMode == "Prior-day equilibrium" and biasDir == 0 and not na(pdMid)
    biasDir := close > pdMid ? 1 : -1
    biasWhy := close > pdMid ? "above prior-day equilibrium" : "below prior-day equilibrium"

if biasMode == "Prior-day direction" and biasDir == 0 and not na(pdO) and not na(pdCl)
    biasDir := pdCl > pdO ? 1 : -1
    biasWhy := pdCl > pdO ? "prior day closed up" : "prior day closed down"

if biasMode == "Daily EMA trend" and biasDir == 0 and not na(dEma) and not na(pdCl)
    biasDir := pdCl > dEma ? 1 : -1
    biasWhy := pdCl > dEma ? "daily close above EMA" : "daily close below EMA"

bool allowBuy  = biasDir > 0 or (biasDir == 0 and allowNtr)
bool allowSell = biasDir < 0 or (biasDir == 0 and allowNtr)

// ───────────────────── LIQUIDITY RAID DETECTION ───────────────────────────
// Every candidate level is read *before* this bar's state updates, so a level
// only fires once — the first time price reaches through it and closes back.
float sellLvl = na
float buyLvl  = na

if useSessLiq
    for i = 0 to sessArr.size() - 1
        Sess s = sessArr.get(i)
        if s.on and not na(s.pHi)
            if not s.pHiSwept and high > s.pHi and close < s.pHi
                sellLvl := math.max(nz(sellLvl, s.pHi), s.pHi)
            if not s.pLoSwept and low < s.pLo and close > s.pLo
                buyLvl := math.min(nz(buyLvl, s.pLo), s.pLo)

if useHtfLiq
    for i = 0 to perArr.size() - 1
        Per p = perArr.get(i)
        if not na(p.wH) and not p.hitH and high > p.wH and close < p.wH
            sellLvl := math.max(nz(sellLvl, p.wH), p.wH)
        if not na(p.wL) and not p.hitL and low < p.wL and close > p.wL
            buyLvl := math.min(nz(buyLvl, p.wL), p.wL)

if usePivLiq and pivHi.size() > 0
    for i = 0 to pivHi.size() - 1
        float L = pivHi.get(i)
        if high > L and close < L
            sellLvl := math.max(nz(sellLvl, L), L)
if usePivLiq and pivLo.size() > 0
    for i = 0 to pivLo.size() - 1
        float L = pivLo.get(i)
        if low < L and close > L
            buyLvl := math.min(nz(buyLvl, L), L)

float barRng = math.max(high - low, syminfo.mintick)
bool  wickS  = (high - math.max(open, close)) / barRng * 100 >= minWick
bool  wickB  = (math.min(open, close) - low)  / barRng * 100 >= minWick
bool  coolOk = bar_index - lastSig > coolDown

// equilibrium of the current dealing range (as of the previous bar)
float drMid  = na(drHi) or na(drLo) ? na : (drHi + drLo) / 2
bool  premOk = not needPrem or (not na(drMid) and close > drMid)
bool  discOk = not needPrem or (not na(drMid) and close < drMid)

bool sellSig = allowSell and premOk and not na(sellLvl) and not na(atrv) and wickS and coolOk and (not needClose or close < open) and (not needTrend or trendDir < 0)
bool buySig  = allowBuy  and discOk and not na(buyLvl)  and not na(atrv) and wickB and coolOk and (not needClose or close > open) and (not needTrend or trendDir > 0)
if sellSig and buySig
    bool preferSell = biasDir != 0 ? biasDir < 0 : trendDir < 0
    sellSig := preferSell
    buySig  := not preferSell

// ─────────────────────────── STATE UPDATES ────────────────────────────────
for i = 0 to sessArr.size() - 1
    Sess sv = sessArr.get(i)
    sv.sessStep(inFlag.get(i), showSessBox, showSessLn, showSessLb, statN)

pDay.perStep(newD, pdH, pdL, statN)
pWk.perStep(newW, pwH, pwL, statN)
pMon.perStep(newM, pmH, pmL, statN)

float ph = ta.pivothigh(pivLen, pivLen)
float pl = ta.pivotlow(pivLen, pivLen)
if usePivLiq
    if pivHi.size() > 0
        for i = pivHi.size() - 1 to 0
            if pivHi.get(i) < high
                pivHi.remove(i)
    if pivLo.size() > 0
        for i = pivLo.size() - 1 to 0
            if pivLo.get(i) > low
                pivLo.remove(i)
    if not na(ph)
        capPush(pivHi, ph, maxLiq)
    if not na(pl)
        capPush(pivLo, pl, maxLiq)

// The dealing range is simply the last confirmed swing high and swing low.
if not na(ph)
    drHi   := ph
    drHiAt := bar_index - pivLen
if not na(pl)
    drLo   := pl
    drLoAt := bar_index - pivLen

float ph2 = ta.pivothigh(drLen2, drLen2)
float pl2 = ta.pivotlow(drLen2, drLen2)
if not na(ph2)
    dr2Hi   := ph2
    dr2HiAt := bar_index - drLen2
if not na(pl2)
    dr2Lo   := pl2
    dr2LoAt := bar_index - drLen2

lPdH.render(newD, pdH, showPD)
lPdL.render(newD, pdL, showPD)
lPdC.render(newD, pdC, showPDC)
lPwH.render(newW, pwH, showPW)
lPwL.render(newW, pwL, showPW)
lPmH.render(newM, pmH, showPM)
lPmL.render(newM, pmL, showPM)
lPdM.render(newD, na(pdH) or na(pdL) ? na : (pdH + pdL) / 2, showMid and showPD)
lPwM.render(newW, na(pwH) or na(pwL) ? na : (pwH + pwL) / 2, showMid and showPW)
lPmM.render(newM, na(pmH) or na(pmL) ? na : (pmH + pmL) / 2, showMid and showPM)

// ── session opens: the price at 09:30 / 12:00 / 00:00, held for the day, and
//    a vertical divider on the bar that stamps each one.
int  tNyo  = time(timeframe.period, nyoSpec, tzIn)
int  tMid  = time(timeframe.period, midSpec, tzIn)
int  tMno  = time(timeframe.period, mnoSpec, tzIn)
bool atNyo = not na(tNyo) and na(tNyo[1])
bool atMid = not na(tMid) and na(tMid[1])
bool atMno = not na(tMno) and na(tMno[1])

if atNyo
    nyoPx := open
if atMid
    midPx := open
if atMno
    mnoPx := open

lNyo.render(atNyo, nyoPx, showOpn)
lMid.render(atMid, midPx, showOpn)
lMno.render(atMno, mnoPx, showOpn)

if showDiv and (atNyo or atMid or atMno)
    line.new(bar_index, low, bar_index, high, extend = extend.both,
         color = color.new(opnCol, 55), style = line.style_dotted)

// ─────────────────────────── SIGNAL LABELS ────────────────────────────────
if sellSig
    label.new(bar_index, high + atrv * 0.4, "SELL LR", xloc.bar_index, yloc.price,
         sigCol, label.style_label_down, color.black, size.tiny,
         tooltip = "Swept " + str.tostring(sellLvl, format.mintick) + " and closed back below")
    lastSig := bar_index
    alert("SELL LR — liquidity raid on " + syminfo.ticker, alert.freq_once_per_bar_close)
if buySig
    label.new(bar_index, low - atrv * 0.4, "BUY LR", xloc.bar_index, yloc.price,
         sigCol, label.style_label_up, color.black, size.tiny,
         tooltip = "Swept " + str.tostring(buyLvl, format.mintick) + " and closed back above")
    lastSig := bar_index
    alert("BUY LR — liquidity raid on " + syminfo.ticker, alert.freq_once_per_bar_close)

// ────────────────────────── TRADE PROJECTION ──────────────────────────────
if tr.active
    bool stopHit = tr.dir < 0 ? high >= tr.stop : low  <= tr.stop
    bool tgtHit  = tr.dir < 0 ? low  <= tr.tgt  : high >= tr.tgt
    bool resolved = stopHit or tgtHit
    if resolved
        tr.active := false
        if stopHit and tr.be
            bes += 1
        if stopHit and not tr.be
            losses += 1
        if not stopHit
            wins += 1
        if not na(tr.rBx)
            box.set_right(tr.rBx, bar_index)
            box.set_bgcolor(tr.rBx, color.new(riskCol, stopHit and not tr.be ? 55 : 90))
        if not na(tr.tBx)
            box.set_right(tr.tBx, bar_index)
            box.set_bgcolor(tr.tBx, color.new(rewCol, tgtHit and not stopHit ? 55 : 90))
        if not na(tr.tp1Ln)
            line.set_x2(tr.tp1Ln, bar_index)
        if not na(tr.tp1Lb)
            label.set_x(tr.tp1Lb, bar_index)
        if not na(tr.lb)
            label.set_x(tr.lb, bar_index)
            label.set_text(tr.lb, stopHit ? (tr.be ? "BE" : "SL") : "TP")

    if not resolved
        // a piece off the table at the partial, then the stop comes to entry
        if not tr.tp1 and not na(tr.tp1Px)
            bool t1Hit = tr.dir < 0 ? low <= tr.tp1Px : high >= tr.tp1Px
            if t1Hit
                tr.tp1 := true
                tp1s   += 1
                if not na(tr.tp1Ln)
                    line.set_color(tr.tp1Ln, color.new(color.gray, 35))
                if not na(tr.tp1Lb)
                    label.set_text(tr.tp1Lb, "TP1 ✓")
                    label.set_textcolor(tr.tp1Lb, color.gray)
        if not na(tr.tp1Ln)
            line.set_x2(tr.tp1Ln, bar_index + projBars)
        if not na(tr.tp1Lb)
            label.set_x(tr.tp1Lb, bar_index + projBars)
        // once the trade has paid for itself, the stop comes to entry
        if beAtR > 0 and not tr.be and not na(tr.risk)
            float trig = tr.entry + tr.dir * tr.risk * beAtR
            bool reached = tr.dir < 0 ? low <= trig : high >= trig
            if reached
                tr.be   := true
                tr.stop := tr.entry
                if not na(tr.rBx)
                    box.set_top(tr.rBx, tr.entry)
                    box.set_bottom(tr.rBx, tr.entry)
                    box.set_bgcolor(tr.rBx, color.new(color.gray, 85))
                    box.set_border_color(tr.rBx, color.new(color.gray, 45))
                if not na(tr.lb)
                    label.set_text(tr.lb, "BE")
        if not na(tr.rBx)
            box.set_right(tr.rBx, bar_index + projBars)
        if not na(tr.tBx)
            box.set_right(tr.tBx, bar_index + projBars)
        if not na(tr.lb)
            label.set_x(tr.lb, bar_index + projBars)

if showTrade and not tr.active and (sellSig or buySig)
    int   d    = sellSig ? -1 : 1
    float lvl  = sellSig ? sellLvl : buyLvl
    float e    = close
    float sl   = d < 0 ? math.max(high, lvl) + atrv * stopBuf : math.min(low, lvl) - atrv * stopBuf
    float risk = math.abs(sl - e)
    if risk > 0
        float tp = e + d * risk * rrMult
        tr.active := true
        tr.be     := false
        tr.dir    := d
        tr.entry  := e
        tr.stop   := sl
        tr.tgt    := tp
        tr.risk   := risk
        tr.rBx := box.new(bar_index, math.max(e, sl), bar_index + projBars, math.min(e, sl),
             border_color = color.new(riskCol, 40), bgcolor = riskCol)
        tr.tBx := box.new(bar_index, math.max(e, tp), bar_index + projBars, math.min(e, tp),
             border_color = color.new(rewCol, 40), bgcolor = rewCol)
        tr.lb  := newLbl(bar_index + projBars, tp, str.tostring(rrMult, "#.#") + "R", d < 0 ? riskCol : rewCol)
        tr.tp1   := false
        tr.tp1Px := tp1AtR > 0 ? e + d * risk * tp1AtR : na
        tr.tp1Ln := na
        tr.tp1Lb := na
        if not na(tr.tp1Px)
            tr.tp1Ln := line.new(bar_index, tr.tp1Px, bar_index + projBars, tr.tp1Px,
                 color = color.new(rewCol, 20), style = line.style_dashed)
            tr.tp1Lb := newLbl(bar_index + projBars, tr.tp1Px, "TP1", rewCol)

// ───────────────────────────── TREND CLOUD ────────────────────────────────
float cloudEdge = stVal + (stDir < 0 ? -1 : 1) * atrv * bandMult
p1 = plot(showCloud ? stVal : na, "Trend line", color = color.new(trendDir > 0 ? bullCol : bearCol, 30))
p2 = plot(showCloud ? cloudEdge : na, "Cloud edge", color = color.new(color.black, 100))
fill(p1, p2, color = trendDir > 0 ? bullCol : bearCol, title = "Trend cloud")

// ──────────────────────── COUNTDOWN + STATS TABLE ─────────────────────────
if barstate.islast
    if showCd or showBias
        int rem  = int(math.max(0, time_close - timenow) / 1000)
        int hrs  = int(rem / 3600)
        int mins = int(rem % 3600 / 60)
        int secs = int(rem % 60)
        string cdTxt = timeframe.period + "  " + (hrs > 0 ? str.tostring(hrs) + ":" : "") + pad2(mins) + ":" + pad2(secs)
        string bTxt  = biasDir > 0 ? "BUY BIAS" : biasDir < 0 ? "SELL BIAS" : "NO BIAS"
        string sTxt  = showBias and showCd ? bTxt + "\n" + cdTxt : showBias ? bTxt : cdTxt
        color  sBg   = biasDir > 0 ? color.new(#26a69a, 20) : biasDir < 0 ? color.new(#ef5350, 20) : color.new(color.gray, 25)
        if na(cdLb)
            cdLb := label.new(bar_index + 3, close, sTxt, xloc.bar_index, yloc.price,
                 sBg, label.style_label_left, color.white, size.small)
        label.set_xy(cdLb, bar_index + 3, close)
        label.set_text(cdLb, sTxt)
        label.set_color(cdLb, sBg)
        label.set_tooltip(cdLb, "Bias: " + biasWhy)

    // ── dealing range: premium above equilibrium, discount below
    if showDR
        dr1.draw(drHi, drLo, drHiAt, drLoAt, drExt, premCol, discCol, showDRq, "EQ")
    if showDR and showDR2
        dr2.draw(dr2Hi, dr2Lo, dr2HiAt, dr2LoAt, drExt, premCol, discCol, showDRq, "eq")

    // ── the developing HTF candle, parked to the right of the last bar
    if showHtf and not na(hO)
        int   lft   = bar_index + htfGap
        int   rgt   = lft + htfW
        int   mid   = lft + int(htfW / 2)
        color bodyC = hC >= hO ? color.new(#26a69a, 15) : color.new(#ef5350, 15)
        float bt    = math.max(hO, hC)
        float bb    = math.min(hO, hC)
        if na(htfBody)
            htfBody := box.new(lft, bt, rgt, bb, border_color = bodyC, bgcolor = bodyC)
            htfWick := line.new(mid, hH, mid, hL, color = bodyC)
            htfTag  := label.new(mid, hH, htfLbl, xloc.bar_index, yloc.price,
                 color.new(color.black, 100), label.style_label_down, color.gray, size.tiny)
            htfCd   := label.new(mid, hL, "", xloc.bar_index, yloc.price,
                 color.new(color.black, 100), label.style_label_up, color.gray, size.tiny)
        box.set_lefttop(htfBody, lft, bt)
        box.set_rightbottom(htfBody, rgt, bb)
        box.set_bgcolor(htfBody, bodyC)
        box.set_border_color(htfBody, bodyC)
        line.set_xy1(htfWick, mid, hH)
        line.set_xy2(htfWick, mid, hL)
        line.set_color(htfWick, bodyC)
        label.set_xy(htfTag, mid, hH)
        label.set_xy(htfCd, mid, hL)
        int hrem = int(math.max(0, hTc - timenow) / 1000)
        int hhrs = int(hrem / 3600)
        label.set_text(htfCd, (hhrs > 0 ? str.tostring(hhrs) + ":" : "") + pad2(int(hrem % 3600 / 60)) + ":" + pad2(int(hrem % 60)))

    if showTbl
        if na(tbl)
            tbl := table.new(tblPos, 4, showWL ? 9 : 8, border_width = 1,
                 frame_width = 1, frame_color = color.new(color.gray, 50), border_color = color.new(color.gray, 60))
        color hdr = color.new(color.black, 30)
        table.cell(tbl, 0, 0, biasDir > 0 ? "BUY" : biasDir < 0 ? "SELL" : "—",
             text_color = color.white, text_size = tblSize,
             bgcolor = biasDir > 0 ? color.new(#26a69a, 35) : biasDir < 0 ? color.new(#ef5350, 35) : hdr,
             tooltip = "Bias of the day: " + biasWhy)
        table.cell(tbl, 1, 0, "Range", text_color = color.white, bgcolor = hdr, text_size = tblSize, tooltip = "Average range of the last N occurrences")
        table.cell(tbl, 2, 0, "High",  text_color = color.white, bgcolor = hdr, text_size = tblSize, tooltip = "How often that high is taken out afterwards")
        table.cell(tbl, 3, 0, "Low",   text_color = color.white, bgcolor = hdr, text_size = tblSize, tooltip = "How often that low is taken out afterwards")
        statRow(tbl, 1, "ASIA", asiaCol, sAsia.rng, sAsia.hHit, sAsia.lHit, tblSize)
        statRow(tbl, 2, "LNDN", lndnCol, sLndn.rng, sLndn.hHit, sLndn.lHit, tblSize)
        statRow(tbl, 3, "NYAM", nyamCol, sNyam.rng, sNyam.hHit, sNyam.lHit, tblSize)
        statRow(tbl, 4, "NYPM", nypmCol, sNypm.rng, sNypm.hHit, sNypm.lHit, tblSize)
        statRow(tbl, 5, "PD",   pdCol,   pDay.rng,  pDay.hHit,  pDay.lHit,  tblSize)
        statRow(tbl, 6, "PW",   pwCol,   pWk.rng,   pWk.hHit,   pWk.lHit,   tblSize)
        statRow(tbl, 7, "PM",   pmCol,   pMon.rng,  pMon.hHit,  pMon.lHit,  tblSize)
        if showWL
            int    done = wins + losses
            float  wr   = done > 0 ? 100.0 * wins / done : na
            string wrTip = "win rate excluding breakevens: " + (na(wr) ? "–" : str.tostring(int(math.round(wr))) + "%") + "\npartials reached: " + str.tostring(tp1s)
            table.cell(tbl, 0, 8, "LR", text_color = color.white, bgcolor = color.new(sigCol, 40), text_size = tblSize, tooltip = wrTip)
            table.cell(tbl, 1, 8, str.tostring(wins) + "W", text_color = color.white, bgcolor = color.new(#26a69a, 60), text_size = tblSize, tooltip = wrTip)
            table.cell(tbl, 2, 8, str.tostring(losses) + "L", text_color = color.white, bgcolor = color.new(#ef5350, 60), text_size = tblSize, tooltip = wrTip)
            table.cell(tbl, 3, 8, str.tostring(bes) + "BE", text_color = color.white, bgcolor = color.new(color.gray, 60), text_size = tblSize, tooltip = wrTip)

// ─────────────────────────────── ALERTS ───────────────────────────────────
alertcondition(sellSig, "SELL LR", "Base HITS: sell-side liquidity raid")
alertcondition(buySig,  "BUY LR",  "Base HITS: buy-side liquidity raid")
