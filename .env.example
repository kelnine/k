# ---- Telegram ----
# Create a bot with @BotFather, paste the token here.
BOT_TOKEN=123456:ABC-your-token
# Public channel the bot posts to (add the bot as admin). @handle or -100... id
FREE_CHANNEL=@your_free_channel
# Private VIP channel (bot must be admin so it can post + invite). Optional.
VIP_CHANNEL=-1001234567890
# Your Telegram user id(s), comma separated — allowed to run /post.
ADMIN_IDS=

# ---- Monetization ----
# Exchange referral code (the analysis engine returns one, e.g. NMX8B0ND).
REF_CODE=NMX8B0ND
# Override these with YOUR actual affiliate links. {ref} is substituted.
REF_WEEX=https://weex.com/register?ref={ref}
REF_BITUNIX=https://www.bitunix.com/register?ref={ref}
REF_BTCC=https://www.btcc.com/register?ref={ref}
# VIP price in Telegram Stars (~$0.013 each). 2000 ≈ $26.
VIP_PRICE_STARS=2000
VIP_DAYS=30

# ---- Signals ----
WATCHLIST=BTC,ETH,SOL,ZEC,SUI,LINK
FREE_MIN_CONFIDENCE=55
VIP_MIN_CONFIDENCE=45
POST_INTERVAL_MIN=120
TZ_LABEL=UTC

# ---- Data source ----
# "binance" works with zero config. "liquid" uses the Co-Invest engine.
DATA_SOURCE=binance
LIQUID_BASE_URL=
LIQUID_TOKEN=

DB_PATH=signals.db
