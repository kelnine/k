//@version=6
// Volume + Momentum System — the two studies merged into one indicator.
// A WaveTrend-style momentum "mountain" (blue -> cyan -> yellow -> red into
// overbought) sits over a normalized relative-volume heatmap, with Bull/Bear
// labels, a combined confluence signal and one unified dashboard.
indicator("Volume + Momentum System", shorttitle="VolMom", overlay=false, max_labels_count=200)

// ------------------------------------------------------------- inputs
// momentum
src      = input.source(hlc3, "Source", group="Momentum")
chanLen  = input.int(10, "Channel Length", minval=1, group="Momentum")
avgLen   = input.int(21, "Average Length", minval=1, group="Momentum")
sigLen   = input.int(4,  "Signal Smoothing", minval=1, group="Momentum")
obLevel  = input.float(60,  "Overbought", step=1, group="Momentum")
osLevel  = input.float(-60, "Oversold", step=1, group="Momentum")
// volume
maLen    = input.int(20, "Volume MA Length", minval=1, group="Volume")
spikeMult= input.float(2.0, "Spike  (× MA)", minval=1.0, step=0.1, group="Volume")
highMult = input.float(1.3, "High   (× MA)", minval=1.0, step=0.1, group="Volume")
lowMult  = input.float(0.5, "Low    (× MA)", minval=0.0, step=0.1, group="Volume")
consistLen = input.int(20, "Consistency Window", minval=2, group="Volume")
trendLen   = input.int(8,  "Vol Trend Window", minval=1, group="Volume")
// appearance
showMom    = input.bool(true, "Show momentum mountain", group="Appearance")
showRibbon = input.bool(true, "Show momentum ribbon", group="Appearance")
showVol    = input.bool(true, "Show volume heatmap (background)", group="Appearance")
showLabels = input.bool(true, "Show Bull/Bear labels", group="Appearance")
// dashboard
showTable = input.bool(true, "Show dashboard", group="Dashboard")
compact   = input.bool(true, "Compact dashboard", group="Dashboard")
tablePos  = input.string("Top Right", "Position", options=["Top Right","Top Left","Bottom Right","Bottom Left"], group="Dashboard")
tblSizeIn = input.string("Tiny", "Text size", options=["Tiny","Small","Normal"], group="Dashboard")

// ------------------------------------------------------------- palette
cUp   = #26a69a
cDown = #ef5350
cHi   = #26c6da
cLo   = #5c6f7a
cMute = #9aa7b2
cWarn = #fdd835
cMa   = #ff9800
hmLow = #2962ff
hmMid = #26c6da
hmWrm = #ffea00
hmHot = #ff1744

// ------------------------------------------------------------- helpers
f_pos() =>
    tablePos == "Top Right"   ? position.top_right   :
     tablePos == "Top Left"    ? position.top_left    :
     tablePos == "Bottom Left" ? position.bottom_left :
     position.bottom_right

f_compact(float x) =>
    a = math.abs(x)
    a >= 1e9 ? str.tostring(x / 1e9, "#.##") + "B" :
     a >= 1e6 ? str.tostring(x / 1e6, "#.##") + "M" :
     a >= 1e3 ? str.tostring(x / 1e3, "#.##") + "K" :
     str.tostring(x, "#.##")

momGrad(float v) =>
    v >= obLevel * 0.5 ? color.from_gradient(v, obLevel * 0.5, obLevel, hmWrm, hmHot) :
     v >= 0            ? color.from_gradient(v, 0, obLevel * 0.5, hmMid, hmWrm) :
     color.from_gradient(v, osLevel, 0, hmLow, hmMid)

// ------------------------------------------------------------- momentum (WaveTrend)
esa = ta.ema(src, chanLen)
de  = ta.ema(math.abs(src - esa), chanLen)
ci  = de != 0 ? (src - esa) / (0.015 * de) : 0.0
mom = ta.ema(ci, avgLen)
sig = ta.sma(mom, sigLen)
grad = momGrad(mom)

bullCross = ta.crossover(mom, sig) and mom < osLevel
bearCross = ta.crossunder(mom, sig) and mom > obLevel

// ------------------------------------------------------------- volume
volMA  = ta.sma(volume, maLen)
relVol = volMA > 0 ? volume / volMA : 1.0
volPct = (relVol - 1.0) * 100.0
priceUp = close >= open

dir = math.sign(volume - volume[1])
var int consec = 0
if dir == 0
    consec := 0
else if dir == dir[1]
    consec := consec + 1
else
    consec := 1

meanV = ta.sma(volume, consistLen)
sdV   = ta.stdev(volume, consistLen)
cv    = meanV > 0 ? sdV / meanV : 0.0
consistency  = cv < 0.4 ? "CONSISTENT" : cv < 0.9 ? "MODERATE" : "ERRATIC"
consistColor = cv < 0.4 ? cUp : cv < 0.9 ? cWarn : cDown

pattern  = relVol >= spikeMult ? "Volume Spike" : relVol >= highMult ? "High Volume" : relVol <= lowMult ? "Low Volume" : "Normal"
patColor = relVol >= highMult ? cHi : relVol <= lowMult ? cLo : cMute

maPast   = volMA[trendLen]
vslope   = not na(maPast) and maPast > 0 ? (volMA - maPast) / maPast : 0.0
vtrend   = vslope > 0.1 ? "Increasing" : vslope < -0.1 ? "Decreasing" : "Flat"
vtrendCol= vslope > 0.1 ? cUp : vslope < -0.1 ? cDown : cMute

// volume heatmap colour
volBase  = relVol <= 1.0       ? color.from_gradient(relVol, lowMult, 1.0, hmLow, cUp) :
           relVol <= spikeMult ? color.from_gradient(relVol, 1.0, spikeMult, hmMid, hmWrm) :
           color.from_gradient(relVol, spikeMult, spikeMult * 2.0, hmWrm, hmHot)
// normalize volume into the momentum pane: relVol -> pane units (1x ≈ OB/2)
volScaled = math.min(relVol, 5.0) * (obLevel / 2.0)

// ------------------------------------------------------------- combined signal
volConfirm = relVol >= highMult
combo = bullCross ? (volConfirm ? "STRONG BUY" : "Bullish") : bearCross ? (volConfirm ? "STRONG SELL" : "Bearish") : mom >= obLevel ? "Overbought" : mom <= osLevel ? "Oversold" : (mom >= 0 ? "Bull bias" : "Bear bias")
comboCol2 = combo == "STRONG BUY" ? cUp : combo == "STRONG SELL" ? cDown : combo == "Bullish" ? cUp : combo == "Bearish" ? cDown : combo == "Oversold" ? cUp : combo == "Overbought" ? cDown : cWarn

// ------------------------------------------------------------- plots
// volume heatmap drawn first so momentum sits on top
plot(showVol ? volScaled : na, "Volume", color=color.new(volBase, 72), style=plot.style_columns)

hline(0, "Zero", color=color.new(color.gray, 60), linestyle=hline.style_dotted)
obL = hline(obLevel, "Overbought", color=color.new(cDown, 55), linestyle=hline.style_dashed)
osL = hline(osLevel, "Oversold",   color=color.new(cUp, 55),   linestyle=hline.style_dashed)
fill(obL, osL, color=color.new(color.gray, 95))

plot(showMom ? mom : na, "Momentum Area", color=color.new(grad, 60), style=plot.style_area)
plot(showMom ? mom : na, "Momentum", color=grad, linewidth=2)
plot(showMom ? sig : na, "Signal", color=color.new(color.white, 25), linewidth=1)

r1 = ta.ema(mom, 3)
r2 = ta.ema(mom, 6)
r3 = ta.ema(mom, 9)
plot(showRibbon ? r1 : na, "Ribbon 1", color=color.new(momGrad(r1), 50), linewidth=1)
plot(showRibbon ? r2 : na, "Ribbon 2", color=color.new(momGrad(r2), 65), linewidth=1)
plot(showRibbon ? r3 : na, "Ribbon 3", color=color.new(momGrad(r3), 80), linewidth=1)

if showLabels and bullCross
    label.new(bar_index, mom, "Bullish", style=label.style_label_up, color=color.new(cUp, 0), textcolor=color.white, size=size.tiny)
if showLabels and bearCross
    label.new(bar_index, mom, "Bearish OB", style=label.style_label_down, color=color.new(cDown, 0), textcolor=color.white, size=size.tiny)

// ------------------------------------------------------------- dashboard
momState = mom >= obLevel ? "OVERBOUGHT" : mom <= osLevel ? "OVERSOLD" : mom >= 0 ? "Bull zone" : "Bear zone"
momStCol = mom >= obLevel ? cDown : mom <= osLevel ? cUp : cMute
relColor = relVol >= highMult ? cHi : relVol <= lowMult ? cLo : cMute
pctColor = volPct >= 0 ? cUp : cDown

tSize = tblSizeIn == "Normal" ? size.normal : tblSizeIn == "Small" ? size.small : size.tiny
var table dash = table.new(f_pos(), 2, 10, border_width=1, frame_width=1, frame_color=color.new(color.gray, 40))

f_row(int r, string label, string val, color valCol) =>
    table.cell(dash, 0, r, label, text_color=color.new(#9aa7b2, 0), text_size=tSize, text_halign=text.align_left,  bgcolor=color.new(#0c1116, 0))
    table.cell(dash, 1, r, val,   text_color=valCol,                text_size=tSize, text_halign=text.align_right, bgcolor=color.new(#0c1116, 0))

if showTable and barstate.islast
    table.cell(dash, 0, 0, "SIGNAL", text_color=color.white, text_size=tSize, text_halign=text.align_left,  bgcolor=color.new(#1b2630, 0))
    table.cell(dash, 1, 0, combo, text_color=color.new(comboCol2, 0), text_size=tSize, text_halign=text.align_right, bgcolor=color.new(#1b2630, 0))
    if compact
        f_row(1, "Momentum", str.tostring(mom, "#.#"), color.new(grad, 0))
        f_row(2, "Mom State", momState, color.new(momStCol, 0))
        f_row(3, "Rel Vol", str.tostring(relVol, "#.##") + "×", color.new(relColor, 0))
        f_row(4, "Volume", pattern, color.new(patColor, 0))
    else
        f_row(1, "Momentum", str.tostring(mom, "#.#"), color.new(grad, 0))
        f_row(2, "Signal Ln", str.tostring(sig, "#.#"), color.new(color.white, 0))
        f_row(3, "Mom State", momState, color.new(momStCol, 0))
        f_row(4, "Volume", f_compact(volume), color.new(cUp, 0))
        f_row(5, "Vol MA", f_compact(volMA), color.new(cMa, 0))
        f_row(6, "Rel Vol", str.tostring(relVol, "#.##") + "×", color.new(relColor, 0))
        f_row(7, "Volume %", (volPct >= 0 ? "+" : "") + str.tostring(volPct, "#.#") + "%", color.new(pctColor, 0))
        f_row(8, "Pattern", pattern, color.new(patColor, 0))
        f_row(9, "Vol Trend", vtrend, color.new(vtrendCol, 0))

// ------------------------------------------------------------- alerts
alertcondition(bullCross, "Bullish cross", "Momentum bullish cross in oversold zone")
alertcondition(bearCross, "Bearish cross", "Momentum bearish cross in overbought zone")
alertcondition(bullCross and volConfirm, "STRONG BUY", "Bullish momentum cross confirmed by high volume")
alertcondition(bearCross and volConfirm, "STRONG SELL", "Bearish momentum cross confirmed by high volume")
alertcondition(relVol >= spikeMult, "Volume spike", "Relative volume above the spike threshold")
