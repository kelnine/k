//@version=6
// Jetstream Strategy — backtestable version of the Jetstream indicator.
// Same engine (ATR SuperTrend trail + WaveTrend waves); the trend flips drive
// stop-and-reverse entries so you can run it in the Strategy Tester. Waves sit
// in this pane; trail / ribbon / trades are forced onto price via force_overlay.
//
// NOT financial advice. Backtest results are hypothetical and include no
// slippage beyond what you set below — forward-test before risking real money.
strategy("Jetstream Strategy", overlay = false, precision = 2, max_labels_count = 500,
     initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 10,
     commission_type = strategy.commission.percent, commission_value = 0.05, process_orders_on_close = true)

// ================================================================ strategy inputs
grpX    = "Strategy"
dirMode = input.string("Both", "Direction", options = ["Both", "Long only", "Short only"], group = grpX)
reqWave = input.bool(false, "Require wave agreement", tooltip = "Only take a flip if the WaveTrend is on the same side", group = grpX)
useStop = input.bool(false, "Use ATR stop / target", group = grpX)
slMult  = input.float(2.0, "Stop  (× ATR)",   minval = 0.1, step = 0.1, group = grpX)
tpMult  = input.float(4.0, "Target (× ATR)",  minval = 0.1, step = 0.1, group = grpX)
useDates = input.bool(false, "Limit date range", group = grpX)
startT  = input.time(timestamp("2020-01-01"), "From", group = grpX)
endT    = input.time(timestamp("2030-01-01"), "To",   group = grpX)
inWindow = not useDates or (time >= startT and time <= endT)

// ================================================================ TREND (on price)
grpT   = "Trend"
atrLen = input.int(10, "ATR Length", minval = 1, group = grpT)
mult   = input.float(3.0, "ATR Multiplier", minval = 0.1, step = 0.1, group = grpT)

grpR    = "EMA Ribbon"
showRib = input.bool(true, "Show ribbon", group = grpR)
fastLen = input.int(21, "Fast EMA", minval = 1, group = grpR)
slowLen = input.int(55, "Slow EMA", minval = 1, group = grpR)

grpS     = "Signals"
showSig  = input.bool(true, "Show signals", group = grpS)
sigStyle = input.string("Labels", "Style", options = ["Labels", "Triangles"], group = grpS)
colorBars = input.bool(false, "Colour bars by trend", group = grpS)

teal = color.new(#26a69a, 0)
red  = color.new(#ef5350, 0)

[st, dir] = ta.supertrend(mult, atrLen)
upTrend = dir < 0
atrv = ta.atr(atrLen)

plot(upTrend ? st : na, "Up trail",   color = teal, linewidth = 2, style = plot.style_linebr, force_overlay = true)
plot(upTrend ? na : st, "Down trail", color = red,  linewidth = 2, style = plot.style_linebr, force_overlay = true)

fast = ta.ema(close, fastLen)
slow = ta.ema(close, slowLen)
pf = plot(showRib ? fast : na, "Fast EMA", color = color.new(#78c8ff, 30), force_overlay = true)
ps = plot(showRib ? slow : na, "Slow EMA", color = color.new(#ffaa5a, 30), force_overlay = true)
fill(pf, ps, color = fast > slow ? color.new(#26a69a, 88) : color.new(#ef5350, 88), title = "Ribbon")

flip = ta.change(dir)
tBuy  = flip < 0
tSell = flip > 0
labels = sigStyle == "Labels"
plotshape(showSig and tBuy  and labels,      "Buy label",  style = shape.labelup,      location = location.belowbar, color = teal, text = "BUY",  textcolor = color.white, size = size.small, force_overlay = true)
plotshape(showSig and tSell and labels,      "Sell label", style = shape.labeldown,    location = location.abovebar, color = red,  text = "SELL", textcolor = color.white, size = size.small, force_overlay = true)
plotshape(showSig and tBuy  and not labels,  "Buy tri",    style = shape.triangleup,   location = location.belowbar, color = teal, size = size.tiny, force_overlay = true)
plotshape(showSig and tSell and not labels,  "Sell tri",   style = shape.triangledown, location = location.abovebar, color = red,  size = size.tiny, force_overlay = true)

barcolor(colorBars ? (upTrend ? teal : red) : na)

// ================================================================ WAVES (this pane)
grpO     = "Oscillator"
oscStyle = input.string("VolMom", "Oscillator style", options = ["Jetstream", "VolMom"], group = grpO)

grpW   = "WaveTrend"
src    = input.source(hlc3, "Source", group = grpW)
n1     = input.int(10, "Channel Length", minval = 1, group = grpW)
n2     = input.int(21, "Average Length", minval = 1, group = grpW)
sigLen = input.int(4,  "Signal SMA",     minval = 1, group = grpW)

grpL   = "Levels"
ob     = input.int(60,  "Overbought", group = grpL)
os     = input.int(-60, "Oversold",   group = grpL)

grpRB  = "Rainbow (Jetstream)"
layers = input.int(6, "Layers", minval = 1, maxval = 6, group = grpRB)

grpMF  = "Money Flow (Jetstream)"
showMF = input.bool(true, "Show money-flow area", group = grpMF)
mfLen  = input.int(60, "MF Length", minval = 1, group = grpMF)
mfMult = input.float(150.0, "MF Scale", minval = 1, group = grpMF)

grpV   = "Volume (VolMom)"
maLen     = input.int(20, "Volume MA Length", minval = 1, group = grpV)
spikeMult = input.float(2.0, "Spike  (× MA)", minval = 1.0, step = 0.1, group = grpV)
highMult  = input.float(1.3, "High   (× MA)", minval = 1.0, step = 0.1, group = grpV)
lowMult   = input.float(0.5, "Low    (× MA)", minval = 0.0, step = 0.1, group = grpV)
showMom    = input.bool(true, "Momentum mountain", group = grpV)
showRibbon = input.bool(true, "Momentum ribbon", group = grpV)
showVol    = input.bool(true, "Volume heatmap", group = grpV)
showLabels = input.bool(true, "Bull/Bear labels", group = grpV)

grpD   = "Dashboard (VolMom)"
showTable = input.bool(true, "Show dashboard", group = grpD)
tablePos  = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grpD)

isJet = oscStyle == "Jetstream"
isVM  = oscStyle == "VolMom"

hmLow = #2962ff
hmMid = #26c6da
hmWrm = #ffea00
hmHot = #ff1744
cHi   = #26c6da
cLo   = #5c6f7a
cMute = #9aa7b2

momGrad(float v) =>
    v >= ob * 0.5 ? color.from_gradient(v, ob * 0.5, ob, hmWrm, hmHot) :
     v >= 0       ? color.from_gradient(v, 0, ob * 0.5, hmMid, hmWrm) :
     color.from_gradient(v, os, 0, hmLow, hmMid)

// shared WaveTrend core
esa = ta.ema(src, n1)
de  = ta.ema(math.abs(src - esa), n1)
ci  = de != 0 ? (src - esa) / (0.015 * de) : 0
wt1 = ta.ema(ci, n2)
wt2 = ta.sma(wt1, sigLen)
bullCross = ta.crossover(wt1, wt2)  and wt1 < os
bearCross = ta.crossunder(wt1, wt2) and wt1 > ob

// volume model (VolMom)
volMA   = ta.sma(volume, maLen)
relVol  = volMA > 0 ? volume / volMA : 1.0
pattern = relVol >= spikeMult ? "Volume Spike" : relVol >= highMult ? "High Volume" : relVol <= lowMult ? "Low Volume" : "Normal"
patCol  = relVol >= highMult ? cHi : relVol <= lowMult ? cLo : cMute
volBase = relVol <= 1.0       ? color.from_gradient(relVol, lowMult, 1.0, hmLow, #26a69a) :
          relVol <= spikeMult ? color.from_gradient(relVol, 1.0, spikeMult, hmMid, hmWrm) :
          color.from_gradient(relVol, spikeMult, spikeMult * 2.0, hmWrm, hmHot)
volScaled = math.min(relVol, 5.0) * (ob / 2.0)
volConfirm = relVol >= highMult

// VolMom layer
plot(isVM and showVol ? volScaled : na, "Volume", color = color.new(volBase, 72), style = plot.style_columns)
momCol = momGrad(wt1)
plot(isVM and showMom ? wt1 : na, "Momentum area", color = color.new(momCol, 60), style = plot.style_area)
plot(isVM and showMom ? wt1 : na, "Momentum",      color = momCol, linewidth = 2)
plot(isVM and showMom ? wt2 : na, "Signal",        color = color.new(color.white, 25), linewidth = 1)
vr1 = ta.ema(wt1, 3)
vr2 = ta.ema(wt1, 6)
vr3 = ta.ema(wt1, 9)
plot(isVM and showRibbon ? vr1 : na, "VRibbon 1", color = color.new(momGrad(vr1), 50))
plot(isVM and showRibbon ? vr2 : na, "VRibbon 2", color = color.new(momGrad(vr2), 65))
plot(isVM and showRibbon ? vr3 : na, "VRibbon 3", color = color.new(momGrad(vr3), 80))
if isVM and showLabels and bullCross
    label.new(bar_index, wt1, "Bullish", style = label.style_label_up, color = color.new(#26a69a, 0), textcolor = color.white, size = size.tiny)
if isVM and showLabels and bearCross
    label.new(bar_index, wt1, "Bearish OB", style = label.style_label_down, color = color.new(#ef5350, 0), textcolor = color.white, size = size.tiny)

// Jetstream layer
rng = high - low
mf  = ta.sma(rng != 0 ? ((close - open) / rng) * mfMult : 0, mfLen)
plot(isJet and showMF ? mf : na, "Money Flow", color = mf >= 0 ? color.new(#26a69a, 55) : color.new(#ef5350, 55), style = plot.style_area)
j0 = ta.ema(wt1, 3)
j1 = ta.ema(wt1, 7)
j2 = ta.ema(wt1, 11)
j3 = ta.ema(wt1, 15)
j4 = ta.ema(wt1, 19)
j5 = ta.ema(wt1, 23)
plot(isJet and layers >= 1 ? j0 : na, "L1", color = color.new(#8a2be2, 10))
plot(isJet and layers >= 2 ? j1 : na, "L2", color = color.new(#3d7bff, 10))
plot(isJet and layers >= 3 ? j2 : na, "L3", color = color.new(#00d4c8, 10))
plot(isJet and layers >= 4 ? j3 : na, "L4", color = color.new(#46d000, 10))
plot(isJet and layers >= 5 ? j4 : na, "L5", color = color.new(#ffd000, 10))
plot(isJet and layers >= 6 ? j5 : na, "L6", color = color.new(#ff3b30, 10))
p1 = plot(isJet ? wt1 : na, "WT1", color = color.new(color.white, 10), linewidth = 2)
p2 = plot(isJet ? wt2 : na, "WT2", color = color.new(#7890ff, 5), linewidth = 1)
fill(p1, p2, color = wt1 > wt2 ? color.new(#26a69a, 82) : color.new(#ef5350, 82), title = "Wave band")
plotshape(isJet and bullCross, "Wave buy",  style = shape.circle, location = location.bottom, color = teal, size = size.tiny)
plotshape(isJet and bearCross, "Wave sell", style = shape.circle, location = location.top,    color = red,  size = size.tiny)

// shared levels
hline(ob, "Overbought", color = color.new(#ef5350, 55), linestyle = hline.style_dashed)
hline(0,  "Zero",       color = color.new(color.gray, 70))
hline(os, "Oversold",   color = color.new(#26a69a, 55), linestyle = hline.style_dashed)

// dashboard (VolMom)
momState = wt1 >= ob ? "OVERBOUGHT" : wt1 <= os ? "OVERSOLD" : wt1 >= 0 ? "Bull zone" : "Bear zone"
momStCol = wt1 >= ob ? red : wt1 <= os ? teal : color.new(cMute, 0)
combo  = bullCross ? (volConfirm ? "STRONG BUY" : "Bullish") : bearCross ? (volConfirm ? "STRONG SELL" : "Bearish") : wt1 >= ob ? "Overbought" : wt1 <= os ? "Oversold" : (wt1 >= 0 ? "Bull bias" : "Bear bias")
comboCol = str.contains(combo, "BUY") or combo == "Bullish" or combo == "Oversold" ? teal : str.contains(combo, "SELL") or combo == "Bearish" or combo == "Overbought" ? red : color.new(#fdd835, 0)
f_pos() =>
    tablePos == "Top Right" ? position.top_right : tablePos == "Top Left" ? position.top_left : tablePos == "Bottom Left" ? position.bottom_left : position.bottom_right
var table dash = table.new(f_pos(), 2, 5, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 40))
f_row(int r, string lab, string val, color valCol) =>
    table.cell(dash, 0, r, lab, text_color = color.new(cMute, 0), text_size = size.tiny, text_halign = text.align_left,  bgcolor = color.new(#0c1116, 0))
    table.cell(dash, 1, r, val, text_color = valCol,              text_size = size.tiny, text_halign = text.align_right, bgcolor = color.new(#0c1116, 0))
if isVM and showTable and barstate.islast
    table.cell(dash, 0, 0, "SIGNAL", text_color = color.white, text_size = size.tiny, text_halign = text.align_left,  bgcolor = color.new(#1b2630, 0))
    table.cell(dash, 1, 0, combo,    text_color = comboCol,     text_size = size.tiny, text_halign = text.align_right, bgcolor = color.new(#1b2630, 0))
    f_row(1, "Momentum", str.tostring(wt1, "#.#"), color.new(momCol, 0))
    f_row(2, "Mom State", momState, momStCol)
    f_row(3, "Rel Vol", str.tostring(relVol, "#.##") + "×", color.new(patCol, 0))
    f_row(4, "Volume", pattern, color.new(patCol, 0))

// ================================================================ orders
waveLong  = not reqWave or wt1 > wt2
waveShort = not reqWave or wt1 < wt2
longSig  = tBuy  and waveLong  and inWindow
shortSig = tSell and waveShort and inWindow

allowLong  = dirMode != "Short only"
allowShort = dirMode != "Long only"

if longSig
    if allowLong
        strategy.entry("Long", strategy.long)
    else
        strategy.close("Short")
if shortSig
    if allowShort
        strategy.entry("Short", strategy.short)
    else
        strategy.close("Long")

// optional ATR stop / target
if useStop and strategy.position_size > 0
    strategy.exit("Long exit", from_entry = "Long",
         stop = strategy.position_avg_price - slMult * atrv,
         limit = strategy.position_avg_price + tpMult * atrv)
if useStop and strategy.position_size < 0
    strategy.exit("Short exit", from_entry = "Short",
         stop = strategy.position_avg_price + slMult * atrv,
         limit = strategy.position_avg_price - tpMult * atrv)

// close everything once outside the backtest window
if useDates and not inWindow
    strategy.close_all()
