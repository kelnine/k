//@version=5
// =============================================================================
// DepthFlow — Order-Flow Liquidity & Volume Blocks
// -----------------------------------------------------------------------------
// A from-scratch, clean-room order-flow overlay for TradingView. Everything is
// derived from raw OHLCV — no external data, no paywall.
//
//   • Volume blocks  — a volume-by-price profile over a trailing window; the
//                      high-volume nodes are drawn as horizontal liquidity
//                      bands (red supply above price, green demand below),
//                      labelled with traded volume and the buy/sell split.
//   • Spot dominance — buy vs. sell volume (close-location method) over a short
//                      recent window, shown top-right as "B xx%  S yy%".
//   • Sweeps         — liquidity grabs: a wick pierces a recent swing high/low
//                      and the candle closes back inside (stop-hunt).
//   • Displacement   — impulsive candles whose body dwarfs recent ATR.
//
// Paste into TradingView's Pine Editor → "Add to chart". Works on any symbol
// that has volume (NQ/ES futures, crypto, etc.).
// =============================================================================
indicator("DepthFlow — Order Flow Liquidity", overlay = true, max_boxes_count = 500, max_labels_count = 500)

// ----------------------------------------------------------------- inputs
grpVP     = "Volume Blocks"
lookback  = input.int(300, "Profile lookback (bars)", minval = 20, group = grpVP)
bins      = input.int(120, "Resolution (bins)", minval = 10, maxval = 500, group = grpVP)
maxBlocks = input.int(8, "Max liquidity blocks", minval = 1, maxval = 30, group = grpVP)
nodeRatio = input.float(0.55, "Node threshold (× peak bin)", minval = 0.1, maxval = 1.0, step = 0.05, group = grpVP)
showSplit = input.bool(true, "Show B/S split on blocks", group = grpVP)

grpDom    = "Dominance"
showDom   = input.bool(true, "Show dominance read-out", group = grpDom)
domWindow = input.int(60, "Dominance window (bars)", minval = 5, group = grpDom)

grpSig    = "Signals"
showSweeps = input.bool(true, "Sweeps (liquidity grabs)", group = grpSig)
swingLen   = input.int(5, "Swing strength", minval = 1, group = grpSig)
showDisp   = input.bool(true, "Displacement", group = grpSig)
atrLen     = input.int(14, "ATR length", minval = 1, group = grpSig)
dispMult   = input.float(1.6, "Displacement (× ATR body)", minval = 0.5, step = 0.1, group = grpSig)
confirmBars = input.int(3, "Setup: sweep→displacement window (bars)", minval = 1, group = grpSig)
showSetups  = input.bool(true, "Mark LONG/SHORT setups", group = grpSig)

// ----------------------------------------------------------------- palette
cSupply = color.rgb(239, 83, 80)   // red  — resting supply above price
cDemand = color.rgb(38, 166, 154)  // green — resting demand below price

// ----------------------------------------------------------------- helpers
f_fmtVol(float v) =>
    v >= 1000000 ? str.tostring(v / 1000000, "#.##") + "M" : v >= 1000 ? str.tostring(v / 1000, "#.###") + "K" : str.tostring(v, "#")

// close-location buy fraction of a candle's volume
f_buyFrac(float h, float l, float c, float o) =>
    float rng = h - l
    rng > 0 ? (c - l) / rng : (c > o ? 1.0 : c < o ? 0.0 : 0.5)

// =============================================================================
// 1) VOLUME-BY-PRICE LIQUIDITY BLOCKS  (rebuilt on the last bar)
// =============================================================================
var box[]   vpBoxes  = array.new<box>()
var label[] vpLabels = array.new<label>()
// current block levels, kept for setup/alert proximity checks
var float[] gBlkTop    = array.new_float()
var float[] gBlkBot    = array.new_float()
var bool[]  gBlkDemand = array.new<bool>()

if barstate.islast
    // clear the previous render
    for b in vpBoxes
        box.delete(b)
    array.clear(vpBoxes)
    for lb in vpLabels
        label.delete(lb)
    array.clear(vpLabels)
    array.clear(gBlkTop)
    array.clear(gBlkBot)
    array.clear(gBlkDemand)

    int n = math.min(lookback, bar_index + 1)

    // window price range
    float pHi = high
    float pLo = low
    for i = 0 to n - 1
        pHi := math.max(pHi, high[i])
        pLo := math.min(pLo, low[i])
    float span = pHi - pLo

    if span > 0
        float binSize = span / bins
        float[] volBin  = array.new_float(bins, 0.0)
        float[] buyBin  = array.new_float(bins, 0.0)
        float[] sellBin = array.new_float(bins, 0.0)

        // bin the window's volume, split into buy / sell per candle
        for i = 0 to n - 1
            float bf    = f_buyFrac(high[i], low[i], close[i], open[i])
            float vBuy  = volume[i] * bf
            float vSell = volume[i] * (1 - bf)
            int b0 = int(math.max(0, math.floor((low[i] - pLo) / binSize)))
            int b1 = int(math.min(bins - 1, math.floor((high[i] - pLo) / binSize)))
            int k  = b1 - b0 + 1
            for b = b0 to b1
                array.set(volBin,  b, array.get(volBin,  b) + volume[i] / k)
                array.set(buyBin,  b, array.get(buyBin,  b) + vBuy / k)
                array.set(sellBin, b, array.get(sellBin, b) + vSell / k)

        float peak = array.max(volBin)
        float thr  = peak * nodeRatio

        // merge contiguous high-volume bins into blocks
        float[] bTop  = array.new_float()
        float[] bBot  = array.new_float()
        float[] bVol  = array.new_float()
        float[] bBuy  = array.new_float()
        float[] bSell = array.new_float()
        bool  inRun = false
        float rTop = 0.0
        float rBot = 0.0
        float rVol = 0.0
        float rBuy = 0.0
        float rSell = 0.0
        for b = 0 to bins - 1
            float vb = array.get(volBin, b)
            if vb >= thr
                float top = pLo + (b + 1) * binSize
                float bot = pLo + b * binSize
                if not inRun
                    inRun := true
                    rTop := top
                    rBot := bot
                    rVol := vb
                    rBuy := array.get(buyBin, b)
                    rSell := array.get(sellBin, b)
                else
                    rTop := top
                    rVol += vb
                    rBuy += array.get(buyBin, b)
                    rSell += array.get(sellBin, b)
            else if inRun
                array.push(bTop, rTop)
                array.push(bBot, rBot)
                array.push(bVol, rVol)
                array.push(bBuy, rBuy)
                array.push(bSell, rSell)
                inRun := false
        if inRun
            array.push(bTop, rTop)
            array.push(bBot, rBot)
            array.push(bVol, rVol)
            array.push(bBuy, rBuy)
            array.push(bSell, rSell)

        // draw the heaviest blocks (left edge = window start, extend right)
        int leftBar = bar_index - (n - 1)
        int drawn = 0
        while drawn < maxBlocks and array.size(bVol) > 0
            int mi = array.indexof(bVol, array.max(bVol))
            float top = array.get(bTop, mi)
            float bot = array.get(bBot, mi)
            float vol = array.get(bVol, mi)
            float bvy = array.get(bBuy, mi)
            float svy = array.get(bSell, mi)
            float center = (top + bot) / 2
            bool  above  = center >= close
            color col    = above ? cSupply : cDemand
            int   dom    = bvy + svy > 0 ? int(math.round(bvy / (bvy + svy) * 100)) : 50

            box bx = box.new(leftBar, top, bar_index, bot, border_color = color.new(col, 45), border_width = 1, bgcolor = color.new(col, 84), extend = extend.right)
            array.push(vpBoxes, bx)

            string txt = f_fmtVol(vol) + (showSplit ? "   B" + str.tostring(dom) + "/S" + str.tostring(100 - dom) : "")
            label lbX = label.new(bar_index, center, txt, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(color.black, 100), textcolor = col, size = size.small)
            array.push(vpLabels, lbX)

            array.push(gBlkTop, top)
            array.push(gBlkBot, bot)
            array.push(gBlkDemand, not above)

            array.remove(bTop, mi)
            array.remove(bBot, mi)
            array.remove(bVol, mi)
            array.remove(bBuy, mi)
            array.remove(bSell, mi)
            drawn += 1

// =============================================================================
// 2) SPOT BUY / SELL DOMINANCE  (top-right read-out)
// =============================================================================
var table domTable = table.new(position.top_right, 1, 1, border_width = 1)
if showDom and barstate.islast
    float db = 0.0
    float ds = 0.0
    int   m  = math.min(domWindow, bar_index + 1)
    for i = 0 to m - 1
        float bf = f_buyFrac(high[i], low[i], close[i], open[i])
        db += volume[i] * bf
        ds += volume[i] * (1 - bf)
    float tot = db + ds
    int   bp  = tot > 0 ? int(math.round(db / tot * 100)) : 50
    color dc  = bp >= 50 ? cDemand : cSupply
    table.cell(domTable, 0, 0, "B " + str.tostring(bp) + "%   S " + str.tostring(100 - bp) + "%", text_color = dc, text_size = size.normal, bgcolor = color.new(color.black, 70))

// =============================================================================
// 3) SWEEPS  (liquidity grabs)
// =============================================================================
float ph = ta.pivothigh(swingLen, swingLen)
float pl = ta.pivotlow(swingLen, swingLen)
var float lastPH = na
var float lastPL = na
if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl

// buy-side sweep: poke above a swing high, close back below it
sweepHigh = showSweeps and not na(lastPH) and high > lastPH and close < lastPH
// sell-side sweep: dip under a swing low, close back above it
sweepLow  = showSweeps and not na(lastPL) and low < lastPL and close > lastPL
// consume the level once swept, so already-grabbed liquidity can't re-trigger
if sweepHigh
    lastPH := na
if sweepLow
    lastPL := na
plotshape(sweepHigh, "Sweep High", shape.triangledown, location.abovebar, color = cSupply, text = "sweep", textcolor = cSupply, size = size.tiny)
plotshape(sweepLow,  "Sweep Low",  shape.triangleup,   location.belowbar, color = cDemand, text = "sweep", textcolor = cDemand, size = size.tiny)

// =============================================================================
// 4) DISPLACEMENT  (impulsive bodies vs. ATR)
// =============================================================================
float atrv = ta.atr(atrLen)
float body = math.abs(close - open)
dispUp = showDisp and body > atrv * dispMult and close >= open
dispDn = showDisp and body > atrv * dispMult and close < open
plotshape(dispUp, "Displacement Up", shape.diamond, location.belowbar, color = cDemand, text = "DISP", textcolor = cDemand, size = size.tiny)
plotshape(dispDn, "Displacement Dn", shape.diamond, location.abovebar, color = cSupply, text = "DISP", textcolor = cSupply, size = size.tiny)

// =============================================================================
// 5) SETUPS + ALERTS  (sweep → displacement, at a liquidity block)
// =============================================================================
f_nearDemand(float p) =>
    bool hit = false
    if array.size(gBlkBot) > 0
        for i = 0 to array.size(gBlkBot) - 1
            if array.get(gBlkDemand, i) and p >= array.get(gBlkBot, i) and p <= array.get(gBlkTop, i)
                hit := true
    hit

f_nearSupply(float p) =>
    bool hit = false
    if array.size(gBlkBot) > 0
        for i = 0 to array.size(gBlkBot) - 1
            if not array.get(gBlkDemand, i) and p >= array.get(gBlkBot, i) and p <= array.get(gBlkTop, i)
                hit := true
    hit

// a sweep arms a pending setup; a same-direction displacement within
// `confirmBars` (while price is at the matching block) confirms it
var bool pendLong  = false
var int  pendLongBar = na
var bool pendShort = false
var int  pendShortBar = na
if sweepLow
    pendLong := true
    pendLongBar := bar_index
if sweepHigh
    pendShort := true
    pendShortBar := bar_index
if not na(pendLongBar) and bar_index - pendLongBar > confirmBars
    pendLong := false
if not na(pendShortBar) and bar_index - pendShortBar > confirmBars
    pendShort := false

bullSetup = pendLong and dispUp and f_nearDemand(low)
bearSetup = pendShort and dispDn and f_nearSupply(high)
if bullSetup
    pendLong := false
if bearSetup
    pendShort := false

plotshape(showSetups and bullSetup, "LONG setup", shape.labelup, location.belowbar, color = cDemand, text = "LONG", textcolor = color.white, size = size.small)
plotshape(showSetups and bearSetup, "SHORT setup", shape.labeldown, location.abovebar, color = cSupply, text = "SHORT", textcolor = color.white, size = size.small)

alertcondition(sweepLow,  "Sweep (sell-side)", "DepthFlow: sell-side sweep — possible long")
alertcondition(sweepHigh, "Sweep (buy-side)",  "DepthFlow: buy-side sweep — possible short")
alertcondition(dispUp,    "Displacement up",   "DepthFlow: bullish displacement")
alertcondition(dispDn,    "Displacement down", "DepthFlow: bearish displacement")
alertcondition(bullSetup, "LONG setup",  "DepthFlow LONG: sweep + displacement at demand block")
alertcondition(bearSetup, "SHORT setup", "DepthFlow SHORT: sweep + displacement at supply block")
