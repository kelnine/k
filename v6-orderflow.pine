//@version=6
// =============================================================================
// V6 OrderFlow — DeepDom-inspired tools from price/volume only.
//
//   TradingView's Pine has NO access to order-book / MBO data, so the real
//   DeepDom "Iceberg Detector" and live liquidity heatmap are impossible here.
//   These are the closest PRICE-ACTION PROXIES, styled to look clean:
//     - Volume Profile heatmap (gradient) + POC + value area (VAH/VAL)
//     - Absorption  = high-volume + small-range bars -> order-block zones
//     - Stop runs   = liquidity sweeps (wick beyond a swing, close back inside)
// =============================================================================
indicator("V6 OrderFlow", shorttitle="V6 OF", overlay=true, max_boxes_count=500, max_lines_count=200, max_labels_count=200)

// ---- palette ----------------------------------------------------------------
cyan    = #18e3e3
magenta = #ec3ad6
orange  = #ff9a3c
gold    = #ffd24a
dim     = #0d3b46

// ---- inputs -----------------------------------------------------------------
showStop = input.bool(true, "Show stop runs", group="Stop runs")
swLen    = input.int(10,  "Swing lookback", minval=2, group="Stop runs")
swMinAtr = input.float(0.15,"Min sweep × ATR", minval=0, step=0.05, group="Stop runs")
cdBars   = input.int(6,   "Cooldown bars", minval=0, group="Stop runs")

showAbs  = input.bool(true,"Show absorption blocks", group="Absorption / order blocks")
absMult  = input.float(1.8,"Volume × avg", minval=1, step=0.1, group="Absorption / order blocks")
absRange = input.float(0.6,"Max body vs range", minval=0.1, maxval=1, step=0.05, group="Absorption / order blocks")
volLen   = input.int(20,  "Volume avg length", minval=1, group="Absorption / order blocks")
keepAbs  = input.int(5,   "Max blocks kept", minval=1, group="Absorption / order blocks")
absExt   = input.int(8,   "Block extend (bars)", minval=0, group="Absorption / order blocks")

showVP   = input.bool(true,"Show volume profile", group="Volume profile")
vpLook   = input.int(150, "Lookback bars", minval=20, group="Volume profile")
vpRows   = input.int(30,  "Rows (resolution)", minval=8, maxval=60, group="Volume profile")
vpWidth  = input.int(34,  "Width (bars)", minval=5, group="Volume profile")
showVA   = input.bool(true,"Show value area (70%)", group="Volume profile")

// ---- stop runs (liquidity sweeps) -------------------------------------------
atr14     = ta.atr(14)
priorHigh = ta.highest(high, swLen)[1]
priorLow  = ta.lowest(low,  swLen)[1]
sweepHigh = high > priorHigh + atr14 * swMinAtr and close < priorHigh
sweepLow  = low  < priorLow  - atr14 * swMinAtr and close > priorLow

var int lastHi = -1000
var int lastLo = -1000
fireHi = showStop and sweepHigh and (bar_index - lastHi > cdBars)
fireLo = showStop and sweepLow  and (bar_index - lastLo > cdBars)
if fireHi
    lastHi := bar_index
if fireLo
    lastLo := bar_index
plotshape(fireHi, "Stop run high", shape.triangledown, location.abovebar, color=magenta, size=size.tiny)
plotshape(fireLo, "Stop run low",  shape.triangleup,   location.belowbar, color=cyan,    size=size.tiny)

// ---- absorption / order blocks ----------------------------------------------
avgVol   = ta.sma(volume, volLen)
rng      = high - low
body     = math.abs(close - open)
absorbed = volume > avgVol * absMult and rng > 0 and (body / rng) < absRange

var box[] blocks = array.new<box>()
if showAbs and absorbed
    bull = close >= open
    fill = bull ? color.new(cyan, 84) : color.new(magenta, 84)
    bord = bull ? color.new(cyan, 35) : color.new(magenta, 35)
    b = box.new(bar_index - 1, high, bar_index + absExt, low, border_color=bord, border_width=1, bgcolor=fill)
    array.push(blocks, b)
    if array.size(blocks) > keepAbs
        box.delete(array.shift(blocks))

// ---- volume profile (gradient heatmap) --------------------------------------
// All drawings tracked + cleared each redraw (no leak past the drawing cap).
var box[] vpBoxes = array.new<box>()
var line  pocLn = na
var line  vahLn = na
var line  valLn = na
var label pocLb = na

if showVP and barstate.islast
    if array.size(vpBoxes) > 0
        for i = 0 to array.size(vpBoxes) - 1
            box.delete(array.get(vpBoxes, i))
        array.clear(vpBoxes)
    line.delete(pocLn)
    line.delete(vahLn)
    line.delete(valLn)
    label.delete(pocLb)

    float hi = ta.highest(high, vpLook)
    float lo = ta.lowest(low,  vpLook)
    float step = (hi - lo) / vpRows
    if step > 0
        float[] buckets = array.new<float>(vpRows, 0.0)
        for i = 0 to vpLook - 1
            int rLo = math.min(vpRows - 1, math.max(0, int((low[i]  - lo) / step)))
            int rHi = math.min(vpRows - 1, math.max(0, int((high[i] - lo) / step)))
            float share = volume[i] / (rHi - rLo + 1)
            for r = rLo to rHi
                array.set(buckets, r, array.get(buckets, r) + share)

        float maxV  = array.max(buckets)
        float total = array.sum(buckets)
        int   poc   = array.indexof(buckets, maxV)

        // value area = expand from POC until 70% of volume captured
        int upi = poc
        int dni = poc
        float acc = array.get(buckets, poc)
        float target = total * 0.70
        while acc < target and (upi < vpRows - 1 or dni > 0)
            float upV = upi < vpRows - 1 ? array.get(buckets, upi + 1) : -1.0
            float dnV = dni > 0          ? array.get(buckets, dni - 1) : -1.0
            if upV >= dnV
                upi += 1
                acc += upV
            else
                dni -= 1
                acc += dnV

        int rightEdge = bar_index + 2
        for r = 0 to vpRows - 1
            float v = array.get(buckets, r)
            int w = maxV > 0 ? math.max(1, int(v / maxV * vpWidth)) : 1
            float yB = lo + r * step
            float yT = lo + (r + 1) * step
            inVA = r >= dni and r <= upi
            // gradient: low volume -> dim teal, high -> glowing cyan; POC -> gold
            base = color.from_gradient(v, 0, maxV, color.new(dim, 62), color.new(cyan, 12))
            col  = r == poc ? color.new(gold, 8) : (inVA ? base : color.from_gradient(v, 0, maxV, color.new(dim, 80), color.new(cyan, 55)))
            array.push(vpBoxes, box.new(rightEdge - w, yT, rightEdge, yB, border_width=0, bgcolor=col))

        float pocY = lo + (poc + 0.5) * step
        pocLn := line.new(bar_index - vpLook, pocY, rightEdge, pocY, color=gold, style=line.style_solid, width=1)
        pocLb := label.new(rightEdge, pocY, " POC", style=label.style_label_left, color=color.new(gold, 82), textcolor=gold, size=size.small)
        if showVA
            vahY = lo + (upi + 1) * step
            valY = lo + dni * step
            vahLn := line.new(bar_index - vpLook, vahY, rightEdge, vahY, color=color.new(cyan, 45), style=line.style_dotted, width=1)
            valLn := line.new(bar_index - vpLook, valY, rightEdge, valY, color=color.new(cyan, 45), style=line.style_dotted, width=1)

// ---- alerts -----------------------------------------------------------------
alertcondition(fireHi,   "Stop run high", "Stop run (buy-side sweep) on {{ticker}} {{interval}}")
alertcondition(fireLo,   "Stop run low",  "Stop run (sell-side sweep) on {{ticker}} {{interval}}")
alertcondition(absorbed, "Absorption",    "Absorption / order block on {{ticker}} {{interval}}")
