//@version=6
// Momentum Oscillator — a WaveTrend-style momentum engine rendered as a
// rainbow "mountain": a gradient area that runs blue -> cyan -> yellow -> red
// as momentum climbs into overbought, with a signal line, overbought/oversold
// zones, Bullish / Bearish OB labels and a compact dashboard.
indicator("Momentum Oscillator", shorttitle="MomHeat", overlay=false, max_labels_count=200)

// ------------------------------------------------------------- inputs
src       = input.source(hlc3, "Source", group="Momentum")
chanLen   = input.int(10, "Channel Length", minval=1, group="Momentum")
avgLen    = input.int(21, "Average Length", minval=1, group="Momentum")
sigLen    = input.int(4,  "Signal Smoothing", minval=1, group="Momentum")
obLevel   = input.float(60,  "Overbought", step=1, group="Levels")
osLevel   = input.float(-60, "Oversold", step=1, group="Levels")
showRibbon= input.bool(true, "Show momentum ribbon", group="Appearance")
showArea  = input.bool(true, "Show gradient mountain", group="Appearance")
showLabels= input.bool(true, "Show Bull/Bear labels", group="Signals")
showTable = input.bool(true, "Show dashboard", group="Dashboard")
tablePos  = input.string("Top Right", "Position", options=["Top Right","Top Left","Bottom Right","Bottom Left"], group="Dashboard")
tblSizeIn = input.string("Tiny", "Text size", options=["Tiny","Small","Normal"], group="Dashboard")

// ------------------------------------------------------------- palette
cUp   = #26a69a
cDown = #ef5350
cMute = #9aa7b2
cWarn = #fdd835
hmLow = #2962ff   // deep oversold
hmMid = #26c6da   // neutral
hmWrm = #ffea00   // building
hmHot = #ff1744   // overbought

// ------------------------------------------------------------- helpers
f_pos() =>
    tablePos == "Top Right"   ? position.top_right   :
     tablePos == "Top Left"    ? position.top_left    :
     tablePos == "Bottom Left" ? position.bottom_left :
     position.bottom_right

// ------------------------------------------------------------- WaveTrend momentum
esa = ta.ema(src, chanLen)
de  = ta.ema(math.abs(src - esa), chanLen)
ci  = de != 0 ? (src - esa) / (0.015 * de) : 0.0
mom = ta.ema(ci, avgLen)          // primary momentum line
sig = ta.sma(mom, sigLen)         // signal line

// gradient: blue (oversold) -> cyan (0) -> yellow (mid) -> red (overbought)
grad = mom >= obLevel * 0.5 ? color.from_gradient(mom, obLevel * 0.5, obLevel, hmWrm, hmHot) :
       mom >= 0             ? color.from_gradient(mom, 0, obLevel * 0.5, hmMid, hmWrm) :
       color.from_gradient(mom, osLevel, 0, hmLow, hmMid)

// ------------------------------------------------------------- plots
// zero / level guides
hline(0, "Zero", color=color.new(color.gray, 60), linestyle=hline.style_dotted)
obL = hline(obLevel, "Overbought", color=color.new(cDown, 55), linestyle=hline.style_dashed)
osL = hline(osLevel, "Oversold",   color=color.new(cUp, 55),   linestyle=hline.style_dashed)
fill(obL, osL, color=color.new(color.gray, 94))

// gradient mountain (area to zero) + main line
plot(showArea ? mom : na, "Momentum Area", color=color.new(grad, 55), style=plot.style_area)
plot(mom, "Momentum", color=grad, linewidth=2)
plot(sig, "Signal", color=color.new(color.white, 25), linewidth=1)

// layered ribbon — smoothed copies coloured by their own level for the heatmap feel
r1 = ta.ema(mom, 3)
r2 = ta.ema(mom, 6)
r3 = ta.ema(mom, 9)
gc(float v) =>
    v >= obLevel * 0.5 ? color.from_gradient(v, obLevel * 0.5, obLevel, hmWrm, hmHot) :
     v >= 0            ? color.from_gradient(v, 0, obLevel * 0.5, hmMid, hmWrm) :
     color.from_gradient(v, osLevel, 0, hmLow, hmMid)
plot(showRibbon ? r1 : na, "Ribbon 1", color=color.new(gc(r1), 45), linewidth=1)
plot(showRibbon ? r2 : na, "Ribbon 2", color=color.new(gc(r2), 60), linewidth=1)
plot(showRibbon ? r3 : na, "Ribbon 3", color=color.new(gc(r3), 75), linewidth=1)

// ------------------------------------------------------------- signals
bullCross = ta.crossover(mom, sig) and mom < osLevel
bearCross = ta.crossunder(mom, sig) and mom > obLevel

if showLabels and bullCross
    label.new(bar_index, mom, "Bullish", style=label.style_label_up, color=color.new(cUp, 0), textcolor=color.white, size=size.tiny)
if showLabels and bearCross
    label.new(bar_index, mom, "Bearish OB", style=label.style_label_down, color=color.new(cDown, 0), textcolor=color.white, size=size.tiny)

// ------------------------------------------------------------- dashboard
state = mom >= obLevel ? "OVERBOUGHT" : mom <= osLevel ? "OVERSOLD" : mom >= 0 ? "Bull zone" : "Bear zone"
stateCol = mom >= obLevel ? cDown : mom <= osLevel ? cUp : mom >= 0 ? cMute : cMute
trendTxt = mom > mom[1] ? "Rising" : mom < mom[1] ? "Falling" : "Flat"
trendCol = mom > mom[1] ? cUp : mom < mom[1] ? cDown : cMute

var string sigTxt = "—"
var color sigCol = cMute
if bullCross
    sigTxt := "BULLISH"
    sigCol := cUp
else if bearCross
    sigTxt := "BEARISH"
    sigCol := cDown
else if mom >= obLevel
    sigTxt := "OVERBOUGHT"
    sigCol := cDown
else if mom <= osLevel
    sigTxt := "OVERSOLD"
    sigCol := cUp
else
    sigTxt := mom >= 0 ? "Bull bias" : "Bear bias"
    sigCol := cWarn

tSize = tblSizeIn == "Normal" ? size.normal : tblSizeIn == "Small" ? size.small : size.tiny
var table dash = table.new(f_pos(), 2, 5, border_width=1, frame_width=1, frame_color=color.new(color.gray, 40))

f_row(int r, string label, string val, color valCol) =>
    table.cell(dash, 0, r, label, text_color=color.new(#9aa7b2, 0), text_size=tSize, text_halign=text.align_left,  bgcolor=color.new(#0c1116, 0))
    table.cell(dash, 1, r, val,   text_color=valCol,                text_size=tSize, text_halign=text.align_right, bgcolor=color.new(#0c1116, 0))

if showTable and barstate.islast
    table.cell(dash, 0, 0, "MOM", text_color=color.white, text_size=tSize, text_halign=text.align_left,  bgcolor=color.new(#1b2630, 0))
    table.cell(dash, 1, 0, sigTxt, text_color=color.new(sigCol, 0), text_size=tSize, text_halign=text.align_right, bgcolor=color.new(#1b2630, 0))
    f_row(1, "Momentum", str.tostring(mom, "#.#"), color.new(grad, 0))
    f_row(2, "Signal Ln", str.tostring(sig, "#.#"), color.new(color.white, 0))
    f_row(3, "State", state, color.new(stateCol, 0))
    f_row(4, "Trend", trendTxt, color.new(trendCol, 0))

// ------------------------------------------------------------- alerts
alertcondition(bullCross, "Bullish cross", "Momentum bullish cross in oversold zone")
alertcondition(bearCross, "Bearish cross", "Momentum bearish cross in overbought zone")
alertcondition(ta.crossover(mom, obLevel), "Entered overbought", "Momentum entered the overbought zone")
alertcondition(ta.crossunder(mom, osLevel), "Entered oversold", "Momentum entered the oversold zone")
