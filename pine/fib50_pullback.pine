//@version=6
// Fib 50% Pullback Setup
// Finds an impulse swing (pivot high -> pivot low for shorts, pivot low -> pivot high
// for longs), anchors a Fibonacci from the swing origin (1) to the swing end (0), then
// waits for price to retrace into the 0.5 level. Entry at 0.5, stop at 0.6 (or any
// level you pick), target past the 0 level (default -0.27 extension).
// Draws the fib, the 1 -> 0 swing line, and a risk/reward position box per trade.
indicator("Fib 50% Pullback Setup", shorttitle = "Fib50", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ───────────────────────────── Inputs ─────────────────────────────
grpS      = "Swing detection"
leftLen   = input.int(10, "Pivot left bars", minval = 1, group = grpS)
rightLen  = input.int(3, "Pivot right bars (confirmation lag)", minval = 1, group = grpS)
atrLen    = input.int(14, "ATR length", minval = 1, group = grpS)
minLegAtr = input.float(2.0, "Min swing size (x ATR)", minval = 0.0, step = 0.25, group = grpS)

grpT     = "Trade rules (fib levels)"
dirMode  = input.string("Both", "Direction", options = ["Both", "Shorts only", "Longs only"], group = grpT)
entryLvl = input.float(0.5, "Entry level", minval = 0.0, maxval = 1.0, step = 0.05, group = grpT)
slLvl    = input.float(0.6, "Stop level", minval = 0.0, maxval = 2.0, step = 0.05, group = grpT, tooltip = "0.6 = tight stop, 0.8 = wider stop (both used in the reference charts).")
tpLvl    = input.float(-0.27, "Target level (negative = beyond 0)", maxval = 1.0, step = 0.05, group = grpT)
maxWait  = input.int(60, "Cancel setup after N bars without entry", minval = 1, group = grpT)

grpF   = "Higher-timeframe filter"
useHtf = input.bool(true, "Only trade with HTF trend", group = grpF)
htfTf  = input.timeframe("240", "HTF timeframe", group = grpF)
htfLen = input.int(50, "HTF EMA length", minval = 1, group = grpF)

grpV       = "Visuals"
lvlStr     = input.string("1, 0.8, 0.7, 0.6, 0.5, 0", "Fib levels to draw", group = grpV)
showFib    = input.bool(true, "Draw fib levels", group = grpV)
showDiag   = input.bool(true, "Draw swing line (1 → 0)", group = grpV)
keepOld    = input.bool(false, "Keep old fib drawings", group = grpV)
showTrade  = input.bool(true, "Draw position boxes", group = grpV)
showStats  = input.bool(true, "Show stats table", group = grpV)
extendBars = input.int(25, "Extend fib right (bars)", minval = 0, group = grpV)
fibCol     = input.color(color.gray, "Fib color", group = grpV)
riskCol    = input.color(color.new(color.gray, 65), "Risk box", group = grpV)
rewCol     = input.color(color.new(color.blue, 65), "Reward box", group = grpV)

if slLvl <= entryLvl or tpLvl >= entryLvl
    runtime.error("Stop level must be above the entry level and target level below it.")

// ───────────────────────────── Helpers ─────────────────────────────
// Price of a fib level for a swing anchored at p1 (level 1) and p0 (level 0).
fibPrice(float p1, float p0, float lvl) =>
    p0 + (p1 - p0) * lvl

var array<float> drawLvls = array.new<float>()
if barstate.isfirst
    for s in str.split(lvlStr, ",")
        v = str.tonumber(str.replace_all(s, " ", ""))
        if not na(v)
            drawLvls.push(v)
    for k in array.from(entryLvl, slLvl, tpLvl)
        if not drawLvls.includes(k)
            drawLvls.push(k)

var array<line>  fibLines  = array.new<line>()
var array<label> fibLabels = array.new<label>()

clearFib() =>
    while fibLines.size() > 0
        fibLines.pop().delete()
    while fibLabels.size() > 0
        fibLabels.pop().delete()

drawFib(float p1, int b1, float p0, int b0) =>
    if not keepOld
        clearFib()
    xR = b0 + extendBars
    if showDiag
        fibLines.push(line.new(b1, p1, b0, p0, color = fibCol, width = 1))
    if showFib
        for lvl in drawLvls
            y     = fibPrice(p1, p0, lvl)
            isKey = lvl == entryLvl or lvl == slLvl or lvl == tpLvl
            fibLines.push(line.new(b1, y, xR, y, color = fibCol, style = isKey ? line.style_solid : line.style_dotted, width = 1))
            fibLabels.push(label.new(xR, y, str.tostring(lvl) + "  (" + str.tostring(y, format.mintick) + ")", style = label.style_label_left, color = color(na), textcolor = fibCol, size = size.small))

// ───────────────────────────── Data ─────────────────────────────
atr = ta.atr(atrLen)
ph  = ta.pivothigh(high, leftLen, rightLen)
pl  = ta.pivotlow(low, leftLen, rightLen)
hiSincePivot = ta.highest(high, rightLen)
loSincePivot = ta.lowest(low, rightLen)

[htfClose, htfEma] = request.security(syminfo.tickerid, htfTf, [close[1], ta.ema(close, htfLen)[1]], lookahead = barmerge.lookahead_on)
allowShort = dirMode != "Longs only"  and (not useHtf or htfClose < htfEma)
allowLong  = dirMode != "Shorts only" and (not useHtf or htfClose > htfEma)

// ───────────────────────────── State ─────────────────────────────
var float lastPh    = na
var int   lastPhBar = na
var float lastPl    = na
var int   lastPlBar = na

var int   state    = 0      // 0 = idle, 1 = waiting for entry, 2 = in trade
var bool  isShort  = false
var int   setupBar = na
var float entryPx  = na
var float slPx     = na
var float tpPx     = na
var int   entryBar = na
var box   riskBox  = na
var box   rewBox   = na

var int   wins   = 0
var int   losses = 0
var float sumR   = 0.0

bool evSetup = false
bool evEntry = false
bool evWin   = false
bool evLoss  = false

// ───────────────────────── Manage active setup ─────────────────────────
if state == 1
    hitEntry = isShort ? high >= entryPx : low <= entryPx
    if hitEntry
        state    := 2
        entryBar := bar_index
        evEntry  := true
        if showTrade
            riskBox := box.new(bar_index, math.max(entryPx, slPx), bar_index + 1, math.min(entryPx, slPx), border_color = color(na), bgcolor = riskCol)
            rewBox  := box.new(bar_index, math.max(entryPx, tpPx), bar_index + 1, math.min(entryPx, tpPx), border_color = color(na), bgcolor = rewCol)
    else if bar_index - setupBar > maxWait
        state := 0

if state == 2
    hitSl = isShort ? high >= slPx : low <= slPx
    hitTp = isShort ? low <= tpPx : high >= tpPx
    rr    = math.abs(tpPx - entryPx) / math.abs(slPx - entryPx)
    // Conservative: if stop and target are both touched in one bar, count the stop.
    // A target on the entry bar itself is not counted (intrabar order unknown).
    if hitSl
        losses += 1
        sumR   -= 1.0
        evLoss := true
        state  := 0
        if showTrade
            label.new(bar_index, slPx, "SL  -1R", style = isShort ? label.style_label_down : label.style_label_up, color = color.new(color.red, 20), textcolor = color.white, size = size.small)
    else if hitTp and bar_index > entryBar
        wins   += 1
        sumR   += rr
        evWin  := true
        state  := 0
        if showTrade
            label.new(bar_index, tpPx, "TP  +" + str.tostring(rr, "#.##") + "R", style = isShort ? label.style_label_up : label.style_label_down, color = color.new(color.green, 20), textcolor = color.white, size = size.small)
    if showTrade and not na(riskBox)
        riskBox.set_right(bar_index + 1)
        rewBox.set_right(bar_index + 1)

// ───────────────────────── Detect new swings ─────────────────────────
bool  cand      = false
bool  candShort = false
float cP1       = na
int   cB1       = na
float cP0       = na
int   cB0       = na

if not na(ph)
    phBar = bar_index - rightLen
    // Bullish leg: pivot low (1) -> pivot high (0)
    if not na(lastPlBar) and lastPlBar < phBar and (na(lastPhBar) or lastPhBar < lastPlBar or ph > lastPh)
        cand      := true
        candShort := false
        cP1 := lastPl
        cB1 := lastPlBar
        cP0 := ph
        cB0 := phBar
    lastPh    := ph
    lastPhBar := phBar

if not na(pl)
    plBar = bar_index - rightLen
    // Bearish leg: pivot high (1) -> pivot low (0)
    if not na(lastPhBar) and lastPhBar < plBar and (na(lastPlBar) or lastPlBar < lastPhBar or pl < lastPl)
        cand      := true
        candShort := true
        cP1 := lastPh
        cB1 := lastPhBar
        cP0 := pl
        cB0 := plBar
    lastPl    := pl
    lastPlBar := plBar

if cand and state != 2
    e       = fibPrice(cP1, cP0, entryLvl)
    bigLeg  = math.abs(cP1 - cP0) >= minLegAtr * atr
    missed  = candShort ? hiSincePivot >= e : loSincePivot <= e
    allowed = candShort ? allowShort : allowLong
    if bigLeg and not missed and allowed
        state    := 1
        isShort  := candShort
        setupBar := bar_index
        entryPx  := e
        slPx     := fibPrice(cP1, cP0, slLvl)
        tpPx     := fibPrice(cP1, cP0, tpLvl)
        riskBox  := na
        rewBox   := na
        evSetup  := true
        drawFib(cP1, cB1, cP0, cB0)

// ───────────────────────────── Plots ─────────────────────────────
plot(state != 0 ? entryPx : na, "Entry",  color.blue,  1, plot.style_linebr)
plot(state != 0 ? slPx    : na, "Stop",   color.red,   1, plot.style_linebr)
plot(state != 0 ? tpPx    : na, "Target", color.green, 1, plot.style_linebr)

plotshape(evEntry and isShort,     "Short entry", shape.triangledown, location.abovebar, color.red,   size = size.small)
plotshape(evEntry and not isShort, "Long entry",  shape.triangleup,   location.belowbar, color.green, size = size.small)

// ───────────────────────────── Stats ─────────────────────────────
var table stats = table.new(position.top_right, 2, 5, bgcolor = color.new(color.black, 80), border_width = 1)
if showStats and barstate.islast
    total = wins + losses
    stats.cell(0, 0, "Trades",   text_color = color.white, text_size = size.small)
    stats.cell(1, 0, str.tostring(total), text_color = color.white, text_size = size.small)
    stats.cell(0, 1, "Wins",     text_color = color.white, text_size = size.small)
    stats.cell(1, 1, str.tostring(wins), text_color = color.green, text_size = size.small)
    stats.cell(0, 2, "Losses",   text_color = color.white, text_size = size.small)
    stats.cell(1, 2, str.tostring(losses), text_color = color.red, text_size = size.small)
    stats.cell(0, 3, "Win rate", text_color = color.white, text_size = size.small)
    stats.cell(1, 3, total > 0 ? str.tostring(100.0 * wins / total, "#.#") + "%" : "-", text_color = color.white, text_size = size.small)
    stats.cell(0, 4, "Net R",    text_color = color.white, text_size = size.small)
    stats.cell(1, 4, str.tostring(sumR, "#.##"), text_color = sumR >= 0 ? color.green : color.red, text_size = size.small)

// ───────────────────────────── Alerts ─────────────────────────────
alertcondition(evSetup, "Setup armed", "Fib50: new setup armed, waiting for 0.5 retrace")
alertcondition(evEntry, "Entry",       "Fib50: price hit the 0.5 entry")
alertcondition(evWin,   "Target hit",  "Fib50: target hit")
alertcondition(evLoss,  "Stop hit",    "Fib50: stop hit")

side = isShort ? "SHORT" : "LONG"
if evSetup
    alert("Fib50 " + side + " setup on " + syminfo.ticker + " | entry " + str.tostring(entryPx, format.mintick) + " SL " + str.tostring(slPx, format.mintick) + " TP " + str.tostring(tpPx, format.mintick), alert.freq_once_per_bar)
if evEntry
    alert("Fib50 " + side + " entry on " + syminfo.ticker + " @ " + str.tostring(entryPx, format.mintick), alert.freq_once_per_bar)
if evWin or evLoss
    alert("Fib50 " + side + (evWin ? " TARGET" : " STOP") + " on " + syminfo.ticker, alert.freq_once_per_bar)
