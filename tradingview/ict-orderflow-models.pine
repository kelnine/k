//@version=6
indicator("ICT Sweep + Order Flow Models [NY]", shorttitle = "ICT+OF Models", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// =============================================================================
// Four intraday models. All times are New York time (the script converts
// internally, so the chart timezone does not matter). Built for a 1-minute chart.
//
//   A · 8 PM range sweep (gold)
//       Most recent 15m swing high/low before 8 PM -> after 8 PM one side is
//       swept -> 1m market structure shift with displacement -> limit entry in
//       the displacement FVG -> target the opposite level.
//   B · 8 AM candle sweep
//       High/low of the 8 AM hourly candle -> after 9 AM one side is swept ->
//       close back inside + 1m MSS with displacement -> FVG entry -> target the
//       opposite side of the candle (or a fixed RR).
//   C · PD-array bias + IFVG / CISD
//       1H FVGs respected / disrespected set the bias -> 5m/15m FVG toward the
//       draw on liquidity -> after 9:30 price taps it -> 1m inversion FVG or
//       change in state of delivery -> target the draw on liquidity.
//   D · Order-flow absorption
//       At an HTF FVG or key level (overnight value area, overnight high/low,
//       previous day high/low): aggressive sellers with no follow-through ->
//       aggressive buyers close above them -> long for 1-2R (mirror for shorts).
// =============================================================================

string TZ       = "America/New_York"
string ALL_DAYS = ":1234567"

// ───────────────────────────── Inputs ─────────────────────────────
string G_GEN = "General"
string G_A   = "A · 8 PM range sweep (gold)"
string G_B   = "B · 8 AM candle sweep"
string G_C   = "C · PD-array bias + IFVG / CISD"
string G_D   = "D · Order-flow absorption"
string G_VIS = "Visuals"

string entryMode   = input.string("FVG edge", "FVG entry price", options = ["FVG edge", "FVG 50% (CE)"], group = G_GEN, tooltip = "Where the limit entry sits inside the fair value gap (models A and B).")
int    mssLen      = input.int(2, "1m swing strength (MSS)", minval = 1, maxval = 10, group = G_GEN, tooltip = "Bars on each side that define the 1m swing high/low a market structure shift must close through.")
float  dispMult    = input.float(1.5, "Displacement: body ≥ × avg body", minval = 0.5, step = 0.1, group = G_GEN, tooltip = "The middle candle of the FVG must have a body at least this many times the 20-bar average body.")
int    minFvgTicks = input.int(0, "Min FVG size (ticks)", minval = 0, group = G_GEN)
int    slBufTicks  = input.int(0, "Stop buffer (ticks)", minval = 0, group = G_GEN)

bool   useA   = input.bool(true, "Enable", group = G_A)
int    aSwing = input.int(2, "15m swing strength", minval = 1, maxval = 10, group = G_A, tooltip = "Bars on each side for the 15m swing high/low. The most recent swings not yet taken out when the window opens are marked.")
string aWin   = input.session("2000-0200", "Trade window (NY)", group = G_A)
string aTgt   = input.string("Opposite level", "Target", options = ["Opposite level", "Fixed RR"], group = G_A)
float  aRR    = input.float(2.0, "RR (Fixed RR or fallback)", minval = 0.5, step = 0.25, group = G_A)

bool   useB   = input.bool(true, "Enable", group = G_B)
string bRange = input.session("0800-0900", "Range candle (NY)", group = G_B)
string bWin   = input.session("0900-1200", "Trade window (NY)", group = G_B)
string bTgt   = input.string("Opposite level", "Target", options = ["Opposite level", "Fixed RR"], group = G_B)
float  bRR    = input.float(2.0, "RR (Fixed RR or fallback)", minval = 0.5, step = 0.25, group = G_B)

bool   useC    = input.bool(true, "Enable", group = G_C)
string cBiasTF = input.timeframe("60", "Bias timeframe", group = G_C)
string cFvgTF  = input.timeframe("5", "Setup FVG timeframe", group = G_C, tooltip = "5 or 15 minute fair value gaps that form toward the draw on liquidity.")
string cWin    = input.session("0930-1200", "Trade window (NY)", group = G_C)
string cTrig   = input.string("IFVG or CISD", "1m trigger", options = ["IFVG or CISD", "IFVG only", "CISD only"], group = G_C)
int    cLook   = input.int(30, "Trigger lookback (bars)", minval = 5, group = G_C, tooltip = "The 1m FVG being inverted must have formed within this many bars, and the trigger must come within this many bars of the low/high made in the zone.")
int    cLiqLen = input.int(3, "Liquidity swing strength (bias TF)", minval = 1, maxval = 10, group = G_C)
string cTgt    = input.string("Draw on liquidity", "Target", options = ["Draw on liquidity", "Fixed RR"], group = G_C)
float  cRR     = input.float(2.0, "RR (Fixed RR or fallback)", minval = 0.5, step = 0.25, group = G_C)

bool   useD      = input.bool(true, "Enable", group = G_D)
string dWin      = input.session("0930-1600", "Trade window (NY)", group = G_D)
string dZoneMode = input.string("HTF FVG + key levels", "Where to look", options = ["HTF FVG + key levels", "HTF FVG only", "Key levels only"], group = G_D)
string dFvgTF    = input.timeframe("15", "HTF FVG timeframe", group = G_D)
string dDelta    = input.string("Candle estimate", "Delta source", options = ["Candle estimate", "Intrabar (lower TF)"], group = G_D, tooltip = "Candle estimate splits each bar's volume by where it closed in its range (works on every plan). Intrabar classifies lower-timeframe bars as buying or selling; on a 1m chart that needs seconds data (1S/5S/15S), which requires a TradingView plan with second-based intervals.")
string dLtf      = input.timeframe("1", "Intrabar timeframe", group = G_D, tooltip = "Only used with Delta source = Intrabar. Must be lower than the chart timeframe to add information, e.g. 1S, 5S or 15S on a 1m chart.")
float  dVolMult  = input.float(1.5, "Aggressive: volume ≥ × 20-bar avg", minval = 1.0, step = 0.1, group = G_D)
float  dDeltaPct = input.float(30.0, "Aggressive: |delta| ≥ % of volume", minval = 5.0, maxval = 100.0, step = 5.0, group = G_D)
int    dMaxBars  = input.int(10, "Max bars from cluster to reversal", minval = 2, group = G_D)
float  dRR       = input.float(2.0, "Target RR", minval = 0.5, step = 0.25, group = G_D)
float  dTolAtr   = input.float(0.25, "Level touch tolerance (× ATR)", minval = 0.0, step = 0.05, group = G_D)
string dOnSess   = input.session("1800-0930", "Overnight session (NY)", group = G_D)
float  dVaPct    = input.float(70.0, "Value area %", minval = 50.0, maxval = 95.0, group = G_D)
int    dRows     = input.int(50, "Profile rows", minval = 10, maxval = 200, group = G_D)
bool   useVA     = input.bool(true, "Overnight value area high/low", group = G_D)
bool   useON     = input.bool(true, "Overnight high/low", group = G_D)
bool   usePD     = input.bool(true, "Previous day high/low", group = G_D)
float  dMan1     = input.float(0.0, "Manual level 1 (0 = off)", group = G_D)
float  dMan2     = input.float(0.0, "Manual level 2 (0 = off)", group = G_D)

bool  showRanges = input.bool(true, "Session ranges (A/B)", group = G_VIS)
bool  showTrades = input.bool(true, "Setups and trades", group = G_VIS)
bool  showZones  = input.bool(true, "HTF FVG zones (C/D)", group = G_VIS)
bool  showLevels = input.bool(true, "Key levels and draw on liquidity", group = G_VIS)
bool  showAggr   = input.bool(false, "Mark aggressive volume bars (D)", group = G_VIS)
bool  showStats  = input.bool(true, "Stats table", group = G_VIS)
color colBull    = input.color(#26a69a, "Bullish", group = G_VIS)
color colBear    = input.color(#ef5350, "Bearish", group = G_VIS)
color colRange   = input.color(#f0b90b, "Ranges", group = G_VIS)
color colEntry   = input.color(#2962ff, "Entry", group = G_VIS)
color colLevel   = input.color(#9598a1, "Key levels", group = G_VIS)

bool useFvgZ = dZoneMode != "Key levels only"
bool useLvls = dZoneMode != "HTF FVG only"

// ───────────────────────────── Types ─────────────────────────────
type Trade
    int   dir = 0
    float entry
    float sl
    float tp
    int   bar
    bool  live = false
    line  lE
    line  lS
    line  lT

type Stats
    int n = 0
    int w = 0
    int l = 0

type Zone
    int   dir
    float top
    float bot
    box   bx
    bool  tapped = false
    int   tapBar
    float ext
    int   extBar
    float cisd
    bool  used = false

type SweepModel
    string tag
    float  hi
    float  lo
    int    state = 4   // 0 wait sweep · 1 swept, wait MSS · 2 armed, wait fill · 3 in trade · 4 idle
    int    dir = 0
    float  ext
    int    extBar
    bool   backIn = false
    bool   mss = false
    int    mssBar
    float  fvgTop
    float  fvgBot
    int    fvgBar
    float  entry
    float  sl
    float  tp
    line   lnHi
    line   lnLo
    box    bx

// ───────────────────────────── Shared series ─────────────────────────────
float tick    = syminfo.mintick
float slBuf   = slBufTicks * tick
float minGap  = minFvgTicks * tick
float body    = math.abs(close - open)
float avgBody = ta.sma(body, 20)
float atr     = ta.atr(14)
float tol     = dTolAtr * atr

bool  bullGap    = low > high[2] and low - high[2] >= minGap
bool  bearGap    = high < low[2] and low[2] - high >= minGap
float bullTopNow = low
float bullBotNow = high[2]
float bearTopNow = low[2]
float bearBotNow = high
bool  bullDisp   = bullGap and close[1] > open[1] and body[1] >= dispMult * nz(avgBody[1])
bool  bearDisp   = bearGap and close[1] < open[1] and body[1] >= dispMult * nz(avgBody[1])

float ph1 = ta.pivothigh(high, mssLen, mssLen)
float pl1 = ta.pivotlow(low, mssLen, mssLen)
var array<float> pHp = array.new<float>()
var array<int>   pHb = array.new<int>()
var array<float> pLp = array.new<float>()
var array<int>   pLb = array.new<int>()

// ───────────────────────────── Functions ─────────────────────────────
f_px(float p) =>
    str.tostring(p, format.mintick)

// Most recent stored pivot that formed before bar `before`.
f_pivotBefore(array<float> ps, array<int> bs, int before) =>
    float res    = na
    int   resBar = na
    int n = ps.size()
    if n > 0
        for i = n - 1 to 0
            if bs.get(i) < before
                res    := ps.get(i)
                resBar := bs.get(i)
                break
    [res, resBar]

// Requested on 15m: most recent swing high/low that has not been taken out yet.
f_liqSwings(int len) =>
    var array<float> hs = array.new<float>()
    var array<float> ls = array.new<float>()
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low, len, len)
    if not na(ph)
        hs.push(ph)
        if hs.size() > 50
            hs.shift()
    if not na(pl)
        ls.push(pl)
        if ls.size() > 50
            ls.shift()
    int nh = hs.size()
    if nh > 0
        for i = nh - 1 to 0
            if high > hs.get(i)
                hs.remove(i)
    int nl = ls.size()
    if nl > 0
        for i = nl - 1 to 0
            if low < ls.get(i)
                ls.remove(i)
    float lastH = hs.size() > 0 ? hs.last() : na
    float lastL = ls.size() > 0 ? ls.last() : na
    [lastH[1], lastL[1]]

// Requested on the bias timeframe. Bias follows the latest PD-array reaction:
// a bullish FVG tapped and held (close above its midpoint) or a bearish FVG
// closed through = bullish; the mirror = bearish. Also returns the nearest
// untaken swing high (buy-side) and swing low (sell-side) liquidity.
f_pdBias(int liqLen) =>
    var array<float> bT   = array.new<float>()
    var array<float> bB   = array.new<float>()
    var array<float> sT   = array.new<float>()
    var array<float> sB   = array.new<float>()
    var array<float> liqH = array.new<float>()
    var array<float> liqL = array.new<float>()
    var int bias = 0
    int bullEv = 0
    int bearEv = 0
    int nb = bT.size()
    if nb > 0
        for i = nb - 1 to 0
            float t = bT.get(i)
            float b = bB.get(i)
            if close < b
                bearEv += 1
                bT.remove(i)
                bB.remove(i)
            else if low <= t and close >= (t + b) / 2
                bullEv += 1
    int ns = sT.size()
    if ns > 0
        for i = ns - 1 to 0
            float t = sT.get(i)
            float b = sB.get(i)
            if close > t
                bullEv += 1
                sT.remove(i)
                sB.remove(i)
            else if high >= b and close <= (t + b) / 2
                bearEv += 1
    if bullEv > 0 and bearEv == 0
        bias := 1
    else if bearEv > 0 and bullEv == 0
        bias := -1
    if low > high[2]
        bT.push(low)
        bB.push(high[2])
        if bT.size() > 10
            bT.shift()
            bB.shift()
    if high < low[2]
        sT.push(low[2])
        sB.push(high)
        if sT.size() > 10
            sT.shift()
            sB.shift()
    float ph = ta.pivothigh(high, liqLen, liqLen)
    float pl = ta.pivotlow(low, liqLen, liqLen)
    if not na(ph)
        liqH.push(ph)
        if liqH.size() > 50
            liqH.shift()
    if not na(pl)
        liqL.push(pl)
        if liqL.size() > 50
            liqL.shift()
    int nh = liqH.size()
    if nh > 0
        for i = nh - 1 to 0
            if high > liqH.get(i)
                liqH.remove(i)
    int nl = liqL.size()
    if nl > 0
        for i = nl - 1 to 0
            if low < liqL.get(i)
                liqL.remove(i)
    float bsl = liqH.size() > 0 ? liqH.min() : na
    float ssl = liqL.size() > 0 ? liqL.max() : na
    [bias[1], bsl[1], ssl[1]]

// Requested on a higher timeframe: FVG formed by the last closed bar.
f_htfFvg() =>
    bool bull = low > high[2]
    bool bear = high < low[2]
    [bull[1], low[1], high[3], bear[1], low[3], high[1], time[3]]

// Volume profile value area from stored bars (each bar's volume spread evenly over its range).
f_valueArea(array<float> hs, array<float> ls, array<float> vs, float lo, float hi, int rows, float vaPct) =>
    float vah = na
    float val = na
    float poc = na
    int n = hs.size()
    if n > 0 and hi > lo
        float step = (hi - lo) / rows
        array<float> bins = array.new<float>(rows, 0.0)
        for i = 0 to n - 1
            int r0 = math.max(0, math.min(rows - 1, math.floor((ls.get(i) - lo) / step)))
            int r1 = math.max(0, math.min(rows - 1, math.floor((hs.get(i) - lo) / step)))
            float share = vs.get(i) / (r1 - r0 + 1)
            for r = r0 to r1
                bins.set(r, bins.get(r) + share)
        float total = bins.sum()
        if total > 0
            int pocIdx = bins.indexof(bins.max())
            int up = pocIdx
            int dn = pocIdx
            float acc = bins.get(pocIdx)
            while acc < total * vaPct / 100.0 and (up < rows - 1 or dn > 0)
                float vUp = up < rows - 1 ? bins.get(up + 1) : -1.0
                float vDn = dn > 0 ? bins.get(dn - 1) : -1.0
                if vUp >= vDn
                    up += 1
                    acc += vUp
                else
                    dn -= 1
                    acc += vDn
            vah := lo + (up + 1) * step
            val := lo + dn * step
            poc := lo + (pocIdx + 0.5) * step
    [vah, val, poc]

// Buy/sell volume from lower-timeframe bars (up bar = buying, down bar = selling).
f_ibDelta(array<float> o, array<float> c, array<float> v) =>
    float b = 0.0
    float s = 0.0
    int n = o.size()
    if n > 0
        for i = 0 to n - 1
            float vi = nz(v.get(i))
            if c.get(i) > o.get(i)
                b += vi
            else if c.get(i) < o.get(i)
                s += vi
            else
                b += vi / 2
                s += vi / 2
    [b, s]

f_addZone(array<Zone> zs, int dir, float top, float bot, int t0) =>
    color c = dir > 0 ? colBull : colBear
    box bx = na
    if showZones
        bx := box.new(t0, top, time, bot, xloc = xloc.bar_time, border_color = color.new(c, 70), bgcolor = color.new(c, 88))
    zs.push(Zone.new(dir, top, bot, bx))
    if zs.size() > 6
        Zone old = zs.shift()
        if not na(old.bx)
            old.bx.delete()
    true

// Drops zones that price closed through; tracks taps, the extreme made inside
// the zone and the CISD level (open of the run of candles that made that extreme).
f_updateZones(array<Zone> zs, float bearRun, float bullRun) =>
    int n = zs.size()
    if n > 0
        for i = n - 1 to 0
            Zone z = zs.get(i)
            bool dead = z.dir > 0 ? close < z.bot : close > z.top
            if dead
                if not na(z.bx)
                    z.bx.delete()
                zs.remove(i)
            else
                if not na(z.bx)
                    z.bx.set_right(time)
                if z.dir > 0 and low <= z.top
                    if not z.tapped
                        z.tapped := true
                        z.tapBar := bar_index
                    if na(z.ext) or low < z.ext
                        z.ext    := low
                        z.extBar := bar_index
                        z.cisd   := bearRun
                if z.dir < 0 and high >= z.bot
                    if not z.tapped
                        z.tapped := true
                        z.tapBar := bar_index
                    if na(z.ext) or high > z.ext
                        z.ext    := high
                        z.extBar := bar_index
                        z.cisd   := bullRun
    true

f_zoneTouch(array<Zone> zs) =>
    bool sup = false
    bool res = false
    int n = zs.size()
    if n > 0
        for i = 0 to n - 1
            Zone z = zs.get(i)
            if z.dir > 0 and low <= z.top and high >= z.bot
                sup := true
            if z.dir < 0 and high >= z.bot and low <= z.top
                res := true
    [sup, res]

// ───────────────────────────── Trade handling ─────────────────────────────
method closeTrade(Trade t, int res, Stats st) =>
    if t.live
        t.live := false
        if res > 0
            st.w := st.w + 1
        else if res < 0
            st.l := st.l + 1
        if showTrades
            string txt = res > 0 ? "TP ✓" : res < 0 ? "SL ✗" : "closed"
            color  c   = res > 0 ? colBull : res < 0 ? colBear : color.gray
            float  y   = res > 0 ? t.tp : res < 0 ? t.sl : close
            label.new(bar_index, y, txt, style = label.style_label_left, color = color.new(c, 20), textcolor = color.white, size = size.tiny)
            t.lE.set_x2(bar_index)
            t.lS.set_x2(bar_index)
            t.lT.set_x2(bar_index)
    t

method openTrade(Trade t, int dir, float entry, float sl, float tp, string tag, Stats st) =>
    t.dir   := dir
    t.entry := entry
    t.sl    := sl
    t.tp    := tp
    t.bar   := bar_index
    t.live  := true
    st.n    := st.n + 1
    if showTrades
        t.lE := line.new(bar_index, entry, bar_index + 1, entry, color = colEntry, width = 2)
        t.lS := line.new(bar_index, sl, bar_index + 1, sl, color = colBear, style = line.style_dashed)
        t.lT := line.new(bar_index, tp, bar_index + 1, tp, color = colBull, style = line.style_dashed)
        string txt = tag + (dir > 0 ? " LONG" : " SHORT") + "\nE " + f_px(entry) + "\nSL " + f_px(sl) + "\nTP " + f_px(tp)
        label.new(bar_index, dir > 0 ? low : high, txt, style = dir > 0 ? label.style_label_up : label.style_label_down, color = dir > 0 ? colBull : colBear, textcolor = color.white, size = size.small)
    t

// Stops are checked before targets, so a bar that touches both counts as a loss.
method manage(Trade t, Stats st) =>
    if t.live and bar_index > t.bar
        if showTrades
            t.lE.set_x2(bar_index)
            t.lS.set_x2(bar_index)
            t.lT.set_x2(bar_index)
        bool hitSL = t.dir > 0 ? low <= t.sl : high >= t.sl
        bool hitTP = t.dir > 0 ? high >= t.tp : low <= t.tp
        if hitSL
            t.closeTrade(-1, st)
        else if hitTP
            t.closeTrade(1, st)
    t

// ───────────────────────────── Sweep → MSS → FVG engine (A, B) ─────────────────────────────
// Returns +1/-1 when a long/short limit setup is armed, +2/-2 when it fills, else 0.
method run(SweepModel m, bool active, bool startNow, float nHi, float nLo, int rngBar, bool needBack, string tgtMode, float rr, Trade t, Stats st) =>
    int ev = 0
    if startNow
        if t.live
            t.closeTrade(0, st)
        m.hi     := nHi
        m.lo     := nLo
        m.dir    := 0
        m.mss    := false
        m.backIn := false
        m.fvgTop := na
        m.fvgBot := na
        m.lnHi   := na
        m.lnLo   := na
        m.bx     := na
        m.state  := na(nHi) or na(nLo) or nHi <= nLo ? 4 : 0
        if m.state == 0 and showRanges
            m.lnHi := line.new(rngBar, nHi, bar_index, nHi, color = colRange, style = line.style_dashed)
            m.lnLo := line.new(rngBar, nLo, bar_index, nLo, color = colRange, style = line.style_dashed)
            label.new(rngBar, nHi, m.tag + " high", style = label.style_label_lower_left, color = color.new(colRange, 100), textcolor = colRange, size = size.tiny)
            label.new(rngBar, nLo, m.tag + " low", style = label.style_label_upper_left, color = color.new(colRange, 100), textcolor = colRange, size = size.tiny)
    if m.state == 3 and not t.live
        m.state := 4
    if not active and m.state <= 2
        m.state := 4
    if active and not na(m.lnHi)
        m.lnHi.set_x2(bar_index)
        m.lnLo.set_x2(bar_index)
    if active and m.state <= 2
        // Armed: wait for price to retrace into the FVG.
        if m.state == 2
            if not na(m.bx)
                m.bx.set_right(bar_index)
            bool filled = m.dir > 0 ? low <= m.entry : high >= m.entry
            bool missed = m.dir > 0 ? high >= m.tp : low <= m.tp
            if filled
                float px = m.dir > 0 ? math.min(open, m.entry) : math.max(open, m.entry)
                t.openTrade(m.dir, px, m.sl, m.tp, m.tag, st)
                m.state := 3
                ev := 2 * m.dir
                bool stoppedNow = m.dir > 0 ? low <= m.sl : high >= m.sl
                if stoppedNow
                    t.closeTrade(-1, st)
            else if missed
                m.state := 4
                if showTrades
                    label.new(bar_index, m.tp, m.tag + " missed", style = label.style_label_left, color = color.new(color.gray, 30), textcolor = color.white, size = size.tiny)
        // Sweep of the range high/low, or a new extreme beyond the sweep.
        if m.state <= 1
            if (m.dir == -1 and high > m.ext) or (m.dir != -1 and high > m.hi)
                if m.dir != -1 and showTrades
                    label.new(bar_index, high, m.tag + " high swept", style = label.style_label_down, color = color.new(colRange, 20), textcolor = color.black, size = size.tiny)
                m.dir    := -1
                m.ext    := high
                m.extBar := bar_index
                m.mss    := false
                m.backIn := false
                m.fvgTop := na
                m.fvgBot := na
                m.state  := 1
            if (m.dir == 1 and low < m.ext) or (m.dir != 1 and low < m.lo)
                if m.dir != 1 and showTrades
                    label.new(bar_index, low, m.tag + " low swept", style = label.style_label_up, color = color.new(colRange, 20), textcolor = color.black, size = size.tiny)
                m.dir    := 1
                m.ext    := low
                m.extBar := bar_index
                m.mss    := false
                m.backIn := false
                m.fvgTop := na
                m.fvgBot := na
                m.state  := 1
        // After the sweep: MSS with a displacement FVG, then arm the limit order.
        if m.state == 1
            if m.dir == 1
                if close > m.lo
                    m.backIn := true
                if bullDisp and bar_index - 2 >= m.extBar and (not m.mss or bar_index - 1 <= m.mssBar + 3)
                    m.fvgTop := bullTopNow
                    m.fvgBot := bullBotNow
                    m.fvgBar := bar_index - 1
                if not na(m.fvgBot) and close < m.fvgBot
                    m.fvgTop := na
                    m.fvgBot := na
                if not m.mss
                    [lvl, lvlBar] = f_pivotBefore(pHp, pHb, m.extBar)
                    if not na(lvl) and close > lvl
                        m.mss    := true
                        m.mssBar := bar_index
                        if showTrades
                            line.new(lvlBar, lvl, bar_index, lvl, color = colBull, style = line.style_dotted)
                            label.new(math.round((lvlBar + bar_index) / 2.0), lvl, "MSS", style = label.style_label_down, color = color.new(colBull, 100), textcolor = colBull, size = size.tiny)
                if m.mss and not na(m.fvgTop) and m.fvgBar <= m.mssBar + 3 and (m.backIn or not needBack)
                    m.entry := entryMode == "FVG edge" ? m.fvgTop : (m.fvgTop + m.fvgBot) / 2
                    m.sl    := m.ext - slBuf
                    float tgt = tgtMode == "Opposite level" ? m.hi : na
                    m.tp    := not na(tgt) and tgt > m.entry ? tgt : m.entry + rr * (m.entry - m.sl)
                    m.state := 2
                    ev := 1
                    if showTrades
                        m.bx := box.new(m.fvgBar - 1, m.fvgTop, bar_index, m.fvgBot, border_color = color.new(colBull, 40), bgcolor = color.new(colBull, 80), text = m.tag + " limit", text_size = size.tiny, text_color = colBull)
            else
                if close < m.hi
                    m.backIn := true
                if bearDisp and bar_index - 2 >= m.extBar and (not m.mss or bar_index - 1 <= m.mssBar + 3)
                    m.fvgTop := bearTopNow
                    m.fvgBot := bearBotNow
                    m.fvgBar := bar_index - 1
                if not na(m.fvgTop) and close > m.fvgTop
                    m.fvgTop := na
                    m.fvgBot := na
                if not m.mss
                    [lvl, lvlBar] = f_pivotBefore(pLp, pLb, m.extBar)
                    if not na(lvl) and close < lvl
                        m.mss    := true
                        m.mssBar := bar_index
                        if showTrades
                            line.new(lvlBar, lvl, bar_index, lvl, color = colBear, style = line.style_dotted)
                            label.new(math.round((lvlBar + bar_index) / 2.0), lvl, "MSS", style = label.style_label_up, color = color.new(colBear, 100), textcolor = colBear, size = size.tiny)
                if m.mss and not na(m.fvgTop) and m.fvgBar <= m.mssBar + 3 and (m.backIn or not needBack)
                    m.entry := entryMode == "FVG edge" ? m.fvgBot : (m.fvgTop + m.fvgBot) / 2
                    m.sl    := m.ext + slBuf
                    float tgt = tgtMode == "Opposite level" ? m.lo : na
                    m.tp    := not na(tgt) and tgt < m.entry ? tgt : m.entry - rr * (m.sl - m.entry)
                    m.state := 2
                    ev := -1
                    if showTrades
                        m.bx := box.new(m.fvgBar - 1, m.fvgTop, bar_index, m.fvgBot, border_color = color.new(colBear, 40), bgcolor = color.new(colBear, 80), text = m.tag + " limit", text_size = size.tiny, text_color = colBear)
    ev

f_sweepMsg(string tag, int ev, SweepModel m, Trade t) =>
    string side = ev > 0 ? "LONG" : "SHORT"
    string body1 = math.abs(ev) == 1 ? " setup: limit " + f_px(m.entry) + "  SL " + f_px(m.sl) + "  TP " + f_px(m.tp) : " filled @ " + f_px(t.entry) + "  SL " + f_px(t.sl) + "  TP " + f_px(t.tp)
    syminfo.ticker + " · " + tag + " " + side + body1

f_tradeMsg(string tag, Trade t) =>
    syminfo.ticker + " · " + tag + " " + (t.dir > 0 ? "LONG" : "SHORT") + " @ " + f_px(t.entry) + "  SL " + f_px(t.sl) + "  TP " + f_px(t.tp)

f_statRow(table tb, int r, string name, Stats st) =>
    string wr = st.w + st.l > 0 ? str.tostring(100.0 * st.w / (st.w + st.l), "#") + "%" : "–"
    table.cell(tb, 0, r, name, text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, r, str.tostring(st.n), text_color = color.white, text_size = size.small)
    table.cell(tb, 2, r, str.tostring(st.w), text_color = colBull, text_size = size.small)
    table.cell(tb, 3, r, str.tostring(st.l), text_color = colBear, text_size = size.small)
    table.cell(tb, 4, r, wr, text_color = color.white, text_size = size.small)
    r + 1

// ───────────────────────────── Data requests ─────────────────────────────
// All higher-timeframe values come from the last closed HTF bar (no repainting).
[aHi15, aLo15]                       = request.security(syminfo.tickerid, "15", f_liqSwings(aSwing), lookahead = barmerge.lookahead_on)
[cBias, cBSL, cSSL]                  = request.security(syminfo.tickerid, cBiasTF, f_pdBias(cLiqLen), lookahead = barmerge.lookahead_on)
[cNB, cBT, cBB, cNS, cST, cSB, cT]   = request.security(syminfo.tickerid, cFvgTF, f_htfFvg(), lookahead = barmerge.lookahead_on)
[dNB, dBT, dBB, dNS, dST, dSB, dT]   = request.security(syminfo.tickerid, dFvgTF, f_htfFvg(), lookahead = barmerge.lookahead_on)
[pdh, pdl]                           = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)

int  cBiasNow = nz(cBias)
bool cFresh   = not na(cT) and cT != nz(cT[1])
bool dFresh   = not na(dT) and dT != nz(dT[1])

// Order-flow proxy: buy vs sell volume per bar.
float buyV  = 0.0
float sellV = 0.0
if dDelta == "Intrabar (lower TF)"
    [ltO, ltC, ltV] = request.security_lower_tf(syminfo.tickerid, dLtf, [open, close, volume])
    [b0, s0] = f_ibDelta(ltO, ltC, ltV)
    buyV  := b0
    sellV := s0
else
    float rngHL = high - low
    float v0    = nz(volume)
    buyV  := rngHL > 0 ? v0 * (close - low) / rngHL : v0 / 2
    sellV := v0 - buyV
float barDelta = buyV - sellV
float barVol   = buyV + sellV
float avgVol   = ta.sma(barVol, 20)
bool  aggrBuy  = barVol > 0 and barVol >= dVolMult * avgVol and barDelta >= dDeltaPct / 100.0 * barVol
bool  aggrSell = barVol > 0 and barVol >= dVolMult * avgVol and -barDelta >= dDeltaPct / 100.0 * barVol

// ───────────────────────────── Sessions (NY time) ─────────────────────────────
bool inA    = not na(time(timeframe.period, aWin + ALL_DAYS, TZ))
bool inBR   = not na(time(timeframe.period, bRange + ALL_DAYS, TZ))
bool inBW   = not na(time(timeframe.period, bWin + ALL_DAYS, TZ))
bool inC    = not na(time(timeframe.period, cWin + ALL_DAYS, TZ))
bool inD    = not na(time(timeframe.period, dWin + ALL_DAYS, TZ))
bool inON   = not na(time(timeframe.period, dOnSess + ALL_DAYS, TZ))
bool aStart = inA and not inA[1]
bool bStart = inBW and not inBW[1]
bool cStart = inC and not inC[1]
bool dStart = inD and not inD[1]

// ───────────────────────────── State ─────────────────────────────
var SweepModel mA = SweepModel.new("A")
var SweepModel mB = SweepModel.new("B")
var Trade tA = Trade.new()
var Trade tB = Trade.new()
var Trade tC = Trade.new()
var Trade tD = Trade.new()
var Stats sA = Stats.new()
var Stats sB = Stats.new()
var Stats sC = Stats.new()
var Stats sD = Stats.new()
var array<Zone> cZones = array.new<Zone>()
var array<Zone> dZones = array.new<Zone>()

// 8 AM candle
var float bHi  = na
var float bLo  = na
var int   bBar = na
var int   bT0  = na

// 1m gaps waiting to be inverted (model C)
var array<float> bgTop = array.new<float>()
var array<int>   bgBar = array.new<int>()
var array<float> ugBot = array.new<float>()
var array<int>   ugBar = array.new<int>()

// Open of the first candle in the latest run of down-close / up-close candles (CISD)
var float bearRunOpen = na
var float bullRunOpen = na
var int   cTaken      = 0

// Overnight profile and key levels (model D)
var array<float> onHs = array.new<float>()
var array<float> onLs = array.new<float>()
var array<float> onVs = array.new<float>()
var float onHi  = na
var float onLo  = na
var float onVAH = na
var float onVAL = na
var float onPOC = na
var float lvONH = na
var float lvONL = na

// Absorption candidates (model D)
var int   dLS     = 0
var float dLTop   = na
var float dLLow0  = na
var float dLExt   = na
var int   dLBar   = na
var int   dSS     = 0
var float dSBot   = na
var float dSHigh0 = na
var float dSExt   = na
var int   dSBar   = na

int  evA        = 0
int  evB        = 0
int  evC        = 0
int  evD        = 0
bool invBull    = false
int  invBullBar = na
bool invBear    = false
int  invBearBar = na
bool atSup      = false
bool atRes      = false

// ───────────────────────────── Main logic (closed bars only) ─────────────────────────────
if barstate.isconfirmed
    // 1m swing points for MSS
    if not na(ph1)
        pHp.push(ph1)
        pHb.push(bar_index - mssLen)
        if pHp.size() > 100
            pHp.shift()
            pHb.shift()
    if not na(pl1)
        pLp.push(pl1)
        pLb.push(bar_index - mssLen)
        if pLp.size() > 100
            pLp.shift()
            pLb.shift()

    // Runs of same-direction candles (CISD reference)
    if close < open and not (close[1] < open[1])
        bearRunOpen := open
    if close > open and not (close[1] > open[1])
        bullRunOpen := open

    // 1m FVG inversions: close above a recent bearish gap / below a recent bullish gap
    int nBG = bgTop.size()
    if nBG > 0
        for i = nBG - 1 to 0
            if bar_index - bgBar.get(i) > cLook
                bgTop.remove(i)
                bgBar.remove(i)
            else if close > bgTop.get(i)
                invBull    := true
                invBullBar := math.max(nz(invBullBar), bgBar.get(i))
                bgTop.remove(i)
                bgBar.remove(i)
    int nUG = ugBot.size()
    if nUG > 0
        for i = nUG - 1 to 0
            if bar_index - ugBar.get(i) > cLook
                ugBot.remove(i)
                ugBar.remove(i)
            else if close < ugBot.get(i)
                invBear    := true
                invBearBar := math.max(nz(invBearBar), ugBar.get(i))
                ugBot.remove(i)
                ugBar.remove(i)
    if bearGap
        bgTop.push(bearTopNow)
        bgBar.push(bar_index - 1)
    if bullGap
        ugBot.push(bullBotNow)
        ugBar.push(bar_index - 1)

    // Manage open trades before looking for new ones
    tA.manage(sA)
    tB.manage(sB)
    tC.manage(sC)
    tD.manage(sD)

    // ── Model A: 8 PM 15m range sweep ──
    if useA
        evA := mA.run(inA, aStart, aHi15, aLo15, bar_index, false, aTgt, aRR, tA, sA)

    // ── Model B: 8 AM candle sweep ──
    if inBR
        if not inBR[1]
            bHi  := high
            bLo  := low
            bBar := bar_index
            bT0  := time
        else
            bHi := math.max(bHi, high)
            bLo := math.min(bLo, low)
    if useB
        bool bFresh = not na(bT0) and time - bT0 < 86400000
        evB := mB.run(inBW, bStart, bFresh ? bHi : na, bFresh ? bLo : na, nz(bBar, bar_index), true, bTgt, bRR, tB, sB)

    // ── Model C: PD-array bias + IFVG / CISD ──
    if useC
        if cFresh
            if cNB
                f_addZone(cZones, 1, cBT, cBB, cT)
            if cNS
                f_addZone(cZones, -1, cST, cSB, cT)
        f_updateZones(cZones, bearRunOpen, bullRunOpen)
        if cStart
            cTaken := 0
            if tC.live
                tC.closeTrade(0, sC)
        if inC and not tC.live and cTaken < 1 and cBiasNow != 0
            int nZ = cZones.size()
            if nZ > 0
                for i = nZ - 1 to 0
                    Zone z = cZones.get(i)
                    if z.dir == cBiasNow and z.tapped and not z.used and bar_index - z.extBar <= cLook
                        bool viaIfvg = cTrig != "CISD only" and (z.dir > 0 ? invBull and invBullBar >= z.tapBar - cLook : invBear and invBearBar >= z.tapBar - cLook)
                        bool viaCisd = cTrig != "IFVG only" and not na(z.cisd) and (z.dir > 0 ? close > z.cisd : close < z.cisd)
                        float sl     = z.dir > 0 ? z.ext - slBuf : z.ext + slBuf
                        float risk   = math.abs(close - sl)
                        if (viaIfvg or viaCisd) and risk > 0
                            float dol   = z.dir > 0 ? cBSL : cSSL
                            bool  dolOk = cTgt == "Draw on liquidity" and not na(dol) and (z.dir > 0 ? dol > close : dol < close)
                            float tp    = dolOk ? dol : close + z.dir * cRR * risk
                            tC.openTrade(z.dir, close, sl, tp, "C " + (viaIfvg ? "IFVG" : "CISD"), sC)
                            z.used := true
                            cTaken += 1
                            evC := z.dir
                            break

    // ── Model D: order-flow absorption ──
    if useD
        // Overnight session profile -> VAH / VAL / POC, high / low
        if inON
            if not inON[1]
                onHs.clear()
                onLs.clear()
                onVs.clear()
                onHi := high
                onLo := low
            else
                onHi := math.max(onHi, high)
                onLo := math.min(onLo, low)
            onHs.push(high)
            onLs.push(low)
            onVs.push(nz(volume))
        else if inON[1]
            [vah, val, poc] = f_valueArea(onHs, onLs, onVs, onLo, onHi, dRows, dVaPct)
            onVAH := vah
            onVAL := val
            onPOC := poc
            lvONH := onHi
            lvONL := onLo

        if useFvgZ
            if dFresh
                if dNB
                    f_addZone(dZones, 1, dBT, dBB, dT)
                if dNS
                    f_addZone(dZones, -1, dST, dSB, dT)
            f_updateZones(dZones, bearRunOpen, bullRunOpen)
            [zSup, zRes] = f_zoneTouch(dZones)
            atSup := zSup
            atRes := zRes
        if useLvls
            array<float> lv = array.from(useVA ? onVAH : na, useVA ? onVAL : na, useON ? lvONH : na, useON ? lvONL : na, usePD ? pdh : na, usePD ? pdl : na, dMan1 > 0 ? dMan1 : na, dMan2 > 0 ? dMan2 : na)
            for lvl in lv
                if not na(lvl) and low <= lvl + tol and high >= lvl - tol
                    atSup := true
                    atRes := true

        if dStart
            dLS := 0
            dSS := 0
            if tD.live
                tD.closeTrade(0, sD)
        if not inD
            dLS := 0
            dSS := 0
        else if not tD.live
            // Long: aggressive sellers absorbed, then aggressive buyers close above them
            if dLS == 1
                dLExt := math.min(dLExt, low)
                if close < dLLow0 or bar_index - dLBar > dMaxBars
                    dLS := 0
                else if aggrBuy and close > dLTop
                    float sl   = dLExt - slBuf
                    float risk = close - sl
                    if risk > 0
                        tD.openTrade(1, close, sl, close + dRR * risk, "D absorption", sD)
                        evD := 1
                        if showTrades
                            box.new(dLBar, dLTop, bar_index, dLExt, border_color = color.new(colBull, 40), bgcolor = color.new(colBull, 85), text = "sellers absorbed", text_size = size.tiny, text_color = colBull)
                    dLS := 0
                    dSS := 0
            if dLS == 0 and not tD.live and aggrSell and atSup
                dLS    := 1
                dLTop  := math.max(open, close)
                dLLow0 := low
                dLExt  := low
                dLBar  := bar_index
            // Short: aggressive buyers absorbed, then aggressive sellers close below them
            if not tD.live
                if dSS == 1
                    dSExt := math.max(dSExt, high)
                    if close > dSHigh0 or bar_index - dSBar > dMaxBars
                        dSS := 0
                    else if aggrSell and close < dSBot
                        float sl   = dSExt + slBuf
                        float risk = sl - close
                        if risk > 0
                            tD.openTrade(-1, close, sl, close - dRR * risk, "D absorption", sD)
                            evD := -1
                            if showTrades
                                box.new(dSBar, dSExt, bar_index, dSBot, border_color = color.new(colBear, 40), bgcolor = color.new(colBear, 85), text = "buyers absorbed", text_size = size.tiny, text_color = colBear)
                        dLS := 0
                        dSS := 0
                if dSS == 0 and not tD.live and aggrBuy and atRes
                    dSS     := 1
                    dSBot   := math.min(open, close)
                    dSHigh0 := high
                    dSExt   := high
                    dSBar   := bar_index

    // ── Alerts (use "Any alert() function call" for full details) ──
    if evA != 0
        alert(f_sweepMsg("Model A", evA, mA, tA), alert.freq_once_per_bar_close)
    if evB != 0
        alert(f_sweepMsg("Model B", evB, mB, tB), alert.freq_once_per_bar_close)
    if evC != 0
        alert(f_tradeMsg("Model C", tC), alert.freq_once_per_bar_close)
    if evD != 0
        alert(f_tradeMsg("Model D", tD), alert.freq_once_per_bar_close)

// ───────────────────────────── Plots ─────────────────────────────
plot(showLevels and useC ? cBSL : na, "Buy-side liquidity", color = color.new(colBull, 40), style = plot.style_linebr)
plot(showLevels and useC ? cSSL : na, "Sell-side liquidity", color = color.new(colBear, 40), style = plot.style_linebr)
plot(showLevels and useD and useLvls and useVA and not inON ? onVAH : na, "Overnight VAH", color = colLevel, style = plot.style_linebr)
plot(showLevels and useD and useLvls and useVA and not inON ? onVAL : na, "Overnight VAL", color = colLevel, style = plot.style_linebr)
plot(showLevels and useD and useLvls and useVA and not inON ? onPOC : na, "Overnight POC", color = color.new(colLevel, 50), style = plot.style_linebr)
plot(showLevels and useD and useLvls and useON and not inON ? lvONH : na, "Overnight high", color = color.new(colLevel, 30), style = plot.style_circles, linewidth = 1)
plot(showLevels and useD and useLvls and useON and not inON ? lvONL : na, "Overnight low", color = color.new(colLevel, 30), style = plot.style_circles, linewidth = 1)
plot(showLevels and useD and useLvls and usePD ? pdh : na, "Previous day high", color = color.new(colRange, 40), style = plot.style_linebr)
plot(showLevels and useD and useLvls and usePD ? pdl : na, "Previous day low", color = color.new(colRange, 40), style = plot.style_linebr)

plotshape(useD and showAggr and aggrBuy, "Aggressive buyers", shape.circle, location.belowbar, color.new(colBull, 30), size = size.tiny)
plotshape(useD and showAggr and aggrSell, "Aggressive sellers", shape.circle, location.abovebar, color.new(colBear, 30), size = size.tiny)

// ───────────────────────────── Alert conditions ─────────────────────────────
alertcondition(evA == 1, "A long setup", "{{ticker}} Model A: long limit armed in the FVG after the 8 PM range low sweep")
alertcondition(evA == -1, "A short setup", "{{ticker}} Model A: short limit armed in the FVG after the 8 PM range high sweep")
alertcondition(evB == 1, "B long setup", "{{ticker}} Model B: long limit armed in the FVG after the 8 AM candle low sweep")
alertcondition(evB == -1, "B short setup", "{{ticker}} Model B: short limit armed in the FVG after the 8 AM candle high sweep")
alertcondition(evC == 1, "C long", "{{ticker}} Model C: long (bullish bias, FVG tap, IFVG/CISD)")
alertcondition(evC == -1, "C short", "{{ticker}} Model C: short (bearish bias, FVG tap, IFVG/CISD)")
alertcondition(evD == 1, "D long", "{{ticker}} Model D: long (sellers absorbed)")
alertcondition(evD == -1, "D short", "{{ticker}} Model D: short (buyers absorbed)")

// ───────────────────────────── Stats table ─────────────────────────────
var table tbl = table.new(position.top_right, 5, 8, bgcolor = color.new(#131722, 15), border_color = color.new(color.gray, 70), border_width = 1)
if barstate.islast and showStats
    table.cell(tbl, 0, 0, "Model", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, 0, "Trades", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 2, 0, "Win", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 3, 0, "Loss", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 4, 0, "Win %", text_color = color.gray, text_size = size.small)
    int r = 1
    if useA
        r := f_statRow(tbl, r, "A · 8 PM sweep", sA)
    if useB
        r := f_statRow(tbl, r, "B · 8 AM sweep", sB)
    if useC
        r := f_statRow(tbl, r, "C · Bias + IFVG/CISD", sC)
    if useD
        r := f_statRow(tbl, r, "D · Absorption", sD)
    if useC
        string biasTxt = cBiasNow > 0 ? "Bullish" : cBiasNow < 0 ? "Bearish" : "Neutral"
        color  biasCol = cBiasNow > 0 ? colBull : cBiasNow < 0 ? colBear : color.gray
        table.cell(tbl, 0, r, cBiasTF + " bias", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
        table.cell(tbl, 1, r, biasTxt, text_color = biasCol, text_size = size.small)
        r += 1
    if timeframe.period != "1"
        table.cell(tbl, 0, r, "⚠ Built for a 1-minute chart", text_color = color.orange, text_size = size.small, text_halign = text.align_left)
