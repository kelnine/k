//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  Deliverance Multi-Session ORB v2
//
//  v1.0 carried forward intact — CISD delivery legs and zones, SH/SL structure
//  rays, swing signals, SMT divergence, and the HTF/MTF CISD + open bias rows —
//  with four independent 15-minute opening ranges layered on top.
//
//  Globex / London / New York / PM each run their own state machine:
//
//      range forms → break → close outside → retest → CISD confirmation → entry
//
//  No session shares state with another, and statistics are kept per session so
//  the four windows can be compared rather than averaged together.
//
//  Everything that fires is evaluated on confirmed bars, and both bias reads
//  come from closed higher-timeframe bars, so nothing repaints.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Deliverance Multi-Session ORB v2", "Deliverance v2", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ═══════════════════════════════════════════════════════ inputs — v1.0

swingLen  = input.int(5,  "Structure swing length", minval = 2,  group = "Structure")
sigLen    = input.int(10, "Signal swing length",    minval = 2,  group = "Structure")
showSig   = input.bool(true, "Show swing signals",               group = "Structure")
minRun    = input.int(2,  "Min candles in delivery leg", minval = 1, group = "CISD")
showZones = input.bool(true, "Show CISD zones",                  group = "CISD")
maxZones  = input.int(6,  "Max active zones", minval = 1,        group = "CISD")
showCisd  = input.bool(true, "Show CISD levels & labels",        group = "CISD")
showSMT   = input.bool(true, "Show SMT divergence",              group = "SMT")
smtSym    = input.symbol("CME_MINI:ES1!", "Comparison symbol",   group = "SMT")
smtValid  = input.int(20, "SMT stays live for (bars)", minval = 1, group = "SMT")
htfTf     = input.timeframe("D",  "HTF bias timeframe",          group = "Dashboard")
mtfTf     = input.timeframe("60", "MTF bias timeframe",          group = "Dashboard")
showDash  = input.bool(true, "Show dashboard",                   group = "Dashboard")
dashSize  = input.string("Tiny", "Dashboard size", options = ["Tiny", "Small", "Normal"], group = "Dashboard")
dashPos   = input.string("Bottom left", "Dashboard position", options = ["Bottom left", "Bottom right", "Top right"], group = "Dashboard")

colBull   = #089981
colBear   = #e5342c
colStruct = #2962ff

// ═══════════════════════════════════════════════════════ inputs — v2 sessions

G_SESS = "Session ranges"
G_LOG  = "Setup requirements"
G_RISK = "Risk & targets"
G_STAT = "Statistics"
G_VIS  = "Session visuals"

tzIn = input.string("America/New_York", "Session timezone", options = ["America/New_York", "America/Chicago", "Europe/London", "UTC"], group = G_SESS, tooltip = "Windows are evaluated in this zone, so DST is handled by TradingView's session engine rather than a hardcoded offset.")

gbxOn   = input.bool(true, "Globex open", group = G_SESS, inline = "gbx")
gbxSpec = input.session("1800-1815", "",  group = G_SESS, inline = "gbx")
gbxCol  = input.color(#ab47bc, "",        group = G_SESS, inline = "gbx")

lonOn   = input.bool(true, "London open", group = G_SESS, inline = "lon")
lonSpec = input.session("0300-0315", "",  group = G_SESS, inline = "lon")
lonCol  = input.color(#26a69a, "",        group = G_SESS, inline = "lon")

nyOn    = input.bool(true, "New York cash open", group = G_SESS, inline = "ny")
nySpec  = input.session("0930-0945", "",         group = G_SESS, inline = "ny")
nyCol   = input.color(#ffa726, "",               group = G_SESS, inline = "ny")

pmOn    = input.bool(true, "PM range", group = G_SESS, inline = "pm")
pmSpec  = input.session("1345-1400", "", group = G_SESS, inline = "pm")
pmCol   = input.color(#42a5f5, "",       group = G_SESS, inline = "pm")

reqClose  = input.bool(true,  "Require candle close outside range", group = G_LOG, tooltip = "Off = a wick through the edge counts as the break.")
reqRetest = input.bool(true,  "Require retest of the broken level", group = G_LOG)
reqCisd   = input.bool(true,  "Require CISD / structure confirmation", group = G_LOG)
reqSmt    = input.bool(false, "Require agreeing SMT divergence",    group = G_LOG)
failBuf   = input.float(0.15, "Failure buffer (× range)", minval = 0.0, maxval = 1.0, step = 0.05, group = G_LOG, tooltip = "How far back inside the range a close must go before the break counts as failed, as a fraction of the range. 0 = any reclaim kills it, which on fast timeframes kills nearly every break.")
failBars  = input.int(1, "Consecutive closes to fail", minval = 1, maxval = 5, group = G_LOG)
reArm     = input.bool(true, "Failed break re-arms the opposite side", group = G_LOG, tooltip = "A refused break flips the session to hunting the other edge of the range instead of ending its day — one re-arm per session per day.")
filterHtf = input.bool(false, "HTF bias filter (block counter setups)", group = G_LOG)
filterMtf = input.bool(false, "MTF bias filter (block counter setups)", group = G_LOG)

stopMode = input.string("Opposite range side", "Stop placement", options = ["Opposite range side", "Retest swing", "ATR"], group = G_RISK)
atrLen   = input.int(14, "ATR length", minval = 2, group = G_RISK)
atrMult  = input.float(1.0, "ATR stop multiple", minval = 0.1, step = 0.1, group = G_RISK)
winR     = input.string("2R", "Target that counts as a win", options = ["1R", "2R", "3R"], group = G_RISK)
showTgts = input.bool(false, "Draw entry / stop / target lines", group = G_RISK)

statsOn = input.bool(true, "Track statistics", group = G_STAT, tooltip = "A virtual trade opens at each confirmation and resolves when price reaches the stop or the target. A bar spanning both counts as a loss, since bar data cannot say which came first.")
statPos = input.string("Bottom right", "Statistics position", options = ["Bottom right", "Bottom left", "Top left", "Middle right"], group = G_STAT)

cleanMode  = input.bool(false, "Clean mode", group = G_VIS, tooltip = "Hides range name labels, early-break and retest markers, the range open and the statistics table. Range boxes and confirmed signals stay.")
showBox    = input.bool(true, "Show range boxes",      group = G_VIS)
showLvls   = input.bool(true, "Show range high / low", group = G_VIS)
showOpen   = input.bool(true, "Show range open",       group = G_VIS)
showEarly  = input.bool(true, "Show early-break labels", group = G_VIS)
showBrk    = input.bool(true, "Show breakout labels",  group = G_VIS)
showRetest = input.bool(true, "Show retest labels",    group = G_VIS)
showConf   = input.bool(true, "Show confirmed signals", group = G_VIS)
showFail   = input.bool(true, "Show failed-breakout labels", group = G_VIS)
histOn     = input.bool(false, "Keep historical ranges", group = G_VIS)
histDays   = input.int(3, "Days of history to keep", minval = 1, maxval = 20, group = G_VIS)
extendBars = input.int(24, "Extend range levels (bars)", minval = 0, maxval = 300, group = G_VIS)

// ═══════════════════════════════════════════════════════ helpers — v1.0

// CISD state of a series: +1 after a close through the open of the last
// bearish delivery leg, -1 after a close through the open of the last bullish leg
f_cisd() =>
    var int   state  = 0
    var int   curDir = 0
    var float curOpen = na
    var float upOpen  = na
    var float dnOpen  = na
    d = close >= open ? 1 : -1
    if d != curDir
        if curDir == 1
            upOpen := curOpen
        else if curDir == -1
            dnOpen := curOpen
        curDir := d
        curOpen := open
    if not na(dnOpen) and close > dnOpen
        state := 1
        dnOpen := na
    if not na(upOpen) and close < upOpen
        state := -1
        upOpen := na
    state

f_tfTxt(string tf) =>
    tf == "60" ? "h1" : tf == "120" ? "h2" : tf == "240" ? "h4" : tf == "1D" ? "D" : tf

f_biasWord(int b) =>
    b > 0 ? "Bullish" : b < 0 ? "Bearish" : "—"

// abbreviated form for the compact bias rows
f_biasShort(string prefix, int b) =>
    prefix + ": " + (b > 0 ? "Bull" : b < 0 ? "Bear" : "—")

f_biasCol(int b) =>
    b > 0 ? colBull : b < 0 ? colBear : color.gray

// ═══════════════════════════════════════════════════════ helpers — v2

int   barMs  = timeframe.in_seconds(timeframe.period) * 1000
int   extMs  = barMs * extendBars
float atrVal = ta.atr(atrLen)

bool vBox    = showBox
bool vLvls   = showLvls
bool vOpen   = showOpen   and not cleanMode
bool vEarly  = showEarly  and not cleanMode
bool vRetest = showRetest and not cleanMode
bool vTag    = not cleanMode
bool vStats  = statsOn    and not cleanMode

f_fmt(float v) =>
    na(v) ? "—" : str.tostring(v, format.mintick)

f_pts(float v) =>
    na(v) ? "—" : str.tostring(v, "#.##")

f_posOf(string p) =>
    switch p
        "Top left"     => position.top_left
        "Bottom right" => position.bottom_right
        "Bottom left"  => position.bottom_left
        "Middle right" => position.middle_right
        =>                position.top_right

// ═══════════════════════════════════════════════════════ CISD levels + zones (chart TF)

var int   curDir   = 0
var int   curStart = na
var float curOpen  = na
var float curHigh  = na
var float curLow   = na
var int   curLen   = 0

var float dnOpen  = na
var int   dnStart = na
var float dnLow   = na
var int   dnLen   = 0

var float upOpen  = na
var int   upStart = na
var float upHigh  = na
var int   upLen   = 0

var int cisdState = 0

// active zones, terminated when price closes back through their level
var array<box>   zBoxes  = array.new<box>()
var array<float> zLevels = array.new<float>()
var array<int>   zDirs   = array.new<int>()

if barstate.isconfirmed
    d = close >= open ? 1 : -1
    if d != curDir
        if curDir == 1
            upOpen  := curOpen
            upStart := curStart
            upHigh  := curHigh
            upLen   := curLen
        else if curDir == -1
            dnOpen  := curOpen
            dnStart := curStart
            dnLow   := curLow
            dnLen   := curLen
        curDir   := d
        curStart := bar_index
        curOpen  := open
        curHigh  := high
        curLow   := low
        curLen   := 1
    else
        curHigh := math.max(curHigh, high)
        curLow  := math.min(curLow, low)
        curLen  += 1

    // bullish change in the state of delivery
    if not na(dnOpen) and close > dnOpen
        if dnLen >= minRun and showCisd
            line.new(dnStart, dnOpen, bar_index, dnOpen, color = colBull, style = line.style_dotted)
            label.new(bar_index, dnOpen, "+CISD", style = label.style_label_left, color = color(na), textcolor = colBull, size = size.small)
            label.new(dnStart, dnOpen, "+", style = label.style_none, textcolor = colBull, size = size.small)
        if dnLen >= minRun and showZones
            array.push(zBoxes, box.new(dnStart, dnOpen, bar_index, dnLow, border_color = color(na), bgcolor = color.new(colBull, 87), extend = extend.right))
            array.push(zLevels, dnOpen)
            array.push(zDirs, 1)
        cisdState := 1
        dnOpen := na

    // bearish change in the state of delivery
    if not na(upOpen) and close < upOpen
        if upLen >= minRun and showCisd
            line.new(upStart, upOpen, bar_index, upOpen, color = colBear, style = line.style_dotted)
            label.new(bar_index, upOpen, "-CISD", style = label.style_label_left, color = color(na), textcolor = colBear, size = size.small)
            label.new(upStart, upOpen, "+", style = label.style_none, textcolor = colBear, size = size.small)
        if upLen >= minRun and showZones
            array.push(zBoxes, box.new(upStart, upHigh, bar_index, upOpen, border_color = color(na), bgcolor = color.new(colBear, 90), extend = extend.right))
            array.push(zLevels, upOpen)
            array.push(zDirs, -1)
        cisdState := -1
        upOpen := na

    // stop extending a zone once price closes back through its level
    if array.size(zBoxes) > 0
        for i = array.size(zBoxes) - 1 to 0
            lvl = array.get(zLevels, i)
            zd  = array.get(zDirs, i)
            if (zd == 1 and close < lvl) or (zd == -1 and close > lvl)
                b = array.get(zBoxes, i)
                box.set_extend(b, extend.none)
                box.set_right(b, bar_index)
                array.remove(zBoxes, i)
                array.remove(zLevels, i)
                array.remove(zDirs, i)
    while array.size(zBoxes) > maxZones
        box.delete(array.shift(zBoxes))
        array.shift(zLevels)
        array.shift(zDirs)

// ═══════════════════════════════════════════════════════ structure: SH / SL rays + swing status

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastH    = na
var bool  crossedH = true
var float lastL    = na
var bool  crossedL = true
var int   swingTrend = 0
var line  shLine = na
var label shLab  = na
var line  slLine = na
var label slLab  = na

if barstate.isconfirmed
    if not na(ph)
        lastH := ph
        crossedH := false
        line.delete(shLine)
        label.delete(shLab)
        shLine := line.new(bar_index - swingLen, ph, bar_index, ph, color = colStruct, extend = extend.right)
        shLab  := label.new(bar_index, ph, "SH", style = label.style_none, textcolor = colStruct, size = size.small)
    if not na(pl)
        lastL := pl
        crossedL := false
        line.delete(slLine)
        label.delete(slLab)
        slLine := line.new(bar_index - swingLen, pl, bar_index, pl, color = colStruct, extend = extend.right)
        slLab  := label.new(bar_index, pl, "SL", style = label.style_none, textcolor = colStruct, size = size.small)
    if not crossedH and not na(lastH) and close > lastH
        crossedH := true
        swingTrend := 1
        line.delete(shLine)
        label.delete(shLab)
    if not crossedL and not na(lastL) and close < lastL
        crossedL := true
        swingTrend := -1
        line.delete(slLine)
        label.delete(slLab)

// ═══════════════════════════════════════════════════════ ▲ / ▼ swing signals

sigH = ta.pivothigh(high, sigLen, sigLen)
sigL = ta.pivotlow(low, sigLen, sigLen)
plotshape(showSig and not na(sigH), "Swing high signal", shape.triangledown, location.abovebar, color = colBear, size = size.small, offset = -sigLen)
plotshape(showSig and not na(sigL), "Swing low signal", shape.triangleup, location.belowbar, color = colBull, size = size.small, offset = -sigLen)

// ═══════════════════════════════════════════════════════ SMT divergence

compLow  = request.security(smtSym, timeframe.period, low)
compHigh = request.security(smtSym, timeframe.period, high)

var float prevPl     = na
var float prevPlComp = na
var int   prevPlBar  = na
var float prevPh     = na
var float prevPhComp = na
var int   prevPhBar  = na

// most recent divergence, so an ORB setup can ask whether one is still live
var int smtDir = 0
var int smtBar = na

if barstate.isconfirmed and showSMT
    if not na(pl)
        compAt = compLow[swingLen]
        if not na(prevPl) and not na(prevPlComp) and not na(compAt)
            if pl < prevPl and compAt > prevPlComp
                line.new(prevPlBar, prevPl, bar_index - swingLen, pl, color = colBull)
                label.new(bar_index - swingLen, pl, "SMT " + smtSym, style = label.style_label_up, color = color(na), textcolor = colBull, size = size.small)
                smtDir := 1
                smtBar := bar_index
        prevPl := pl
        prevPlComp := compAt
        prevPlBar := bar_index - swingLen
    if not na(ph)
        compAt = compHigh[swingLen]
        if not na(prevPh) and not na(prevPhComp) and not na(compAt)
            if ph > prevPh and compAt < prevPhComp
                line.new(prevPhBar, prevPh, bar_index - swingLen, ph, color = colBear)
                label.new(bar_index - swingLen, ph, "SMT " + smtSym, style = label.style_label_down, color = color(na), textcolor = colBear, size = size.small)
                smtDir := -1
                smtBar := bar_index
        prevPh := ph
        prevPhComp := compAt
        prevPhBar := bar_index - swingLen

bool smtLive = not na(smtBar) and bar_index - smtBar <= smtValid
int  smtNow  = smtLive ? smtDir : 0

// ═══════════════════════════════════════════════════════ HTF / MTF bias

htfCisd = request.security(syminfo.tickerid, htfTf, f_cisd())
mtfCisd = request.security(syminfo.tickerid, mtfTf, f_cisd())
htfOpen = request.security(syminfo.tickerid, htfTf, close >= open ? 1 : -1)
mtfOpen = request.security(syminfo.tickerid, mtfTf, close >= open ? 1 : -1)

// combined: both delivery reads agreeing is what makes a setup "strong"
int    cBias    = htfCisd == 1 and mtfCisd == 1 ? 1 : htfCisd == -1 and mtfCisd == -1 ? -1 : 0
string cBiasTxt = cBias > 0 ? "Strong Long" : cBias < 0 ? "Strong Short" : "Mixed"

f_grade(int dir) =>
    cBias == 0 ? "Mixed" : cBias == dir ? "Strong" : "Counter"

// confirmation accepts a CISD flip in the break's direction, or structure
// already reading that way
f_confirms(int dir) =>
    cisdState == dir or swingTrend == dir

// ═══════════════════════════════════════════════════════ archived range drawings

type Arch
    box   bx
    line  hiL
    line  loL
    line  opL
    label lb

var array<Arch> ARCH = array.new<Arch>()
int histMax = histDays * 4

f_archive(box bx, line hiL, line loL, line opL, label lb) =>
    bool any = not na(bx) or not na(hiL) or not na(loL) or not na(opL) or not na(lb)
    if any and histOn
        ARCH.push(Arch.new(bx = bx, hiL = hiL, loL = loL, opL = opL, lb = lb))
        if ARCH.size() > histMax
            Arch old = ARCH.shift()
            box.delete(old.bx)
            line.delete(old.hiL)
            line.delete(old.loL)
            line.delete(old.opL)
            label.delete(old.lb)
    else if any
        box.delete(bx)
        line.delete(hiL)
        line.delete(loL)
        line.delete(opL)
        label.delete(lb)

// ═══════════════════════════════════════════════════════ session state

type Sess
    string key
    string tag
    color  col
    bool   on
    float  hi     = na
    float  lo     = na
    float  op     = na
    int    t0     = na
    bool   inS    = false
    bool   formed = false
    int    dir    = 0
    bool   early  = false
    bool   broke  = false
    bool   retest = false
    bool   conf   = false
    bool   failed = false
    bool   rearmed = false
    int    failRun = 0
    float  brkLvl = na
    float  swHi   = na
    float  swLo   = na
    bool   live   = false
    int    tDir   = 0
    float  entry  = na
    float  stop   = na
    float  tgt    = na
    box    bx
    line   hiL
    line   loL
    line   opL
    label  tagLbl
    int    nSetup = 0
    int    nWin   = 0
    int    nLoss  = 0
    int    nBull  = 0
    int    nBear  = 0
    int    nFail  = 0

var array<Sess> SESS = array.from(
     Sess.new(key = "GLOBEX", tag = "GLOBEX ORB", col = gbxCol, on = gbxOn),
     Sess.new(key = "LONDON", tag = "LONDON ORB", col = lonCol, on = lonOn),
     Sess.new(key = "NY",     tag = "NY ORB",     col = nyCol,  on = nyOn),
     Sess.new(key = "PM",     tag = "PM RANGE",   col = pmCol,  on = pmOn))

// time() needs a simple-qualified session string, so membership is resolved at
// global scope and handed to the loop by index
var array<bool> IN_NOW = array.new<bool>(4, false)
IN_NOW.set(0, not na(time(timeframe.period, gbxSpec, tzIn)))
IN_NOW.set(1, not na(time(timeframe.period, lonSpec, tzIn)))
IN_NOW.set(2, not na(time(timeframe.period, nySpec, tzIn)))
IN_NOW.set(3, not na(time(timeframe.period, pmSpec, tzIn)))

string activeName = IN_NOW.get(0) ? "Globex" : IN_NOW.get(1) ? "London" : IN_NOW.get(2) ? "New York" : IN_NOW.get(3) ? "PM" : "—"

f_status(Sess s) =>
    not s.formed ? "No Range" : s.failed ? "Failed" : s.conf ? (s.dir > 0 ? "Conf Long" : "Conf Short") : s.retest ? "Retest" : s.broke ? "Confirmed" : s.rearmed ? "Re-armed" : s.early ? "Early Break" : "Waiting"

// ═══════════════════════════════════════════════════════ session engine

for i = 0 to SESS.size() - 1
    Sess s = SESS.get(i)
    if s.on
        bool inNow  = IN_NOW.get(i)
        bool opened = inNow and not s.inS
        bool closed = s.inS and not inNow

        // ── a fresh instance of this range ──
        if opened
            f_archive(s.bx, s.hiL, s.loL, s.opL, s.tagLbl)
            s.bx     := na
            s.hiL    := na
            s.loL    := na
            s.opL    := na
            s.tagLbl := na
            s.hi     := high
            s.lo     := low
            s.op     := open
            s.t0     := time
            s.formed := false
            s.dir    := 0
            s.early  := false
            s.broke  := false
            s.retest := false
            s.conf   := false
            s.failed := false
            s.rearmed := false
            s.failRun := 0
            s.brkLvl := na
            s.swHi   := na
            s.swLo   := na
            if vBox
                s.bx := box.new(time, high, time, low, xloc = xloc.bar_time, border_color = color.new(s.col, 40), bgcolor = color.new(s.col, 88))
            if vLvls
                s.hiL := line.new(time, high, time, high, xloc = xloc.bar_time, color = s.col, style = line.style_solid, width = 1)
                s.loL := line.new(time, low,  time, low,  xloc = xloc.bar_time, color = s.col, style = line.style_solid, width = 1)
            if vOpen
                s.opL := line.new(time, open, time, open, xloc = xloc.bar_time, color = color.new(s.col, 35), style = line.style_dotted, width = 1)
            if vTag
                s.tagLbl := label.new(time, high, s.tag, xloc = xloc.bar_time, style = label.style_label_down, color = color.new(s.col, 20), textcolor = color.white, size = size.tiny)

        // ── accumulate while the window is open ──
        if inNow
            s.hi := na(s.hi) ? high : math.max(s.hi, high)
            s.lo := na(s.lo) ? low  : math.min(s.lo, low)
            if not na(s.bx)
                box.set_top(s.bx, s.hi)
                box.set_bottom(s.bx, s.lo)
                box.set_right(s.bx, time + barMs)
            if not na(s.tagLbl)
                label.set_xy(s.tagLbl, s.t0, s.hi)

        // the range is fixed the moment the window closes
        if closed
            s.formed := true

        // keep the levels running to the right of price
        if not na(s.hi)
            int x2 = time + extMs + barMs
            if not na(s.hiL)
                line.set_xy1(s.hiL, s.t0, s.hi)
                line.set_xy2(s.hiL, x2, s.hi)
            if not na(s.loL)
                line.set_xy1(s.loL, s.t0, s.lo)
                line.set_xy2(s.loL, x2, s.lo)
            if not na(s.opL)
                line.set_xy1(s.opL, s.t0, s.op)
                line.set_xy2(s.opL, x2, s.op)

        // ════════ progression — confirmed bars only, so nothing repaints ════
        if s.formed and not inNow and not na(s.hi) and barstate.isconfirmed
            float rngSz = s.hi - s.lo

            // 1. early break: traded through, has not closed through
            if not s.broke and not s.early
                if high > s.hi
                    s.early := true
                    s.dir   := 1
                    if vEarly
                        label.new(time, low, "EARLY ▲", xloc = xloc.bar_time, style = label.style_label_up, color = color.new(color.gray, 40), textcolor = color.new(color.silver, 10), size = size.tiny, tooltip = s.tag + " probed above " + f_fmt(s.hi) + " without closing outside.")
                if low < s.lo
                    s.early := true
                    s.dir   := -1
                    if vEarly
                        label.new(time, high, "EARLY ▼", xloc = xloc.bar_time, style = label.style_label_down, color = color.new(color.gray, 40), textcolor = color.new(color.silver, 10), size = size.tiny, tooltip = s.tag + " probed below " + f_fmt(s.lo) + " without closing outside.")

            // 2. the break
            if not s.broke
                bool brkUp = reqClose ? close > s.hi : high > s.hi
                bool brkDn = reqClose ? close < s.lo : low  < s.lo
                if brkUp
                    s.broke  := true
                    s.dir    := 1
                    s.brkLvl := s.hi
                    s.swLo   := low
                    s.nBull  := s.nBull + 1
                    if showBrk
                        label.new(time, low, s.tag + " ▲", xloc = xloc.bar_time, style = label.style_label_up, color = color.new(colBull, 20), textcolor = color.white, size = size.tiny, tooltip = "Break above " + f_fmt(s.hi) + "\nRange: " + f_pts(rngSz) + " pts\nBias: " + cBiasTxt + " (" + f_grade(1) + ")")
                    alert(s.tag + " break up through " + f_fmt(s.hi) + " — " + f_grade(1) + " vs " + cBiasTxt, alert.freq_once_per_bar)
                else if brkDn
                    s.broke  := true
                    s.dir    := -1
                    s.brkLvl := s.lo
                    s.swHi   := high
                    s.nBear  := s.nBear + 1
                    if showBrk
                        label.new(time, high, s.tag + " ▼", xloc = xloc.bar_time, style = label.style_label_down, color = color.new(colBear, 20), textcolor = color.white, size = size.tiny, tooltip = "Break below " + f_fmt(s.lo) + "\nRange: " + f_pts(rngSz) + " pts\nBias: " + cBiasTxt + " (" + f_grade(-1) + ")")
                    alert(s.tag + " break down through " + f_fmt(s.lo) + " — " + f_grade(-1) + " vs " + cBiasTxt, alert.freq_once_per_bar)

            // 3. after the break: failure, retest, confirmation
            else if not s.conf and not s.failed
                s.swLo := na(s.swLo) ? low  : math.min(s.swLo, low)
                s.swHi := na(s.swHi) ? high : math.max(s.swHi, high)

                // a one-tick reclaim is noise, not a failure: the close has to
                // get back inside by a slice of the range, and stay there
                float failPad = failBuf * rngSz
                bool  backIn  = s.dir > 0 ? close < s.brkLvl - failPad : close > s.brkLvl + failPad
                s.failRun := backIn ? s.failRun + 1 : 0
                if s.failRun >= failBars
                    s.nFail := s.nFail + 1
                    if showFail
                        label.new(time, s.dir > 0 ? high : low, "ORB REJ", xloc = xloc.bar_time, style = s.dir > 0 ? label.style_label_down : label.style_label_up, color = color.new(colBear, 25), textcolor = color.white, size = size.tiny, tooltip = s.tag + " reclaimed " + f_fmt(s.brkLvl) + " by " + f_pts(failPad) + " pts — breakout failed." + (reArm and not s.rearmed ? "\nNow hunting the opposite edge." : ""))
                    alert(s.tag + " breakout failed at " + f_fmt(s.brkLvl), alert.freq_once_per_bar)
                    if reArm and not s.rearmed
                        // the refused break flips the session onto the other
                        // side of the range rather than ending its day
                        s.rearmed := true
                        s.failed  := false
                        s.broke   := false
                        s.early   := false
                        s.retest  := false
                        s.failRun := 0
                        s.dir     := -s.dir
                        s.brkLvl  := na
                        s.swHi    := na
                        s.swLo    := na
                    else
                        s.failed := true
                else if not na(s.brkLvl)
                    if not s.retest
                        bool rtUp = s.dir > 0 and low  <= s.brkLvl and close > s.brkLvl
                        bool rtDn = s.dir < 0 and high >= s.brkLvl and close < s.brkLvl
                        if rtUp or rtDn
                            s.retest := true
                            if vRetest
                                label.new(time, s.dir > 0 ? low : high, "ORB RETEST", xloc = xloc.bar_time, style = s.dir > 0 ? label.style_label_up : label.style_label_down, color = color.new(s.col, 45), textcolor = color.white, size = size.tiny, tooltip = s.tag + " retested " + f_fmt(s.brkLvl) + " and held.")
                            alert(s.tag + " retest of " + f_fmt(s.brkLvl), alert.freq_once_per_bar)

                    bool okRetest = not reqRetest or s.retest
                    bool okStruct = not reqCisd   or f_confirms(s.dir)
                    bool okSmt    = not reqSmt    or smtNow == s.dir
                    bool okHtf    = not filterHtf or htfCisd == s.dir
                    bool okMtf    = not filterMtf or mtfCisd == s.dir
                    if okRetest and okStruct and okSmt and okHtf and okMtf
                        s.conf   := true
                        s.nSetup := s.nSetup + 1

                        float st = na
                        if stopMode == "Opposite range side"
                            st := s.dir > 0 ? s.lo : s.hi
                        else if stopMode == "Retest swing"
                            st := s.dir > 0 ? s.swLo : s.swHi
                        else
                            st := s.dir > 0 ? close - atrMult * atrVal : close + atrMult * atrVal

                        float risk = math.abs(close - st)
                        if not na(risk) and risk > 0
                            float rMult = winR == "1R" ? 1.0 : winR == "3R" ? 3.0 : 2.0
                            s.live  := true
                            s.tDir  := s.dir
                            s.entry := close
                            s.stop  := st
                            s.tgt   := s.dir > 0 ? close + rMult * risk : close - rMult * risk
                            if showTgts
                                int xr = time + extMs + barMs
                                line.new(time, s.entry, xr, s.entry, xloc = xloc.bar_time, color = color.new(color.gray, 20), style = line.style_dotted)
                                line.new(time, s.stop,  xr, s.stop,  xloc = xloc.bar_time, color = color.new(colBear, 30), style = line.style_dotted)
                                line.new(time, s.tgt,   xr, s.tgt,   xloc = xloc.bar_time, color = color.new(colBull, 30), style = line.style_dotted)

                        if showConf
                            string ctxt = s.dir > 0 ? "CONF LONG" : "CONF SHORT"
                            string ctip = s.tag + "\nEntry " + f_fmt(close) + "\nStop " + f_fmt(st) + "\nTarget " + winR + " " + f_fmt(s.tgt) + "\nBias: " + cBiasTxt + " (" + f_grade(s.dir) + ")\nCISD: " + f_biasWord(cisdState) + "   Swing: " + f_biasWord(swingTrend) + "\nSMT: " + f_biasWord(smtNow) + "\nRange: " + f_pts(rngSz) + " pts"
                            label.new(time, s.dir > 0 ? low : high, ctxt, xloc = xloc.bar_time, style = s.dir > 0 ? label.style_label_up : label.style_label_down, color = s.dir > 0 ? color.new(colBull, 10) : color.new(colBear, 10), textcolor = color.white, size = size.small, tooltip = ctip)
                        alert(s.tag + " " + (s.dir > 0 ? "CONFIRMED LONG" : "CONFIRMED SHORT") + " at " + f_fmt(close) + " — stop " + f_fmt(st) + ", target " + f_fmt(s.tgt) + " (" + f_grade(s.dir) + ")", alert.freq_once_per_bar)

        // ── resolve the virtual trade: stop first when one bar spans both ──
        if s.live and statsOn and not na(s.stop) and not na(s.tgt)
            bool hitStop = s.tDir > 0 ? low <= s.stop : high >= s.stop
            bool hitTgt  = s.tDir > 0 ? high >= s.tgt : low  <= s.tgt
            if hitStop
                s.live  := false
                s.nLoss := s.nLoss + 1
            else if hitTgt
                s.live := false
                s.nWin := s.nWin + 1

        s.inS := inNow

// ═══════════════════════════════════════════════════════ dashboard

dashTextSize = dashSize == "Tiny" ? size.tiny : dashSize == "Small" ? size.small : size.normal
dashPosition = dashPos == "Bottom right" ? position.bottom_right : dashPos == "Top right" ? position.top_right : position.bottom_left

var table dash = table.new(dashPosition, 4, 10, border_width = 1, border_color = color.new(color.black, 40), frame_color = color.new(color.black, 40), frame_width = 1)

if showDash and barstate.islast
    htfName = f_tfTxt(htfTf)
    mtfName = f_tfTxt(mtfTf)
    color hdrBg = #f8f9fb
    color labBg = #4b5563
    color labTx = #f3f4f6

    table.cell(dash, 0, 0, syminfo.ticker + " " + timeframe.period, bgcolor = hdrBg, text_color = #111111, text_size = dashTextSize)
    table.cell(dash, 1, 0, "Deliverance v2", bgcolor = hdrBg, text_color = #111111, text_size = dashTextSize)
    table.cell(dash, 2, 0, "Active", bgcolor = labBg, text_color = labTx, text_size = dashTextSize)
    table.cell(dash, 3, 0, activeName, bgcolor = color.white, text_color = #111111, text_size = dashTextSize)

    table.cell(dash, 0, 1, "Session", bgcolor = labBg, text_color = labTx, text_size = dashTextSize)
    table.cell(dash, 1, 1, "Size",    bgcolor = labBg, text_color = labTx, text_size = dashTextSize)
    table.cell(dash, 2, 1, "Dir",     bgcolor = labBg, text_color = labTx, text_size = dashTextSize)
    table.cell(dash, 3, 1, "Status",  bgcolor = labBg, text_color = labTx, text_size = dashTextSize)

    for i = 0 to SESS.size() - 1
        Sess s = SESS.get(i)
        int r = i + 2
        table.cell(dash, 0, r, s.key, bgcolor = color.new(s.col, s.on ? 55 : 85), text_color = #111111, text_size = dashTextSize)
        table.cell(dash, 1, r, s.on and not na(s.hi) ? f_pts(s.hi - s.lo) : "—", bgcolor = color.white, text_color = #1f2937, text_size = dashTextSize)
        table.cell(dash, 2, r, s.on ? f_biasWord(s.dir) : "off", bgcolor = color.white, text_color = f_biasCol(s.on ? s.dir : 0), text_size = dashTextSize)
        table.cell(dash, 3, r, s.on ? f_status(s) : "—", bgcolor = s.on and s.conf ? color.new(f_biasCol(s.dir), 80) : color.white, text_color = #1f2937, text_size = dashTextSize)

    table.cell(dash, 0, 6, "Swing", bgcolor = labBg, text_color = labTx, text_size = dashTextSize)
    table.cell(dash, 1, 6, f_biasWord(swingTrend), bgcolor = color.white, text_color = f_biasCol(swingTrend), text_size = dashTextSize)
    table.cell(dash, 2, 6, "CISD", bgcolor = labBg, text_color = labTx, text_size = dashTextSize)
    table.cell(dash, 3, 6, f_biasWord(cisdState), bgcolor = color.white, text_color = f_biasCol(cisdState), text_size = dashTextSize)

    table.cell(dash, 0, 7, "CISD Bias", bgcolor = labBg, text_color = labTx, text_size = dashTextSize)
    table.cell(dash, 1, 7, f_biasShort(htfName, htfCisd) + " | " + f_biasShort(mtfName, mtfCisd), bgcolor = #efdcb9, text_color = #1f2937, text_size = dashTextSize)
    table.cell(dash, 2, 7, "Combined", bgcolor = labBg, text_color = labTx, text_size = dashTextSize)
    table.cell(dash, 3, 7, cBiasTxt, bgcolor = #efdcb9, text_color = f_biasCol(cBias), text_size = dashTextSize)

    table.cell(dash, 0, 8, "Open Bias", bgcolor = labBg, text_color = labTx, text_size = dashTextSize)
    table.cell(dash, 1, 8, f_biasShort(htfName, htfOpen) + " | " + f_biasShort(mtfName, mtfOpen), bgcolor = #cde8cf, text_color = #1f2937, text_size = dashTextSize)
    table.cell(dash, 2, 8, "SMT", bgcolor = labBg, text_color = labTx, text_size = dashTextSize)
    table.cell(dash, 3, 8, f_biasWord(smtNow), bgcolor = #cde8cf, text_color = f_biasCol(smtNow), text_size = dashTextSize)

    // the 15-minute window cannot be resolved on a chart coarser than 15m
    if timeframe.in_seconds(timeframe.period) > 900
        table.cell(dash, 0, 9, "⚠", bgcolor = color.new(colBear, 15), text_color = color.white, text_size = dashTextSize)
        table.cell(dash, 1, 9, "Use 5m or 15m", bgcolor = color.new(colBear, 40), text_color = #111111, text_size = dashTextSize)
        table.cell(dash, 2, 9, "range", bgcolor = color.new(colBear, 40), text_color = #111111, text_size = dashTextSize)
        table.cell(dash, 3, 9, "spans >15m", bgcolor = color.new(colBear, 40), text_color = #111111, text_size = dashTextSize)

// ═══════════════════════════════════════════════════════ statistics

var table stat = table.new(f_posOf(statPos), 8, 6, border_width = 1, border_color = color.new(color.black, 40), frame_color = color.new(color.black, 40), frame_width = 1)

if vStats and barstate.islast
    color hdrBg = #f8f9fb
    color labBg = #4b5563
    color labTx = #f3f4f6
    table.cell(stat, 0, 0, "Session", bgcolor = labBg, text_color = labTx, text_size = dashTextSize)
    table.cell(stat, 1, 0, "N",    bgcolor = labBg, text_color = labTx, text_size = dashTextSize)
    table.cell(stat, 2, 0, "W",    bgcolor = labBg, text_color = labTx, text_size = dashTextSize)
    table.cell(stat, 3, 0, "L",    bgcolor = labBg, text_color = labTx, text_size = dashTextSize)
    table.cell(stat, 4, 0, "Win%", bgcolor = labBg, text_color = labTx, text_size = dashTextSize)
    table.cell(stat, 5, 0, "Bull", bgcolor = labBg, text_color = labTx, text_size = dashTextSize)
    table.cell(stat, 6, 0, "Bear", bgcolor = labBg, text_color = labTx, text_size = dashTextSize)
    table.cell(stat, 7, 0, "Fail", bgcolor = labBg, text_color = labTx, text_size = dashTextSize)

    int openTrades = 0
    for i = 0 to SESS.size() - 1
        Sess s = SESS.get(i)
        int   r  = i + 1
        int   dn = s.nWin + s.nLoss
        float wr = dn == 0 ? na : s.nWin * 100.0 / dn
        table.cell(stat, 0, r, s.key, bgcolor = color.new(s.col, s.on ? 55 : 85), text_color = #111111, text_size = dashTextSize)
        table.cell(stat, 1, r, str.tostring(s.nSetup), bgcolor = color.white, text_color = #1f2937, text_size = dashTextSize)
        table.cell(stat, 2, r, str.tostring(s.nWin),   bgcolor = color.white, text_color = colBull, text_size = dashTextSize)
        table.cell(stat, 3, r, str.tostring(s.nLoss),  bgcolor = color.white, text_color = colBear, text_size = dashTextSize)
        table.cell(stat, 4, r, na(wr) ? "—" : str.tostring(wr, "#") + "%", bgcolor = na(wr) ? color.white : color.new(wr >= 50 ? colBull : colBear, 80), text_color = #1f2937, text_size = dashTextSize)
        table.cell(stat, 5, r, str.tostring(s.nBull),  bgcolor = color.white, text_color = #1f2937, text_size = dashTextSize)
        table.cell(stat, 6, r, str.tostring(s.nBear),  bgcolor = color.white, text_color = #1f2937, text_size = dashTextSize)
        table.cell(stat, 7, r, str.tostring(s.nFail),  bgcolor = color.white, text_color = #1f2937, text_size = dashTextSize)
        if s.live
            openTrades := openTrades + 1

    table.cell(stat, 0, 5, "Open", bgcolor = hdrBg, text_color = #111111, text_size = size.tiny)
    table.cell(stat, 1, 5, str.tostring(openTrades), bgcolor = color.white, text_color = #1f2937, text_size = size.tiny)
    table.cell(stat, 2, 5, "unresolved", bgcolor = color.white, text_color = #6b7280, text_size = size.tiny)
    table.cell(stat, 3, 5, "", bgcolor = color.white, text_size = size.tiny)
    table.cell(stat, 4, 5, winR, bgcolor = color.white, text_color = #1f2937, text_size = size.tiny)
    table.cell(stat, 5, 5, "", bgcolor = color.white, text_size = size.tiny)
    table.cell(stat, 6, 5, "", bgcolor = color.white, text_size = size.tiny)
    table.cell(stat, 7, 5, "", bgcolor = color.white, text_size = size.tiny)
