//@version=6
// Jetstream (all-in-one) — free alternative to premium "signal + money-flow
// wave" packs, combined into a SINGLE indicator. Built from public techniques
// (ATR SuperTrend + WaveTrend), fully auditable, $0.
//
// The indicator lives in its own pane (the WaveTrend money-flow waves), while
// the trend trail, EMA ribbon and BUY/SELL signals are pushed onto the price
// chart with `force_overlay = true` — so one "Add to chart" gives you both.
indicator("Jetstream", overlay = false, precision = 2, max_labels_count = 500, max_boxes_count = 500)

// ================================================================ TREND (on price)
grpT   = "Trend"
atrLen = input.int(10, "ATR Length", minval = 1, group = grpT)
mult   = input.float(3.0, "ATR Multiplier", minval = 0.1, step = 0.1, group = grpT)

grpR    = "EMA Ribbon"
showRib = input.bool(true, "Show ribbon", group = grpR)
fastLen = input.int(21, "Fast EMA", minval = 1, group = grpR)
slowLen = input.int(55, "Slow EMA", minval = 1, group = grpR)

grpS     = "Signals"
showSig  = input.bool(true, "Show signals", group = grpS)
sigStyle = input.string("Labels", "Style", options = ["Labels", "Triangles"], group = grpS)
colorBars = input.bool(false, "Colour bars by trend", group = grpS)

teal = color.new(#26a69a, 0)
red  = color.new(#ef5350, 0)

[st, dir] = ta.supertrend(mult, atrLen)
upTrend = dir < 0

plot(upTrend ? st : na, "Up trail",   color = teal, linewidth = 2, style = plot.style_linebr, force_overlay = true)
plot(upTrend ? na : st, "Down trail", color = red,  linewidth = 2, style = plot.style_linebr, force_overlay = true)

fast = ta.ema(close, fastLen)
slow = ta.ema(close, slowLen)
pf = plot(showRib ? fast : na, "Fast EMA", color = color.new(#78c8ff, 30), force_overlay = true)
ps = plot(showRib ? slow : na, "Slow EMA", color = color.new(#ffaa5a, 30), force_overlay = true)
fill(pf, ps, color = fast > slow ? color.new(#26a69a, 88) : color.new(#ef5350, 88), title = "Ribbon")

flip = ta.change(dir)
tBuy  = flip < 0
tSell = flip > 0
labels = sigStyle == "Labels"
plotshape(showSig and tBuy  and labels,      "Buy label",  style = shape.labelup,      location = location.belowbar, color = teal, text = "BUY",  textcolor = color.white, size = size.small, force_overlay = true)
plotshape(showSig and tSell and labels,      "Sell label", style = shape.labeldown,    location = location.abovebar, color = red,  text = "SELL", textcolor = color.white, size = size.small, force_overlay = true)
plotshape(showSig and tBuy  and not labels,  "Buy tri",    style = shape.triangleup,   location = location.belowbar, color = teal, size = size.tiny, force_overlay = true)
plotshape(showSig and tSell and not labels,  "Sell tri",   style = shape.triangledown, location = location.abovebar, color = red,  size = size.tiny, force_overlay = true)

barcolor(colorBars ? (upTrend ? teal : red) : na)

// ================================================================ OSCILLATOR (this pane)
// Two interchangeable bottom-pane styles over one shared WaveTrend core:
//   • Jetstream — nested rainbow waves + candle-body money-flow area
//   • VolMom    — gradient momentum "mountain" over a relative-volume heatmap,
//                 Bull/Bear labels and a dashboard. Adapted (with thanks) from
//                 a user-provided open-source Volume + Momentum WaveTrend study;
//                 rebuilt here from the same public techniques.
grpO     = "Oscillator"
oscStyle = input.string("VolMom", "Oscillator style", options = ["Jetstream", "VolMom"], group = grpO)

grpW   = "WaveTrend"
src    = input.source(hlc3, "Source", group = grpW)
n1     = input.int(10, "Channel Length", minval = 1, group = grpW)
n2     = input.int(21, "Average Length", minval = 1, group = grpW)
sigLen = input.int(4,  "Signal SMA",     minval = 1, group = grpW)

grpL   = "Levels"
ob     = input.int(60,  "Overbought", group = grpL)
os     = input.int(-60, "Oversold",   group = grpL)

grpRB  = "Rainbow (Jetstream)"
layers = input.int(6, "Layers", minval = 1, maxval = 6, group = grpRB)

grpMF  = "Money Flow (Jetstream)"
showMF = input.bool(true, "Show money-flow area", group = grpMF)
mfLen  = input.int(60, "MF Length", minval = 1, group = grpMF)
mfMult = input.float(150.0, "MF Scale", minval = 1, group = grpMF)

grpV   = "Volume (VolMom)"
maLen     = input.int(20, "Volume MA Length", minval = 1, group = grpV)
spikeMult = input.float(2.0, "Spike  (× MA)", minval = 1.0, step = 0.1, group = grpV)
highMult  = input.float(1.3, "High   (× MA)", minval = 1.0, step = 0.1, group = grpV)
lowMult   = input.float(0.5, "Low    (× MA)", minval = 0.0, step = 0.1, group = grpV)
showMom    = input.bool(true, "Momentum mountain", group = grpV)
showRibbon = input.bool(true, "Momentum ribbon", group = grpV)
showVol    = input.bool(true, "Volume heatmap", group = grpV)
showLabels = input.bool(true, "Bull/Bear labels", group = grpV)

grpD   = "Dashboard (VolMom)"
showTable = input.bool(true, "Show dashboard", group = grpD)
tablePos  = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grpD)

isJet = oscStyle == "Jetstream"
isVM  = oscStyle == "VolMom"

// palette
hmLow = #2962ff
hmMid = #26c6da
hmWrm = #ffea00
hmHot = #ff1744
cHi   = #26c6da
cLo   = #5c6f7a
cMute = #9aa7b2

momGrad(float v) =>
    v >= ob * 0.5 ? color.from_gradient(v, ob * 0.5, ob, hmWrm, hmHot) :
     v >= 0       ? color.from_gradient(v, 0, ob * 0.5, hmMid, hmWrm) :
     color.from_gradient(v, os, 0, hmLow, hmMid)

// ---- shared WaveTrend core
esa = ta.ema(src, n1)
de  = ta.ema(math.abs(src - esa), n1)
ci  = de != 0 ? (src - esa) / (0.015 * de) : 0
wt1 = ta.ema(ci, n2)
wt2 = ta.sma(wt1, sigLen)

bullCross = ta.crossover(wt1, wt2)  and wt1 < os
bearCross = ta.crossunder(wt1, wt2) and wt1 > ob

// ---- volume model (VolMom)
volMA   = ta.sma(volume, maLen)
relVol  = volMA > 0 ? volume / volMA : 1.0
pattern = relVol >= spikeMult ? "Volume Spike" : relVol >= highMult ? "High Volume" : relVol <= lowMult ? "Low Volume" : "Normal"
patCol  = relVol >= highMult ? cHi : relVol <= lowMult ? cLo : cMute
volBase = relVol <= 1.0       ? color.from_gradient(relVol, lowMult, 1.0, hmLow, #26a69a) :
          relVol <= spikeMult ? color.from_gradient(relVol, 1.0, spikeMult, hmMid, hmWrm) :
          color.from_gradient(relVol, spikeMult, spikeMult * 2.0, hmWrm, hmHot)
volScaled = math.min(relVol, 5.0) * (ob / 2.0)
volConfirm = relVol >= highMult

// ================================================================ VolMom layer
plot(isVM and showVol ? volScaled : na, "Volume", color = color.new(volBase, 72), style = plot.style_columns)

momCol = momGrad(wt1)
plot(isVM and showMom ? wt1 : na, "Momentum area", color = color.new(momCol, 60), style = plot.style_area)
plot(isVM and showMom ? wt1 : na, "Momentum",      color = momCol, linewidth = 2)
plot(isVM and showMom ? wt2 : na, "Signal",        color = color.new(color.white, 25), linewidth = 1)

vr1 = ta.ema(wt1, 3)
vr2 = ta.ema(wt1, 6)
vr3 = ta.ema(wt1, 9)
plot(isVM and showRibbon ? vr1 : na, "VRibbon 1", color = color.new(momGrad(vr1), 50))
plot(isVM and showRibbon ? vr2 : na, "VRibbon 2", color = color.new(momGrad(vr2), 65))
plot(isVM and showRibbon ? vr3 : na, "VRibbon 3", color = color.new(momGrad(vr3), 80))

if isVM and showLabels and bullCross
    label.new(bar_index, wt1, "Bullish", style = label.style_label_up, color = color.new(#26a69a, 0), textcolor = color.white, size = size.tiny)
if isVM and showLabels and bearCross
    label.new(bar_index, wt1, "Bearish OB", style = label.style_label_down, color = color.new(#ef5350, 0), textcolor = color.white, size = size.tiny)

// ================================================================ Jetstream layer
rng = high - low
mf = ta.sma(rng != 0 ? ((close - open) / rng) * mfMult : 0, mfLen)
plot(isJet and showMF ? mf : na, "Money Flow", color = mf >= 0 ? color.new(#26a69a, 55) : color.new(#ef5350, 55), style = plot.style_area)

j0 = ta.ema(wt1, 3)
j1 = ta.ema(wt1, 7)
j2 = ta.ema(wt1, 11)
j3 = ta.ema(wt1, 15)
j4 = ta.ema(wt1, 19)
j5 = ta.ema(wt1, 23)
plot(isJet and layers >= 1 ? j0 : na, "L1", color = color.new(#8a2be2, 10))
plot(isJet and layers >= 2 ? j1 : na, "L2", color = color.new(#3d7bff, 10))
plot(isJet and layers >= 3 ? j2 : na, "L3", color = color.new(#00d4c8, 10))
plot(isJet and layers >= 4 ? j3 : na, "L4", color = color.new(#46d000, 10))
plot(isJet and layers >= 5 ? j4 : na, "L5", color = color.new(#ffd000, 10))
plot(isJet and layers >= 6 ? j5 : na, "L6", color = color.new(#ff3b30, 10))

p1 = plot(isJet ? wt1 : na, "WT1", color = color.new(color.white, 10), linewidth = 2)
p2 = plot(isJet ? wt2 : na, "WT2", color = color.new(#7890ff, 5), linewidth = 1)
fill(p1, p2, color = wt1 > wt2 ? color.new(#26a69a, 82) : color.new(#ef5350, 82), title = "Wave band")
plotshape(isJet and bullCross, "Wave buy",  style = shape.circle, location = location.bottom, color = teal, size = size.tiny)
plotshape(isJet and bearCross, "Wave sell", style = shape.circle, location = location.top,    color = red,  size = size.tiny)

// ---- shared levels
hline(ob, "Overbought", color = color.new(#ef5350, 55), linestyle = hline.style_dashed)
hline(0,  "Zero",       color = color.new(color.gray, 70))
hline(os, "Oversold",   color = color.new(#26a69a, 55), linestyle = hline.style_dashed)

// ================================================================ dashboard (VolMom)
momState = wt1 >= ob ? "OVERBOUGHT" : wt1 <= os ? "OVERSOLD" : wt1 >= 0 ? "Bull zone" : "Bear zone"
momStCol = wt1 >= ob ? red : wt1 <= os ? teal : color.new(cMute, 0)
combo  = bullCross ? (volConfirm ? "STRONG BUY" : "Bullish") : bearCross ? (volConfirm ? "STRONG SELL" : "Bearish") : wt1 >= ob ? "Overbought" : wt1 <= os ? "Oversold" : (wt1 >= 0 ? "Bull bias" : "Bear bias")
comboCol = str.contains(combo, "BUY") or combo == "Bullish" or combo == "Oversold" ? teal : str.contains(combo, "SELL") or combo == "Bearish" or combo == "Overbought" ? red : color.new(#fdd835, 0)

f_pos() =>
    tablePos == "Top Right" ? position.top_right : tablePos == "Top Left" ? position.top_left : tablePos == "Bottom Left" ? position.bottom_left : position.bottom_right

var table dash = table.new(f_pos(), 2, 5, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 40))
f_row(int r, string lab, string val, color valCol) =>
    table.cell(dash, 0, r, lab, text_color = color.new(cMute, 0), text_size = size.tiny, text_halign = text.align_left,  bgcolor = color.new(#0c1116, 0))
    table.cell(dash, 1, r, val, text_color = valCol,              text_size = size.tiny, text_halign = text.align_right, bgcolor = color.new(#0c1116, 0))

if isVM and showTable and barstate.islast
    table.cell(dash, 0, 0, "SIGNAL", text_color = color.white, text_size = size.tiny, text_halign = text.align_left,  bgcolor = color.new(#1b2630, 0))
    table.cell(dash, 1, 0, combo,    text_color = comboCol,     text_size = size.tiny, text_halign = text.align_right, bgcolor = color.new(#1b2630, 0))
    f_row(1, "Momentum", str.tostring(wt1, "#.#"), color.new(momCol, 0))
    f_row(2, "Mom State", momState, momStCol)
    f_row(3, "Rel Vol", str.tostring(relVol, "#.##") + "×", color.new(patCol, 0))
    f_row(4, "Volume", pattern, color.new(patCol, 0))

// ================================================================ TREND SCANNER (dashboard)
// A small toggleable table reading four independent trend methods at once, so
// you can see which way each is pointing plus an overall consensus.
gTS       = "Trend Scanner"
showTrend = input.bool(true, "Show trend scanner", group = gTS)
trendPos  = input.string("Top Left", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = gTS)

// scanner 1 — ATR SuperTrend (reuses the on-chart trail)
s1Up = upTrend
// scanner 2 — EMA ribbon (fast vs slow)
s2Up = fast > slow
// scanner 3 — WaveTrend momentum (bull/bear zone)
s3Up = wt1 >= 0
// scanner 4 — MACD (12/26/9)
[macdLine, macdSig, _macdHist] = ta.macd(close, 12, 26, 9)
s4Up = macdLine > macdSig

bullVotes = (s1Up ? 1 : 0) + (s2Up ? 1 : 0) + (s3Up ? 1 : 0) + (s4Up ? 1 : 0)
consensus = bullVotes == 4 ? "STRONG UP" : bullVotes == 3 ? "UP" : bullVotes == 2 ? "MIXED" : bullVotes == 1 ? "DOWN" : "STRONG DOWN"
consCol   = bullVotes >= 3 ? teal : bullVotes == 2 ? color.new(#fdd835, 0) : red

f_dir(bool up) => up ? "▲ UP" : "▼ DN"
f_dcol(bool up) => up ? teal : red
f_tpos() =>
    trendPos == "Top Right" ? position.top_right : trendPos == "Top Left" ? position.top_left : trendPos == "Bottom Left" ? position.bottom_left : position.bottom_right
f_trow(table t, int r, string lab, bool up) =>
    table.cell(t, 0, r, lab, text_color = color.new(cMute, 0), text_size = size.tiny, text_halign = text.align_left,  bgcolor = color.new(#0c1116, 0))
    table.cell(t, 1, r, f_dir(up), text_color = f_dcol(up),    text_size = size.tiny, text_halign = text.align_right, bgcolor = color.new(#0c1116, 0))

var table tdash = table.new(f_tpos(), 2, 6, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 40))
if showTrend and barstate.islast
    table.cell(tdash, 0, 0, "TREND SCAN", text_color = color.white, text_size = size.tiny, text_halign = text.align_left,  bgcolor = color.new(#1b2630, 0))
    table.cell(tdash, 1, 0, consensus,    text_color = consCol,     text_size = size.tiny, text_halign = text.align_right, bgcolor = color.new(#1b2630, 0))
    f_trow(tdash, 1, "SuperTrend", s1Up)
    f_trow(tdash, 2, "EMA Ribbon", s2Up)
    f_trow(tdash, 3, "Momentum",   s3Up)
    f_trow(tdash, 4, "MACD",       s4Up)
    table.cell(tdash, 0, 5, "Score", text_color = color.new(cMute, 0), text_size = size.tiny, text_halign = text.align_left,  bgcolor = color.new(#0c1116, 0))
    table.cell(tdash, 1, 5, str.tostring(bullVotes) + "/4 up", text_color = consCol, text_size = size.tiny, text_halign = text.align_right, bgcolor = color.new(#0c1116, 0))

// ================================================================ alerts
alertcondition(tBuy,  "Jetstream Buy",  "Jetstream flipped LONG on {{ticker}} {{interval}}")
alertcondition(tSell, "Jetstream Sell", "Jetstream flipped SHORT on {{ticker}} {{interval}}")
alertcondition(tBuy or tSell, "Jetstream Signal", "Jetstream trend flipped on {{ticker}} {{interval}}")
alertcondition(tBuy and wt1 > wt2,  "Jetstream Confluence Long",  "Jetstream LONG with wave agreement on {{ticker}} {{interval}}")
alertcondition(tSell and wt1 < wt2, "Jetstream Confluence Short", "Jetstream SHORT with wave agreement on {{ticker}} {{interval}}")
alertcondition(bullCross and volConfirm, "Strong Buy",  "Momentum bull cross confirmed by high volume on {{ticker}} {{interval}}")
alertcondition(bearCross and volConfirm, "Strong Sell", "Momentum bear cross confirmed by high volume on {{ticker}} {{interval}}")

// ================================================================ SUPPLY / DEMAND ZONES (on price)
// Optional overlay layer drawn on the price chart (force_overlay) and gated by
// one master toggle. Adapted, with thanks, from a user-provided open-source
// "Supply Demand Zones PRO" study; integrated here as a switchable layer.
gZ = "Supply/Demand Zones"
showZones = input.bool(true, "Show Supply/Demand Zones", group = gZ)
swingLen = input.int(12, "Swing Length (Sensitivity)", minval = 3, maxval = 50, group = gZ)
maxZones = input.int(10, "Max Zones to Display", minval = 3, maxval = 30, group = gZ)
maxZoneHeightATR = input.float(1.0, "Max Zone Height (ATR ×)", minval = 0.5, maxval = 10.0, step = 0.5, group = gZ)
minZoneHeightATR = input.float(1.0, "Min Zone Height (ATR ×)", minval = 0.1, maxval = 2.0, step = 0.1, group = gZ)
forceZoneHeightATR = input.float(1.0, "Force Zone Height (ATR ×)", minval = 0.2, maxval = 3.0, step = 0.1, group = gZ)
minZoneDistance = input.int(44, "Min Distance Between Zones (bars)", minval = 1, maxval = 100, group = gZ)
invalidationMethod = input.string("Close", "Zone Invalidation", options = ["Close", "Wick"], group = gZ)
showHistoric = input.bool(true, "Show Historic Zones", group = gZ)
activeLookback = input.int(1000, "Active Zones Lookback", minval = 100, maxval = 5000, group = gZ)
historicBars = input.int(1000, "Historic Zones Lookback", minval = 100, maxval = 5000, group = gZ)
showActiveLabels = input.bool(true, "Show Active Zone Info", group = gZ)
showHistoricLabels = input.bool(false, "Show Historic Zone Info", group = gZ)
zLabelSize = input.string("Normal", "Zone Label Size", options = ["Tiny", "Small", "Normal", "Large"], group = gZ)
activeSupplyCol = input.color(color.new(color.red, 80), "Active Supply", group = gZ)
activeDemandCol = input.color(color.new(color.green, 80), "Active Demand", group = gZ)
historicCol = input.color(color.new(color.gray, 85), "Historic Zones", group = gZ)
showRetestMarkers = input.bool(true, "Show Retests", group = gZ)
retestBullCol = input.color(color.new(color.green, 0), "Demand Retest", group = gZ)
retestBearCol = input.color(color.new(color.red, 0), "Supply Retest", group = gZ)
zoneAlertsOn = input.bool(true, "Enable Zone Alerts", group = gZ)

f_getPips() =>
    syminfo.type == "forex" ? (syminfo.currency == "JPY" ? 0.01 : 0.0001) : (syminfo.ticker == "XAUUSD" or syminfo.ticker == "GOLD") ? 0.1 : 0.0001
f_toPips(val) =>
    math.abs(val) / f_getPips()
f_getSession() =>
    h = hour(time, syminfo.timezone)
    h >= 0 and h < 9 ? "Asian" : h >= 8 and h < 13 ? "London" : h >= 13 and h < 22 ? "New York" : "Other"
f_getZLabelSize() =>
    zLabelSize == "Tiny" ? size.tiny : zLabelSize == "Small" ? size.small : zLabelSize == "Normal" ? size.normal : size.large
f_calcStrength(retests, age) =>
    s = 8.0 - (retests * 0.8) - math.min(age / 500.0, 2.0)
    int(math.max(0, math.min(10, s)))
f_getLabelColor(zoneType, broken) =>
    broken ? color.new(color.gray, 0) : zoneType == "Supply" ? color.new(color.red, 0) : color.new(color.green, 0)

zatr = ta.atr(20)

type ZoneData
    box zoneBox
    label infoLabel
    label retestLabel
    float top
    float bottom
    int startBar
    string session
    int retests
    bool broken
    string zoneType
    bool retestCounted

var array<ZoneData> allZones = array.new<ZoneData>()
var int lastSupplyBar = 0
var int lastDemandBar = 0

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

if showZones and not na(ph) and barstate.isconfirmed
    sess = f_getSession()
    if sess != "Other"
        top = high[swingLen]
        bot = low[swingLen]
        startBar = bar_index - swingLen
        if bar_index - lastSupplyBar >= minZoneDistance
            mid = (top + bot) / 2
            zoneHeight = top - bot
            if zoneHeight < zatr * forceZoneHeightATR
                forcedHeight = zatr * forceZoneHeightATR
                top := mid + (forcedHeight / 2)
                bot := mid - (forcedHeight / 2)
                zoneHeight := forcedHeight
            if zoneHeight > zatr * maxZoneHeightATR
                maxHeight = zatr * maxZoneHeightATR
                top := mid + (maxHeight / 2)
                bot := mid - (maxHeight / 2)
                zoneHeight := maxHeight
            if zoneHeight >= zatr * minZoneHeightATR
                mergedWithExisting = false
                if array.size(allZones) > 0
                    for i = array.size(allZones) - 1 to math.max(0, array.size(allZones) - 10)
                        z = array.get(allZones, i)
                        if z.zoneType == "Supply" and not z.broken
                            if (top >= z.bottom and bot <= z.top)
                                newTop = math.max(top, z.top)
                                newBot = math.min(bot, z.bottom)
                                z.top := newTop
                                z.bottom := newBot
                                box.set_top(z.zoneBox, newTop)
                                box.set_bottom(z.zoneBox, newBot)
                                mergedWithExisting := true
                                break
                if not mergedWithExisting
                    zoneBox = box.new(startBar, top, bar_index + 400, bot, bgcolor = activeSupplyCol, border_width = 0, force_overlay = true)
                    zoneData = ZoneData.new(zoneBox, na, na, top, bot, startBar, sess, 0, false, "Supply", false)
                    array.push(allZones, zoneData)
                    lastSupplyBar := bar_index
                    if array.size(allZones) > maxZones * 4
                        array.shift(allZones)

if showZones and not na(pl) and barstate.isconfirmed
    sess = f_getSession()
    if sess != "Other"
        top = high[swingLen]
        bot = low[swingLen]
        startBar = bar_index - swingLen
        if bar_index - lastDemandBar >= minZoneDistance
            mid = (top + bot) / 2
            zoneHeight = top - bot
            if zoneHeight < zatr * forceZoneHeightATR
                forcedHeight = zatr * forceZoneHeightATR
                top := mid + (forcedHeight / 2)
                bot := mid - (forcedHeight / 2)
                zoneHeight := forcedHeight
            if zoneHeight > zatr * maxZoneHeightATR
                maxHeight = zatr * maxZoneHeightATR
                top := mid + (maxHeight / 2)
                bot := mid - (maxHeight / 2)
                zoneHeight := maxHeight
            if zoneHeight >= zatr * minZoneHeightATR
                mergedWithExisting = false
                if array.size(allZones) > 0
                    for i = array.size(allZones) - 1 to math.max(0, array.size(allZones) - 10)
                        z = array.get(allZones, i)
                        if z.zoneType == "Demand" and not z.broken
                            if (top >= z.bottom and bot <= z.top)
                                newTop = math.max(top, z.top)
                                newBot = math.min(bot, z.bottom)
                                z.top := newTop
                                z.bottom := newBot
                                box.set_top(z.zoneBox, newTop)
                                box.set_bottom(z.zoneBox, newBot)
                                mergedWithExisting := true
                                break
                if not mergedWithExisting
                    zoneBox = box.new(startBar, top, bar_index + 400, bot, bgcolor = activeDemandCol, border_width = 0, force_overlay = true)
                    zoneData = ZoneData.new(zoneBox, na, na, top, bot, startBar, sess, 0, false, "Demand", false)
                    array.push(allZones, zoneData)
                    lastDemandBar := bar_index
                    if array.size(allZones) > maxZones * 4
                        array.shift(allZones)

if showZones and array.size(allZones) > 0
    activeSupplyCount = 0
    activeDemandCount = 0
    historicSupplyCount = 0
    historicDemandCount = 0
    for i = 0 to array.size(allZones) - 1
        z = array.get(allZones, i)
        box.set_right(z.zoneBox, bar_index + 400)
        if not z.broken
            priceInZone = high >= z.bottom and low <= z.top
            if priceInZone and not z.retestCounted
                z.retests += 1
                z.retestCounted := true
            else if not priceInZone
                z.retestCounted := false
        if not z.broken
            if z.zoneType == "Supply"
                breakLevel = invalidationMethod == "Close" ? close : high
                if breakLevel > z.top
                    z.broken := true
                    box.set_bgcolor(z.zoneBox, historicCol)
            else
                breakLevel = invalidationMethod == "Close" ? close : low
                if breakLevel < z.bottom
                    z.broken := true
                    box.set_bgcolor(z.zoneBox, historicCol)
        age = bar_index - z.startBar
        zoneHeight = z.top - z.bottom
        shouldHide = false
        if z.broken and not showHistoric
            shouldHide := true
        if z.broken and age > historicBars
            shouldHide := true
        if not z.broken and age > activeLookback
            shouldHide := true
        if z.broken and showHistoric
            if zoneHeight < zatr * minZoneHeightATR
                shouldHide := true
            if z.zoneType == "Supply"
                if historicSupplyCount >= maxZones
                    shouldHide := true
                else if not shouldHide
                    historicSupplyCount += 1
            else
                if historicDemandCount >= maxZones
                    shouldHide := true
                else if not shouldHide
                    historicDemandCount += 1
        if not z.broken and not shouldHide
            if z.zoneType == "Supply"
                if activeSupplyCount >= maxZones
                    shouldHide := true
                else
                    activeSupplyCount += 1
            else
                if activeDemandCount >= maxZones
                    shouldHide := true
                else
                    activeDemandCount += 1
        if shouldHide
            box.set_bgcolor(z.zoneBox, color.new(color.gray, 100))
            box.set_border_color(z.zoneBox, color.new(color.gray, 100))
            if not na(z.infoLabel)
                label.set_color(z.infoLabel, color.new(color.black, 100))
                label.set_textcolor(z.infoLabel, color.new(color.white, 100))
            if not na(z.retestLabel)
                label.set_color(z.retestLabel, color.new(color.white, 100))
                label.set_textcolor(z.retestLabel, color.new(color.white, 100))
        else
            if z.broken
                box.set_bgcolor(z.zoneBox, historicCol)
            else
                zoneCol = z.zoneType == "Supply" ? activeSupplyCol : activeDemandCol
                box.set_bgcolor(z.zoneBox, zoneCol)
            showThisLabel = z.broken ? showHistoricLabels : showActiveLabels
            if showThisLabel
                heightPips = f_toPips(z.top - z.bottom)
                distPips = z.zoneType == "Supply" ? f_toPips(z.bottom - close) : f_toPips(close - z.top)
                strength = f_calcStrength(z.retests, age)
                txt = str.format("{0,number,#} pips || {1} || Strength {2}/10 || {3} || {4} bars || {5,number,#} pips away", heightPips, z.zoneType, strength, z.session, age, math.abs(distPips))
                mid = (z.top + z.bottom) / 2
                lblColor = f_getLabelColor(z.zoneType, z.broken)
                if na(z.infoLabel)
                    z.infoLabel := label.new(z.startBar + 10, mid, txt, color = color.new(color.black, 100), textcolor = lblColor, size = f_getZLabelSize(), style = label.style_label_left, force_overlay = true)
                else
                    label.set_text(z.infoLabel, txt)
                    label.set_y(z.infoLabel, mid)
                    label.set_color(z.infoLabel, color.new(color.black, 100))
                    label.set_textcolor(z.infoLabel, lblColor)
                    label.set_size(z.infoLabel, f_getZLabelSize())
                    label.set_style(z.infoLabel, label.style_label_left)
                    label.set_x(z.infoLabel, z.startBar + 10)
            else
                if not na(z.infoLabel)
                    label.set_color(z.infoLabel, color.new(color.black, 100))
                    label.set_textcolor(z.infoLabel, color.new(color.white, 100))
            if showRetestMarkers and z.retests > 0
                if na(z.retestLabel)
                    if z.zoneType == "Supply"
                        z.retestLabel := label.new(z.startBar + 3, z.top, "R", color = retestBearCol, textcolor = color.white, size = size.small, style = label.style_label_down, force_overlay = true)
                    else
                        z.retestLabel := label.new(z.startBar + 3, z.bottom, "R", color = retestBullCol, textcolor = color.white, size = size.small, style = label.style_label_up, force_overlay = true)
                else
                    retestCol = z.zoneType == "Supply" ? retestBearCol : retestBullCol
                    label.set_color(z.retestLabel, retestCol)
                    label.set_textcolor(z.retestLabel, color.white)
            else
                if not na(z.retestLabel)
                    label.set_color(z.retestLabel, color.new(color.white, 100))
                    label.set_textcolor(z.retestLabel, color.new(color.white, 100))

alertcondition(showZones and zoneAlertsOn and not na(ph) and barstate.isconfirmed, "New Supply Zone", "{{ticker}} - New Supply Zone @ {{close}}")
alertcondition(showZones and zoneAlertsOn and not na(pl) and barstate.isconfirmed, "New Demand Zone", "{{ticker}} - New Demand Zone @ {{close}}")
