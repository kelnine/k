// Combined SMC Suite — three overlays merged into one indicator, each with its own toggle.
//
//   1. Order Block Detector          © LuxAlgo   (CC BY-NC-SA 4.0)
//                                    https://creativecommons.org/licenses/by-nc-sa/4.0/
//   2. Smart Money Breakout Channels © AlgoAlpha (MPL 2.0)
//                                    https://mozilla.org/MPL/2.0/
//   3. 200 EMA Filtered Parabolic SAR — reconstructed from its settings panel
//      (inputs / style / signal shapes), since only screenshots were available.
//
// Original licenses above continue to apply to their respective sections.

//@version=6
indicator("Combined SMC Suite [OB + Breakout Channels + PSAR]", "Combined SMC Suite"
  , overlay           = true
  , max_boxes_count   = 500
  , max_labels_count  = 500
  , max_lines_count   = 500)

import TradingView/ta/10

//-----------------------------------------------------------------------------}
//Module master switches
//-----------------------------------------------------------------------------{
G_MOD  = "═══ Modules ═══"
G_OB   = "Order Block Detector [LuxAlgo]"
G_BC   = "Smart Money Breakout Channels [AlgoAlpha]"
G_PS   = "200 EMA Filtered Parabolic SAR"

obEnable = input.bool(true, "Order Block Detector"          , group = G_MOD)
bcEnable = input.bool(true, "Smart Money Breakout Channels"  , group = G_MOD)
psEnable = input.bool(true, "200 EMA Filtered Parabolic SAR" , group = G_MOD)

//=============================================================================}
// 1. ORDER BLOCK DETECTOR [LuxAlgo]
//=============================================================================={
//-----------------------------------------------------------------------------
//Settings
//-----------------------------------------------------------------------------
obLength = input.int(5, 'Volume Pivot Length'
  , minval = 1
  , group  = G_OB)

obBullExtLast = input.int(3, 'Bullish OB '
  , minval = 1
  , inline = 'bull'
  , group  = G_OB)

obBgBullCss = input.color(color.new(#169400, 80), ''
  , inline = 'bull'
  , group  = G_OB)

obBullCss = input.color(#169400, ''
  , inline = 'bull'
  , group  = G_OB)

obBullAvgCss = input.color(color.new(#9598a1, 37), ''
  , inline = 'bull'
  , group  = G_OB)

obBearExtLast = input.int(3, 'Bearish OB'
  , minval = 1
  , inline = 'bear'
  , group  = G_OB)

obBgBearCss = input.color(color.new(#ff1100, 80), ''
  , inline = 'bear'
  , group  = G_OB)

obBearCss = input.color(#ff1100, ''
  , inline = 'bear'
  , group  = G_OB)

obBearAvgCss = input.color(color.new(#9598a1, 37), ''
  , inline = 'bear'
  , group  = G_OB)

obLineStyleIn = input.string('⎯⎯⎯', 'Average Line Style'
  , options = ['⎯⎯⎯', '----', '····']
  , group   = G_OB)

obLineWidth = input.int(1, 'Average Line Width'
  , minval = 1
  , group  = G_OB)

obMitigation = input.string('Wick', 'Mitigation Methods'
  , options = ['Wick', 'Close']
  , group   = G_OB)

//-----------------------------------------------------------------------------
//Functions
//-----------------------------------------------------------------------------
//Line style
obGetLineStyle(style) =>
    switch style
        '⎯⎯⎯'  => line.style_solid
        '----' => line.style_dashed
        '····' => line.style_dotted
        =>        line.style_solid

//Collect order block coordinates
obGetCoordinates(condition, top, btm, obVal) =>
    var obTop  = array.new_float(0)
    var obBtm  = array.new_float(0)
    var obAvg  = array.new_float(0)
    var obLeft = array.new_int(0)

    float ob = na

    if condition
        avg = math.avg(top, btm)

        array.unshift(obTop , top)
        array.unshift(obBtm , btm)
        array.unshift(obAvg , avg)
        array.unshift(obLeft, time[obLength])

        ob := obVal

    [obTop, obBtm, obAvg, obLeft, ob]

//Drop mitigated order blocks from the coordinate arrays.
//Iterates back-to-front so removals never shift indices that are still pending
//(the original forward `for … in` loop mutated the array it was walking).
obRemoveMitigated(obTop, obBtm, obLeft, obAvg, target, bull) =>
    mitigated   = false
    targetArray = bull ? obBtm : obTop

    if array.size(targetArray) > 0
        for i = array.size(targetArray) - 1 to 0
            element = array.get(targetArray, i)

            if (bull ? target < element : target > element)
                mitigated := true

                array.remove(obTop , i)
                array.remove(obBtm , i)
                array.remove(obAvg , i)
                array.remove(obLeft, i)

    mitigated

//Draw the most recent order blocks
obSetBlocks(show, obTop, obBtm, obLeft, obAvg, extLast, bgCss, borderCss, lvlCss) =>
    var obBox = array.new_box(0)
    var obLvl = array.new_line(0)

    //Pre-allocate the drawing objects
    if barstate.isfirst and show
        for i = 0 to extLast - 1
            array.unshift(obBox, box.new(na, na, na, na
              , xloc         = xloc.bar_time
              , extend       = extend.right
              , bgcolor      = bgCss
              , border_color = color.new(borderCss, 70)))

            array.unshift(obLvl, line.new(na, na, na, na
              , xloc   = xloc.bar_time
              , extend = extend.right
              , color  = lvlCss
              , style  = obGetLineStyle(obLineStyleIn)
              , width  = obLineWidth))

    if barstate.islast and show
        if array.size(obTop) > 0
            for i = 0 to math.min(extLast - 1, array.size(obTop) - 1)
                getBox = array.get(obBox, i)
                getLvl = array.get(obLvl, i)

                box.set_lefttop(getBox    , array.get(obLeft, i), array.get(obTop, i))
                box.set_rightbottom(getBox, array.get(obLeft, i), array.get(obBtm, i))

                line.set_xy1(getLvl, array.get(obLeft, i)    , array.get(obAvg, i))
                line.set_xy2(getLvl, array.get(obLeft, i) + 1, array.get(obAvg, i))

//-----------------------------------------------------------------------------
//Global elements
//-----------------------------------------------------------------------------
var obOs         = 0
var obTargetBull = 0.
var obTargetBear = 0.

obUpper = ta.highest(obLength)
obLower = ta.lowest(obLength)

if obMitigation == 'Close'
    obTargetBull := ta.lowest(close, obLength)
    obTargetBear := ta.highest(close, obLength)
else
    obTargetBull := obLower
    obTargetBear := obUpper

obOs := high[obLength] > obUpper ? 0 : low[obLength] < obLower ? 1 : obOs[1]

obPhv = ta.pivothigh(volume, obLength, obLength)

//-----------------------------------------------------------------------------
//Bullish / bearish order block coordinates
//-----------------------------------------------------------------------------
[obBullTop
  , obBullBtm
  , obBullAvg
  , obBullLeft
  , obBullOb] = obGetCoordinates(obEnable and obPhv and obOs == 1, hl2[obLength], low[obLength], low[obLength])

[obBearTop
  , obBearBtm
  , obBearAvg
  , obBearLeft
  , obBearOb] = obGetCoordinates(obEnable and obPhv and obOs == 0, high[obLength], hl2[obLength], high[obLength])

//-----------------------------------------------------------------------------
//Remove mitigated order blocks
//-----------------------------------------------------------------------------
obMitigatedBull = obRemoveMitigated(obBullTop, obBullBtm, obBullLeft, obBullAvg, obTargetBull, true)
obMitigatedBear = obRemoveMitigated(obBearTop, obBearBtm, obBearLeft, obBearAvg, obTargetBear, false)

//-----------------------------------------------------------------------------
//Display order blocks
//-----------------------------------------------------------------------------
obSetBlocks(obEnable, obBullTop, obBullBtm, obBullLeft, obBullAvg, obBullExtLast, obBgBullCss, obBullCss, obBullAvgCss)
obSetBlocks(obEnable, obBearTop, obBearBtm, obBearLeft, obBearAvg, obBearExtLast, obBgBearCss, obBearCss, obBearAvgCss)

//=============================================================================}
// 2. SMART MONEY BREAKOUT CHANNELS [AlgoAlpha]
//=============================================================================={
//-----------------------------------------------------------------------------
//Settings
//-----------------------------------------------------------------------------
bcOverlap = input.bool(false, "Nested Channels"
  , group   = G_BC
  , tooltip = "When enabled, allows multiple channels to overlap. When disabled, only one channel can exist at a time.")

bcStrong = input.bool(true, "Strong Closes Only"
  , tooltip = "When enabled, breakouts only trigger when more than 50% of the candle body is outside the channel."
  , group   = G_BC)

bcNormLength = input.int(100, title = "Normalization Length"
  , minval  = 1
  , group   = G_BC
  , tooltip = "Bars used to calculate the highest high / lowest low for price normalization.")

bcBoxLength = input.int(14, "Box Detection Length"
  , minval  = 1
  , group   = G_BC
  , tooltip = "Bars used to detect channel formation patterns.")

bcShwVol = input.bool(true, "Show Volume Analysis"
  , tooltip = "Displays volume analysis as candle-like bars within the channel."
  , group   = G_BC)

bcVolMode = input.string("Comparison", "Volume Display Mode"
  , options = ["Volume", "Comparison", "Delta"]
  , group   = G_BC
  , tooltip = "Volume: total volume as symmetrical bars. Comparison: up volume above midline, down volume below. Delta: net volume delta.")

bcTf = input.timeframe("1", "Volume Delta Timeframe Source"
  , group   = G_BC
  , tooltip = "The timeframe used to calculate volume delta data.")

bcVolScale = input.float(0.5, "Volume Scale"
  , minval = 0.1, maxval = 2.0, step = 0.1
  , group   = G_BC
  , tooltip = "Adjusts the height of volume bars relative to channel size.")

bcTextSizeIn = input.string("Tiny", "Volume Text Size"
  , options = ["Tiny", "Small", "Medium", "Large"]
  , group   = G_BC
  , tooltip = "Size of the volume text at the corner of the channels.")

bcGreen = input.color(#00ffbb, title = "Bullish Colour"
  , group   = G_BC
  , tooltip = "Primary colour for bullish visual elements.")

bcRed = input.color(#ff1100, title = "Bearish Colour"
  , group   = G_BC
  , tooltip = "Primary colour for bearish visual elements.")

//-----------------------------------------------------------------------------
//Variables
//-----------------------------------------------------------------------------
var bcBoxes   = array.new_box()
var bcBoxesU  = array.new_box()
var bcBoxesL  = array.new_box()

var line[] bcGaugeLines  = array.new<line>()
var label  bcGaugeLabel  = na
var line[] bcCenterLines = array.new<line>()

//-----------------------------------------------------------------------------
//Functions
//-----------------------------------------------------------------------------
bcTextSize(sz) =>
    switch sz
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Medium" => size.normal
        "Large"  => size.large
        =>          size.tiny

bcCanCreate(float tNew, float bNew) =>
    ok = true
    if bcBoxes.size() > 0
        for j = 0 to bcBoxes.size() - 1
            if (tNew > bcBoxes.get(j).get_bottom()) and (bNew < bcBoxes.get(j).get_top())
                ok := false
                break
    ok

bcVolTransparency(float v, float smoothedVol) =>
    if bcVolMode == "Volume"
        float volRatio     = v / smoothedVol
        float transparency = math.max(20, math.min(80, 80 - (volRatio - 0.5) * 40))
        transparency
    else
        0

//-----------------------------------------------------------------------------
//Calculations
//-----------------------------------------------------------------------------
bcLowestLow       = ta.lowest(low, bcNormLength)
bcHighestHigh     = ta.highest(high, bcNormLength)
bcNormalizedPrice = (close - bcLowestLow) / (bcHighestHigh - bcLowestLow)
bcVol             = ta.stdev(bcNormalizedPrice, 14)

bcUpper = (ta.highestbars(bcVol, bcBoxLength + 1) + bcBoxLength) / bcBoxLength
bcLower = (ta.lowestbars(bcVol, bcBoxLength + 1) + bcBoxLength) / bcBoxLength

bcUpbreak   = 0.0
bcDownbreak = 0.0

bcDuration = math.max(nz(ta.barssince(ta.crossover(bcLower, bcUpper))), 1)
bcH = ta.highest(bcDuration)
bcL = ta.lowest(bcDuration)

//request.*() must stay unconditional, so this is evaluated even when the module is off
[bcUv, bcDv, bcVold] = ta.requestUpAndDownVolume(bcTf)

var bcHvold = bcVold
var bcLvold = bcVold

if ta.crossover(bcLower, bcUpper)
    bcHvold := bcVold
    bcLvold := bcVold

if bcVold > bcHvold
    bcHvold := bcVold

if bcVold < bcLvold
    bcLvold := bcVold

bcSmoothedVol = ta.sma(volume, 20)
bcVola        = ta.atr(bcBoxLength) / 2

bool bcNewChannelFormed = false
bool bcBullishBreakout  = false
bool bcBearishBreakout  = false

if bcEnable and ta.crossover(bcUpper, bcLower) and bcDuration > 10
    if bcOverlap or bcCanCreate(bcH, bcL)
        bcBoxes.unshift(box.new(bar_index - bcDuration, bcH, bar_index, bcL, bgcolor = color.new(chart.fg_color, 90), border_color = na))
        bcBoxesU.unshift(box.new(bar_index - bcDuration, bcH, bar_index, bcH - bcVola, bgcolor = color.new(bcRed, 70), border_color = na))
        bcBoxesL.unshift(box.new(bar_index - bcDuration, bcL + bcVola, bar_index, bcL, bgcolor = color.new(bcGreen, 70), border_color = na))

        float centerY = (bcH + bcL) / 2
        bcCenterLines.unshift(line.new(bar_index - bcDuration, centerY, bar_index, centerY, color = color.new(chart.fg_color, 50), width = 1, style = line.style_dashed))
        bcNewChannelFormed := true

//Walked back-to-front so a removal never invalidates an index the loop still has to
//visit (the original forward loop could run past the end of the shrinking array).
if bcBoxes.size() > 0
    for i = bcBoxes.size() - 1 to 0
        if ((bcStrong ? math.avg(close, open) : close) > bcBoxes.get(i).get_top())
            bcUpbreak := bcBoxes.get(i).get_bottom()
            bcBoxes.remove(i)
            bcBoxesU.remove(i)
            bcBoxesL.remove(i)
            bcCenterLines.remove(i)
            bcBullishBreakout := true

        else if ((bcStrong ? math.avg(close, open) : close) < bcBoxes.get(i).get_bottom())
            bcDownbreak := bcBoxes.get(i).get_top()
            bcBoxes.remove(i)
            bcBoxesU.remove(i)
            bcBoxesL.remove(i)
            bcCenterLines.remove(i)
            bcBearishBreakout := true

        else
            bcBoxes.get(i).set_right(bar_index)
            bcBoxesU.get(i).set_right(bar_index)
            bcBoxesL.get(i).set_right(bar_index)
            bcCenterLines.get(i).set_x2(bar_index)

            //Volume text goes on whichever side price is not currently sitting in
            float boxMidline   = (bcBoxes.get(i).get_top() + bcBoxes.get(i).get_bottom()) / 2
            float currentPrice = bcStrong ? math.avg(close, open) : close

            string volText = ""
            if bcVolMode == "Volume"
                volText := str.tostring(math.round(volume / 1000, 1)) + "K"
            else if bcVolMode == "Comparison"
                volText := str.tostring(math.round(bcUv / 1000, 1)) + "K/" + str.tostring(math.round(bcDv / 1000, 1)) + "K"
            else if bcVolMode == "Delta"
                volText := str.tostring(math.round(bcVold / 1000, 1)) + "K"

            if currentPrice > boxMidline
                bcBoxesL.get(i).set_text(volText)
                bcBoxesL.get(i).set_text_halign(text.align_right)
                bcBoxesL.get(i).set_text_color(color.new(chart.fg_color, 30))
                bcBoxesL.get(i).set_text_size(bcTextSize(bcTextSizeIn))
                bcBoxesU.get(i).set_text("")
            else
                bcBoxesU.get(i).set_text(volText)
                bcBoxesU.get(i).set_text_halign(text.align_right)
                bcBoxesU.get(i).set_text_color(color.new(chart.fg_color, 30))
                bcBoxesU.get(i).set_text_size(bcTextSize(bcTextSizeIn))
                bcBoxesL.get(i).set_text("")

float bcCurrentMidline = na
float bcChannelHeight  = na

if bcBoxes.size() > 0
    float topBound    = bcBoxes.get(0).get_top()
    float bottomBound = bcBoxes.get(0).get_bottom()
    bcCurrentMidline := (topBound + bottomBound) / 2
    bcChannelHeight  := (topBound - bottomBound) * bcVolScale

float bcVolUpperOpen  = na
float bcVolUpperHigh  = na
float bcVolUpperLow   = na
float bcVolUpperClose = na

float bcVolLowerOpen  = na
float bcVolLowerHigh  = na
float bcVolLowerLow   = na
float bcVolLowerClose = na

if bcEnable and not na(bcCurrentMidline) and not na(bcChannelHeight) and bcShwVol
    if bcVolMode == "Volume"
        float volHeight = (volume / bcSmoothedVol) * (bcChannelHeight / 4)
        bcVolUpperOpen  := bcCurrentMidline
        bcVolUpperClose := bcCurrentMidline + volHeight
        bcVolUpperHigh  := bcCurrentMidline + volHeight
        bcVolUpperLow   := bcCurrentMidline

        bcVolLowerOpen  := bcCurrentMidline
        bcVolLowerClose := bcCurrentMidline - volHeight
        bcVolLowerHigh  := bcCurrentMidline
        bcVolLowerLow   := bcCurrentMidline - volHeight

    else if bcVolMode == "Comparison"
        float uvHeight = na(bcUv) ? 0 : (bcUv / bcSmoothedVol) * (bcChannelHeight / 4)
        float dvHeight = na(bcDv) ? 0 : (bcDv / bcSmoothedVol) * (bcChannelHeight / 4)

        bcVolUpperOpen  := bcCurrentMidline
        bcVolUpperClose := bcCurrentMidline + uvHeight
        bcVolUpperHigh  := bcCurrentMidline + uvHeight
        bcVolUpperLow   := bcCurrentMidline

        bcVolLowerOpen  := bcCurrentMidline
        bcVolLowerClose := bcCurrentMidline + dvHeight
        bcVolLowerHigh  := bcCurrentMidline
        bcVolLowerLow   := bcCurrentMidline + dvHeight

    else if bcVolMode == "Delta"
        float deltaHeight = na(bcVold) ? 0 : math.abs(bcVold / bcSmoothedVol) * (bcChannelHeight / 4)

        if bcVold >= 0
            bcVolUpperOpen  := bcCurrentMidline
            bcVolUpperClose := bcCurrentMidline + deltaHeight
            bcVolUpperHigh  := bcCurrentMidline + deltaHeight
            bcVolUpperLow   := bcCurrentMidline

            bcVolLowerOpen  := bcCurrentMidline
            bcVolLowerClose := bcCurrentMidline
            bcVolLowerHigh  := bcCurrentMidline
            bcVolLowerLow   := bcCurrentMidline
        else
            bcVolUpperOpen  := bcCurrentMidline
            bcVolUpperClose := bcCurrentMidline
            bcVolUpperHigh  := bcCurrentMidline
            bcVolUpperLow   := bcCurrentMidline

            bcVolLowerOpen  := bcCurrentMidline
            bcVolLowerClose := bcCurrentMidline - deltaHeight
            bcVolLowerHigh  := bcCurrentMidline
            bcVolLowerLow   := bcCurrentMidline - deltaHeight

color bcUpperColor = na
color bcLowerColor = na

if bcVolMode == "Volume"
    float transparency = bcVolTransparency(volume, bcSmoothedVol)
    bcUpperColor := color.new(chart.fg_color, transparency)
    bcLowerColor := color.new(chart.fg_color, transparency)
else
    bcUpperColor := bcGreen
    bcLowerColor := bcRed

//=============================================================================}
// 3. 200 EMA FILTERED PARABOLIC SAR
//=============================================================================={
//-----------------------------------------------------------------------------
//Settings
//-----------------------------------------------------------------------------
psShow21 = input.bool(false, "Show the 21 EMA?"
  , group = G_PS)

psMaFastLength = input.int(7  , "MaFastLength", minval = 1, group = G_PS)
psMaMedLength  = input.int(21 , "MaMedLength" , minval = 1, group = G_PS)
psMaSlowLength = input.int(200, "MaSlowLength", minval = 1, group = G_PS)

psStart     = input.float(0.02, "PSARstart", step = 0.01 , group = G_PS)
psIncrement = input.float(0.02, "Increment", step = 0.01 , group = G_PS)
psMaximum   = input.float(0.2 , "Maximum"  , step = 0.05 , group = G_PS)

psAdxSmoothing = input.int(14, "ADX Smoothing", minval = 1, group = G_PS)
psDiLength     = input.int(14, "DI Length"    , minval = 1, group = G_PS)
psThreshold    = input.int(20, "Threshold"    , minval = 0, group = G_PS
  , tooltip = "Minimum ADX required for a signal. Set to 0 to disable the trend-strength filter.")

psShowBg = input.bool(true, "Plots Background"
  , group   = G_PS
  , tooltip = "Shades the background by the 200 EMA trend regime.")

psBullBg = input.color(color.new(#169400, 90), "Color 0", inline = 'psbg', group = G_PS)
psBearBg = input.color(color.new(#ff1100, 90), "Color 1", inline = 'psbg', group = G_PS)

psLongCss  = input.color(#169400, "Long / Short"     , inline = 'pssig', group = G_PS)
psShortCss = input.color(#ff1100, ""                 , inline = 'pssig', group = G_PS)
psExitCss  = input.color(color.white, "Exit"         , inline = 'pssig', group = G_PS)

//-----------------------------------------------------------------------------
//Calculations
//-----------------------------------------------------------------------------
psFast = ta.ema(close, psMaFastLength)
psMed  = ta.ema(close, psMaMedLength)
psSlow = ta.ema(close, psMaSlowLength)
psSar  = ta.sar(psStart, psIncrement, psMaximum)

[psDiPlus, psDiMinus, psAdx] = ta.dmi(psDiLength, psAdxSmoothing)

psSarBull = psSar < close
psSarBear = psSar > close

psFlipUp = psSarBull and not psSarBull[1]
psFlipDn = psSarBear and not psSarBear[1]

psTrendUp = close > psSlow
psTrendDn = close < psSlow
psStrongT = psAdx > psThreshold

var bool psInLong  = false
var bool psInShort = false

//Exits are read from the state carried in from the previous bar, before it is updated
psExitLong  = psInLong  and psFlipDn
psExitShort = psInShort and psFlipUp

if psExitLong
    psInLong := false
if psExitShort
    psInShort := false

//200 EMA trend filter + ADX strength filter on the SAR flip
psLong  = psFlipUp and psTrendUp and psStrongT and not psInLong
psShort = psFlipDn and psTrendDn and psStrongT and not psInShort

if psLong
    psInLong  := true
    psInShort := false
if psShort
    psInShort := true
    psInLong  := false

//=============================================================================}
// VISUALS
//=============================================================================={
//--- Order blocks (hidden reference plots, kept for alerts / external scripts)
plot(obEnable ? obBullOb : na, 'Bull OB', obBullCss, 2, plot.style_linebr
  , offset  = -obLength
  , display = display.none)

plot(obEnable ? obBearOb : na, 'Bear OB', obBearCss, 2, plot.style_linebr
  , offset  = -obLength
  , display = display.none)

//--- Breakout channels
plotshape(bcEnable and bcUpbreak   != 0 ? bcUpbreak   : na, "Bullish Breakout Signal", shape.labelup  , location.absolute, bcGreen, text = "▲", textcolor = chart.fg_color)
plotshape(bcEnable and bcDownbreak != 0 ? bcDownbreak : na, "Bearish Breakout Signal", shape.labeldown, location.absolute, bcRed  , text = "▼", textcolor = chart.fg_color)

plotcandle(bcVolUpperOpen, bcVolUpperHigh, bcVolUpperLow, bcVolUpperClose, "Volume Up"  , color = bcUpperColor, wickcolor = bcUpperColor, bordercolor = bcUpperColor)
plotcandle(bcVolLowerOpen, bcVolLowerHigh, bcVolLowerLow, bcVolLowerClose, "Volume Down", color = bcLowerColor, wickcolor = bcLowerColor, bordercolor = bcLowerColor)

bcVolumeAvailable = not na(volume)

if bcEnable and barstate.islast
    bool channelActive = bcBoxes.size() > 0 and bcUpbreak == 0 and bcDownbreak == 0

    if array.size(bcGaugeLines) > 0
        for ln in bcGaugeLines
            ln.delete()
        bcGaugeLines.clear()

    if not na(bcGaugeLabel)
        bcGaugeLabel.delete()
        bcGaugeLabel := na

    if channelActive
        float topBound    = bcBoxes.get(0).get_top()
        float bottomBound = bcBoxes.get(0).get_bottom()

        if not na(topBound) and not na(bottomBound) and topBound != bottomBound
            int   segments = 21
            float segLen   = (topBound - bottomBound) / segments

            for i = 0 to segments - 1
                float y1 = topBound - i * segLen
                float y2 = topBound - (i + 1) * segLen
                color segCol = color.from_gradient(y1, bottomBound, topBound, bcRed, bcGreen)
                line ln = line.new(x1 = bar_index + 2, y1 = y1, x2 = bar_index + 2, y2 = y2, color = segCol, width = 4)
                bcGaugeLines.unshift(ln)

            float delvol = -100 * 2 * ((bcVold - bcLvold) / (bcHvold - bcLvold) - 0.5)
            delvol := math.max(math.min(delvol, 100), -100)
            float pointerPos = topBound - ((delvol + 100) / 200) * (topBound - bottomBound)
            bcGaugeLabel := label.new(x = bar_index + 3, y = pointerPos, text = "◀", color = na, textcolor = chart.fg_color, size = size.small, style = label.style_label_left)

if bcEnable and not bcVolumeAvailable
    var bcGaugeWarnTable = table.new(position = position.top_right, columns = 1, rows = 1, bgcolor = bcRed, border_width = 1, border_color = chart.fg_color, frame_color = chart.fg_color, frame_width = 1)
    table.cell(bcGaugeWarnTable, 0, 0, "Volume not available\nGauge may not work as expected", text_color = chart.fg_color, text_halign = text.align_center, text_size = size.small)

//--- 200 EMA filtered Parabolic SAR
plotshape(psEnable and psLong      ? low  : na, "Parabolic SAR long" , shape.labelup  , location.belowbar, psLongCss , text = "Long" , textcolor = color.white, size = size.tiny)
plotshape(psEnable and psShort     ? high : na, "Parabolic SAR short", shape.labeldown, location.abovebar, psShortCss, text = "Short", textcolor = color.white, size = size.tiny)
plotshape(psEnable and psExitLong  ? high : na, "Exit long"          , shape.triangledown, location.abovebar, psExitCss, text = "EL", textcolor = chart.fg_color, size = size.tiny)
plotshape(psEnable and psExitShort ? low  : na, "Exit short"         , shape.triangleup  , location.belowbar, psExitCss, text = "ES", textcolor = chart.fg_color, size = size.tiny)

plot(psEnable ? psFast : na, "Fast MA", color.new(color.gray, 40), 1)
plot(psEnable and psShow21 ? psMed : na, "Med MA (21)", color.new(color.olive, 0), 1)
plot(psEnable ? psSlow : na, "Slow MA (200)", psShortCss, 2)
plot(psEnable ? psSar  : na, "Parabolic SAR", color.new(chart.fg_color, 30), 1, plot.style_cross)

bgcolor(psEnable and psShowBg ? (psTrendUp ? psBullBg : psTrendDn ? psBearBg : na) : na, title = "Plots Background")

//=============================================================================}
// ALERTS
//=============================================================================={
//Order blocks — v6 no longer casts float to bool implicitly, so the OB price
//series are tested for na explicitly
obBullFormed = not na(obBullOb)
obBearFormed = not na(obBearOb)

alertcondition(obBullFormed    , 'Bullish OB Formed'   , 'Bullish order block detected')
alertcondition(obBearFormed    , 'Bearish OB Formed'   , 'Bearish order block detected')
alertcondition(obMitigatedBull , 'Bullish OB Mitigated', 'Bullish order block mitigated')
alertcondition(obMitigatedBear , 'Bearish OB Mitigated', 'Bearish order block mitigated')

//Breakout channels
alertcondition(bcNewChannelFormed, "New Channel Formation", "A new breakout channel has been formed")
alertcondition(bcBullishBreakout , "Bullish Breakout"     , "Price has broken out above the channel (bullish signal)")
alertcondition(bcBearishBreakout , "Bearish Breakout"     , "Price has broken out below the channel (bearish signal)")

//Parabolic SAR
alertcondition(psLong      , "PSAR Long"      , "200 EMA filtered Parabolic SAR long signal")
alertcondition(psShort     , "PSAR Short"     , "200 EMA filtered Parabolic SAR short signal")
alertcondition(psExitLong  , "PSAR Exit Long" , "200 EMA filtered Parabolic SAR exit long")
alertcondition(psExitShort , "PSAR Exit Short", "200 EMA filtered Parabolic SAR exit short")

//Confluence
alertcondition(psLong  and bcBullishBreakout, "Confluence Long" , "PSAR long + bullish channel breakout")
alertcondition(psShort and bcBearishBreakout, "Confluence Short", "PSAR short + bearish channel breakout")
//=============================================================================}
