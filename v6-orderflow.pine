//@version=6
// =============================================================================
// V6 OrderFlow — DeepDom-inspired tools from price/volume only.
//
//   TradingView's Pine has NO access to order-book / MBO data, so the real
//   DeepDom "Iceberg Detector" and live liquidity heatmap are impossible here.
//   These are the closest PRICE-ACTION PROXIES:
//     - Stop runs   = liquidity sweeps (wick beyond a swing, close back inside)
//     - Absorption  = high-volume + small-range bars -> order-block zones
//     - Volume Profile (lookback) with POC + value-area high/low
//   Add as an overlay. Pair it with the V6 oscillator/strategy.
// =============================================================================
indicator("V6 OrderFlow", shorttitle="V6 OF", overlay=true, max_boxes_count=300, max_lines_count=300, max_labels_count=300)

cyan   = #18e3e3
magenta= #ec3ad6
orange = #ffa03c
gold   = #ffcd46

// ---- inputs -----------------------------------------------------------------
swLen    = input.int(10,  "Stop-run swing lookback", minval=2, group="Stop runs")
swMinAtr = input.float(0.15,"Min sweep size × ATR", minval=0, step=0.05, group="Stop runs")
cdBars   = input.int(6,   "Cooldown bars (declutter)", minval=0, group="Stop runs")
showStop = input.bool(true,"Show stop runs", group="Stop runs")
stopLbl  = input.bool(false,"Use text labels (else arrows)", group="Stop runs")

absMult  = input.float(1.8,"Absorption volume × avg", minval=1, step=0.1, group="Absorption / order blocks")
absRange = input.float(0.6,"Max body vs range (small bar)", minval=0.1, maxval=1, step=0.05, group="Absorption / order blocks")
volLen   = input.int(20,  "Volume average length", minval=1, group="Absorption / order blocks")
showAbs  = input.bool(true,"Show absorption blocks", group="Absorption / order blocks")
keepAbs  = input.int(5,   "Max blocks kept", minval=1, group="Absorption / order blocks")
absExt   = input.int(6,   "Block extend (bars)", minval=0, group="Absorption / order blocks")

showVP   = input.bool(true,"Show volume profile", group="Volume profile")
vpLook   = input.int(150, "Profile lookback bars", minval=20, group="Volume profile")
vpRows   = input.int(24,  "Profile rows", minval=8, maxval=50, group="Volume profile")
vpWidth  = input.int(30,  "Profile width (bars)", minval=5, group="Volume profile")

// ---- stop runs (liquidity sweeps) -------------------------------------------
atr14     = ta.atr(14)
priorHigh = ta.highest(high, swLen)[1]
priorLow  = ta.lowest(low,  swLen)[1]
sweepHigh = high > priorHigh + atr14 * swMinAtr and close < priorHigh   // ran buy stops, rejected
sweepLow  = low  < priorLow  - atr14 * swMinAtr and close > priorLow     // ran sell stops, rejected

var int lastHi = -1000
var int lastLo = -1000
fireHi = showStop and sweepHigh and (bar_index - lastHi > cdBars)
fireLo = showStop and sweepLow  and (bar_index - lastLo > cdBars)
if fireHi
    lastHi := bar_index
    if stopLbl
        label.new(bar_index, high, "stop run", style=label.style_label_down, color=color.new(magenta, 20), textcolor=color.white, size=size.tiny)
if fireLo
    lastLo := bar_index
    if stopLbl
        label.new(bar_index, low, "stop run", style=label.style_label_up, color=color.new(cyan, 20), textcolor=color.black, size=size.tiny)
plotshape(fireHi and not stopLbl, "Stop run high", shape.triangledown, location.abovebar, color=magenta, size=size.tiny)
plotshape(fireLo and not stopLbl, "Stop run low",  shape.triangleup,   location.belowbar, color=cyan,    size=size.tiny)

// ---- absorption / order blocks ----------------------------------------------
// big volume but the bar barely moved -> aggressive orders were absorbed by
// resting liquidity. Mark a compact zone; newest few are kept so it stays clean.
avgVol   = ta.sma(volume, volLen)
rng      = high - low
body     = math.abs(close - open)
absorbed = volume > avgVol * absMult and rng > 0 and (body / rng) < absRange

var box[] blocks = array.new<box>()
if showAbs and absorbed
    c = close >= open ? color.new(cyan, 80) : color.new(magenta, 80)
    b = box.new(bar_index - 1, high, bar_index + absExt, low, border_color=color.new(orange, 25), border_width=1, bgcolor=c)
    array.push(blocks, b)
    if array.size(blocks) > keepAbs
        box.delete(array.shift(blocks))

// ---- volume profile (lookback) ----------------------------------------------
// Drawings are tracked and deleted before each redraw. (The old version leaked
// boxes every tick until Pine's drawing cap wiped the whole indicator.)
var box[]  vpBoxes = array.new<box>()
var line   pocLine = na
var label  pocLab  = na

if showVP and barstate.islast
    if array.size(vpBoxes) > 0
        for i = 0 to array.size(vpBoxes) - 1
            box.delete(array.get(vpBoxes, i))
        array.clear(vpBoxes)
    line.delete(pocLine)
    label.delete(pocLab)

    float hi = ta.highest(high, vpLook)
    float lo = ta.lowest(low,  vpLook)
    float step = (hi - lo) / vpRows
    if step > 0
        float[] buckets = array.new<float>(vpRows, 0.0)
        // spread each bar's volume across the rows its range covers
        for i = 0 to vpLook - 1
            int rLo = math.min(vpRows - 1, math.max(0, int((low[i]  - lo) / step)))
            int rHi = math.min(vpRows - 1, math.max(0, int((high[i] - lo) / step)))
            float share = volume[i] / (rHi - rLo + 1)
            for r = rLo to rHi
                array.set(buckets, r, array.get(buckets, r) + share)
        float maxV = array.max(buckets)
        int   poc  = array.indexof(buckets, maxV)
        for r = 0 to vpRows - 1
            float v = array.get(buckets, r)
            int w = maxV > 0 ? math.max(1, int(v / maxV * vpWidth)) : 1
            float yT = lo + (r + 1) * step
            float yB = lo + r * step
            col = r == poc ? color.new(gold, 20) : color.new(#18e3e3, 72)
            array.push(vpBoxes, box.new(bar_index - w, yT, bar_index + 1, yB, border_width=0, bgcolor=col))
        float pocY = lo + (poc + 0.5) * step
        pocLine := line.new(bar_index - vpLook, pocY, bar_index + 1, pocY, color=gold, style=line.style_dashed, width=1)
        pocLab  := label.new(bar_index + 2, pocY, "POC", style=label.style_label_left, color=color.new(gold, 80), textcolor=gold, size=size.small)

// ---- alerts -----------------------------------------------------------------
alertcondition(sweepHigh, "Stop run high", "Stop run (buy-side sweep) on {{ticker}} {{interval}}")
alertcondition(sweepLow,  "Stop run low",  "Stop run (sell-side sweep) on {{ticker}} {{interval}}")
alertcondition(absorbed,  "Absorption",    "Absorption / order block on {{ticker}} {{interval}}")
