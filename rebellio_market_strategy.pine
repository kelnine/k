//@version=6
// Rebellio Market - Auto Strategy
// Encodes @RebellioMarket trading system | Day Trade (VWAP) or Swing (4H EMA+RSI)
// Day mode: 1m-5m chart | Swing mode: 4H chart | Strategy Tester tab for backtest

strategy("Rebellio Market - Auto Strategy",
     overlay                 = true,
     initial_capital         = 1000,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     pyramiding              = 0,
     calc_on_every_tick      = false,
     process_orders_on_close = true,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.0)

// ============================================================
// INPUTS
// ============================================================
string mode     = input.string("Day Trade (VWAP)", "Mode",
                     options = ["Day Trade (VWAP)", "Swing (4H EMA+RSI)"], group = "Mode")
bool allowShort = input.bool(true, "Allow Shorts", group = "Mode")

float riskPct   = input.float(2.0, "Risk per Trade (%)",    minval = 0.1, step = 0.1, group = "Risk")
float rrTarget  = input.float(2.0, "Reward/Risk multiple",  minval = 1.0, step = 0.5, group = "Risk")
int   maxTrades = input.int  (3,   "Max Trades/Day",        minval = 1,               group = "Risk")
float dailyLoss = input.float(4.0, "Daily Loss Limit (%)",  minval = 0.5, step = 0.5, group = "Risk")

int emaFast   = input.int(9,   "EMA Fast",     group = "Indicators")
int emaMid    = input.int(20,  "EMA Mid",      group = "Indicators")
int emaSlow   = input.int(200, "EMA Slow",     group = "Indicators")
int rsiLen    = input.int(14,  "RSI Length",   group = "Indicators")
int rsiThresh = input.int(50,  "RSI Threshold",group = "Indicators")
int volLen    = input.int(20,  "Volume MA",    group = "Indicators")

bool   useIdxFilter = input.bool  (false,      "SPY Uptrend Filter", group = "Filters")
string idxSym       = input.symbol("AMEX:SPY", "Index Symbol",       group = "Filters")

bool showInd    = input.bool(true, "Show Indicators",    group = "Visuals")
bool showLabels = input.bool(true, "Show Labels",        group = "Visuals")
bool showTable  = input.bool(true, "Show Stats Table",   group = "Visuals")

// ============================================================
// INDICATORS
// ============================================================
float ema9   = ta.ema(close, emaFast)
float ema20  = ta.ema(close, emaMid)
float ema200 = ta.ema(close, emaSlow)
float myRsi  = ta.rsi(close, rsiLen)
float volAvg = ta.sma(volume, volLen)
bool  volExp = volume > volAvg
float myVwap = ta.vwap
bool  vwapOk = not na(myVwap)

bool isDayMode   = mode == "Day Trade (VWAP)"
bool isSwingMode = mode == "Swing (4H EMA+RSI)"

float idxClose = request.security(symbol = idxSym, timeframe = timeframe.period, expression = close)
float idxEma   = request.security(symbol = idxSym, timeframe = timeframe.period, expression = ta.ema(close, emaMid))
bool  idxOk    = not useIdxFilter or (not na(idxClose) and not na(idxEma) and idxClose > idxEma)
bool  idxOkS   = not useIdxFilter or (not na(idxClose) and not na(idxEma) and idxClose < idxEma)

// ============================================================
// CANDLE PATTERNS
// ============================================================
float bodyHi    = math.max(open, close)
float bodyLo    = math.min(open, close)
float bodySize  = bodyHi - bodyLo
float rng       = high - low

bool bullEngulf = close > open and close[1] < open[1] and close > open[1] and open <= close[1]
bool bearEngulf = close < open and close[1] > open[1] and close < open[1] and open >= close[1]
bool hammer     = rng > 0 and (bodyLo - low)  > bodySize * 1.5 and close > open
bool shootStar  = rng > 0 and (high - bodyHi) > bodySize * 1.5 and close < open
bool bullReject = bullEngulf or hammer
bool bearReject = bearEngulf or shootStar

// ============================================================
// SIGNALS
// ============================================================
bool dayLong  = isDayMode and vwapOk and close > myVwap and ema9 > ema20 and volExp and idxOk
bool dayShort = isDayMode and vwapOk and allowShort and close < myVwap and ema9 < ema20 and volExp and idxOkS

bool pbLong   = low  <= ema20 * 1.005 and close > ema20
bool pbShort  = high >= ema20 * 0.995 and close < ema20
bool swingLong  = isSwingMode and close > ema200 and pbLong  and bullReject and myRsi > rsiThresh           and idxOk
bool swingShort = isSwingMode and allowShort and close < ema200 and pbShort and bearReject and myRsi < (100 - rsiThresh) and idxOkS

bool goLong  = dayLong  or swingLong
bool goShort = dayShort or swingShort

// ============================================================
// STOPS, TARGETS & SIZING
// ============================================================
float sLow  = ta.lowest (low,  5)
float sHigh = ta.highest(high, 5)

float longStop  = isDayMode ? math.min(myVwap, sLow)  : sLow
float shortStop = isDayMode ? math.max(myVwap, sHigh) : sHigh
float longRisk  = close - longStop
float shortRisk = shortStop - close
float longTP    = close + longRisk  * rrTarget
float shortTP   = close - shortRisk * rrTarget

float riskCash = strategy.equity * (riskPct / 100.0)
float longQty  = longRisk  > 0 ? riskCash / longRisk  : 0.0
float shortQty = shortRisk > 0 ? riskCash / shortRisk : 0.0

// ============================================================
// DAILY GUARDRAILS
// ============================================================
var int   tradesToday = 0
var float dayStartEq  = strategy.equity

if na(time("D")[1]) or time("D") != time("D")[1]
    tradesToday := 0
    dayStartEq  := strategy.equity

float dayPnLPct = dayStartEq > 0 ? (strategy.equity - dayStartEq) / dayStartEq * 100.0 : 0.0
bool  canTrade  = (not isDayMode or tradesToday < maxTrades) and
                  (not isDayMode or dayPnLPct > -dailyLoss)

// ============================================================
// EXECUTE
// ============================================================
var label longLbl  = na
var label shortLbl = na

if goLong and longRisk > 0 and canTrade and strategy.position_size == 0
    strategy.entry(id = "Long",  direction = strategy.long,  qty = longQty)
    strategy.exit (id = "LX",    from_entry = "Long",  stop = longStop,  limit = longTP)
    tradesToday += 1
    if showLabels
        longLbl := label.new(bar_index, low,
             "LONG\nSL " + str.tostring(longStop,  format.mintick) +
             "\nTP "     + str.tostring(longTP,    format.mintick),
             style = label.style_label_up, color = color.new(color.green, 20),
             textcolor = color.white, size = size.small)

if goShort and shortRisk > 0 and canTrade and strategy.position_size == 0
    strategy.entry(id = "Short", direction = strategy.short, qty = shortQty)
    strategy.exit (id = "SX",    from_entry = "Short", stop = shortStop, limit = shortTP)
    tradesToday += 1
    if showLabels
        shortLbl := label.new(bar_index, high,
             "SHORT\nSL " + str.tostring(shortStop, format.mintick) +
             "\nTP "      + str.tostring(shortTP,   format.mintick),
             style = label.style_label_down, color = color.new(color.red, 20),
             textcolor = color.white, size = size.small)

// ============================================================
// PLOTS
// ============================================================
plot(showInd and isDayMode   ? myVwap : na, "VWAP",    color.orange,  linewidth = 2)
plot(showInd                 ? ema9   : na, "EMA 9",   color.aqua)
plot(showInd                 ? ema20  : na, "EMA 20",  color.yellow)
plot(showInd and isSwingMode ? ema200 : na, "EMA 200", color.fuchsia, linewidth = 2)

plotshape(goLong  and canTrade, "Buy",  shape.triangleup,   location.belowbar, color.green, size = size.tiny)
plotshape(goShort and canTrade, "Sell", shape.triangledown, location.abovebar, color.red,   size = size.tiny)

// ============================================================
// ALERTS  (Alert -> "alert() function calls only" -> webhook URL)
// ============================================================
if goLong and longRisk > 0 and canTrade and strategy.position_size == 0
    alert('{"action":"buy","symbol":"'  + syminfo.ticker + '","qty":' + str.tostring(longQty,  "#.##") +
          ',"stop":'  + str.tostring(longStop,  format.mintick) +
          ',"target":' + str.tostring(longTP,   format.mintick) + '}', alert.freq_once_per_bar_close)

if goShort and shortRisk > 0 and canTrade and strategy.position_size == 0
    alert('{"action":"sell","symbol":"' + syminfo.ticker + '","qty":' + str.tostring(shortQty, "#.##") +
          ',"stop":'  + str.tostring(shortStop, format.mintick) +
          ',"target":' + str.tostring(shortTP,  format.mintick) + '}', alert.freq_once_per_bar_close)

// ============================================================
// STATS TABLE
// ============================================================
var table tbl = table.new(position.top_right, 2, 7, border_width = 1)

if showTable and barstate.islast
    float wr = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100.0 : 0.0

    table.cell(table_id = tbl, column = 0, row = 0, text = "REBELLIO",       bgcolor = color.navy, text_color = color.white,  text_size = size.normal)
    table.cell(table_id = tbl, column = 1, row = 0, text = isDayMode ? "DAY" : "SWING", bgcolor = color.navy, text_color = color.yellow, text_size = size.normal)
    table.cell(table_id = tbl, column = 0, row = 1, text = "Equity",         text_size = size.small)
    table.cell(table_id = tbl, column = 1, row = 1, text = "$" + str.tostring(strategy.equity,    "#.##"), text_size = size.small)
    table.cell(table_id = tbl, column = 0, row = 2, text = "Net P&L",        text_size = size.small)
    table.cell(table_id = tbl, column = 1, row = 2, text = "$" + str.tostring(strategy.netprofit, "#.##"),
               text_color = strategy.netprofit >= 0 ? color.green : color.red, text_size = size.small)
    table.cell(table_id = tbl, column = 0, row = 3, text = "Win Rate",       text_size = size.small)
    table.cell(table_id = tbl, column = 1, row = 3, text = str.tostring(wr,  "#.#") + "%", text_size = size.small)
    table.cell(table_id = tbl, column = 0, row = 4, text = "Trades",         text_size = size.small)
    table.cell(table_id = tbl, column = 1, row = 4, text = str.tostring(strategy.closedtrades),   text_size = size.small)
    table.cell(table_id = tbl, column = 0, row = 5, text = "Today",          text_size = size.small)
    table.cell(table_id = tbl, column = 1, row = 5, text = str.tostring(tradesToday) + "/" + str.tostring(maxTrades), text_size = size.small)
    table.cell(table_id = tbl, column = 0, row = 6, text = "Day P&L",        text_size = size.small)
    table.cell(table_id = tbl, column = 1, row = 6, text = str.tostring(dayPnLPct, "#.#") + "%",
               text_color = dayPnLPct >= 0 ? color.green : color.red, text_size = size.small)
