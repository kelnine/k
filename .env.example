# ── Twitter API v2 credentials (OAuth 1.0a) ─────────────────────────────────
# Create an app at https://developer.twitter.com → "Keys and tokens"
TWITTER_APP_KEY=
TWITTER_APP_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ── Bot settings ─────────────────────────────────────────────────────────────
# Comma-separated Binance symbols to watch
BOT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Candle timeframe (1m 5m 15m 1h 4h 1d)
BOT_TF=1h

# How often to poll in milliseconds (default 60 s)
BOT_POLL_MS=60000

# SMC fractal swing strength — bars required on each side (default 5)
BOT_SWING=5

# Number of candles to load per symbol per poll (default 300)
BOT_CANDLES=300

# Risk:reward targets expressed as multiples of initial risk
BOT_T1_R=0.5
BOT_T2_R=1.0
BOT_T3_R=2.0

# Set to "false" to post real tweets (default: dry-run prints to console)
BOT_DRY_RUN=true

# Hashtags appended to every tweet
BOT_HASHTAGS=#crypto #BTC #trading

# JSON file used to persist signal history and open trade state
BOT_STATE_FILE=./bot-state.json
