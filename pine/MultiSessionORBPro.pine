//@version=6
// ═════════════════════════════════════════════════════════════════════════════════════════════
//  Multi-Session ORB Pro — indicator
//  Four independent opening ranges (New York, London, CME Globex, Tokyo), each computed in its
//  own IANA timezone, with confirmed breakout / retest signals, optional filters, trade levels,
//  alerts (plain text or JSON) and a compact dashboard.
//  SIGNAL GENERATION ONLY — this script never places, routes or manages real orders.
//  Companion backtest: MultiSessionORBPro_Strategy.pine (identical signal engine, verified by
//  tools/check_shared.py).
// ═════════════════════════════════════════════════════════════════════════════════════════════
indicator("Multi-Session ORB Pro", shorttitle = "MS-ORB Pro", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ╔══════════════════════════════════ BEGIN SHARED CORE ══════════════════════════════════════╗
// ║ Byte-for-byte identical in the indicator and the strategy (tools/check_shared.py).          ║
// ║ Inputs, session clock, opening-range builder and the breakout / retest / trade engine.      ║
// ╚═════════════════════════════════════════════════════════════════════════════════════════════╝

// ───────────────────────────── ① Market profile ─────────────────────────────
string G_PROF = "① Market profile"
string iProfile = input.string("Auto-detect", "Market profile", options = ["Auto-detect", "Futures (MNQ/NQ)", "Crypto (perpetuals)"], group = G_PROF, display = display.none, tooltip = "Auto-detect: crypto spot / perpetual symbols use the Crypto profile, everything else the Futures profile. The profile selects which enable column is used for every session and which risk block (⑦ Futures or ⑧ Crypto) applies. The dashboard shows the profile in use.")
bool iCrypto7d = input.bool(false, "Crypto: form reference windows 7 days a week", group = G_PROF, display = display.none, tooltip = "Crypto trades continuously, so on crypto charts all four windows are REFERENCE windows, not real market opens. Off: each session keeps its own day calendar below. On: every enabled window also forms on Saturday / Sunday (holiday lists still apply).")

// ───────────────────────────── ② New York ─────────────────────────────
string G_NY = "② New York — NYSE cash open"
bool   nyOnF   = input.bool(true, "Enable on futures", inline = "ny1", group = G_NY, display = display.none)
bool   nyOnC   = input.bool(true, "on crypto", inline = "ny1", group = G_NY, display = display.none)
string nyTz    = input.string("America/New_York", "Timezone (IANA)", options = ["America/New_York", "America/Chicago", "Europe/London", "Europe/Berlin", "Europe/Zurich", "Asia/Tokyo", "Asia/Hong_Kong", "Asia/Shanghai", "Asia/Singapore", "Australia/Sydney", "GMT+0"], group = G_NY, display = display.none)
int    nyH     = input.int(9, "Start (local)  hh", minval = 0, maxval = 23, inline = "ny2", group = G_NY, display = display.none)
int    nyM     = input.int(30, "mm", minval = 0, maxval = 59, inline = "ny2", group = G_NY, display = display.none)
int    nyDur   = input.int(15, "Range minutes", options = [5, 15, 30, 60], group = G_NY, display = display.none)
bool   nySu    = input.bool(false, "Days  Su", inline = "ny3", group = G_NY, display = display.none)
bool   nyMo    = input.bool(true, "Mo", inline = "ny3", group = G_NY, display = display.none)
bool   nyTu    = input.bool(true, "Tu", inline = "ny3", group = G_NY, display = display.none)
bool   nyWe    = input.bool(true, "We", inline = "ny3", group = G_NY, display = display.none)
bool   nyTh    = input.bool(true, "Th", inline = "ny3", group = G_NY, display = display.none)
bool   nyFr    = input.bool(true, "Fr", inline = "ny3", group = G_NY, display = display.none)
bool   nySa    = input.bool(false, "Sa", inline = "ny3", group = G_NY, display = display.none)
bool   nyHolOn = input.bool(true, "Skip listed holidays", group = G_NY, display = display.none, tooltip = "NYSE full-day closures 2025–2027 are pre-filled. On these days MNQ/NQ still trade at 09:30 ET, so without this list a false 'cash open' range would form. Verify against the official NYSE calendar and add new years yourself. Any text after the date is ignored.")
string nyHol   = input.text_area("2025-01-01 New Year\n2025-01-09 Natl Day of Mourning\n2025-01-20 MLK Day\n2025-02-17 Presidents Day\n2025-04-18 Good Friday\n2025-05-26 Memorial Day\n2025-06-19 Juneteenth\n2025-07-04 Independence Day\n2025-09-01 Labor Day\n2025-11-27 Thanksgiving\n2025-12-25 Christmas\n2026-01-01 New Year\n2026-01-19 MLK Day\n2026-02-16 Presidents Day\n2026-04-03 Good Friday\n2026-05-25 Memorial Day\n2026-06-19 Juneteenth\n2026-07-03 Independence Day (obs)\n2026-09-07 Labor Day\n2026-11-26 Thanksgiving\n2026-12-25 Christmas\n2027-01-01 New Year\n2027-01-18 MLK Day\n2027-02-15 Presidents Day\n2027-03-26 Good Friday\n2027-05-31 Memorial Day\n2027-06-18 Juneteenth (obs)\n2027-07-05 Independence Day (obs)\n2027-09-06 Labor Day\n2027-11-25 Thanksgiving\n2027-12-24 Christmas (obs)", "Holidays (local date YYYY-MM-DD)", group = G_NY, display = display.none)
color  nyCol   = input.color(#2962FF, "Levels", inline = "ny4", group = G_NY)
color  nyFill  = input.color(#2962FF, "Fill", inline = "ny4", group = G_NY)

// ───────────────────────────── ③ London ─────────────────────────────
string G_LDN = "③ London — LSE cash open"
bool   ldOnF   = input.bool(true, "Enable on futures", inline = "ld1", group = G_LDN, display = display.none)
bool   ldOnC   = input.bool(true, "on crypto", inline = "ld1", group = G_LDN, display = display.none)
string ldTz    = input.string("Europe/London", "Timezone (IANA)", options = ["America/New_York", "America/Chicago", "Europe/London", "Europe/Berlin", "Europe/Zurich", "Asia/Tokyo", "Asia/Hong_Kong", "Asia/Shanghai", "Asia/Singapore", "Australia/Sydney", "GMT+0"], group = G_LDN, display = display.none, tooltip = "Europe/London switches between GMT and BST automatically, so the window is 03:00 ET most of the year and 04:00 ET during the short periods when only one side of the Atlantic is on daylight-saving time.")
int    ldH     = input.int(8, "Start (local)  hh", minval = 0, maxval = 23, inline = "ld2", group = G_LDN, display = display.none)
int    ldM     = input.int(0, "mm", minval = 0, maxval = 59, inline = "ld2", group = G_LDN, display = display.none)
int    ldDur   = input.int(15, "Range minutes", options = [5, 15, 30, 60], group = G_LDN, display = display.none)
bool   ldSu    = input.bool(false, "Days  Su", inline = "ld3", group = G_LDN, display = display.none)
bool   ldMo    = input.bool(true, "Mo", inline = "ld3", group = G_LDN, display = display.none)
bool   ldTu    = input.bool(true, "Tu", inline = "ld3", group = G_LDN, display = display.none)
bool   ldWe    = input.bool(true, "We", inline = "ld3", group = G_LDN, display = display.none)
bool   ldTh    = input.bool(true, "Th", inline = "ld3", group = G_LDN, display = display.none)
bool   ldFr    = input.bool(true, "Fr", inline = "ld3", group = G_LDN, display = display.none)
bool   ldSa    = input.bool(false, "Sa", inline = "ld3", group = G_LDN, display = display.none)
bool   ldHolOn = input.bool(true, "Skip listed holidays", group = G_LDN, display = display.none, tooltip = "LSE full-day closures (England & Wales bank holidays) 2025–2027 are pre-filled. Verify against the official LSE calendar and extend yearly.")
string ldHol   = input.text_area("2025-01-01 New Year\n2025-04-18 Good Friday\n2025-04-21 Easter Monday\n2025-05-05 Early May BH\n2025-05-26 Spring BH\n2025-08-25 Summer BH\n2025-12-25 Christmas\n2025-12-26 Boxing Day\n2026-01-01 New Year\n2026-04-03 Good Friday\n2026-04-06 Easter Monday\n2026-05-04 Early May BH\n2026-05-25 Spring BH\n2026-08-31 Summer BH\n2026-12-25 Christmas\n2026-12-28 Boxing Day (sub)\n2027-01-01 New Year\n2027-03-26 Good Friday\n2027-03-29 Easter Monday\n2027-05-03 Early May BH\n2027-05-31 Spring BH\n2027-08-30 Summer BH\n2027-12-27 Christmas (sub)\n2027-12-28 Boxing Day (sub)", "Holidays (local date YYYY-MM-DD)", group = G_LDN, display = display.none)
color  ldCol   = input.color(#AB47BC, "Levels", inline = "ld4", group = G_LDN)
color  ldFill  = input.color(#AB47BC, "Fill", inline = "ld4", group = G_LDN)

// ───────────────────────────── ④ CME Globex ─────────────────────────────
string G_CME = "④ CME Globex — evening reopen"
bool   cmOnF   = input.bool(true, "Enable on futures", inline = "cm1", group = G_CME, display = display.none)
bool   cmOnC   = input.bool(true, "on crypto", inline = "cm1", group = G_CME, display = display.none)
string cmTz    = input.string("America/New_York", "Timezone (IANA)", options = ["America/New_York", "America/Chicago", "Europe/London", "Europe/Berlin", "Europe/Zurich", "Asia/Tokyo", "Asia/Hong_Kong", "Asia/Shanghai", "Asia/Singapore", "Australia/Sydney", "GMT+0"], group = G_CME, display = display.none, tooltip = "18:00 America/New_York = 17:00 America/Chicago, the CME Globex reopen after the daily maintenance halt. On crypto charts this is a reference window only.")
int    cmH     = input.int(18, "Start (local)  hh", minval = 0, maxval = 23, inline = "cm2", group = G_CME, display = display.none)
int    cmM     = input.int(0, "mm", minval = 0, maxval = 59, inline = "cm2", group = G_CME, display = display.none)
int    cmDur   = input.int(15, "Range minutes", options = [5, 15, 30, 60], group = G_CME, display = display.none)
bool   cmSu    = input.bool(true, "Days  Su", inline = "cm3", group = G_CME, display = display.none, tooltip = "Days are the LOCAL date of the window. Globex reopens Sunday–Thursday evenings (Sunday evening = start of the trading week).")
bool   cmMo    = input.bool(true, "Mo", inline = "cm3", group = G_CME, display = display.none)
bool   cmTu    = input.bool(true, "Tu", inline = "cm3", group = G_CME, display = display.none)
bool   cmWe    = input.bool(true, "We", inline = "cm3", group = G_CME, display = display.none)
bool   cmTh    = input.bool(true, "Th", inline = "cm3", group = G_CME, display = display.none)
bool   cmFr    = input.bool(false, "Fr", inline = "cm3", group = G_CME, display = display.none)
bool   cmSa    = input.bool(false, "Sa", inline = "cm3", group = G_CME, display = display.none)
bool   cmHolOn = input.bool(true, "Skip listed holidays", group = G_CME, display = display.none, tooltip = "Empty by default on purpose: on MNQ/NQ charts an evening with no Globex reopen simply has no bars, so no range forms. Holiday reopen times change year to year (e.g. Good Friday / payrolls), so a wrong date here would hide a real range. Add evening dates (NY local date) only if you want to skip the reference window on crypto charts.")
string cmHol   = input.text_area("", "Holidays (local date YYYY-MM-DD)", group = G_CME, display = display.none)
color  cmCol   = input.color(#FFA000, "Levels", inline = "cm4", group = G_CME)
color  cmFill  = input.color(#FFA000, "Fill", inline = "cm4", group = G_CME)

// ───────────────────────────── ⑤ Tokyo ─────────────────────────────
string G_TKY = "⑤ Tokyo — TSE cash open"
bool   tkOnF   = input.bool(false, "Enable on futures", inline = "tk1", group = G_TKY, display = display.none)
bool   tkOnC   = input.bool(true, "on crypto", inline = "tk1", group = G_TKY, display = display.none)
string tkTz    = input.string("Asia/Tokyo", "Timezone (IANA)", options = ["America/New_York", "America/Chicago", "Europe/London", "Europe/Berlin", "Europe/Zurich", "Asia/Tokyo", "Asia/Hong_Kong", "Asia/Shanghai", "Asia/Singapore", "Australia/Sydney", "GMT+0"], group = G_TKY, display = display.none, tooltip = "Japan has no daylight-saving time; 09:00 JST is 19:00 ET in US winter and 20:00 ET in US summer (previous NY calendar day).")
int    tkH     = input.int(9, "Start (local)  hh", minval = 0, maxval = 23, inline = "tk2", group = G_TKY, display = display.none)
int    tkM     = input.int(0, "mm", minval = 0, maxval = 59, inline = "tk2", group = G_TKY, display = display.none)
int    tkDur   = input.int(15, "Range minutes", options = [5, 15, 30, 60], group = G_TKY, display = display.none)
bool   tkSu    = input.bool(false, "Days  Su", inline = "tk3", group = G_TKY, display = display.none)
bool   tkMo    = input.bool(true, "Mo", inline = "tk3", group = G_TKY, display = display.none)
bool   tkTu    = input.bool(true, "Tu", inline = "tk3", group = G_TKY, display = display.none)
bool   tkWe    = input.bool(true, "We", inline = "tk3", group = G_TKY, display = display.none)
bool   tkTh    = input.bool(true, "Th", inline = "tk3", group = G_TKY, display = display.none)
bool   tkFr    = input.bool(true, "Fr", inline = "tk3", group = G_TKY, display = display.none)
bool   tkSa    = input.bool(false, "Sa", inline = "tk3", group = G_TKY, display = display.none)
bool   tkHolOn = input.bool(true, "Skip listed holidays", group = G_TKY, display = display.none, tooltip = "JPX (Tokyo Stock Exchange) full-day closures 2025–2027 are pre-filled, including the Dec 31 – Jan 3 year-end closure. Verify against the official JPX calendar and extend yearly.")
string tkHol   = input.text_area("2025-01-01\n2025-01-02\n2025-01-03\n2025-01-13\n2025-02-11\n2025-02-24\n2025-03-20\n2025-04-29\n2025-05-05\n2025-05-06\n2025-07-21\n2025-08-11\n2025-09-15\n2025-09-23\n2025-10-13\n2025-11-03\n2025-11-24\n2025-12-31\n2026-01-01\n2026-01-02\n2026-01-12\n2026-02-11\n2026-02-23\n2026-03-20\n2026-04-29\n2026-05-04\n2026-05-05\n2026-05-06\n2026-07-20\n2026-08-11\n2026-09-21\n2026-09-22\n2026-09-23\n2026-10-12\n2026-11-03\n2026-11-23\n2026-12-31\n2027-01-01\n2027-01-11\n2027-02-11\n2027-02-23\n2027-03-22\n2027-04-29\n2027-05-03\n2027-05-04\n2027-05-05\n2027-07-19\n2027-08-11\n2027-09-20\n2027-09-23\n2027-10-11\n2027-11-03\n2027-11-23\n2027-12-31", "Holidays (local date YYYY-MM-DD)", group = G_TKY, display = display.none)
color  tkCol   = input.color(#00ACC1, "Levels", inline = "tk4", group = G_TKY)
color  tkFill  = input.color(#00ACC1, "Fill", inline = "tk4", group = G_TKY)

// ───────────────────────────── ⑥ Signals ─────────────────────────────
string G_SIG = "⑥ Signals"
string iMode       = input.string("Breakout close", "Entry mode", options = ["Breakout close", "Breakout + retest", "Breakout + momentum"], group = G_SIG, display = display.none, tooltip = "Breakout close: a confirmed candle CLOSE beyond ORH / ORL (+ minimum distance).\nBreakout + retest: a breakout first, then a later candle that trades back to the level (within tolerance) and closes back outside it.\nBreakout + momentum: the breakout candle must also have a strong body and range (settings below).\nSignals are only evaluated on confirmed bar closes after the range is complete.")
string iDir        = input.string("Both", "Direction", options = ["Both", "Long only", "Short only"], group = G_SIG, display = display.none)
bool   iFirstOnly  = input.bool(false, "First breakout per session only", group = G_SIG, display = display.none, tooltip = "Only the first breakout of a session (either direction) can become a signal. If that first breakout is filtered out, the session produces no signal.")
int    iMaxSig     = input.int(2, "Max signals per session", minval = 1, maxval = 10, group = G_SIG, display = display.none)
int    iSigWin     = input.int(180, "Signal window after range close (min)", minval = 0, maxval = 1440, step = 15, group = G_SIG, display = display.none, tooltip = "Breakouts / retests are only accepted within this many minutes after the range completes. 0 = until the levels expire.")
int    iLifeHrs    = input.int(12, "Level lifetime after range close (hours)", minval = 0, maxval = 96, group = G_SIG, display = display.none, tooltip = "After this time the session's levels stop extending, turn dotted and are marked as history; any tracked trade is closed (time exit). This prevents old levels from being mistaken for the current session. 0 = keep until the same session's next window starts.")
int    iRetestBars = input.int(12, "Max bars to wait for retest", minval = 1, maxval = 500, group = G_SIG, display = display.none)
bool   iRetestCndl = input.bool(true, "Retest candle must close in breakout direction", group = G_SIG, display = display.none)
int    iMomBody    = input.int(55, "Momentum: min body % of candle range", minval = 10, maxval = 100, group = G_SIG, display = display.none)
float  iMomAtr     = input.float(1.0, "Momentum: min candle range × ATR", minval = 0, step = 0.1, group = G_SIG, display = display.none)
bool   iFbOn       = input.bool(true, "False-breakout / re-entry warning", inline = "fb", group = G_SIG, display = display.none)
int    iFbBars     = input.int(6, "within bars", minval = 1, maxval = 200, inline = "fb", group = G_SIG, display = display.none, tooltip = "Warns when price closes back inside the range within this many bars after a breakout.")
bool   iOnePerBar  = input.bool(true, "One signal per bar across sessions", group = G_SIG, display = display.none, tooltip = "If two sessions would signal on the same bar, only the first in priority order (NY, London, CME, Tokyo) is kept.")
bool   iBlockOpen  = input.bool(true, "No new signal while that session's trade is open", group = G_SIG, display = display.none)
bool   iExitInside = input.bool(false, "Exit tracked trade on a close back inside the range", group = G_SIG, display = display.none)
bool   iSkipPart   = input.bool(false, "Skip ranges with missing bars", group = G_SIG, display = display.none, tooltip = "Thin markets can skip 1-minute bars. Off: the range is built from the bars that exist and flagged as partial. On: partial ranges never produce signals.")
int    iTimeExit   = input.int(0, "Time exit after entry (min)", minval = 0, maxval = 2880, group = G_SIG, display = display.none, tooltip = "0 = the tracked trade is closed when the session's levels expire.")
int    iAtrLen     = input.int(14, "ATR length (chart timeframe)", minval = 1, maxval = 200, group = G_SIG, display = display.none)

// ───────────────────────────── ⑦ Futures risk settings ─────────────────────────────
string G_FUT = "⑦ Futures settings (MNQ / NQ)"
string fUnit    = input.string("Ticks", "Distance unit", options = ["Ticks", "ATR"], group = G_FUT, display = display.none, tooltip = "Unit for min breakout distance, retest tolerance, stop buffer and break-even offset. Ticks use syminfo.mintick (MNQ / NQ = 0.25 points).")
float  fMinDist = input.float(2, "Min breakout distance", minval = 0, step = 0.5, group = G_FUT, display = display.none)
float  fTol     = input.float(8, "Retest tolerance", minval = 0, step = 0.5, group = G_FUT, display = display.none)
string fStop    = input.string("Opposite OR boundary", "Stop-loss", options = ["Opposite OR boundary", "OR midpoint", "ATR from entry"], group = G_FUT, display = display.none)
float  fStopBuf = input.float(2, "Stop buffer (beyond boundary / midpoint)", minval = 0, step = 0.5, group = G_FUT, display = display.none)
float  fStopAtr = input.float(1.5, "ATR stop multiplier", minval = 0.1, step = 0.1, group = G_FUT, display = display.none)
float  fTp1     = input.float(1.0, "TP1 (R)", minval = 0.1, step = 0.25, inline = "ftp", group = G_FUT, display = display.none)
float  fTp2     = input.float(2.0, "TP2 (R)", minval = 0.1, step = 0.25, inline = "ftp", group = G_FUT, display = display.none)
int    fTp1Pct  = input.int(50, "TP1 exit % of position", minval = 0, maxval = 100, step = 5, group = G_FUT, display = display.none, tooltip = "Used by the strategy. With 1 contract no partial is possible; TP1 then only triggers the break-even move.")
bool   fBE      = input.bool(true, "Move stop to break-even after TP1", inline = "fbe", group = G_FUT, display = display.none)
float  fBEOff   = input.float(1, "offset", minval = 0, step = 0.5, inline = "fbe", group = G_FUT, display = display.none)

// ───────────────────────────── ⑧ Crypto risk settings ─────────────────────────────
string G_CRY = "⑧ Crypto settings (perpetuals)"
string cUnit    = input.string("ATR", "Distance unit", options = ["Ticks", "ATR"], group = G_CRY, display = display.none, tooltip = "ATR adapts the distances to each coin's volatility (BTC, SOL, NEAR and ZEC have very different tick sizes).")
float  cMinDist = input.float(0.05, "Min breakout distance", minval = 0, step = 0.01, group = G_CRY, display = display.none)
float  cTol     = input.float(0.15, "Retest tolerance", minval = 0, step = 0.01, group = G_CRY, display = display.none)
string cStop    = input.string("Opposite OR boundary", "Stop-loss", options = ["Opposite OR boundary", "OR midpoint", "ATR from entry"], group = G_CRY, display = display.none)
float  cStopBuf = input.float(0.1, "Stop buffer (beyond boundary / midpoint)", minval = 0, step = 0.01, group = G_CRY, display = display.none)
float  cStopAtr = input.float(1.5, "ATR stop multiplier", minval = 0.1, step = 0.1, group = G_CRY, display = display.none)
float  cTp1     = input.float(1.0, "TP1 (R)", minval = 0.1, step = 0.25, inline = "ctp", group = G_CRY, display = display.none)
float  cTp2     = input.float(2.0, "TP2 (R)", minval = 0.1, step = 0.25, inline = "ctp", group = G_CRY, display = display.none)
int    cTp1Pct  = input.int(50, "TP1 exit % of position", minval = 0, maxval = 100, step = 5, group = G_CRY, display = display.none)
bool   cBE      = input.bool(true, "Move stop to break-even after TP1", inline = "cbe", group = G_CRY, display = display.none)
float  cBEOff   = input.float(0, "offset", minval = 0, step = 0.01, inline = "cbe", group = G_CRY, display = display.none)

// ───────────────────────────── ⑨ Optional confirmation filters ─────────────────────────────
string G_FLT = "⑨ Confirmation filters (all optional, off by default)"
bool   uEma921   = input.bool(false, "EMA 9 / 21 trend alignment", group = G_FLT, display = display.none, tooltip = "Long: EMA9 > EMA21. Short: EMA9 < EMA21 (chart timeframe, confirmed close).")
bool   uEma50200 = input.bool(false, "EMA 50 / 200 higher-trend filter", group = G_FLT, display = display.none, tooltip = "Long: EMA50 > EMA200. Short: EMA50 < EMA200.")
bool   uVol      = input.bool(false, "Volume >", inline = "fv", group = G_FLT, display = display.none, tooltip = "Signal candle volume must exceed this multiple of its simple moving average. Ignored when the symbol has no volume data.")
float  uVolMult  = input.float(1.2, "× SMA", minval = 0.1, step = 0.1, inline = "fv", group = G_FLT, display = display.none)
int    uVolLen   = input.int(20, "len", minval = 1, inline = "fv", group = G_FLT, display = display.none)
bool   uAtrVol   = input.bool(false, "ATR ≥", inline = "fa", group = G_FLT, display = display.none, tooltip = "Volatility filter: chart ATR must be at least this multiple of its own SMA (avoids dead markets).")
float  uAtrMin   = input.float(0.8, "× its SMA", minval = 0.1, step = 0.1, inline = "fa", group = G_FLT, display = display.none)
int    uAtrLen   = input.int(100, "len", minval = 2, inline = "fa", group = G_FLT, display = display.none)
bool   uRange    = input.bool(false, "Range size, % of daily ATR(14)", inline = "fr", group = G_FLT, display = display.none, tooltip = "The completed opening range must be between min % and max % of the previous days' ATR(14) (confirmed daily candles only).")
float  uRangeMin = input.float(5, "min", minval = 0, step = 1, inline = "fr", group = G_FLT, display = display.none)
float  uRangeMax = input.float(60, "max", minval = 0, step = 1, inline = "fr", group = G_FLT, display = display.none)
bool   uRsi      = input.bool(false, "RSI  long ≥", inline = "fi", group = G_FLT, display = display.none)
float  uRsiLong  = input.float(50, "", minval = 0, maxval = 100, inline = "fi", group = G_FLT, display = display.none)
float  uRsiShort = input.float(50, "short ≤", minval = 0, maxval = 100, inline = "fi", group = G_FLT, display = display.none)
int    uRsiLen   = input.int(14, "len", minval = 2, inline = "fi", group = G_FLT, display = display.none)
bool   uHtf      = input.bool(false, "Higher-TF trend: close vs EMA", inline = "fh", group = G_FLT, display = display.none, tooltip = "Long: the last CONFIRMED higher-timeframe close is above its EMA. Short: below. Uses request.security with [1] + lookahead_on, so it never repaints.")
string uHtfTf    = input.timeframe("60", "", inline = "fh", group = G_FLT, display = display.none)
int    uHtfLen   = input.int(50, "EMA", minval = 2, inline = "fh", group = G_FLT, display = display.none)

// ───────────────────────────── Event codes ─────────────────────────────
int EVT_NONE     = 0
int EVT_BREAK    = 1
int EVT_SETUP    = 2
int EVT_RETEST   = 3
int EVT_FALSE    = 4
int EVT_FILTERED = 5
int EVT_TIMEOUT  = 6
int EVT_RETFAIL  = 7
int EVT_TP1      = 8
int EVT_TP2      = 9
int EVT_SL       = 10
int EVT_BE       = 11
int EVT_EXIT     = 12

// ───────────────────────────── Profile resolution ─────────────────────────────
bool   SYM_CRYPTO   = syminfo.type == "crypto" or syminfo.type == "swap" or str.endswith(syminfo.ticker, ".P") or str.contains(syminfo.ticker, "USDT")
bool   IS_CRYPTO    = iProfile == "Crypto (perpetuals)" or (iProfile == "Auto-detect" and SYM_CRYPTO)
string PROFILE_NAME = IS_CRYPTO ? "Crypto" : "Futures"
bool   UNIT_TICKS   = (IS_CRYPTO ? cUnit : fUnit) == "Ticks"
float  P_MINDIST    = IS_CRYPTO ? cMinDist : fMinDist
float  P_TOL        = IS_CRYPTO ? cTol : fTol
string P_STOP       = IS_CRYPTO ? cStop : fStop
float  P_STOPBUF    = IS_CRYPTO ? cStopBuf : fStopBuf
float  P_STOPATR    = IS_CRYPTO ? cStopAtr : fStopAtr
float  P_TP1        = IS_CRYPTO ? cTp1 : fTp1
float  P_TP2        = math.max(IS_CRYPTO ? cTp2 : fTp2, P_TP1)
int    P_TP1PCT     = IS_CRYPTO ? cTp1Pct : fTp1Pct
bool   P_BE         = IS_CRYPTO ? cBE : fBE
float  P_BEOFF      = IS_CRYPTO ? cBEOff : fBEOff
int    STOPMODE     = P_STOP == "Opposite OR boundary" ? 1 : P_STOP == "OR midpoint" ? 2 : 3
int    MODE         = iMode == "Breakout + retest" ? 2 : iMode == "Breakout + momentum" ? 3 : 1
bool   LONG_OK      = iDir != "Short only"
bool   SHORT_OK     = iDir != "Long only"

// ───────────────────────────── Chart & data ─────────────────────────────
bool   TIME_CHART = timeframe.isintraday and not timeframe.isticks
int    TF_SEC     = TIME_CHART ? timeframe.in_seconds(timeframe.period) : 0
bool   CHART_OK   = chart.is_standard or chart.is_heikinashi
string STD_TICKER = ticker.standard(syminfo.tickerid)

// Real OHLC even on Heikin Ashi charts (ranges must use true wick highs / lows).
[stdO, stdH, stdL, stdC] = request.security(STD_TICKER, timeframe.period, [open, high, low, close])
float sO = chart.is_heikinashi ? stdO : open
float sH = chart.is_heikinashi ? stdH : high
float sL = chart.is_heikinashi ? stdL : low
float sC = chart.is_heikinashi ? stdC : close

float trueRng = na(sC[1]) ? sH - sL : math.max(sH - sL, math.abs(sH - sC[1]), math.abs(sL - sC[1]))
float atrV    = ta.rma(trueRng, iAtrLen)
float ema9    = ta.ema(sC, 9)
float ema21   = ta.ema(sC, 21)
float ema50   = ta.ema(sC, 50)
float ema200  = ta.ema(sC, 200)
float rsiV    = ta.rsi(sC, uRsiLen)
float volMa   = ta.sma(volume, uVolLen)
float atrAvg  = ta.sma(atrV, uAtrLen)
// Higher-timeframe values use the previous CONFIRMED candle: expr[1] + lookahead_on = no repainting.
float dAtr    = request.security(STD_TICKER, "1D", ta.atr(14)[1], lookahead = barmerge.lookahead_on)
[htfC, htfE]  = request.security(STD_TICKER, uHtfTf, [close[1], ta.ema(close, uHtfLen)[1]], lookahead = barmerge.lookahead_on)

bool VOL_OK  = not uVol or na(volume) or (not na(volMa) and volume > uVolMult * volMa)
bool ATR_OK  = not uAtrVol or na(atrAvg) or atrV >= uAtrMin * atrAvg
bool F_LONG  = VOL_OK and ATR_OK and (not uEma921 or ema9 > ema21) and (not uEma50200 or ema50 > ema200) and (not uRsi or rsiV >= uRsiLong) and (not uHtf or htfC > htfE)
bool F_SHORT = VOL_OK and ATR_OK and (not uEma921 or ema9 < ema21) and (not uEma50200 or ema50 < ema200) and (not uRsi or rsiV <= uRsiShort) and (not uHtf or htfC < htfE)

int BAR_TC  = na(time_close) ? time + TF_SEC * 1000 : time_close
int PREV_TC = time_close[1]
int PREV_T  = time[1]

// ───────────────────────────── Types ─────────────────────────────
type SessCfg
    string key
    string name
    string tz
    int    sh
    int    sm
    int    dur
    bool   enabled = false
    string days
    bool   holOn = false
    string hol
    color  col
    color  fillCol
    bool   tfOk = false
    bool   tf1hOk = false

type SessState
    int    candStart = na
    bool   candOk = false
    string candDate = ""
    int    winStart = na
    int    winEnd = na
    int    win1hEnd = na
    string winDate = ""
    int    phase = 0
    int    phase1h = 0
    float  hi = na
    float  lo = na
    float  hi1h = na
    float  lo1h = na
    float  orh = na
    float  orl = na
    float  mid = na
    float  orh1h = na
    float  orl1h = na
    int    endTime = na
    int    end1hTime = na
    int    bars = 0
    bool   partial = false
    bool   misaligned = false
    bool   valid = true
    bool   ok1h = true
    bool   rangeOk = true
    int    expireAt = na
    int    sigEndAt = na
    bool   bullArmed = false
    bool   bearArmed = false
    int    pendDir = 0
    int    pendBar = na
    int    lastBrkDir = 0
    int    lastBrkBar = na
    int    fbWatch = 0
    int    fbBar = na
    int    brkCount = 0
    int    sigCount = 0
    int    lastEvt = 0
    int    trDir = 0
    float  trEntry = na
    float  trStop = na
    float  trStop0 = na
    float  trTp1 = na
    float  trTp2 = na
    bool   trTp1Hit = false
    bool   trBE = false
    int    trBar = na
    int    trTime = na
    string trType = ""
    string trId = ""
    bool   evNewWin = false
    bool   evRangeDone = false
    bool   ev1hDone = false
    bool   evExpire = false
    int    evBreak = 0
    int    evSetup = 0
    int    evRetest = 0
    int    evFalse = 0
    int    evFiltered = 0
    int    evEntry = 0
    bool   evTp1 = false
    string evTp1Id = ""
    int    evTp1Dir = 0
    float  evTp1Px = na
    float  evTp1Stop = na
    int    evExitDir = 0
    int    evExitReason = 0
    string evExitId = ""
    float  evExitPx = na
    float  evExitR = na

// ───────────────────────────── Utilities ─────────────────────────────
f_mask(bool su, bool mo, bool tu, bool we, bool th, bool fr, bool sa) =>
    (su ? "1" : "0") + (mo ? "1" : "0") + (tu ? "1" : "0") + (we ? "1" : "0") + (th ? "1" : "0") + (fr ? "1" : "0") + (sa ? "1" : "0")

// A range of `durMin` minutes is exact only when whole chart bars tile it.
f_tfOk(int durMin) =>
    TIME_CHART and TF_SEC > 0 and TF_SEC <= durMin * 60 and (durMin * 60) % TF_SEC == 0

f_fmt(float v) =>
    na(v) ? "—" : str.tostring(v, format.mintick)

// Converts a profile distance (ticks or ATR multiple) into price units.
f_px(float v) =>
    UNIT_TICKS ? v * syminfo.mintick : v * nz(atrV)

f_pos(string p) =>
    switch p
        "Top left"      => position.top_left
        "Top center"    => position.top_center
        "Middle left"   => position.middle_left
        "Middle right"  => position.middle_right
        "Bottom left"   => position.bottom_left
        "Bottom center" => position.bottom_center
        "Bottom right"  => position.bottom_right
        => position.top_right

f_tfLabel() =>
    string r = timeframe.period
    if timeframe.isseconds
        r := str.tostring(timeframe.multiplier) + "s"
    else if timeframe.isminutes
        r := timeframe.multiplier % 60 == 0 ? str.tostring(math.floor(timeframe.multiplier / 60)) + "H" : str.tostring(timeframe.multiplier) + "m"
    r

f_dateStr(int t, string tz) =>
    str.format_time(t, "yyyy-MM-dd", tz)

// Trading-day check on the LOCAL date of the window (dayofweek: 1 = Sunday … 7 = Saturday).
f_dayOk(SessCfg c, int st) =>
    int dow = dayofweek(st, c.tz)
    (IS_CRYPTO and iCrypto7d) or str.substring(c.days, dow - 1, dow) == "1"

f_isHoliday(SessCfg c, string ds) =>
    c.holOn and str.contains(c.hol, ds)

// Most recent window start <= t, built with timestamp() in the session's IANA timezone,
// so daylight-saving changes in New York, London or Tokyo are handled by the timezone database.
f_latestStart(SessCfg c, int t) =>
    int y = year(t, c.tz)
    int m = month(t, c.tz)
    int d = dayofmonth(t, c.tz)
    int st = timestamp(c.tz, y, m, d, c.sh, c.sm, 0)
    if st > t
        // previous LOCAL calendar day (local noon − 24 h is always inside that day, even on DST days)
        int p = timestamp(c.tz, y, m, d, 12, 0, 0) - 86400000
        st := timestamp(c.tz, year(p, c.tz), month(p, c.tz), dayofmonth(p, c.tz), c.sh, c.sm, 0)
    st

f_momentum(int dir) =>
    float rng = sH - sL
    bool dirBar = dir == 1 ? sC > sO : sC < sO
    dirBar and rng > 0 and math.abs(sC - sO) >= rng * iMomBody / 100 and (na(atrV) or rng >= atrV * iMomAtr)

f_reason(int r) =>
    r == 2 ? "TP2" : r == 3 ? "STOP" : r == 4 ? "BREAKEVEN_STOP" : r == 5 ? "TIME_EXIT" : r == 6 ? "BACK_INSIDE_RANGE" : r == 7 ? "REPLACED" : "EXIT"

f_reasonShort(int r) =>
    r == 2 ? "TP2" : r == 3 ? "SL" : r == 4 ? "BE" : r == 5 ? "Time" : r == 6 ? "Inside" : r == 7 ? "Repl" : "Exit"

f_rTxt(float r) =>
    na(r) ? "" : (r >= 0 ? "+" : "") + str.tostring(r, "#.##") + "R"

// ───────────────────────────── Engine ─────────────────────────────
f_resetEvents(SessState s) =>
    s.evNewWin := false
    s.evRangeDone := false
    s.ev1hDone := false
    s.evExpire := false
    s.evBreak := 0
    s.evSetup := 0
    s.evRetest := 0
    s.evFalse := 0
    s.evFiltered := 0
    s.evEntry := 0
    s.evTp1 := false
    s.evTp1Id := ""
    s.evTp1Dir := 0
    s.evTp1Px := na
    s.evTp1Stop := na
    s.evExitDir := 0
    s.evExitReason := 0
    s.evExitId := ""
    s.evExitPx := na
    s.evExitR := na
    true

// reason: 2 = TP2, 3 = stop, 4 = break-even stop, 5 = time / expiry, 6 = close back inside range, 7 = replaced by new signal
f_closeTrade(SessState s, float px, int reason) =>
    float risk0 = math.abs(s.trEntry - s.trStop0)
    s.evExitDir := s.trDir
    s.evExitReason := reason
    s.evExitId := s.trId
    s.evExitPx := px
    s.evExitR := risk0 > 0 ? s.trDir * (px - s.trEntry) / risk0 : na
    s.trDir := 0
    s.lastEvt := reason == 2 ? EVT_TP2 : reason == 3 ? EVT_SL : reason == 4 ? EVT_BE : EVT_EXIT
    true

f_openTrade(SessCfg c, SessState s, int dir, string typ) =>
    float entry = sC
    float buf = f_px(P_STOPBUF)
    float stop = STOPMODE == 1 ? (dir > 0 ? s.orl - buf : s.orh + buf) : STOPMODE == 2 ? (dir > 0 ? s.mid - buf : s.mid + buf) : (dir > 0 ? entry - atrV * P_STOPATR : entry + atrV * P_STOPATR)
    stop := math.round_to_mintick(stop)
    float risk = dir > 0 ? entry - stop : stop - entry
    bool ok = not na(risk) and risk > 0
    if ok
        if s.trDir != 0
            f_closeTrade(s, sC, 7)
        s.sigCount := s.sigCount + 1
        s.trDir := dir
        s.trEntry := entry
        s.trStop := stop
        s.trStop0 := stop
        s.trTp1 := math.round_to_mintick(entry + dir * risk * P_TP1)
        s.trTp2 := math.round_to_mintick(entry + dir * risk * P_TP2)
        s.trTp1Hit := false
        s.trBE := false
        s.trBar := bar_index
        s.trTime := BAR_TC
        s.trType := typ
        s.trId := c.key + "-" + str.replace_all(s.winDate, "-", "") + "-" + str.tostring(s.sigCount) + (dir > 0 ? "L" : "S")
        s.evEntry := dir
        s.lastEvt := typ == "RETEST" ? EVT_RETEST : EVT_BREAK
        if typ == "RETEST"
            s.evRetest := dir
    ok

// Bar-by-bar tracking of the signal's stop / targets. Same-bar stop + target = stop first (conservative).
f_manageTrade(SessState s) =>
    if s.trDir == 1
        if sL <= s.trStop
            f_closeTrade(s, math.min(sO, s.trStop), s.trBE ? 4 : 3)
        else
            if not s.trTp1Hit and sH >= s.trTp1
                s.trTp1Hit := true
                s.evTp1 := true
                s.evTp1Id := s.trId
                s.evTp1Dir := 1
                s.evTp1Px := s.trTp1
                s.lastEvt := EVT_TP1
                if P_BE
                    s.trStop := math.max(s.trStop, math.round_to_mintick(s.trEntry + f_px(P_BEOFF)))
                    s.trBE := true
                s.evTp1Stop := s.trStop
            if sH >= s.trTp2
                f_closeTrade(s, math.max(sO, s.trTp2), 2)
    else if s.trDir == -1
        if sH >= s.trStop
            f_closeTrade(s, math.max(sO, s.trStop), s.trBE ? 4 : 3)
        else
            if not s.trTp1Hit and sL <= s.trTp1
                s.trTp1Hit := true
                s.evTp1 := true
                s.evTp1Id := s.trId
                s.evTp1Dir := -1
                s.evTp1Px := s.trTp1
                s.lastEvt := EVT_TP1
                if P_BE
                    s.trStop := math.min(s.trStop, math.round_to_mintick(s.trEntry - f_px(P_BEOFF)))
                    s.trBE := true
                s.evTp1Stop := s.trStop
            if sL <= s.trTp2
                f_closeTrade(s, math.min(sO, s.trTp2), 2)
    if s.trDir != 0
        if iExitInside and ((s.trDir == 1 and sC < s.orh) or (s.trDir == -1 and sC > s.orl))
            f_closeTrade(s, sC, 6)
        else if iTimeExit > 0 and BAR_TC - s.trTime >= iTimeExit * 60000
            f_closeTrade(s, sC, 5)
    true

f_newWindow(SessCfg c, SessState s, int st) =>
    s.winStart := st
    s.winEnd := st + c.dur * 60000
    s.win1hEnd := st + 3600000
    s.winDate := s.candDate
    s.phase := 1
    s.phase1h := c.tf1hOk and c.dur < 60 ? 1 : 0
    s.hi := na
    s.lo := na
    s.hi1h := na
    s.lo1h := na
    s.orh := na
    s.orl := na
    s.mid := na
    s.orh1h := na
    s.orl1h := na
    s.endTime := na
    s.end1hTime := na
    s.bars := 0
    // A bar that straddles the window start means the chart TF is not aligned with the window.
    s.misaligned := not na(PREV_TC) and PREV_TC > st
    // First bar later than the window start = missing bar(s) (or chart history starts mid-window).
    s.partial := time > st
    s.valid := not s.misaligned and not (na(PREV_TC) and time > st)
    s.ok1h := not s.misaligned
    s.rangeOk := true
    s.expireAt := na
    s.sigEndAt := na
    s.bullArmed := false
    s.bearArmed := false
    s.pendDir := 0
    s.pendBar := na
    s.lastBrkDir := 0
    s.lastBrkBar := na
    s.fbWatch := 0
    s.fbBar := na
    s.brkCount := 0
    s.sigCount := 0
    s.lastEvt := EVT_NONE
    s.evNewWin := true
    true

// Freezes ORH / ORL — only called once the complete window has closed.
f_finalize(SessCfg c, SessState s, int endT) =>
    s.phase := 2
    s.orh := s.hi
    s.orl := s.lo
    s.mid := math.round_to_mintick((s.hi + s.lo) / 2)
    s.endTime := endT
    int expBars = TF_SEC > 0 ? math.floor(c.dur * 60 / TF_SEC) : 0
    s.partial := s.partial or s.bars < expBars
    if s.misaligned or (iSkipPart and s.partial)
        s.valid := false
    float rng = s.orh - s.orl
    s.rangeOk := not uRange or na(dAtr) or (rng >= dAtr * uRangeMin / 100 and rng <= dAtr * uRangeMax / 100)
    s.expireAt := iLifeHrs > 0 ? s.winEnd + iLifeHrs * 3600000 : na
    int sigEnd = iSigWin > 0 ? s.winEnd + iSigWin * 60000 : na
    s.sigEndAt := na(sigEnd) ? s.expireAt : na(s.expireAt) ? sigEnd : math.min(sigEnd, s.expireAt)
    s.bullArmed := true
    s.bearArmed := true
    s.evRangeDone := true
    true

f_finalize1h(SessState s, int endT) =>
    s.phase1h := 2
    s.orh1h := s.hi1h
    s.orl1h := s.lo1h
    s.end1hTime := endT
    s.ev1hDone := true
    true

// Breakout / retest / false-breakout logic. Called only on CONFIRMED bars that start at or after the window end.
f_signals(SessCfg c, SessState s, bool allowSig) =>
    int entryDir = 0
    bool inSig = (na(s.sigEndAt) or BAR_TC <= s.sigEndAt) and (na(s.expireAt) or BAR_TC < s.expireAt)
    float minD = f_px(P_MINDIST)
    float tol = f_px(P_TOL)
    bool canEnter = allowSig and s.valid and s.rangeOk and s.sigCount < iMaxSig and not (iBlockOpen and s.trDir != 0)
    // a — false-breakout / re-entry watch
    if s.fbWatch == 1
        if sC < s.orh
            s.evFalse := 1
            s.fbWatch := 0
            s.lastEvt := EVT_FALSE
        else if bar_index - s.fbBar >= iFbBars
            s.fbWatch := 0
    else if s.fbWatch == -1
        if sC > s.orl
            s.evFalse := -1
            s.fbWatch := 0
            s.lastEvt := EVT_FALSE
        else if bar_index - s.fbBar >= iFbBars
            s.fbWatch := 0
    // b — a direction is re-armed once price closes back inside the range
    if not s.bullArmed and sC < s.orh
        s.bullArmed := true
    if not s.bearArmed and sC > s.orl
        s.bearArmed := true
    // c — pending retest: a breakout must already have happened (Breakout + retest mode)
    if s.pendDir != 0
        if not inSig or bar_index - s.pendBar > iRetestBars
            s.pendDir := 0
            s.lastEvt := EVT_TIMEOUT
        else if s.pendDir == 1
            if sC < s.orh
                s.pendDir := 0
                s.lastEvt := EVT_RETFAIL
            else if sL <= s.orh + tol and (not iRetestCndl or sC > sO)
                s.pendDir := 0
                bool tookL = false
                if canEnter and F_LONG
                    tookL := f_openTrade(c, s, 1, "RETEST")
                if tookL
                    entryDir := 1
                else
                    s.evFiltered := 1
                    s.lastEvt := EVT_FILTERED
        else
            if sC > s.orl
                s.pendDir := 0
                s.lastEvt := EVT_RETFAIL
            else if sH >= s.orl - tol and (not iRetestCndl or sC < sO)
                s.pendDir := 0
                bool tookS = false
                if canEnter and F_SHORT
                    tookS := f_openTrade(c, s, -1, "RETEST")
                if tookS
                    entryDir := -1
                else
                    s.evFiltered := -1
                    s.lastEvt := EVT_FILTERED
    // d — fresh breakout: confirmed close beyond the level by at least the minimum distance
    if entryDir == 0 and s.pendDir == 0 and inSig and s.valid
        int bdir = s.bullArmed and sC > s.orh + minD ? 1 : s.bearArmed and sC < s.orl - minD ? -1 : 0
        if bdir != 0
            if bdir == 1
                s.bullArmed := false
            else
                s.bearArmed := false
            s.brkCount := s.brkCount + 1
            s.lastBrkDir := bdir
            s.lastBrkBar := bar_index
            s.evBreak := bdir
            s.lastEvt := EVT_BREAK
            if iFbOn
                s.fbWatch := bdir
                s.fbBar := bar_index
            bool dirOk = bdir == 1 ? LONG_OK : SHORT_OK
            bool setupOk = s.rangeOk and dirOk and s.sigCount < iMaxSig and (not iFirstOnly or s.brkCount == 1)
            bool took = false
            if MODE == 2
                if setupOk
                    s.pendDir := bdir
                    s.pendBar := bar_index
                    s.evSetup := bdir
                    s.lastEvt := EVT_SETUP
            else if setupOk and canEnter and (bdir == 1 ? F_LONG : F_SHORT) and (MODE == 1 or f_momentum(bdir))
                took := f_openTrade(c, s, bdir, MODE == 3 ? "MOMENTUM" : "BREAKOUT")
            if took
                entryDir := bdir
            else if s.evSetup == 0
                s.evFiltered := bdir
                s.lastEvt := EVT_FILTERED
    entryDir

// One full bar of processing for one session. Returns the entry direction issued on this bar (0 = none).
f_engine(SessCfg c, SessState s, bool allowSig) =>
    f_resetEvents(s)
    int entryDir = 0
    if c.enabled and c.tfOk and CHART_OK
        bool conf = barstate.isconfirmed
        // 1 — manage the tracked trade (never on its own entry bar)
        if s.trDir != 0 and bar_index > s.trBar and conf
            f_manageTrade(s)
        // 2 — most recent window start in the session's own timezone + trading-day / holiday check
        int st = f_latestStart(c, time)
        // NOTE: any comparison with na is false in Pine, so the na() checks below are required
        if na(s.candStart) or st != s.candStart
            s.candStart := st
            s.candDate := f_dateStr(st, c.tz)
            s.candOk := f_dayOk(c, st) and not f_isHoliday(c, s.candDate)
        bool inWin = s.candOk and time >= st and time < st + c.dur * 60000
        // 3 — a new window starts: everything from the previous window is reset (no stale levels)
        if inWin and (na(s.winStart) or st != s.winStart)
            if s.trDir != 0
                f_closeTrade(s, sC, 5)
            f_newWindow(c, s, st)
        // 4 — build the range from wick extremes; ORH / ORL freeze only when the window is complete
        if s.phase == 1
            if time < s.winEnd
                s.hi := na(s.hi) ? sH : math.max(s.hi, sH)
                s.lo := na(s.lo) ? sL : math.min(s.lo, sL)
                s.bars := s.bars + 1
                if BAR_TC > s.winEnd
                    s.misaligned := true
                if BAR_TC >= s.winEnd and conf
                    f_finalize(c, s, time)
            else
                // the last window bar(s) were missing: freeze before this bar is evaluated
                f_finalize(c, s, PREV_T)
        if s.phase1h == 1
            if time < s.win1hEnd
                s.hi1h := na(s.hi1h) ? sH : math.max(s.hi1h, sH)
                s.lo1h := na(s.lo1h) ? sL : math.min(s.lo1h, sL)
                if BAR_TC > s.win1hEnd
                    s.ok1h := false
                if BAR_TC >= s.win1hEnd and conf
                    f_finalize1h(s, time)
            else
                f_finalize1h(s, PREV_T)
        // 5 — signals: confirmed closes of bars that START after the window (never while forming)
        if s.phase == 2 and time >= s.winEnd and conf
            entryDir := f_signals(c, s, allowSig)
        // 6 — expiry: levels become history, pending setups are dropped, the tracked trade is closed
        if s.phase == 2 and not na(s.expireAt) and BAR_TC >= s.expireAt and conf
            s.phase := 3
            s.evExpire := true
            s.pendDir := 0
            s.fbWatch := 0
            if s.trDir != 0
                f_closeTrade(s, sC, 5)
    entryDir

// ───────────────────────────── Session objects ─────────────────────────────
var SessCfg cNY  = SessCfg.new(key = "NY", name = "New York", tz = nyTz, sh = nyH, sm = nyM, dur = nyDur, enabled = IS_CRYPTO ? nyOnC : nyOnF, days = f_mask(nySu, nyMo, nyTu, nyWe, nyTh, nyFr, nySa), holOn = nyHolOn, hol = nyHol, col = nyCol, fillCol = nyFill, tfOk = f_tfOk(nyDur), tf1hOk = f_tfOk(60))
var SessCfg cLDN = SessCfg.new(key = "LDN", name = "London", tz = ldTz, sh = ldH, sm = ldM, dur = ldDur, enabled = IS_CRYPTO ? ldOnC : ldOnF, days = f_mask(ldSu, ldMo, ldTu, ldWe, ldTh, ldFr, ldSa), holOn = ldHolOn, hol = ldHol, col = ldCol, fillCol = ldFill, tfOk = f_tfOk(ldDur), tf1hOk = f_tfOk(60))
var SessCfg cCME = SessCfg.new(key = "CME", name = "CME Globex", tz = cmTz, sh = cmH, sm = cmM, dur = cmDur, enabled = IS_CRYPTO ? cmOnC : cmOnF, days = f_mask(cmSu, cmMo, cmTu, cmWe, cmTh, cmFr, cmSa), holOn = cmHolOn, hol = cmHol, col = cmCol, fillCol = cmFill, tfOk = f_tfOk(cmDur), tf1hOk = f_tfOk(60))
var SessCfg cTKY = SessCfg.new(key = "TKY", name = "Tokyo", tz = tkTz, sh = tkH, sm = tkM, dur = tkDur, enabled = IS_CRYPTO ? tkOnC : tkOnF, days = f_mask(tkSu, tkMo, tkTu, tkWe, tkTh, tkFr, tkSa), holOn = tkHolOn, hol = tkHol, col = tkCol, fillCol = tkFill, tfOk = f_tfOk(tkDur), tf1hOk = f_tfOk(60))
var SessState sNY  = SessState.new()
var SessState sLDN = SessState.new()
var SessState sCME = SessState.new()
var SessState sTKY = SessState.new()

// ╔═══════════════════════════════════ END SHARED CORE ═══════════════════════════════════════╗

// (indicator-specific code between the two shared blocks: none)

// ╔═══════════════════════════════════ BEGIN SHARED RUN ══════════════════════════════════════╗
// Priority order NY → London → CME → Tokyo. With "One signal per bar" a later session cannot
// signal on a bar where an earlier one already did.
int eNY  = f_engine(cNY, sNY, true)
int eLDN = f_engine(cLDN, sLDN, not iOnePerBar or eNY == 0)
int eCME = f_engine(cCME, sCME, not iOnePerBar or (eNY == 0 and eLDN == 0))
int eTKY = f_engine(cTKY, sTKY, not iOnePerBar or (eNY == 0 and eLDN == 0 and eCME == 0))
// ╔═══════════════════════════════════ END SHARED RUN ════════════════════════════════════════╗

// ═════════════════════════════════════════════════════════════════════════════════════════════
//  INDICATOR — drawings, dashboard, alerts
// ═════════════════════════════════════════════════════════════════════════════════════════════

// ───────────────────────────── ⑩ Display ─────────────────────────────
string G_DSP = "⑩ Display"
bool   dBox     = input.bool(true, "Shade the range while it forms", group = G_DSP, display = display.none)
int    dFillTr  = input.int(85, "Range fill transparency", minval = 0, maxval = 100, group = G_DSP, display = display.none)
bool   dLevels  = input.bool(true, "ORH / ORL levels", inline = "lv", group = G_DSP, display = display.none)
bool   dMid     = input.bool(true, "50% midpoint", inline = "lv", group = G_DSP, display = display.none)
bool   d1h      = input.bool(false, "Show the 1-hour range alongside", group = G_DSP, display = display.none, tooltip = "Draws the first 60 minutes of each session as a second, dashed range. Display only — signals use the primary range. Hidden when the primary range is already 60 minutes.")
bool   dExtend  = input.bool(true, "Extend active levels to the right", group = G_DSP, display = display.none)
bool   dLabels  = input.bool(true, "Level labels", inline = "lb", group = G_DSP, display = display.none)
bool   dPrice   = input.bool(true, "price", inline = "lb", group = G_DSP, display = display.none)
bool   dAge     = input.bool(true, "age", inline = "lb", group = G_DSP, display = display.none)
int    dLblOff  = input.int(3, "Label offset (bars)", minval = 0, maxval = 100, group = G_DSP, display = display.none)
float  dMerge   = input.float(0.25, "Merge labels closer than × ATR", minval = 0, step = 0.05, group = G_DSP, display = display.none, tooltip = "Level labels whose prices are within this distance are merged into one label instead of overlapping.")
bool   dClean   = input.bool(false, "Clean mode — latest session only", group = G_DSP, display = display.none, tooltip = "Shows only the most recently started session's ranges; other sessions' drawings and all history are removed. Signals of all enabled sessions are still calculated.")
int    dKeep    = input.int(3, "Historical sessions to keep (each)", minval = 1, maxval = 10, group = G_DSP, display = display.none)
int    dLw      = input.int(1, "Level width", minval = 1, maxval = 4, group = G_DSP, display = display.none)
bool   dSig     = input.bool(true, "Signals", inline = "sg", group = G_DSP, display = display.none)
bool   dSetup   = input.bool(true, "setups", inline = "sg", group = G_DSP, display = display.none)
bool   dFalse   = input.bool(true, "false breakouts", inline = "sg", group = G_DSP, display = display.none)
bool   dTrade   = input.bool(true, "Entry / stop / targets", inline = "tr", group = G_DSP, display = display.none)
bool   dExitLb  = input.bool(true, "TP / SL markers", inline = "tr", group = G_DSP, display = display.none)
int    dKeepTr  = input.int(10, "Trades kept on chart", minval = 1, maxval = 40, group = G_DSP, display = display.none)
int    dMaxLbl  = input.int(150, "Max signal markers", minval = 20, maxval = 300, group = G_DSP, display = display.none)
color  cBull    = input.color(#089981, "Bull", inline = "cl", group = G_DSP)
color  cBear    = input.color(#F23645, "Bear", inline = "cl", group = G_DSP)
color  cWarn    = input.color(#FFD600, "Warning", inline = "cl", group = G_DSP)
color  cTxt     = input.color(color.white, "Text", inline = "cl", group = G_DSP)

// ───────────────────────────── ⑪ Dashboard ─────────────────────────────
string G_DB = "⑪ Dashboard"
bool   dbOn     = input.bool(true, "Show dashboard", group = G_DB, display = display.none)
string dbPos    = input.string("Top right", "Position", options = ["Top right", "Top center", "Top left", "Middle right", "Middle left", "Bottom right", "Bottom center", "Bottom left"], group = G_DB, display = display.none)
string dbSize   = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = G_DB, display = display.none)
bool   dbBias   = input.bool(true, "Multi-timeframe bias", group = G_DB, display = display.none, tooltip = "Last CONFIRMED close of each timeframe vs its EMA (non-repainting).")
string dbTf1    = input.timeframe("15", "Bias TFs", inline = "bt", group = G_DB, display = display.none)
string dbTf2    = input.timeframe("60", "", inline = "bt", group = G_DB, display = display.none)
string dbTf3    = input.timeframe("240", "", inline = "bt", group = G_DB, display = display.none)
int    dbBiasLn = input.int(21, "Bias EMA length", minval = 2, group = G_DB, display = display.none)
bool   dbValid  = input.bool(false, "Validation mode (window times in NY and UTC)", group = G_DB, display = display.none, tooltip = "Adds two columns with each session's current (or next) window start converted to New York time and UTC. Use it to check daylight-saving transitions.")

// ───────────────────────────── ⑫ Alerts ─────────────────────────────
string G_AL = "⑫ Alerts — one alert: condition = this indicator → “Any alert() function call”"
string alFmt    = input.string("Text", "Message format", options = ["Text", "JSON"], group = G_AL, display = display.none, tooltip = "JSON messages are meant for a webhook-driven PAPER-trading bot (e.g. AutoKel). Every message is sent once, at the close of a confirmed bar.")
string alBot    = input.string("AutoKel", "JSON bot tag", group = G_AL, display = display.none)
bool   alBreak  = input.bool(true, "Breakout entries", inline = "a1", group = G_AL, display = display.none)
bool   alRetest = input.bool(true, "Retest entries", inline = "a1", group = G_AL, display = display.none)
bool   alSetup  = input.bool(false, "Breakout setups (retest mode)", inline = "a2", group = G_AL, display = display.none)
bool   alFalse  = input.bool(true, "False breakouts", inline = "a2", group = G_AL, display = display.none)
bool   alExit   = input.bool(true, "TP / SL / exit events", group = G_AL, display = display.none)

string DB_SIZE = dbSize == "Tiny" ? size.tiny : dbSize == "Normal" ? size.normal : size.small
string SYM_FULL = syminfo.prefix + ":" + syminfo.ticker

// Multi-timeframe bias (previous confirmed candle of each TF).
[b1c, b1e] = request.security(STD_TICKER, dbTf1, [close[1], ta.ema(close, dbBiasLn)[1]], lookahead = barmerge.lookahead_on)
[b2c, b2e] = request.security(STD_TICKER, dbTf2, [close[1], ta.ema(close, dbBiasLn)[1]], lookahead = barmerge.lookahead_on)
[b3c, b3e] = request.security(STD_TICKER, dbTf3, [close[1], ta.ema(close, dbBiasLn)[1]], lookahead = barmerge.lookahead_on)

// ───────────────────────────── Drawing types ─────────────────────────────
type RangeDraw
    box   bx
    box   bx1h
    line  lh
    line  ll
    line  lm
    line  lh1
    line  ll1
    bool  active = true

type TradeDraw
    string id = ""
    line   le
    line   ls
    line   lt1
    line   lt2
    line   lbe
    label  xe
    label  xs
    label  xt1
    label  xt2
    bool   active = true

type SessDraw
    RangeDraw cur
    array<RangeDraw> hist
    TradeDraw tr

// ───────────────────────────── Drawing helpers ─────────────────────────────
f_delB(box b) =>
    if not na(b)
        box.delete(b)
    true

f_delL(line l) =>
    if not na(l)
        line.delete(l)
    true

f_delX(label x) =>
    if not na(x)
        label.delete(x)
    true

f_lnX2(line l, int x2) =>
    if not na(l)
        line.set_x2(l, x2)
    true

f_xlX(label x, int x2) =>
    if not na(x)
        label.set_x(x, x2)
    true

f_lnArchive(line l, color col) =>
    if not na(l)
        line.set_extend(l, extend.none)
        line.set_x2(l, time)
        line.set_style(l, line.style_dotted)
        line.set_color(l, col)
    true

f_rangeDelete(RangeDraw r) =>
    if not na(r)
        f_delB(r.bx)
        f_delB(r.bx1h)
        f_delL(r.lh)
        f_delL(r.ll)
        f_delL(r.lm)
        f_delL(r.lh1)
        f_delL(r.ll1)
    true

// Turns the current range into history: stops extension, dotted + faded, trims to the history limit.
f_archive(SessDraw d, SessCfg c) =>
    RangeDraw r = d.cur
    if not na(r)
        if r.active
            r.active := false
            if dClean
                f_rangeDelete(r)
            else
                color fc = color.new(c.col, 60)
                f_lnArchive(r.lh, fc)
                f_lnArchive(r.ll, fc)
                f_lnArchive(r.lm, fc)
                f_lnArchive(r.lh1, fc)
                f_lnArchive(r.ll1, fc)
                if not na(r.bx)
                    box.set_bgcolor(r.bx, color.new(c.fillCol, math.min(100, dFillTr + 7)))
                    box.set_border_style(r.bx, line.style_dotted)
                if not na(r.bx1h)
                    box.set_border_style(r.bx1h, line.style_dotted)
                d.hist.push(r)
                while d.hist.size() > dKeep
                    f_rangeDelete(d.hist.shift())
    true

f_tag(SessCfg c, SessState s) =>
    string t = c.key + " " + str.substring(s.winDate, 5, 10)
    if not s.valid
        t := t + (s.misaligned ? " ⚠ TF" : " ⚠ partial")
    else if s.partial
        t := t + " · partial"
    if not s.rangeOk
        t := t + " · size ✗"
    t

f_drawRange(SessCfg c, SessState s, SessDraw d) =>
    if s.evNewWin
        f_archive(d, c)
        RangeDraw nr = RangeDraw.new()
        if dBox
            nr.bx := box.new(s.winStart, sH, time, sL, xloc = xloc.bar_time, border_color = color.new(c.col, 30), border_width = 1, bgcolor = color.new(c.fillCol, dFillTr), text = f_tag(c, s), text_size = size.tiny, text_color = color.new(c.col, 0), text_halign = text.align_left, text_valign = text.align_top)
        if d1h and s.phase1h == 1
            nr.bx1h := box.new(s.winStart, sH, time, sL, xloc = xloc.bar_time, border_color = color.new(c.col, 55), border_width = 1, border_style = line.style_dashed, bgcolor = color.new(c.fillCol, math.min(100, dFillTr + 8)))
        d.cur := nr
    RangeDraw r = d.cur
    if not na(r)
        if r.active
            string ext = dExtend ? extend.right : extend.none
            // live formation box (updates intrabar; values are frozen only at the window close)
            if s.phase == 1 and time < s.winEnd and not na(r.bx)
                box.set_top(r.bx, s.hi)
                box.set_bottom(r.bx, s.lo)
                box.set_right(r.bx, time)
            if s.phase1h == 1 and time < s.win1hEnd and not na(r.bx1h)
                box.set_top(r.bx1h, s.hi1h)
                box.set_bottom(r.bx1h, s.lo1h)
                box.set_right(r.bx1h, time)
            if s.evRangeDone
                if not na(r.bx)
                    box.set_top(r.bx, s.orh)
                    box.set_bottom(r.bx, s.orl)
                    box.set_right(r.bx, s.endTime)
                    box.set_text(r.bx, f_tag(c, s))
                if dLevels
                    string lst = s.valid ? line.style_solid : line.style_dashed
                    r.lh := line.new(s.winStart, s.orh, time, s.orh, xloc = xloc.bar_time, extend = ext, color = c.col, style = lst, width = dLw)
                    r.ll := line.new(s.winStart, s.orl, time, s.orl, xloc = xloc.bar_time, extend = ext, color = c.col, style = lst, width = dLw)
                    if dMid
                        r.lm := line.new(s.winStart, s.mid, time, s.mid, xloc = xloc.bar_time, extend = ext, color = color.new(c.col, 40), style = line.style_dashed, width = 1)
            if s.ev1hDone and d1h
                if not na(r.bx1h)
                    box.set_top(r.bx1h, s.orh1h)
                    box.set_bottom(r.bx1h, s.orl1h)
                    box.set_right(r.bx1h, s.end1hTime)
                if dLevels and s.ok1h
                    r.lh1 := line.new(s.winStart, s.orh1h, time, s.orh1h, xloc = xloc.bar_time, extend = ext, color = color.new(c.col, 30), style = line.style_dotted, width = 1)
                    r.ll1 := line.new(s.winStart, s.orl1h, time, s.orl1h, xloc = xloc.bar_time, extend = ext, color = color.new(c.col, 30), style = line.style_dotted, width = 1)
            if not dExtend
                f_lnX2(r.lh, time)
                f_lnX2(r.ll, time)
                f_lnX2(r.lm, time)
                f_lnX2(r.lh1, time)
                f_lnX2(r.ll1, time)
            if s.evExpire
                f_archive(d, c)
    true

f_tradeClose(TradeDraw t, array<TradeDraw> hist) =>
    t.active := false
    f_lnX2(t.le, time)
    f_lnX2(t.lt1, time)
    f_lnX2(t.lt2, time)
    if na(t.lbe)
        f_lnX2(t.ls, time)
    else
        f_lnX2(t.lbe, time)
    f_delX(t.xe)
    f_delX(t.xs)
    f_delX(t.xt1)
    f_delX(t.xt2)
    hist.push(t)
    while hist.size() > dKeepTr
        TradeDraw o = hist.shift()
        f_delL(o.le)
        f_delL(o.ls)
        f_delL(o.lt1)
        f_delL(o.lt2)
        f_delL(o.lbe)
    true

f_tradeOpen(SessCfg c, SessState s, SessDraw d) =>
    int x1 = time
    int x2 = time + TF_SEC * 1000
    TradeDraw t = TradeDraw.new(id = s.trId)
    t.le  := line.new(x1, s.trEntry, x2, s.trEntry, xloc = xloc.bar_time, color = color.new(#B2B5BE, 0), width = 1)
    t.ls  := line.new(x1, s.trStop, x2, s.trStop, xloc = xloc.bar_time, color = cBear, width = 1)
    t.lt1 := line.new(x1, s.trTp1, x2, s.trTp1, xloc = xloc.bar_time, color = color.new(cBull, 35), style = line.style_dashed, width = 1)
    t.lt2 := line.new(x1, s.trTp2, x2, s.trTp2, xloc = xloc.bar_time, color = cBull, width = 1)
    t.xe  := label.new(x2, s.trEntry, c.key + " entry " + f_fmt(s.trEntry), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(#787B86, 15), textcolor = cTxt, size = size.tiny)
    t.xs  := label.new(x2, s.trStop, "SL " + f_fmt(s.trStop), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(cBear, 15), textcolor = cTxt, size = size.tiny)
    t.xt1 := label.new(x2, s.trTp1, "TP1 " + f_fmt(s.trTp1) + " (" + str.tostring(P_TP1) + "R)", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(cBull, 40), textcolor = cTxt, size = size.tiny)
    t.xt2 := label.new(x2, s.trTp2, "TP2 " + f_fmt(s.trTp2) + " (" + str.tostring(P_TP2) + "R)", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(cBull, 15), textcolor = cTxt, size = size.tiny)
    d.tr := t
    true

// Order: close the old trade drawing → (range drawing elsewhere) → open the new one → extend the live one.
f_tradeDraw(SessCfg c, SessState s, SessDraw d, array<TradeDraw> hist) =>
    if not na(d.tr)
        if d.tr.active and s.evExitDir != 0 and d.tr.id == s.evExitId
            f_tradeClose(d.tr, hist)
    if dTrade and s.evEntry != 0
        if not na(d.tr)
            if d.tr.active
                f_tradeClose(d.tr, hist)
        f_tradeOpen(c, s, d)
    if not na(d.tr)
        TradeDraw t = d.tr
        if t.active and s.trDir != 0 and t.id == s.trId
            int x2 = time + TF_SEC * 1000
            if s.evTp1 and s.trBE and na(t.lbe)
                f_lnX2(t.ls, time)
                t.lbe := line.new(time, s.trStop, x2, s.trStop, xloc = xloc.bar_time, color = cBear, style = line.style_dotted, width = 1)
                if not na(t.xs)
                    label.set_y(t.xs, s.trStop)
                    label.set_text(t.xs, "BE " + f_fmt(s.trStop))
            f_lnX2(t.le, x2)
            f_lnX2(t.lt1, x2)
            f_lnX2(t.lt2, x2)
            if na(t.lbe)
                f_lnX2(t.ls, x2)
            else
                f_lnX2(t.lbe, x2)
            f_xlX(t.xe, x2)
            f_xlX(t.xs, x2)
            f_xlX(t.xt1, x2)
            f_xlX(t.xt2, x2)
    true

f_push(array<label> pool, label l) =>
    pool.push(l)
    if pool.size() > dMaxLbl
        label.delete(pool.shift())
    true

f_marks(SessCfg c, SessState s, array<label> pool) =>
    if dExitLb and s.evExitDir != 0
        bool good = not na(s.evExitR) and s.evExitR > 0
        f_push(pool, label.new(bar_index, s.evExitPx, c.key + " " + f_reasonShort(s.evExitReason) + " " + f_rTxt(s.evExitR), style = label.style_label_left, color = color.new(good ? cBull : s.evExitReason == 4 ? #787B86 : cBear, 25), textcolor = cTxt, size = size.tiny, tooltip = c.name + " exit (" + f_reason(s.evExitReason) + ") at " + f_fmt(s.evExitPx) + "\nID " + s.evExitId))
    if dExitLb and s.evTp1
        f_push(pool, label.new(bar_index, s.evTp1Px, c.key + " TP1" + (P_BE ? " → BE" : ""), style = label.style_label_left, color = color.new(cBull, 35), textcolor = cTxt, size = size.tiny, tooltip = c.name + " TP1 reached at " + f_fmt(s.evTp1Px) + (P_BE ? "\nStop moved to " + f_fmt(s.evTp1Stop) : "") + "\nID " + s.evTp1Id))
    if dFalse and s.evFalse != 0
        f_push(pool, label.new(bar_index, s.evFalse > 0 ? sH : sL, "✕ " + c.key, yloc = s.evFalse > 0 ? yloc.abovebar : yloc.belowbar, style = s.evFalse > 0 ? label.style_label_down : label.style_label_up, color = cWarn, textcolor = color.black, size = size.tiny, tooltip = c.name + ": " + (s.evFalse > 0 ? "bullish" : "bearish") + " breakout failed — closed back inside the range"))
    if dSetup and s.evSetup != 0
        f_push(pool, label.new(bar_index, s.evSetup > 0 ? sL : sH, c.key + " BO", yloc = s.evSetup > 0 ? yloc.belowbar : yloc.abovebar, style = s.evSetup > 0 ? label.style_label_up : label.style_label_down, color = color.new(s.evSetup > 0 ? cBull : cBear, 65), textcolor = cTxt, size = size.tiny, tooltip = c.name + " breakout — waiting up to " + str.tostring(iRetestBars) + " bars for a retest"))
    if dSig and s.evEntry != 0
        int dir = s.evEntry
        string kind = s.trType == "RETEST" ? "RT" : s.trType == "MOMENTUM" ? "MO" : "BO"
        string tip = c.name + " " + (dir > 0 ? "LONG " : "SHORT ") + s.trType + "\nEntry " + f_fmt(s.trEntry) + "\nStop " + f_fmt(s.trStop) + "\nTP1 " + f_fmt(s.trTp1) + "   TP2 " + f_fmt(s.trTp2) + "\nORH " + f_fmt(s.orh) + "   ORL " + f_fmt(s.orl) + "\nID " + s.trId
        f_push(pool, label.new(bar_index, dir > 0 ? sL : sH, c.key + (dir > 0 ? " ▲ " : " ▼ ") + kind, yloc = dir > 0 ? yloc.belowbar : yloc.abovebar, style = dir > 0 ? label.style_label_up : label.style_label_down, color = dir > 0 ? cBull : cBear, textcolor = cTxt, size = size.small, tooltip = tip))
    true

// ───────────────────────────── Alerts ─────────────────────────────
f_num(float v) =>
    na(v) ? "null" : str.tostring(v, format.mintick)

f_iso(int t) =>
    str.format_time(t, "yyyy-MM-dd", "GMT+0") + "T" + str.format_time(t, "HH:mm:ss", "GMT+0") + "Z"

f_msg(SessCfg c, SessState s, string ev, string kind, int dir, float entry, float stop, float tp1, float tp2, float px, float r, string id) =>
    string side = dir > 0 ? "long" : dir < 0 ? "short" : "flat"
    string m = ""
    if alFmt == "JSON"
        m := '{"source":"MS-ORB-Pro","bot":"' + alBot + '","schema":1,"paper_only":true,"event":"' + ev + '","type":"' + kind + '","side":"' + side + '"'
        m := m + ',"symbol":"' + SYM_FULL + '","ticker":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","profile":"' + str.lower(PROFILE_NAME) + '"'
        m := m + ',"session":"' + c.key + '","session_name":"' + c.name + '","session_date":"' + s.winDate + '","orh":' + f_num(s.orh) + ',"orl":' + f_num(s.orl)
        m := m + ',"entry":' + f_num(entry) + ',"stop":' + f_num(stop) + ',"tp1":' + f_num(tp1) + ',"tp2":' + f_num(tp2) + ',"price":' + f_num(px)
        m := m + ',"r":' + (na(r) ? "null" : str.tostring(r, "#.##")) + ',"tp1_r":' + str.tostring(P_TP1) + ',"tp2_r":' + str.tostring(P_TP2) + ',"tp1_pct":' + str.tostring(P_TP1PCT)
        m := m + ',"signal_id":"' + id + '","bar_close_utc":"' + f_iso(BAR_TC) + '","bar_close_ms":' + str.tostring(BAR_TC) + '}'
    else
        m := "MS-ORB Pro | " + syminfo.ticker + " " + f_tfLabel() + " | " + c.name + " | " + ev + " " + kind + (dir != 0 ? " " + str.upper(side) : "")
        if not na(entry)
            m := m + " | Entry " + f_fmt(entry)
        if not na(stop)
            m := m + " | SL " + f_fmt(stop)
        if not na(tp1)
            m := m + " | TP1 " + f_fmt(tp1) + " (" + str.tostring(P_TP1) + "R)"
        if not na(tp2)
            m := m + " | TP2 " + f_fmt(tp2) + " (" + str.tostring(P_TP2) + "R)"
        if not na(px)
            m := m + " | Price " + f_fmt(px)
        if not na(r)
            m := m + " | " + f_rTxt(r)
        m := m + " | ORH " + f_fmt(s.orh) + " ORL " + f_fmt(s.orl) + (id != "" ? " | ID " + id : "")
    m

// Called only on confirmed bars → one message per event, after the candle has closed.
f_alerts(SessCfg c, SessState s) =>
    if alExit and s.evExitDir != 0
        alert(f_msg(c, s, "EXIT", f_reason(s.evExitReason), s.evExitDir, na, na, na, na, s.evExitPx, s.evExitR, s.evExitId), alert.freq_all)
    if alExit and s.evTp1
        alert(f_msg(c, s, "TP1", P_BE ? "TARGET_1_STOP_TO_BREAKEVEN" : "TARGET_1", s.evTp1Dir, na, s.evTp1Stop, s.evTp1Px, na, s.evTp1Px, P_TP1, s.evTp1Id), alert.freq_all)
    if alFalse and s.evFalse != 0
        alert(f_msg(c, s, "WARNING", "FALSE_BREAKOUT", s.evFalse, na, na, na, na, sC, na, ""), alert.freq_all)
    if alSetup and s.evSetup != 0
        alert(f_msg(c, s, "SETUP", "BREAKOUT_AWAITING_RETEST", s.evSetup, na, na, na, na, sC, na, ""), alert.freq_all)
    if s.evEntry != 0
        bool isRt = s.trType == "RETEST"
        if (isRt and alRetest) or (not isRt and alBreak)
            alert(f_msg(c, s, "ENTRY", s.trType, s.evEntry, s.trEntry, s.trStop, s.trTp1, s.trTp2, sC, na, s.trId), alert.freq_all)
    true

// ───────────────────────────── Dashboard helpers ─────────────────────────────
f_dayName(int dow) =>
    switch dow
        1 => "Sun"
        2 => "Mon"
        3 => "Tue"
        4 => "Wed"
        5 => "Thu"
        6 => "Fri"
        => "Sat"

f_when(int t, string tz) =>
    na(t) ? "—" : f_dayName(dayofweek(t, tz)) + " " + str.format_time(t, "HH:mm", tz)

// Next window start after t that falls on an enabled day and is not a listed holiday.
f_nextStart(SessCfg c, int t) =>
    int res = na
    int noon = timestamp(c.tz, year(t, c.tz), month(t, c.tz), dayofmonth(t, c.tz), 12, 0, 0)
    for i = 0 to 9
        int p = noon + i * 86400000
        int cand = timestamp(c.tz, year(p, c.tz), month(p, c.tz), dayofmonth(p, c.tz), c.sh, c.sm, 0)
        if cand > t and f_dayOk(c, cand) and not f_isHoliday(c, f_dateStr(cand, c.tz))
            res := cand
            break
    res

f_age(int ms) =>
    int mins = math.floor(ms / 60000)
    mins < 60 ? str.tostring(mins) + "m" : str.tostring(math.floor(mins / 60)) + "h"

// Status text for a session in its active phase (phase 2 = range complete, levels live).
f_activeStatus(SessState s) =>
    switch
        not s.valid             => s.misaligned ? "Range ✗ TF" : "Range ✗ partial"
        not s.rangeOk           => "Range ✗ size"
        s.trDir != 0            => s.trTp1Hit ? "In trade · TP1 ✓" : "In trade"
        s.pendDir != 0          => "Breakout · retest?"
        s.lastEvt == EVT_FALSE  => "False breakout"
        s.lastEvt == EVT_TP2    => "Done · TP2"
        s.lastEvt == EVT_SL     => "Done · stopped"
        s.lastEvt == EVT_BE     => "Done · break-even"
        s.lastEvt == EVT_EXIT   => "Done · time exit"
        s.lastEvt == EVT_FILTERED => "Breakout (filtered)"
        s.lastEvt == EVT_TIMEOUT  => "Retest timed out"
        s.lastEvt == EVT_RETFAIL  => "Retest failed"
        s.lastBrkDir != 0       => "Breakout"
        not na(s.sigEndAt) and BAR_TC > s.sigEndAt => "Range · window over"
        => "Range"

f_activeColor(SessState s) =>
    int d = s.trDir != 0 ? s.trDir : s.pendDir != 0 ? s.pendDir : s.lastBrkDir
    color dc = d > 0 ? cBull : cBear
    switch
        not s.valid or not s.rangeOk => cWarn
        s.trDir != 0 or s.pendDir != 0 => dc
        s.lastEvt == EVT_FALSE or s.lastEvt == EVT_RETFAIL => cWarn
        s.lastEvt == EVT_TP2 => cBull
        s.lastEvt == EVT_SL => cBear
        s.lastEvt == EVT_BE or s.lastEvt == EVT_EXIT or s.lastEvt == EVT_TIMEOUT => #787B86
        s.lastEvt == EVT_FILTERED => #B2B5BE
        s.lastBrkDir != 0 => dc
        => #D1D4DC

f_status(SessCfg c, SessState s) =>
    string st = "Waiting"
    color col = #787B86
    if not c.enabled
        st := "Off"
    else if not c.tfOk or not CHART_OK
        st := "TF ✗"
        col := cWarn
    else if s.phase == 1
        st := "Forming"
        col := c.col
    else if s.phase == 2
        st := f_activeStatus(s)
        col := f_activeColor(s)
    [st, col]

f_dirOf(SessState s) =>
    int d = s.phase == 2 ? (s.trDir != 0 ? s.trDir : s.pendDir != 0 ? s.pendDir : s.lastBrkDir) : 0
    d

f_rangeTxt(SessState s) =>
    string t = "—"
    if s.phase == 1 and not na(s.hi)
        t := f_fmt(s.hi - s.lo) + " …"
    else if s.phase == 2
        t := f_fmt(s.orh - s.orl) + (IS_CRYPTO ? "" : " (" + str.tostring(math.round((s.orh - s.orl) / syminfo.mintick)) + "t)")
    t

f_bias(float c, float e) =>
    na(c) or na(e) ? "–" : c > e ? "▲" : c < e ? "▼" : "="

f_tfName(simple string tf) =>
    int sec = timeframe.in_seconds(tf)
    sec >= 86400 ? tf : sec >= 3600 and sec % 3600 == 0 ? str.tostring(math.floor(sec / 3600)) + "H" : str.tostring(math.floor(sec / 60)) + "m"

f_cell(table t, int col, int row, string txt, color fg, color bg) =>
    table.cell(t, col, row, txt, text_color = fg, bgcolor = bg, text_size = DB_SIZE, text_halign = text.align_left)
    true

f_warnings() =>
    string w = ""
    if not TIME_CHART
        w := "⚠ Use a time-based intraday chart (1m / 3m / 5m / 15m recommended)."
    else if not CHART_OK
        w := "⚠ Renko / Kagi / P&F / Line-break / Range charts are not supported."
    else
        string bad = (cNY.enabled and not cNY.tfOk ? " NY" : "") + (cLDN.enabled and not cLDN.tfOk ? " LDN" : "") + (cCME.enabled and not cCME.tfOk ? " CME" : "") + (cTKY.enabled and not cTKY.tfOk ? " TKY" : "")
        if bad != ""
            w := "⚠ " + f_tfLabel() + " bars cannot tile the range for:" + bad + ". Use a timeframe that divides the range length (15-min range → 1/3/5/15m). Those sessions are disabled, not approximated."
        if d1h and not cNY.tf1hOk
            w := w + (w != "" ? "\n" : "") + "⚠ 1-hour range needs a timeframe that divides 60 minutes."
    if uHtf and TIME_CHART and timeframe.in_seconds(uHtfTf) <= TF_SEC
        w := w + (w != "" ? "\n" : "") + "⚠ HTF filter timeframe should be higher than the chart timeframe."
    if uVol and na(volume)
        w := w + (w != "" ? "\n" : "") + "⚠ No volume data on this symbol: volume filter is ignored."
    if not IS_CRYPTO and syminfo.session == session.regular and (cLDN.enabled or cCME.enabled or cTKY.enabled)
        w := w + (w != "" ? "\n" : "") + "⚠ Chart shows regular hours only: London / CME / Tokyo windows need extended (ETH) bars."
    string yr = str.tostring(year(BAR_TC, "GMT+0"))
    string noHol = (cNY.enabled and cNY.holOn and not str.contains(cNY.hol, yr) ? " NY" : "") + (cLDN.enabled and cLDN.holOn and not str.contains(cLDN.hol, yr) ? " LDN" : "") + (cTKY.enabled and cTKY.holOn and not str.contains(cTKY.hol, yr) ? " TKY" : "")
    if noHol != ""
        w := w + (w != "" ? "\n" : "") + "⚠ Holiday list has no " + yr + " dates for:" + noHol + " — add them in the session settings."
    w

// ───────────────────────────── Per-bar rendering ─────────────────────────────
var SessDraw dNY  = SessDraw.new(hist = array.new<RangeDraw>())
var SessDraw dLDN = SessDraw.new(hist = array.new<RangeDraw>())
var SessDraw dCME = SessDraw.new(hist = array.new<RangeDraw>())
var SessDraw dTKY = SessDraw.new(hist = array.new<RangeDraw>())
var array<SessCfg>   A_CFG = array.new<SessCfg>()
var array<SessState> A_ST  = array.new<SessState>()
var array<SessDraw>  A_DR  = array.new<SessDraw>()
var array<TradeDraw> TR_HIST = array.new<TradeDraw>()
var array<label>     SIG_LBL = array.new<label>()
var array<label>     LVL_LBL = array.new<label>()
if barstate.isfirst
    A_CFG.push(cNY)
    A_CFG.push(cLDN)
    A_CFG.push(cCME)
    A_CFG.push(cTKY)
    A_ST.push(sNY)
    A_ST.push(sLDN)
    A_ST.push(sCME)
    A_ST.push(sTKY)
    A_DR.push(dNY)
    A_DR.push(dLDN)
    A_DR.push(dCME)
    A_DR.push(dTKY)

for i = 0 to 3
    SessCfg c = A_CFG.get(i)
    SessState s = A_ST.get(i)
    SessDraw d = A_DR.get(i)
    f_tradeDraw(c, s, d, TR_HIST)
    f_drawRange(c, s, d)
    f_marks(c, s, SIG_LBL)
    if barstate.isconfirmed
        f_alerts(c, s)

// Clean mode: only the most recently started session keeps its drawings.
if dClean
    int latest = math.max(nz(sNY.winStart, 0), nz(sLDN.winStart, 0), nz(sCME.winStart, 0), nz(sTKY.winStart, 0))
    for i = 0 to 3
        SessState s = A_ST.get(i)
        if nz(s.winStart, 0) < latest
            f_archive(A_DR.get(i), A_CFG.get(i))

// ───────────────────────────── Level labels (last bar only, merged to avoid overlap) ─────────────────────────────
if barstate.islast
    for l in LVL_LBL
        label.delete(l)
    LVL_LBL.clear()
    if dLabels and dLevels
        array<float>  ps = array.new<float>()
        array<string> ts = array.new<string>()
        array<color>  cs = array.new<color>()
        for i = 0 to 3
            SessCfg c = A_CFG.get(i)
            SessState s = A_ST.get(i)
            RangeDraw r = A_DR.get(i).cur
            if not na(r)
                if r.active and s.phase == 2
                    string age = dAge ? " · " + f_age(BAR_TC - s.winEnd) : ""
                    ps.push(s.orh)
                    ts.push(c.key + " ORH" + (dPrice ? " " + f_fmt(s.orh) : "") + age)
                    cs.push(c.col)
                    ps.push(s.orl)
                    ts.push(c.key + " ORL" + (dPrice ? " " + f_fmt(s.orl) : "") + age)
                    cs.push(c.col)
                    if dMid
                        ps.push(s.mid)
                        ts.push(c.key + " 50%" + (dPrice ? " " + f_fmt(s.mid) : ""))
                        cs.push(color.new(c.col, 30))
                    if d1h and s.phase1h == 2 and s.ok1h
                        ps.push(s.orh1h)
                        ts.push(c.key + " 1H H" + (dPrice ? " " + f_fmt(s.orh1h) : ""))
                        cs.push(color.new(c.col, 30))
                        ps.push(s.orl1h)
                        ts.push(c.key + " 1H L" + (dPrice ? " " + f_fmt(s.orl1h) : ""))
                        cs.push(color.new(c.col, 30))
        int n = ps.size()
        if n > 0
            array<int> idx = ps.sort_indices(order.descending)
            float gap = nz(atrV) * dMerge
            int xL = time + dLblOff * TF_SEC * 1000
            float sumP = 0.0
            float lastP = na
            string txt = ""
            color gcol = na
            int cnt = 0
            for k = 0 to n - 1
                int j = idx.get(k)
                float p = ps.get(j)
                if cnt > 0 and math.abs(lastP - p) > gap
                    LVL_LBL.push(label.new(xL, sumP / cnt, txt, xloc = xloc.bar_time, style = label.style_label_left, color = cnt > 1 ? color.new(#5D606B, 10) : color.new(gcol, 15), textcolor = cTxt, size = size.small, tooltip = txt))
                    cnt := 0
                    sumP := 0.0
                    txt := ""
                if cnt == 0
                    txt := ts.get(j)
                    gcol := cs.get(j)
                else
                    txt := txt + "\n" + ts.get(j)
                sumP := sumP + p
                lastP := p
                cnt := cnt + 1
            if cnt > 0
                LVL_LBL.push(label.new(xL, sumP / cnt, txt, xloc = xloc.bar_time, style = label.style_label_left, color = cnt > 1 ? color.new(#5D606B, 10) : color.new(gcol, 15), textcolor = cTxt, size = size.small, tooltip = txt))

// ───────────────────────────── Dashboard ─────────────────────────────
var table dash = dbOn ? table.new(f_pos(dbPos), 6, 11, bgcolor = color.new(#131722, 8), frame_color = color.new(#787B86, 40), frame_width = 1, border_color = color.new(#2A2E39, 0), border_width = 1) : na
if dbOn and barstate.islast
    int nCol = dbValid ? 6 : 4
    color hdrBg = color.new(#2A2E39, 0)
    color rowBg = color.new(#131722, 8)
    table.clear(dash, 0, 0, 5, 10)
    f_cell(dash, 0, 0, "MS-ORB Pro · " + syminfo.ticker + " · " + f_tfLabel() + " · " + PROFILE_NAME + " profile", cTxt, hdrBg)
    table.merge_cells(dash, 0, 0, nCol - 1, 0)
    f_cell(dash, 0, 1, "Session", #B2B5BE, hdrBg)
    f_cell(dash, 1, 1, "Status", #B2B5BE, hdrBg)
    f_cell(dash, 2, 1, "Dir", #B2B5BE, hdrBg)
    f_cell(dash, 3, 1, "Range", #B2B5BE, hdrBg)
    if dbValid
        f_cell(dash, 4, 1, "Window NY", #B2B5BE, hdrBg)
        f_cell(dash, 5, 1, "Window UTC", #B2B5BE, hdrBg)
    int curIdx = -1
    int curStart = 0
    for i = 0 to 3
        SessCfg c = A_CFG.get(i)
        SessState s = A_ST.get(i)
        [stTxt, stCol] = f_status(c, s)
        int dr = f_dirOf(s)
        string nm = c.name + (dbValid ? " " + (c.sh < 10 ? "0" : "") + str.tostring(c.sh) + ":" + (c.sm < 10 ? "0" : "") + str.tostring(c.sm) : "")
        bool live = s.phase == 1 or s.phase == 2
        int shown = live ? s.winStart : (c.enabled ? f_nextStart(c, BAR_TC) : na)
        string stFull = stTxt == "Waiting" and not na(shown) ? "Waiting · " + f_when(shown, c.tz) : stTxt
        f_cell(dash, 0, i + 2, nm, c.enabled ? c.col : #5D606B, rowBg)
        f_cell(dash, 1, i + 2, stFull, stCol, rowBg)
        f_cell(dash, 2, i + 2, dr > 0 ? "Bull" : dr < 0 ? "Bear" : "—", dr > 0 ? cBull : dr < 0 ? cBear : #787B86, rowBg)
        f_cell(dash, 3, i + 2, c.enabled ? f_rangeTxt(s) : "—", #D1D4DC, rowBg)
        if dbValid
            f_cell(dash, 4, i + 2, c.enabled ? f_when(shown, "America/New_York") : "—", #D1D4DC, rowBg)
            f_cell(dash, 5, i + 2, c.enabled ? f_when(shown, "GMT+0") : "—", #D1D4DC, rowBg)
        if c.enabled and live and s.winStart > curStart
            curStart := s.winStart
            curIdx := i
    // current session + its range
    string curTxt = "Current: none active"
    string rngTxt = "Range: —"
    if curIdx >= 0
        SessCfg c = A_CFG.get(curIdx)
        SessState s = A_ST.get(curIdx)
        [cs1, cc1] = f_status(c, s)
        curTxt := "Current: " + c.name + " · " + cs1 + " · started " + f_age(BAR_TC - s.winStart) + " ago"
        if s.phase == 2
            float rg = s.orh - s.orl
            rngTxt := "Range " + f_fmt(s.orl) + " – " + f_fmt(s.orh) + " · size " + f_fmt(rg) + (IS_CRYPTO ? " (" + str.tostring(rg / s.orl * 100, "#.##") + "%)" : " (" + str.tostring(math.round(rg / syminfo.mintick)) + " ticks)") + (na(dAtr) ? "" : " · " + str.tostring(rg / dAtr * 100, "#") + "% of daily ATR")
        else
            rngTxt := "Range forming: " + f_fmt(s.lo) + " – " + f_fmt(s.hi) + " (not final until " + str.format_time(s.winEnd, "HH:mm", c.tz) + " " + c.key + " time)"
    f_cell(dash, 0, 6, curTxt, cTxt, rowBg)
    table.merge_cells(dash, 0, 6, nCol - 1, 6)
    f_cell(dash, 0, 7, rngTxt, #D1D4DC, rowBg)
    table.merge_cells(dash, 0, 7, nCol - 1, 7)
    string flt = (uEma921 ? " EMA9/21" : "") + (uEma50200 ? " EMA50/200" : "") + (uVol ? " VOL" : "") + (uAtrVol ? " ATR" : "") + (uRange ? " SIZE" : "") + (uRsi ? " RSI" : "") + (uHtf ? " HTF " + f_tfName(uHtfTf) : "")
    string modeTxt = "Mode: " + iMode + " · " + iDir + " · filters:" + (flt == "" ? " none" : flt)
    f_cell(dash, 0, 8, modeTxt, #B2B5BE, rowBg)
    table.merge_cells(dash, 0, 8, nCol - 1, 8)
    int nextRow = 9
    if dbBias
        string bias = "Bias (EMA " + str.tostring(dbBiasLn) + "): " + f_tfName(dbTf1) + " " + f_bias(b1c, b1e) + " · " + f_tfName(dbTf2) + " " + f_bias(b2c, b2e) + " · " + f_tfName(dbTf3) + " " + f_bias(b3c, b3e)
        f_cell(dash, 0, nextRow, bias, #D1D4DC, rowBg)
        table.merge_cells(dash, 0, nextRow, nCol - 1, nextRow)
        nextRow := nextRow + 1
    string w = f_warnings()
    if w != ""
        f_cell(dash, 0, nextRow, w, cWarn, rowBg)
        table.merge_cells(dash, 0, nextRow, nCol - 1, nextRow)

// Chart warning when the dashboard is hidden.
var label warnLbl = na
if barstate.islast
    f_delX(warnLbl)
    string w = dbOn ? "" : f_warnings()
    warnLbl := w != "" ? label.new(bar_index, sH, "MS-ORB Pro\n" + w, yloc = yloc.abovebar, style = label.style_label_down, color = color.new(#131722, 5), textcolor = cWarn, size = size.small) : na

// ───────────────────────────── Alert conditions + Data Window values ─────────────────────────────
f_isBO(SessState s, int dir) =>
    s.evEntry == dir and s.trType != "RETEST"

f_isRT(SessState s, int dir) =>
    s.evEntry == dir and s.trType == "RETEST"

bool A_BULL_BO = f_isBO(sNY, 1) or f_isBO(sLDN, 1) or f_isBO(sCME, 1) or f_isBO(sTKY, 1)
bool A_BEAR_BO = f_isBO(sNY, -1) or f_isBO(sLDN, -1) or f_isBO(sCME, -1) or f_isBO(sTKY, -1)
bool A_BULL_RT = f_isRT(sNY, 1) or f_isRT(sLDN, 1) or f_isRT(sCME, 1) or f_isRT(sTKY, 1)
bool A_BEAR_RT = f_isRT(sNY, -1) or f_isRT(sLDN, -1) or f_isRT(sCME, -1) or f_isRT(sTKY, -1)
bool A_FALSE   = sNY.evFalse != 0 or sLDN.evFalse != 0 or sCME.evFalse != 0 or sTKY.evFalse != 0
bool A_TRADE   = sNY.evTp1 or sLDN.evTp1 or sCME.evTp1 or sTKY.evTp1 or sNY.evExitDir != 0 or sLDN.evExitDir != 0 or sCME.evExitDir != 0 or sTKY.evExitDir != 0

int   SIG_SESS  = sNY.evEntry != 0 ? 1 : sLDN.evEntry != 0 ? 2 : sCME.evEntry != 0 ? 3 : sTKY.evEntry != 0 ? 4 : 0
float SIG_DIR   = SIG_SESS == 1 ? sNY.evEntry : SIG_SESS == 2 ? sLDN.evEntry : SIG_SESS == 3 ? sCME.evEntry : SIG_SESS == 4 ? sTKY.evEntry : na
float SIG_ENTRY = SIG_SESS == 1 ? sNY.trEntry : SIG_SESS == 2 ? sLDN.trEntry : SIG_SESS == 3 ? sCME.trEntry : SIG_SESS == 4 ? sTKY.trEntry : na
float SIG_STOP  = SIG_SESS == 1 ? sNY.trStop : SIG_SESS == 2 ? sLDN.trStop : SIG_SESS == 3 ? sCME.trStop : SIG_SESS == 4 ? sTKY.trStop : na
float SIG_TP1   = SIG_SESS == 1 ? sNY.trTp1 : SIG_SESS == 2 ? sLDN.trTp1 : SIG_SESS == 3 ? sCME.trTp1 : SIG_SESS == 4 ? sTKY.trTp1 : na
float SIG_TP2   = SIG_SESS == 1 ? sNY.trTp2 : SIG_SESS == 2 ? sLDN.trTp2 : SIG_SESS == 3 ? sCME.trTp2 : SIG_SESS == 4 ? sTKY.trTp2 : na

plot(SIG_SESS > 0 ? SIG_SESS : na, "Sig session", display = display.data_window)
plot(SIG_DIR, "Sig direction", display = display.data_window)
plot(SIG_ENTRY, "Sig entry", display = display.data_window)
plot(SIG_STOP, "Sig stop", display = display.data_window)
plot(SIG_TP1, "Sig TP1", display = display.data_window)
plot(SIG_TP2, "Sig TP2", display = display.data_window)
plot(sNY.phase == 2 ? sNY.orh : na, "NY ORH", display = display.data_window)
plot(sNY.phase == 2 ? sNY.orl : na, "NY ORL", display = display.data_window)
plot(sLDN.phase == 2 ? sLDN.orh : na, "LDN ORH", display = display.data_window)
plot(sLDN.phase == 2 ? sLDN.orl : na, "LDN ORL", display = display.data_window)
plot(sCME.phase == 2 ? sCME.orh : na, "CME ORH", display = display.data_window)
plot(sCME.phase == 2 ? sCME.orl : na, "CME ORL", display = display.data_window)
plot(sTKY.phase == 2 ? sTKY.orh : na, "TKY ORH", display = display.data_window)
plot(sTKY.phase == 2 ? sTKY.orl : na, "TKY ORL", display = display.data_window)

alertcondition(A_BULL_BO, "ORB bullish breakout", 'MS-ORB Pro BULLISH BREAKOUT | {{exchange}}:{{ticker}} {{interval}} | session {{plot("Sig session")}} (1 NY, 2 LDN, 3 CME, 4 TKY) | entry {{plot("Sig entry")}} | stop {{plot("Sig stop")}} | TP1 {{plot("Sig TP1")}} | TP2 {{plot("Sig TP2")}}')
alertcondition(A_BEAR_BO, "ORB bearish breakout", 'MS-ORB Pro BEARISH BREAKOUT | {{exchange}}:{{ticker}} {{interval}} | session {{plot("Sig session")}} (1 NY, 2 LDN, 3 CME, 4 TKY) | entry {{plot("Sig entry")}} | stop {{plot("Sig stop")}} | TP1 {{plot("Sig TP1")}} | TP2 {{plot("Sig TP2")}}')
alertcondition(A_BULL_RT, "ORB bullish retest", 'MS-ORB Pro BULLISH RETEST | {{exchange}}:{{ticker}} {{interval}} | session {{plot("Sig session")}} (1 NY, 2 LDN, 3 CME, 4 TKY) | entry {{plot("Sig entry")}} | stop {{plot("Sig stop")}} | TP1 {{plot("Sig TP1")}} | TP2 {{plot("Sig TP2")}}')
alertcondition(A_BEAR_RT, "ORB bearish retest", 'MS-ORB Pro BEARISH RETEST | {{exchange}}:{{ticker}} {{interval}} | session {{plot("Sig session")}} (1 NY, 2 LDN, 3 CME, 4 TKY) | entry {{plot("Sig entry")}} | stop {{plot("Sig stop")}} | TP1 {{plot("Sig TP1")}} | TP2 {{plot("Sig TP2")}}')
alertcondition(A_FALSE, "ORB false-breakout warning", 'MS-ORB Pro FALSE BREAKOUT | {{exchange}}:{{ticker}} {{interval}} | price closed back inside an opening range | close {{close}}')
alertcondition(A_TRADE, "ORB TP / SL / exit event", 'MS-ORB Pro TRADE EVENT | {{exchange}}:{{ticker}} {{interval}} | TP1, TP2, stop or time exit on a tracked signal | close {{close}}')
alertcondition(A_BULL_BO or A_BEAR_BO or A_BULL_RT or A_BEAR_RT, "ORB any entry signal", 'MS-ORB Pro ENTRY | {{exchange}}:{{ticker}} {{interval}} | direction {{plot("Sig direction")}} (1 long, -1 short) | session {{plot("Sig session")}} | entry {{plot("Sig entry")}} | stop {{plot("Sig stop")}} | TP1 {{plot("Sig TP1")}} | TP2 {{plot("Sig TP2")}}')
