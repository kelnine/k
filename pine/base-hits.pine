// ──────────────────────────────── TYPES ───────────────────────────────────
type Sess
    string name
    color  col
    bool   on       = false
    bool   wasIn    = false
    float  hi       = na
    float  lo       = na
    box    bx       = na
    float  pHi      = na
    float  pLo      = na
    int    pAt      = na
    bool   pHiSwept = false
    bool   pLoSwept = false
    line   hiLn     = na
    line   loLn     = na
    label  hiLb     = na
    label  loLb     = na
    array<float> rng
    array<float> hHit
    array<float> lHit

type Per
    string name
    color  col
    float  wH   = na
    float  wL   = na
    bool   hitH = false
    bool   hitL = false
    array<float> rng
    array<float> hHit
    array<float> lHit

type Lvl
    string name
    color  col
    line   ln = na
    label  lb = na

type DRange
    box   prem = na
    box   disc = na
    line  eq   = na
    line  q75  = na
    line  q25  = na
    label lb   = na

type Trade
    bool  active = false
    bool  be     = false
    bool  tp1    = false
    int   dir    = 0
    float entry  = na
    float stop   = na
    float tgt    = na
    float risk   = na
    float tp1Px  = na
    box   rBx    = na
    box   tBx    = na
    line  tp1Ln  = na
    label tp1Lb  = na
    label lb     = na

// ────────────────────────────── HELPERS ───────────────────────────────────
capPush(array<float> a, float v, int cap) =>
    a.push(v)
    while a.size() > cap
        a.shift()
    a.size()

pad2(int v) =>
    (v < 10 ? "0" : "") + str.tostring(v)

newLbl(int x, float y, string txt, color c) =>
    label.new(x, y, txt, xloc.bar_index, yloc.price, color.new(color.black, 100),
         label.style_label_left, c, size.tiny)

// Session state machine: track the live session, publish its levels when it
// closes, then watch for the sweep and record the outcome as a statistic.
method sessStep(Sess s, bool isIn, bool boxOn, bool lnOn, bool lbOn, int cap) =>
    bool opens   = s.on and isIn and not s.wasIn
    bool runs    = s.on and isIn and s.wasIn
    bool closes  = s.on and not isIn and s.wasIn
    bool watches = s.on and not isIn and not s.wasIn and not na(s.pHi)

    // session opens → bank the previous instance as a statistic, start fresh
    if opens
        if not na(s.pHi)
            capPush(s.rng,  s.pHi - s.pLo,      cap)
            capPush(s.hHit, s.pHiSwept ? 1 : 0, cap)
            capPush(s.lHit, s.pLoSwept ? 1 : 0, cap)
        s.hi := high
        s.lo := low
        if boxOn
            s.bx := box.new(bar_index, s.hi, bar_index, s.lo,
                 border_color = color.new(s.col, 55), border_width = 1,
                 bgcolor = color.new(s.col, 90))

    // session running → stretch the box with the range
    if runs
        s.hi := math.max(s.hi, high)
        s.lo := math.min(s.lo, low)
        if not na(s.bx)
            box.set_right(s.bx, bar_index)
            box.set_top(s.bx, s.hi)
            box.set_bottom(s.bx, s.lo)

    // session closes → publish its high and low as levels
    if closes
        s.pHi      := s.hi
        s.pLo      := s.lo
        s.pAt      := bar_index
        s.pHiSwept := false
        s.pLoSwept := false
        if not na(s.hiLn)
            line.delete(s.hiLn)
        if not na(s.loLn)
            line.delete(s.loLn)
        if not na(s.hiLb)
            label.delete(s.hiLb)
        if not na(s.loLb)
            label.delete(s.loLb)
        if lnOn
            s.hiLn := line.new(bar_index, s.pHi, bar_index, s.pHi, color = s.col, style = line.style_dotted)
            s.loLn := line.new(bar_index, s.pLo, bar_index, s.pLo, color = s.col, style = line.style_dotted)
        if lbOn
            s.hiLb := newLbl(bar_index, s.pHi, s.name + " High", s.col)
            s.loLb := newLbl(bar_index, s.pLo, s.name + " Low",  s.col)

    // outside the session → extend the levels until price takes them
    if watches
        if high > s.pHi
            s.pHiSwept := true
        if low < s.pLo
            s.pLoSwept := true
        if not s.pHiSwept and not na(s.hiLn)
            line.set_x2(s.hiLn, bar_index)
        if not s.pHiSwept and not na(s.hiLb)
            label.set_x(s.hiLb, bar_index)
        if not s.pLoSwept and not na(s.loLn)
            line.set_x2(s.loLn, bar_index)
        if not s.pLoSwept and not na(s.loLb)
            label.set_x(s.loLb, bar_index)

    s.wasIn := isIn

// Previous day / week / month: same idea, driven by the HTF rollover.
method perStep(Per p, bool isNew, float pH, float pL, int cap) =>
    if isNew
        if not na(p.wH)
            capPush(p.rng,  p.wH - p.wL,    cap)
            capPush(p.hHit, p.hitH ? 1 : 0, cap)
            capPush(p.lHit, p.hitL ? 1 : 0, cap)
        p.wH   := pH
        p.wL   := pL
        p.hitH := false
        p.hitL := false
    if not na(p.wH)
        if high > p.wH
            p.hitH := true
        if low < p.wL
            p.hitL := true

// Stepped level line: a fresh segment each period, the old one stays frozen.
method render(Lvl v, bool isNew, float price, bool show) =>
    if show and not na(price)
        bool fresh = isNew or na(v.ln)
        if fresh
            if not na(v.lb)
                label.delete(v.lb)
            v.ln := line.new(bar_index, price, bar_index, price, color = v.col, style = line.style_dashed)
            v.lb := newLbl(bar_index, price, v.name, v.col)
        if not fresh
            line.set_y1(v.ln, price)
            line.set_y2(v.ln, price)
            line.set_x2(v.ln, bar_index)
            label.set_xy(v.lb, bar_index, price)

// Premium above equilibrium, discount below, drawn from the swing that opened
// the range out to the right edge.
method draw(DRange d, float hi, float lo, int hiAt, int loAt, int ext, color pc, color dc, bool lines, string tag) =>
    if not na(hi) and not na(lo) and hi > lo
        int   l   = math.min(nz(hiAt, bar_index), nz(loAt, bar_index))
        int   r   = bar_index + ext
        float eqv = (hi + lo) / 2
        float q75 = lo + (hi - lo) * 0.75
        float q25 = lo + (hi - lo) * 0.25
        if na(d.prem)
            d.prem := box.new(l, hi, r, eqv, border_color = color.new(pc, 60), bgcolor = pc)
            d.disc := box.new(l, eqv, r, lo, border_color = color.new(dc, 60), bgcolor = dc)
            d.eq   := line.new(l, eqv, r, eqv, color = color.new(color.gray, 30), style = line.style_dashed)
            d.q75  := line.new(l, q75, r, q75, color = color.new(color.gray, 60), style = line.style_dotted)
            d.q25  := line.new(l, q25, r, q25, color = color.new(color.gray, 60), style = line.style_dotted)
            d.lb   := newLbl(r, eqv, tag, color.gray)
        box.set_lefttop(d.prem, l, hi)
        box.set_rightbottom(d.prem, r, eqv)
        box.set_lefttop(d.disc, l, eqv)
        box.set_rightbottom(d.disc, r, lo)
        line.set_xy1(d.eq, l, eqv)
        line.set_xy2(d.eq, r, eqv)
        line.set_xy1(d.q75, l, q75)
        line.set_xy2(d.q75, r, q75)
        line.set_xy1(d.q25, l, q25)
        line.set_xy2(d.q25, r, q25)
        line.set_color(d.q75, color.new(color.gray, lines ? 60 : 100))
        line.set_color(d.q25, color.new(color.gray, lines ? 60 : 100))
        line.set_color(d.eq, color.new(color.gray, lines ? 30 : 100))
        label.set_xy(d.lb, r, eqv)
        label.set_textcolor(d.lb, color.new(color.gray, lines ? 0 : 100))

statRow(table t, int r, string nm, color c, array<float> rng, array<float> hh, array<float> ll, string sz) =>
    float ar = rng.size() > 0 ? rng.avg() : na
    float hp = hh.size()  > 0 ? hh.avg() * 100 : na
    float lp = ll.size()  > 0 ? ll.avg() * 100 : na
    string tip = "samples: " + str.tostring(rng.size())
    table.cell(t, 0, r, nm, text_color = color.white, bgcolor = color.new(c, 20), text_size = sz, tooltip = tip)
    table.cell(t, 1, r, na(ar) ? "–" : str.tostring(ar, "#.###"),
         text_color = color.white, bgcolor = color.new(color.gray, 80), text_size = sz, tooltip = tip)
    table.cell(t, 2, r, na(hp) ? "–" : str.tostring(int(math.round(hp))) + "%",
         text_color = color.white, text_size = sz,
         bgcolor = color.from_gradient(nz(hp, 0), 0, 100, color.new(#787b86, 85), color.new(#ef5350, 40)), tooltip = tip)
    table.cell(t, 3, r, na(lp) ? "–" : str.tostring(int(math.round(lp))) + "%",
         text_color = color.white, text_size = sz,
         bgcolor = color.from_gradient(nz(lp, 0), 0, 100, color.new(#787b86, 85), color.new(#26a69a, 40)), tooltip = tip)

// ─────────────────────────────── STATE ────────────────────────────────────
var Sess sAsia = Sess.new(name = "ASIA", col = asiaCol, on = asiaOn, rng = array.new<float>(), hHit = array.new<float>(), lHit = array.new<float>())
var Sess sLndn = Sess.new(name = "LNDN", col = lndnCol, on = lndnOn, rng = array.new<float>(), hHit = array.new<float>(), lHit = array.new<float>())
var Sess sNyam = Sess.new(name = "NYAM", col = nyamCol, on = nyamOn, rng = array.new<float>(), hHit = array.new<float>(), lHit = array.new<float>())
var Sess sNypm = Sess.new(name = "NYPM", col = nypmCol, on = nypmOn, rng = array.new<float>(), hHit = array.new<float>(), lHit = array.new<float>())
var array<Sess> sessArr = array.from(sAsia, sLndn, sNyam, sNypm)

