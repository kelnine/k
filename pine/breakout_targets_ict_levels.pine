//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// Breakout Targets + ICT Levels + CISD
//
// Built from two chart setups:
//  1. HTF range breakout ("Retirement Prices", BTC 1W)
//     • Rolling range high/low, auto descending/ascending trendlines
//     • Rejection-block zones (swing wick) with dashed 50% line
//     • On a range breakout: measured-move targets = range edge ± k × range height
//  2. LTF ICT execution ("Top ticked", MNQ 5m)
//     • DO / TDO / 09:30 / 10:00 opens, PDH/PDL, PWH/PWL, PMH/PML,
//       Asia, London, NY AM & NY PM session highs/lows
//     • Liquidity sweep → CISD (close through the open of the last opposing
//       delivery run) → Entry / SL / TP1 / TP2, tracked until TP2 or SL
//
// Label columns (bars right of the last bar) keep groups from overlapping:
//   trade labels → "Trade label offset", ICT levels → "Level label offset",
//   breakout targets → "Target label offset". ICT levels that sit within
//   "Merge distance" of each other share one label (e.g. "PDL / PMH").
// ─────────────────────────────────────────────────────────────────────────────
indicator("Breakout Targets + ICT Levels + CISD", shorttitle = "BT+ICT", overlay = true,
     max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500, max_bars_back = 5000)

// Drawings anchored further back than the history buffer throw a runtime error
// when TradingView recalculates (e.g. after scrolling loads more bars), so every
// x coordinate in the past is kept within MAX_BACK bars of the current bar.
const int MAX_BACK = 4500
clampX(int x) => math.max(x, bar_index - MAX_BACK)

// ───────────── Inputs ─────────────
const string G_BRK = "Range Breakout / Targets"
showBrk   = input.bool(true, "Show range breakout targets", group = G_BRK)
minBrkTF  = input.timeframe("60", "Only on timeframes ≥", group = G_BRK,
     tooltip = "Range targets on 1–15m charts are tiny and noisy. Set to 1 minute to show them everywhere.")
rngLen    = input.int(26, "Range lookback (bars)", minval = 5, group = G_BRK)
maxRngPct = input.float(0.0, "Max range height % (0 = off)", minval = 0, step = 1, group = G_BRK,
     tooltip = "Only accept breakouts from ranges no taller than this % of the range low. Use it to require a real consolidation.")
t1        = input.float(0.5,   "Target 1 (× range height)", minval = 0, step = 0.1, group = G_BRK)
t2        = input.float(1.0,   "Target 2 (× range height)", minval = 0, step = 0.1, group = G_BRK)
t3        = input.float(1.618, "Target 3 (× range height)", minval = 0, step = 0.1, group = G_BRK)
tgtTitle  = input.string("Breakout Targets", "Target title", group = G_BRK)
tgtExt    = input.int(45, "Target label offset (bars right)", minval = 1, maxval = 450, group = G_BRK)
colTgt    = input.color(#4CAF50, "Target color", group = G_BRK)
colRngIn  = input.color(#131722, "Range edge color", group = G_BRK)

const string G_STR = "Structure"
pvL        = input.int(5, "Pivot left bars",  minval = 1, group = G_STR)
pvR        = input.int(5, "Pivot right bars", minval = 1, group = G_STR)
showZones  = input.bool(true, "Show rejection-block zones", group = G_STR)
maxZones   = input.int(6, "Max zones", minval = 1, maxval = 100, group = G_STR)
delBroken  = input.bool(true, "Delete zones once closed through", group = G_STR)
colZoneBd  = input.color(#00BCD4, "Zone border", group = G_STR)
colZoneBg  = input.color(color.new(#787B86, 75), "Zone fill", group = G_STR)
showTL     = input.bool(true, "Show auto trendlines", group = G_STR)
colTLIn    = input.color(#131722, "Trendline color", group = G_STR)

const string G_ICT = "ICT Levels (intraday only)"
tz         = input.string("America/New_York", "Timezone", group = G_ICT)
showDO     = input.bool(true, "Daily open (DO)", group = G_ICT)
showTDO    = input.bool(true, "True day open (TDO, 00:00)", group = G_ICT)
show930    = input.bool(true, "09:30 open", group = G_ICT)
show1000   = input.bool(true, "10:00 open", group = G_ICT)
showPD     = input.bool(true, "Previous day high/low", group = G_ICT)
showPW     = input.bool(false, "Previous week high/low", group = G_ICT)
showPM     = input.bool(true, "Previous month high/low", group = G_ICT)
showAsia   = input.bool(true, "Asia high/low", group = G_ICT)
asiaSess   = input.session("2000-0000", "Asia session", group = G_ICT)
showLon    = input.bool(true, "London high/low", group = G_ICT)
lonSess    = input.session("0200-0500", "London session", group = G_ICT)
showNYAM   = input.bool(true, "NY AM high/low", group = G_ICT)
nyAmSess   = input.session("0930-1200", "NY AM session", group = G_ICT)
showNYPM   = input.bool(false, "NY PM high/low", group = G_ICT)
nyPmSess   = input.session("1330-1600", "NY PM session", group = G_ICT)
shadeSess  = input.bool(false, "Shade London / NY AM / NY PM", group = G_ICT)
lvlExt     = input.int(20, "Level label offset (bars right)", minval = 1, maxval = 450, group = G_ICT)
mergeTol   = input.float(0.25, "Merge distance (× ATR)", minval = 0, step = 0.05, group = G_ICT,
     tooltip = "Levels closer than this share a single label, e.g. \"PDL / PMH\". 0 = only merge identical prices.")
colOpenIn  = input.color(#131722, "Opens color", group = G_ICT)
colHTF     = input.color(#787B86, "PD/PW/PM color", group = G_ICT)
colSess    = input.color(#2962FF, "Session H/L color", group = G_ICT)

const string G_CISD = "CISD"
showCisd   = input.bool(true, "Show CISD signals", group = G_CISD)
reqSweep   = input.bool(true, "Require liquidity sweep first", group = G_CISD,
     tooltip = "Sweep = high/low trades through a pivot, PDH/PDL, PWH/PWL, PMH/PML or a completed Asia/London/NY AM high/low.")
sigWindow  = input.string("Any time", "Signal only during", options = ["Any time", "NY AM", "NY AM + NY PM", "London + NY AM", "London + NY AM + NY PM"], group = G_CISD,
     tooltip = "Restrict CISD signals to these sessions (intraday charts only). Sessions are set in the ICT Levels group.")
sweepLook  = input.int(12, "Sweep must be within (bars)", minval = 1, group = G_CISD)
minBody    = input.float(0.3, "Min CISD candle body (× ATR)", minval = 0, step = 0.1, group = G_CISD,
     tooltip = "Filters weak closes through the level. Raise it on 1m charts to cut noise.")
maxSig     = input.int(3, "Keep last N CISD / TL-break marks", minval = 1, maxval = 50, group = G_CISD)
showTrade  = input.bool(true, "Project Entry / SL / TPs", group = G_CISD)
tp1R       = input.float(1.0, "TP 1 (R multiple)", minval = 0, step = 0.25, group = G_CISD)
tp2R       = input.float(2.0, "TP 2 (R multiple)", minval = 0, step = 0.25, group = G_CISD)
tradeExt   = input.int(3, "Trade label offset (bars right)", minval = 1, maxval = 450, group = G_CISD)
colBull    = input.color(#2962FF, "Bullish color", group = G_CISD)
colBear    = input.color(#F23645, "Bearish color", group = G_CISD)

const string G_SCN = "MTF Scanner"
showScan   = input.bool(true, "Show scanner", group = G_SCN)
on1        = input.bool(true, "", inline = "s1", group = G_SCN)
tf1        = input.timeframe("5",   "Slot 1", inline = "s1", group = G_SCN)
on2        = input.bool(true, "", inline = "s2", group = G_SCN)
tf2        = input.timeframe("15",  "Slot 2", inline = "s2", group = G_SCN)
on3        = input.bool(true, "", inline = "s3", group = G_SCN)
tf3        = input.timeframe("60",  "Slot 3", inline = "s3", group = G_SCN)
on4        = input.bool(true, "", inline = "s4", group = G_SCN)
tf4        = input.timeframe("240", "Slot 4", inline = "s4", group = G_SCN)
scanAlerts = input.bool(true, "Alert on new scanner signals", group = G_SCN,
     tooltip = "Create an alert with condition \"Any alert() function call\" to get these.")
scanPosIn  = input.string("Top right", "Position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G_SCN)
scanSzIn   = input.string("small", "Scanner size", options = ["tiny", "small", "normal", "large", "huge"], group = G_SCN)

const string G_STY = "Style"
autoCol    = input.bool(true, "Neutral lines follow chart text color", group = G_STY,
     tooltip = "Keeps range edge, trendline and open lines visible on both light and dark themes. Turn off to use the custom colors above.")
lblSizeIn  = input.string("small", "Label size", options = ["tiny", "small", "normal", "large", "huge"], group = G_STY)

color  colRng  = autoCol ? chart.fg_color : colRngIn
color  colTL   = autoCol ? chart.fg_color : colTLIn
color  colOpen = autoCol ? chart.fg_color : colOpenIn
toSize(string s) =>
    switch s
        "tiny"   => size.tiny
        "normal" => size.normal
        "large"  => size.large
        "huge"   => size.huge
        => size.small
string lblSz   = toSize(lblSizeIn)

// ───────────── Types & helpers ─────────────
type Zone
    box   bx
    line  mid
    float top
    float bot
    bool  supply
    bool  active = true
    int   left

type Lvl
    line   ln
    label  lb
    float  y
    string txt
    bool   on = false

method reset(Lvl self) =>
    line.delete(self.ln)
    label.delete(self.lb)
    self.ln := na
    self.lb := na
    self.on := false
    self

// Draws/updates the line; the label text is filled in by the merge pass below.
method draw(Lvl self, bool show, int x1, float y, string txt, color col, string sty) =>
    self.on := show and not na(y) and not na(x1)
    if self.on
        int x2 = bar_index + lvlExt
        self.y   := y
        self.txt := txt
        if na(self.ln)
            self.ln := line.new(clampX(x1), y, x2, y, color = col, style = sty, width = 1)
            self.lb := label.new(x2, y, "", style = label.style_label_left, color = color(na), textcolor = col, size = lblSz)
        else
            self.ln.set_xy1(clampX(x1), y)
            self.ln.set_xy2(x2, y)
            self.lb.set_xy(x2, y)
    self

clearAll(array<line> ls, array<label> lbs) =>
    for l in ls
        l.delete()
    ls.clear()
    for b in lbs
        b.delete()
    lbs.clear()

capLines(array<line> a, int n) =>
    while a.size() > n
        a.shift().delete()

capLabels(array<label> a, int n) =>
    while a.size() > n
        a.shift().delete()

// ───────────── Pivots / volatility ─────────────
float ph   = ta.pivothigh(high, pvL, pvR)
float pl   = ta.pivotlow(low, pvL, pvR)
float atr  = ta.atr(14)
float minH = atr * 0.15

// ───────────── Rejection-block zones ─────────────
var array<Zone> zones = array.new<Zone>()

newZone(int x, float top, float bot, bool supply) =>
    float m = (top + bot) / 2
    box  b  = box.new(x, top, bar_index, bot, border_color = colZoneBd, bgcolor = colZoneBg,
         text = "RB", text_color = color.new(colZoneBd, 20), text_size = size.tiny, text_halign = text.align_right)
    line ln = line.new(x, m, bar_index, m, color = colZoneBd, style = line.style_dashed)
    Zone.new(b, ln, top, bot, supply, true, x)

if showZones
    if not na(ph)
        float top = high[pvR]
        float bot = math.max(open[pvR], close[pvR])
        if top - bot < minH
            bot := top - minH
        zones.push(newZone(bar_index - pvR, top, bot, true))
    if not na(pl)
        float bot = low[pvR]
        float top = math.min(open[pvR], close[pvR])
        if top - bot < minH
            top := bot + minH
        zones.push(newZone(bar_index - pvR, top, bot, false))

    while zones.size() > maxZones
        Zone old = zones.shift()
        old.bx.delete()
        old.mid.delete()

    if zones.size() > 0
        for i = zones.size() - 1 to 0
            Zone z = zones.get(i)
            if z.left < bar_index - MAX_BACK
                z.bx.delete()
                z.mid.delete()
                zones.remove(i)
                continue
            if z.active
                z.bx.set_right(bar_index)
                z.mid.set_x2(bar_index)
                bool broken = z.supply ? close > z.top : close < z.bot
                if broken
                    z.active := false
                    if delBroken
                        z.bx.delete()
                        z.mid.delete()
                        zones.remove(i)
                    else
                        z.bx.set_bgcolor(color.new(#787B86, 92))
                        z.bx.set_border_color(color.new(#787B86, 70))
                        z.mid.set_color(color.new(#787B86, 70))

// ───────────── Auto trendlines ─────────────
// Descending: anchored at the swing high, drawn through each later lower high.
// Lines run only up to the current bar (no infinite extension off the chart).
var float dnAY = na
var int   dnAX = na
var float dnSlope = na
var line  dnTL = na
var bool  dnLive = false
// Ascending: anchored at the swing low, drawn through each later higher low.
var float upAY = na
var int   upAX = na
var float upSlope = na
var line  upTL = na
var bool  upLive = false

var array<label> tlLabels = array.new<label>()

if not na(ph)
    int x = bar_index - pvR
    if na(dnAY) or ph >= dnAY
        if dnLive
            dnTL.delete()
        dnLive := false
        dnAY := ph
        dnAX := x
    else if showTL
        float s = (ph - dnAY) / (x - dnAX)
        if close < dnAY + s * (bar_index - dnAX)
            if dnLive
                dnTL.delete()
            dnSlope := s
            dnTL := line.new(dnAX, dnAY, x, ph, color = colTL, width = 2)
            dnLive := true

if not na(pl)
    int x = bar_index - pvR
    if na(upAY) or pl <= upAY
        if upLive
            upTL.delete()
        upLive := false
        upAY := pl
        upAX := x
    else if showTL
        float s = (pl - upAY) / (x - upAX)
        if close > upAY + s * (bar_index - upAX)
            if upLive
                upTL.delete()
            upSlope := s
            upTL := line.new(upAX, upAY, x, pl, color = colTL, width = 2)
            upLive := true

if not na(dnAX) and dnAX < bar_index - MAX_BACK
    if dnLive
        dnTL.delete()
    dnLive := false
    dnAY := na
    dnAX := na
if not na(upAX) and upAX < bar_index - MAX_BACK
    if upLive
        upTL.delete()
    upLive := false
    upAY := na
    upAX := na

bool tlBreakUp = false
bool tlBreakDn = false
if dnLive
    float v = dnAY + dnSlope * (bar_index - dnAX)
    dnTL.set_xy2(bar_index, v)
    if close > v
        tlBreakUp := true
        dnLive := false
        dnAY := na
        tlLabels.push(label.new(bar_index, low, "TL break", style = label.style_label_up, color = color(na), textcolor = colBull, size = size.tiny))
if upLive
    float v = upAY + upSlope * (bar_index - upAX)
    upTL.set_xy2(bar_index, v)
    if close < v
        tlBreakDn := true
        upLive := false
        upAY := na
        tlLabels.push(label.new(bar_index, high, "TL break", style = label.style_label_down, color = color(na), textcolor = colBear, size = size.tiny))
capLabels(tlLabels, maxSig)

// ───────────── Range breakout + measured targets ─────────────
float rngHi = ta.highest(high, rngLen)[1]
float rngLo = ta.lowest(low, rngLen)[1]
int   hiOff = ta.highestbars(high, rngLen)[1]
int   loOff = ta.lowestbars(low, rngLen)[1]

var int lastBullBrk = -100000
var int lastBearBrk = -100000
var array<line>  brkLines  = array.new<line>()
var array<label> brkLabels = array.new<label>()   // moved to the target column on the last bar
var label        brkTitle  = na                   // stays at the breakout bar

bool brkTFok = timeframe.in_seconds() >= timeframe.in_seconds(minBrkTF)
bool rngOk   = showBrk and brkTFok and not na(rngHi) and not na(rngLo) and
     (maxRngPct <= 0 or (rngHi - rngLo) / rngLo * 100 <= maxRngPct)
bool bullBrk = rngOk and close > rngHi and bar_index - lastBullBrk > rngLen
bool bearBrk = rngOk and close < rngLo and bar_index - lastBearBrk > rngLen

if bullBrk or bearBrk
    if bullBrk
        lastBullBrk := bar_index
    else
        lastBearBrk := bar_index
    clearAll(brkLines, brkLabels)
    label.delete(brkTitle)
    bool  up    = bullBrk
    float h     = rngHi - rngLo
    float edge  = up ? rngHi : rngLo
    float other = up ? rngLo : rngHi
    int   xEdge = clampX(bar_index - 1 + (up ? hiOff : loOff))
    int   xOth  = clampX(bar_index - 1 + (up ? loOff : hiOff))
    int   xl    = bar_index + tgtExt
    brkLines.push(line.new(xEdge, edge, bar_index, edge, color = colRng, width = 2, extend = extend.right))
    brkLabels.push(label.new(xl, edge, (up ? "Range high  " : "Range low  ") + str.tostring(edge, format.mintick),
         style = label.style_label_left, color = colRng, textcolor = chart.bg_color, size = lblSz))
    brkLines.push(line.new(xOth, other, bar_index, other, color = color.new(colRng, 50), style = line.style_dotted, extend = extend.right))
    float last = na
    for [i, r] in array.from(t1, t2, t3)
        if r > 0
            float p = up ? edge + h * r : edge - h * r
            last := p
            brkLines.push(line.new(bar_index, p, bar_index + 1, p, color = colTgt, width = 2, extend = extend.right))
            brkLabels.push(label.new(xl, p, "T" + str.tostring(i + 1) + " (" + str.tostring(r) + "x)  " + str.tostring(p, format.mintick),
                 style = label.style_label_left, color = colTgt, textcolor = color.white, size = lblSz))
    // Title sits just beyond the furthest target, starting at the breakout bar,
    // so it never collides with the target labels in the right-hand column.
    if not na(last) and tgtTitle != ""
        brkTitle := label.new(bar_index, last, tgtTitle, color = color(na), textcolor = colTgt, size = size.normal,
             style = up ? label.style_label_lower_left : label.style_label_upper_left)

if barstate.islast
    for lb in brkLabels
        lb.set_x(bar_index + tgtExt)

// ───────────── ICT levels ─────────────
bool showSess = timeframe.isintraday and timeframe.in_seconds() <= 3600

inSess(string s) => not na(time(timeframe.period, s, tz))

int  nyMin     = hour(time, tz) * 60 + minute(time, tz)
int  nyMinPrev = nz(nyMin[1], -1)
bool newDay    = timeframe.change("D")
// True only on the bar that opens exactly at minute t (NY time). If no bar starts
// there (e.g. 9:30 on a 1h futures chart, 00:00 on a stock), the level is skipped
// rather than showing the wrong bar's open.
atMinute(int t) => nyMin == t and nyMinPrev != t

[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pmh, pml] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead = barmerge.lookahead_on)

var Lvl lDO   = Lvl.new()
var Lvl lTDO  = Lvl.new()
var Lvl l930  = Lvl.new()
var Lvl l1000 = Lvl.new()
var Lvl lPDH  = Lvl.new()
var Lvl lPDL  = Lvl.new()
var Lvl lPWH  = Lvl.new()
var Lvl lPWL  = Lvl.new()
var Lvl lPMH  = Lvl.new()
var Lvl lPML  = Lvl.new()
var Lvl lAH   = Lvl.new()
var Lvl lAL   = Lvl.new()
var Lvl lLH   = Lvl.new()
var Lvl lLL   = Lvl.new()
var Lvl lNAH  = Lvl.new()
var Lvl lNAL  = Lvl.new()
var Lvl lNPH  = Lvl.new()
var Lvl lNPL  = Lvl.new()

var array<Lvl> allLvls = array.new<Lvl>()
if barstate.isfirst
    allLvls.push(lDO)
    allLvls.push(lTDO)
    allLvls.push(l930)
    allLvls.push(l1000)
    allLvls.push(lPDH)
    allLvls.push(lPDL)
    allLvls.push(lPWH)
    allLvls.push(lPWL)
    allLvls.push(lPMH)
    allLvls.push(lPML)
    allLvls.push(lAH)
    allLvls.push(lAL)
    allLvls.push(lLH)
    allLvls.push(lLL)
    allLvls.push(lNAH)
    allLvls.push(lNAL)
    allLvls.push(lNPH)
    allLvls.push(lNPL)

var float dOpen = na
var int   dayX  = na
var float tdo   = na
var int   tdoX  = na
var float o930  = na
var int   x930  = na
var float o1000 = na
var int   x1000 = na

if newDay
    dOpen := open
    dayX  := bar_index
    lDO.reset()
    lPDH.reset()
    lPDL.reset()
    lPWH.reset()
    lPWL.reset()
    lPMH.reset()
    lPML.reset()
if atMinute(0)
    tdo  := open
    tdoX := bar_index
    lTDO.reset()
if atMinute(570)
    o930 := open
    x930 := bar_index
    l930.reset()
if atMinute(600)
    o1000 := open
    x1000 := bar_index
    l1000.reset()

// Session highs/lows
bool inAsia = inSess(asiaSess)
bool inLon  = inSess(lonSess)
var float asiaH = na
var float asiaL = na
var int   asiaX = na
var float lonH  = na
var float lonL  = na
var int   lonX  = na

if inAsia and not inAsia[1]
    asiaH := high
    asiaL := low
    asiaX := bar_index
    lAH.reset()
    lAL.reset()
else if inAsia
    asiaH := math.max(asiaH, high)
    asiaL := math.min(asiaL, low)

bool inNYAM = inSess(nyAmSess)
bool inNYPM = inSess(nyPmSess)
var float nyAmH = na
var float nyAmL = na
var int   nyAmX = na
var float nyPmH = na
var float nyPmL = na
var int   nyPmX = na

if inNYAM and not inNYAM[1]
    nyAmH := high
    nyAmL := low
    nyAmX := bar_index
    lNAH.reset()
    lNAL.reset()
else if inNYAM
    nyAmH := math.max(nyAmH, high)
    nyAmL := math.min(nyAmL, low)

if inNYPM and not inNYPM[1]
    nyPmH := high
    nyPmL := low
    nyPmX := bar_index
    lNPH.reset()
    lNPL.reset()
else if inNYPM
    nyPmH := math.max(nyPmH, high)
    nyPmL := math.min(nyPmL, low)

bgcolor(shadeSess and showSess and inLon  ? color.new(colSess, 94) : na, title = "London shade")
bgcolor(shadeSess and showSess and inNYAM ? color.new(#FF9800, 92) : na, title = "NY AM shade")
bgcolor(shadeSess and showSess and inNYPM ? color.new(#FF9800, 95) : na, title = "NY PM shade")

if inLon and not inLon[1]
    lonH := high
    lonL := low
    lonX := bar_index
    lLH.reset()
    lLL.reset()
else if inLon
    lonH := math.max(lonH, high)
    lonL := math.min(lonL, low)

if showSess and barstate.islast
    lDO.draw(showDO,    dayX,  dOpen, "DO",    colOpen, line.style_dotted)
    lTDO.draw(showTDO,  tdoX,  tdo,   "TDO",   colOpen, line.style_dashed)
    l930.draw(show930,  x930,  o930,  "9:30",  colOpen, line.style_dotted)
    l1000.draw(show1000, x1000, o1000, "10:00", colOpen, line.style_dotted)
    lPDH.draw(showPD, dayX, pdh, "PDH", colHTF, line.style_dotted)
    lPDL.draw(showPD, dayX, pdl, "PDL", colHTF, line.style_dotted)
    lPWH.draw(showPW, dayX, pwh, "PWH", colHTF, line.style_dotted)
    lPWL.draw(showPW, dayX, pwl, "PWL", colHTF, line.style_dotted)
    lPMH.draw(showPM, dayX, pmh, "PMH", colHTF, line.style_dotted)
    lPML.draw(showPM, dayX, pml, "PML", colHTF, line.style_dotted)
    lAH.draw(showAsia, asiaX, asiaH, "Asia high", colSess, line.style_solid)
    lAL.draw(showAsia, asiaX, asiaL, "Asia low",  colSess, line.style_solid)
    lLH.draw(showLon,  lonX,  lonH,  "LNDN high", colSess, line.style_solid)
    lLL.draw(showLon,  lonX,  lonL,  "LNDN low",  colSess, line.style_solid)
    lNAH.draw(showNYAM, nyAmX, nyAmH, "NY AM high", #FF9800, line.style_solid)
    lNAL.draw(showNYAM, nyAmX, nyAmL, "NY AM low",  #FF9800, line.style_solid)
    lNPH.draw(showNYPM, nyPmX, nyPmH, "NY PM high", #FF9800, line.style_solid)
    lNPL.draw(showNYPM, nyPmX, nyPmL, "NY PM low",  #FF9800, line.style_solid)

    // Merge pass: sort visible levels by price; levels within mergeTol × ATR of a
    // group's first level share its label ("PDL / PMH  30356.50").
    array<Lvl>   vis = array.new<Lvl>()
    array<float> ys  = array.new<float>()
    for l in allLvls
        if l.on
            vis.push(l)
            ys.push(l.y)
    if vis.size() > 0
        array<int> idx = ys.sort_indices(order.ascending)
        float  tol  = nz(atr) * mergeTol
        Lvl    head = vis.get(idx.get(0))
        string txt  = head.txt
        if idx.size() > 1
            for k = 1 to idx.size() - 1
                Lvl l = vis.get(idx.get(k))
                if math.abs(l.y - head.y) <= tol
                    txt := txt + " / " + l.txt
                    l.lb.set_text("")
                else
                    head.lb.set_text(txt + "  " + str.tostring(head.y, format.mintick))
                    head := l
                    txt  := l.txt
        head.lb.set_text(txt + "  " + str.tostring(head.y, format.mintick))

// ───────────── Liquidity sweeps ─────────────
tookHigh(float l) => not na(l) and high > l and high[1] <= l
tookLow(float l)  => not na(l) and low < l and low[1] >= l

var float lastPH = na
var float lastPL = na
if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl

float sAH = showSess and not inAsia ? asiaH : na
float sAL = showSess and not inAsia ? asiaL : na
float sLH = showSess and not inLon  ? lonH  : na
float sLL = showSess and not inLon  ? lonL  : na
float sNH = showSess and not inNYAM ? nyAmH : na
float sNL = showSess and not inNYAM ? nyAmL : na

bool hPD = tookHigh(pdh)
bool hPW = tookHigh(pwh)
bool hPM = tookHigh(pmh)
bool hA  = tookHigh(sAH)
bool hL  = tookHigh(sLH)
bool lPD = tookLow(pdl)
bool lPW = tookLow(pwl)
bool lPM = tookLow(pml)
bool lA  = tookLow(sAL)
bool lL  = tookLow(sLL)
bool hN  = tookHigh(sNH)
bool lN  = tookLow(sNL)
bool bslSwept = (not na(lastPH) and high > lastPH) or hPD or hPW or hPM or hA or hL or hN
bool sslSwept = (not na(lastPL) and low < lastPL)  or lPD or lPW or lPM or lA or lL or lN

var int lastBslBar = -100000
var int lastSslBar = -100000
if bslSwept
    lastBslBar := bar_index
    lastPH := na
if sslSwept
    lastSslBar := bar_index
    lastPL := na

// ───────────── CISD ─────────────
// Bearish CISD: close below the open of the most recent run of up-close candles.
// Bullish CISD: close above the open of the most recent run of down-close candles.
bool bullBar = close > open
bool bearBar = close < open
bool bigBody = math.abs(close - open) >= minBody * nz(atr)

var float bullRunOpen = na
var int   bullRunX    = na
var float bullRunHigh = na
var float bearRunOpen = na
var int   bearRunX    = na
var float bearRunLow  = na

if bullBar and not bullBar[1]
    bullRunOpen := open
    bullRunX    := bar_index
    bullRunHigh := high
else if not na(bullRunOpen)
    bullRunHigh := math.max(bullRunHigh, high)

if bearBar and not bearBar[1]
    bearRunOpen := open
    bearRunX    := bar_index
    bearRunLow  := low
else if not na(bearRunOpen)
    bearRunLow := math.min(bearRunLow, low)

bool  bearCisd = false
bool  bullCisd = false
float cisdLvl  = na
float cisdExt  = na
int   cisdX    = na

if not na(bullRunOpen) and bar_index > bullRunX and close < bullRunOpen
    bearCisd := bigBody and (not reqSweep or bar_index - lastBslBar <= sweepLook)
    cisdLvl  := bullRunOpen
    cisdExt  := bullRunHigh
    cisdX    := bullRunX
    bullRunOpen := na

if not bearCisd and not na(bearRunOpen) and bar_index > bearRunX and close > bearRunOpen
    bullCisd := bigBody and (not reqSweep or bar_index - lastSslBar <= sweepLook)
    cisdLvl  := bearRunOpen
    cisdExt  := bearRunLow
    cisdX    := bearRunX
    bearRunOpen := na

bool inWindow = switch sigWindow
    "NY AM"                  => inNYAM
    "NY AM + NY PM"          => inNYAM or inNYPM
    "London + NY AM"         => inLon or inNYAM
    "London + NY AM + NY PM" => inLon or inNYAM or inNYPM
    => true
inWindow := inWindow or not showSess

bearCisd := showCisd and inWindow and bearCisd
bullCisd := showCisd and inWindow and bullCisd

var array<line>  cisdLines  = array.new<line>()
var array<label> cisdLabels = array.new<label>()

if bearCisd or bullCisd
    color c = bearCisd ? colBear : colBull
    cisdX := clampX(cisdX)
    cisdLines.push(line.new(cisdX, cisdLvl, bar_index, cisdLvl, color = c, width = 2))
    cisdLabels.push(label.new(math.round((cisdX + bar_index) / 2), cisdLvl, "CISD", color = color(na), textcolor = c, size = size.tiny,
         style = bearCisd ? label.style_label_up : label.style_label_down))
    capLines(cisdLines, maxSig)
    capLabels(cisdLabels, maxSig)

// ───────────── Trade projection (latest CISD, tracked until TP 2 or SL) ─────────────
var line  trLnE  = na
var line  trLnS  = na
var line  trLnT1 = na
var line  trLnT2 = na
var label trLbE  = na
var label trLbS  = na
var label trLbT1 = na
var label trLbT2 = na
var bool  trLive = false
var int   trDir  = 0
var int   trBar  = na
var float trE    = na
var float trS    = na
var float trT1   = na
var float trT2   = na
var bool  trHit1 = false

fmt(float p) => str.tostring(p, format.mintick)
mkLine(int x, float y, color c, string sty) =>
    na(y) ? line(na) : line.new(x, y, x + tradeExt, y, color = c, style = sty, width = 2)
mkLabel(int x, float y, string t, color c) =>
    na(y) ? label(na) : label.new(x + tradeExt, y, t, style = label.style_label_left, color = c, textcolor = color.white, size = lblSz)

if showTrade and (bearCisd or bullCisd)
    line.delete(trLnE)
    line.delete(trLnS)
    line.delete(trLnT1)
    line.delete(trLnT2)
    label.delete(trLbE)
    label.delete(trLbS)
    label.delete(trLbT1)
    label.delete(trLbT2)
    trDir  := bearCisd ? -1 : 1
    trBar  := bar_index
    trE    := cisdLvl
    trS    := cisdExt
    float risk = math.abs(trE - trS)
    trT1   := risk > 0 and tp1R > 0 ? trE + trDir * risk * tp1R : na
    trT2   := risk > 0 and tp2R > 0 ? trE + trDir * risk * tp2R : na
    trHit1 := false
    trLive := true
    trLnE  := mkLine(bar_index, trE,  #787B86, line.style_solid)
    trLnS  := mkLine(bar_index, trS,  colBear, line.style_dashed)
    trLnT1 := mkLine(bar_index, trT1, colTgt,  line.style_dotted)
    trLnT2 := mkLine(bar_index, trT2, colTgt,  line.style_dotted)
    trLbE  := mkLabel(bar_index, trE,  "Entry " + fmt(trE), #787B86)
    trLbS  := mkLabel(bar_index, trS,  "SL " + fmt(trS), colBear)
    trLbT1 := mkLabel(bar_index, trT1, "TP 1  " + fmt(trT1), colTgt)
    trLbT2 := mkLabel(bar_index, trT2, "TP 2  " + fmt(trT2), colTgt)

bool trSL  = false
bool trTP1 = false
bool trTP2 = false
if trLive and bar_index > trBar
    // Stop is checked first: if one bar tags both stop and target, assume the worst.
    trSL  := trDir < 0 ? high >= trS : low <= trS
    trTP2 := not trSL and not na(trT2) and (trDir < 0 ? low <= trT2 : high >= trT2)
    trTP1 := not trSL and not trHit1 and not na(trT1) and (trTP2 or (trDir < 0 ? low <= trT1 : high >= trT1))
    if trTP1
        trHit1 := true
        trLbT1.set_text("TP 1 ✓  " + fmt(trT1))
    if trTP2
        trLbT2.set_text("TP 2 ✓  " + fmt(trT2))
    if trSL
        trLbS.set_text("SL ✗  " + fmt(trS))
    // Trade ends at SL, at TP 2, or at TP 1 when TP 2 is disabled.
    if trSL or trTP2 or (trHit1 and na(trT2)) or bar_index - trBar > MAX_BACK
        trLive := false
    int xEnd = bar_index + (trLive ? tradeExt : 0)
    for ln in array.from(trLnE, trLnS, trLnT1, trLnT2)
        if not na(ln)
            ln.set_x2(xEnd)
    for lb in array.from(trLbE, trLbS, trLbT1, trLbT2)
        if not na(lb)
            lb.set_x(xEnd)

// ───────────── MTF scanner ─────────────
// Runs a self-contained copy of the CISD model on each slot's timeframe:
// swing-sweep → CISD → Entry / SL / TP1 / TP2 with status, plus a swing-break bias.
// Higher timeframes use only confirmed (closed) bars, so rows never repaint.
scanCisd(int off) =>
    float sPH  = ta.pivothigh(high, 3, 3)
    float sPL  = ta.pivotlow(low, 3, 3)
    float sAtr = ta.atr(14)
    var float swH    = na
    var float swL    = na
    var float bosH   = na
    var float bosL   = na
    var int   bias   = 0
    var int   bslBar = -100000
    var int   sslBar = -100000
    if not na(sPH)
        swH  := sPH
        bosH := sPH
    if not na(sPL)
        swL  := sPL
        bosL := sPL
    if not na(bosH) and close > bosH
        bias := 1
        bosH := na
    if not na(bosL) and close < bosL
        bias := -1
        bosL := na
    if not na(swH) and high > swH
        bslBar := bar_index
        swH    := na
    if not na(swL) and low < swL
        sslBar := bar_index
        swL    := na

    bool upBar = close > open
    bool dnBar = close < open
    var float uOpen = na
    var float uHigh = na
    var float dOpn  = na
    var float dLow  = na
    if upBar and not upBar[1]
        uOpen := open
        uHigh := high
    else if not na(uOpen)
        uHigh := math.max(uHigh, high)
    if dnBar and not dnBar[1]
        dOpn := open
        dLow := low
    else if not na(dOpn)
        dLow := math.min(dLow, low)

    bool  big = math.abs(close - open) >= minBody * nz(sAtr)
    int   sig = 0
    float sE  = na
    float sS  = na
    if not na(uOpen) and close < uOpen
        if big and (not reqSweep or bar_index - bslBar <= sweepLook)
            sig := -1
            sE  := uOpen
            sS  := uHigh
        uOpen := na
    if sig == 0 and not na(dOpn) and close > dOpn
        if big and (not reqSweep or bar_index - sslBar <= sweepLook)
            sig := 1
            sE  := dOpn
            sS  := dLow
        dOpn := na

    // Status: 0 active, 1 TP1 hit, 2 TP2 hit, -1 stopped, 3 TP1 then stopped
    var int   tDir  = 0
    var float tE    = na
    var float tS    = na
    var float tT1   = na
    var float tT2   = na
    var int   tBar  = na
    var int   tTime = na
    var int   tSt   = 0
    if sig != 0
        float r = math.abs(sE - sS)
        tDir  := sig
        tE    := sE
        tS    := sS
        tT1   := r > 0 and tp1R > 0 ? sE + sig * r * tp1R : na
        tT2   := r > 0 and tp2R > 0 ? sE + sig * r * tp2R : na
        tBar  := bar_index
        tTime := time
        tSt   := 0
    else if tDir != 0 and (tSt == 0 or (tSt == 1 and not na(tT2)))
        bool hitS  = tDir < 0 ? high >= tS : low <= tS
        bool hitT1 = not na(tT1) and (tDir < 0 ? low <= tT1 : high >= tT1)
        bool hitT2 = not na(tT2) and (tDir < 0 ? low <= tT2 : high >= tT2)
        if hitS
            tSt := tSt == 1 ? 3 : -1
        else if hitT2
            tSt := 2
        else if hitT1
            tSt := 1
    int age = tDir != 0 ? bar_index - tBar : na
    [tDir[off], tE[off], tS[off], tT1[off], tT2[off], tSt[off], age[off], tTime[off], bias[off]]

scanRow(simple string tf) =>
    simple bool higher = timeframe.in_seconds(tf) > timeframe.in_seconds()
    request.security(syminfo.tickerid, tf, scanCisd(higher ? 1 : 0),
         lookahead = higher ? barmerge.lookahead_on : barmerge.lookahead_off)

fmtTF(string tf) =>
    int sec = timeframe.in_seconds(tf)
    sec < 60 ? str.tostring(sec) + "s" : sec < 3600 ? str.tostring(math.round(sec / 60)) + "m" :
         sec < 86400 ? str.tostring(math.round(sec / 3600)) + "H" : sec < 604800 ? str.tostring(math.round(sec / 86400)) + "D" :
         sec < 2419200 ? str.tostring(math.round(sec / 604800)) + "W" : str.tostring(math.max(1, math.round(sec / 2592000))) + "M"

fmtP(float p) => na(p) ? "—" : str.tostring(p, format.mintick)

callText(string tf, int d, float e, float s, float a, float b) =>
    syminfo.ticker + " " + fmtTF(tf) + ": " + (d > 0 ? "LONG" : "SHORT") + " CISD  Entry " + fmtP(e) +
         "  SL " + fmtP(s) + "  TP1 " + fmtP(a) + (na(b) ? "" : "  TP2 " + fmtP(b))

[d1, e1, s1, a1, b1, st1, ag1, tm1, bi1] = scanRow(tf1)
[d2, e2, s2, a2, b2, st2, ag2, tm2, bi2] = scanRow(tf2)
[d3, e3, s3, a3, b3, st3, ag3, tm3, bi3] = scanRow(tf3)
[d4, e4, s4, a4, b4, st4, ag4, tm4, bi4] = scanRow(tf4)

// Call-outs: fire once when a slot's latest signal changes.
newSig(bool on, int d, int tm) => showScan and on and d != 0 and not na(tm) and tm != nz(tm[1])
bool n1 = newSig(on1, d1, tm1)
bool n2 = newSig(on2, d2, tm2)
bool n3 = newSig(on3, d3, tm3)
bool n4 = newSig(on4, d4, tm4)
if scanAlerts
    if n1
        alert(callText(tf1, d1, e1, s1, a1, b1), alert.freq_once_per_bar)
    if n2
        alert(callText(tf2, d2, e2, s2, a2, b2), alert.freq_once_per_bar)
    if n3
        alert(callText(tf3, d3, e3, s3, a3, b3), alert.freq_once_per_bar)
    if n4
        alert(callText(tf4, d4, e4, s4, a4, b4), alert.freq_once_per_bar)

string scanPos = switch scanPosIn
    "Top left"     => position.top_left
    "Bottom right" => position.bottom_right
    "Bottom left"  => position.bottom_left
    => position.top_right
string scanSz = toSize(scanSzIn)

var table scanT = table.new(scanPos, 7, 5, bgcolor = color.new(chart.bg_color, 5),
     frame_color = color.new(chart.fg_color, 70), frame_width = 1, border_color = color.new(chart.fg_color, 85), border_width = 1)

cellTxt(int c, int r, string t, color tc, color bg) =>
    table.cell(scanT, c, r, t, text_color = tc, bgcolor = bg, text_size = scanSz)

drawRow(int r, string tf, int d, float e, float s, float a, int st, int ag, int bi) =>
    color fg = chart.fg_color
    cellTxt(0, r, fmtTF(tf), fg, color(na))
    cellTxt(1, r, bi > 0 ? "Bull" : bi < 0 ? "Bear" : "—", bi > 0 ? colBull : bi < 0 ? colBear : fg, color(na))
    if d == 0
        for c = 2 to 6
            cellTxt(c, r, "—", fg, color(na))
    else
        bool  fresh = st == 0 and ag <= 2
        color dc    = d > 0 ? colBull : colBear
        cellTxt(2, r, (d > 0 ? "LONG" : "SHORT") + " · " + str.tostring(ag), color.white, fresh ? dc : color.new(dc, 45))
        cellTxt(3, r, fmtP(e), fg, color(na))
        cellTxt(4, r, fmtP(s), colBear, color(na))
        cellTxt(5, r, fmtP(a), colTgt, color(na))
        string stT = st == 0 ? "Active" : st == 1 ? "TP1 ✓" : st == 2 ? "TP2 ✓" : st == -1 ? "SL ✗" : "TP1 ✓ / SL"
        color  stC = st == 0 ? fg : st > 0 and st < 3 ? colTgt : colBear
        cellTxt(6, r, stT, stC, color(na))

if showScan and barstate.islast
    table.clear(scanT, 0, 0, 6, 4)
    color hc = color.new(chart.fg_color, 88)
    array<string> hdr = array.from("TF", "Bias", "Signal · bars ago", "Entry", "SL", "TP 1", "Status")
    for [c, h] in hdr
        cellTxt(c, 0, h, chart.fg_color, hc)
    int r = 1
    if on1
        drawRow(r, tf1, d1, e1, s1, a1, st1, ag1, bi1)
        r += 1
    if on2
        drawRow(r, tf2, d2, e2, s2, a2, st2, ag2, bi2)
        r += 1
    if on3
        drawRow(r, tf3, d3, e3, s3, a3, st3, ag3, bi3)
        r += 1
    if on4
        drawRow(r, tf4, d4, e4, s4, a4, st4, ag4, bi4)

// ───────────── Plots & alerts ─────────────
plotshape(bearCisd, "Bearish CISD", shape.triangledown, location.abovebar, colBear, size = size.tiny)
plotshape(bullCisd, "Bullish CISD", shape.triangleup,   location.belowbar, colBull, size = size.tiny)
plotshape(bullBrk,  "Range breakout",  shape.flag, location.belowbar, colTgt,  size = size.small)
plotshape(bearBrk,  "Range breakdown", shape.flag, location.abovebar, colBear, size = size.small)

alertcondition(bullBrk,   "Range breakout",       "{{ticker}} closed above the range high: targets projected")
alertcondition(bearBrk,   "Range breakdown",      "{{ticker}} closed below the range low: targets projected")
alertcondition(tlBreakUp, "Trendline break up",   "{{ticker}} broke the descending trendline")
alertcondition(tlBreakDn, "Trendline break down", "{{ticker}} broke the ascending trendline")
alertcondition(bearCisd,  "Bearish CISD",         "{{ticker}} bearish CISD after buy-side sweep")
alertcondition(bullCisd,  "Bullish CISD",         "{{ticker}} bullish CISD after sell-side sweep")
alertcondition(trTP1,     "Trade TP 1 hit",       "{{ticker}} CISD trade reached TP 1")
alertcondition(trTP2,     "Trade TP 2 hit",       "{{ticker}} CISD trade reached TP 2")
alertcondition(trSL,      "Trade stopped out",    "{{ticker}} CISD trade hit its stop")
alertcondition(n1 or n2 or n3 or n4, "Scanner: new signal", "{{ticker}} scanner: new CISD signal on one of the scanner timeframes")
