//@version=6
indicator("Swing Trading Strategy | 200/20 EMA + RSI", shorttitle="SwingStrat", overlay=true, max_labels_count=500, max_lines_count=500)

// ═══════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════
grp_ema  = "EMA Settings"
grp_rsi  = "RSI Settings"
grp_sig  = "Signal Filters"
grp_risk = "Risk Management"
grp_disp = "Display"

fast_len     = input.int(20,  "Fast EMA",             minval=1,   group=grp_ema)
slow_len     = input.int(200, "Slow EMA",             minval=1,   group=grp_ema)
ema_prox_pct = input.float(0.3, "EMA Touch Proximity %", minval=0.05, step=0.05, group=grp_ema,
               tooltip="Max % distance from 20 EMA for price to count as a 'touch'")

rsi_len  = input.int(14,   "RSI Length",   minval=1,       group=grp_rsi)
rsi_mid  = input.float(50, "RSI Midline",  minval=1, maxval=99, group=grp_rsi)

use_vol_filter = input.bool(true, "Volume Filter (above 20-bar avg)", group=grp_sig)
use_ms_filter  = input.bool(true, "Market Structure Filter (HH/HL – LH/LL)", group=grp_sig)
pivot_len      = input.int(5, "Pivot Lookback for Structure", minval=2, group=grp_sig)

rr_tp1       = input.float(2.0, "TP1 Risk:Reward Ratio", minval=0.5, step=0.5, group=grp_risk)
sl_lookback  = input.int(10,   "SL Lookback (bars)",     minval=3,   group=grp_risk)
tp2_lookback = input.int(50,   "TP2 Lookback (bars)",    minval=10,  group=grp_risk)
show_sl_tp   = input.bool(true, "Show SL / TP Lines",    group=grp_risk)
line_len     = input.int(30,   "Line Length (bars)",     minval=5,   group=grp_risk)

show_bg    = input.bool(true, "Trend Background Shading", group=grp_disp)
show_table = input.bool(true, "Show Condition Table",     group=grp_disp)

// ═══════════════════════════════════════════════════════════════════
// CORE INDICATORS
// ═══════════════════════════════════════════════════════════════════
ema20  = ta.ema(close, fast_len)
ema200 = ta.ema(close, slow_len)
rsi    = ta.rsi(close, rsi_len)
avg_vol = ta.sma(volume, 20)

uptrend  = close > ema200
downtrend = close < ema200
sideways = not uptrend and not downtrend

// ═══════════════════════════════════════════════════════════════════
// EMA TOUCH DETECTION
// Price must pull back to the 20 EMA within the proximity threshold
// ═══════════════════════════════════════════════════════════════════
prox = ema_prox_pct / 100.0

// Bullish: wick taps the 20 EMA from above while still in uptrend
bull_ema_touch = low <= ema20 * (1.0 + prox) and close > ema20 * (1.0 - prox) and uptrend

// Bearish: wick taps the 20 EMA from below while still in downtrend
bear_ema_touch = high >= ema20 * (1.0 - prox) and close < ema20 * (1.0 + prox) and downtrend

// ═══════════════════════════════════════════════════════════════════
// CANDLESTICK PATTERN DETECTION
// ═══════════════════════════════════════════════════════════════════
body    = math.abs(close - open)
range_h = high - low
upper_w = high - math.max(close, open)
lower_w = math.min(close, open) - low

// Bullish Pin Bar: long lower wick (>= 2× body & >= 50% of range), body in upper half
bull_pin = range_h > 0 and lower_w >= body * 2.0 and lower_w >= range_h * 0.5 and close >= (high + low) / 2

// Bearish Pin Bar: long upper wick (>= 2× body & >= 50% of range), body in lower half
bear_pin = range_h > 0 and upper_w >= body * 2.0 and upper_w >= range_h * 0.5 and close <= (high + low) / 2

// Bullish Engulfing: previous red candle fully engulfed by current green candle
bull_engulf = close[1] < open[1] and close > open and open <= close[1] and close >= open[1]

// Bearish Engulfing: previous green candle fully engulfed by current red candle
bear_engulf = close[1] > open[1] and close < open and open >= close[1] and close <= open[1]

bull_pattern = bull_pin or bull_engulf
bear_pattern = bear_pin or bear_engulf

// ═══════════════════════════════════════════════════════════════════
// VOLUME FILTER
// ═══════════════════════════════════════════════════════════════════
vol_ok = use_vol_filter ? volume > avg_vol : true

// ═══════════════════════════════════════════════════════════════════
// MARKET STRUCTURE — Higher Highs/Higher Lows | Lower Highs/Lower Lows
// ═══════════════════════════════════════════════════════════════════
ph = ta.pivothigh(high, pivot_len, pivot_len)
pl = ta.pivotlow(low,  pivot_len, pivot_len)

var float ph1 = na
var float ph2 = na
var float pl1 = na
var float pl2 = na

if not na(ph)
    ph2 := ph1
    ph1 := ph

if not na(pl)
    pl2 := pl1
    pl1 := pl

hh_hl = not na(ph1) and not na(ph2) and not na(pl1) and not na(pl2) and ph1 > ph2 and pl1 > pl2
lh_ll = not na(ph1) and not na(ph2) and not na(pl1) and not na(pl2) and ph1 < ph2 and pl1 < pl2

ms_bull = use_ms_filter ? hh_hl : true
ms_bear = use_ms_filter ? lh_ll : true

// ═══════════════════════════════════════════════════════════════════
// ENTRY SIGNALS
// ═══════════════════════════════════════════════════════════════════
buy_signal  = uptrend   and bull_ema_touch and bull_pattern and rsi > rsi_mid and vol_ok and ms_bull
sell_signal = downtrend and bear_ema_touch and bear_pattern and rsi < rsi_mid and vol_ok and ms_bear

// ═══════════════════════════════════════════════════════════════════
// STOP LOSS & TAKE PROFIT LEVELS
// ═══════════════════════════════════════════════════════════════════
buy_sl   = ta.lowest(low,   sl_lookback)   // below pullback low
sell_sl  = ta.highest(high, sl_lookback)   // above pullback high

buy_risk  = close - buy_sl
sell_risk = sell_sl - close

buy_tp1  = close + buy_risk  * rr_tp1     // 1:rr_tp1 R:R
sell_tp1 = close - sell_risk * rr_tp1

buy_tp2  = ta.highest(high, tp2_lookback) // previous resistance
sell_tp2 = ta.lowest(low,   tp2_lookback) // previous support

// ═══════════════════════════════════════════════════════════════════
// PLOTS — EMAs & Background
// ═══════════════════════════════════════════════════════════════════
plot(ema20,  "EMA 20",  color=color.new(color.orange, 0), linewidth=1)
plot(ema200, "EMA 200", color=color.new(color.blue,   0), linewidth=2)

bgcolor(show_bg and uptrend   ? color.new(color.green,  92) : na, title="Uptrend BG")
bgcolor(show_bg and downtrend ? color.new(color.red,    92) : na, title="Downtrend BG")
bgcolor(show_bg and sideways  ? color.new(color.yellow, 94) : na, title="No-Trade Zone BG")

// ═══════════════════════════════════════════════════════════════════
// SIGNAL SHAPES
// ═══════════════════════════════════════════════════════════════════
plotshape(buy_signal,  title="BUY Signal",
          style=shape.labelup, location=location.belowbar,
          color=color.lime, textcolor=color.black,
          text="BUY", size=size.normal)

plotshape(sell_signal, title="SELL Signal",
          style=shape.labeldown, location=location.abovebar,
          color=color.red, textcolor=color.white,
          text="SELL", size=size.normal)

// ═══════════════════════════════════════════════════════════════════
// SL / TP LINES (drawn on signal bar, extend forward)
// ═══════════════════════════════════════════════════════════════════
if show_sl_tp and buy_signal
    line.new(bar_index, buy_sl,  bar_index + line_len, buy_sl,
             color=color.red,   style=line.style_dashed, width=1)
    line.new(bar_index, buy_tp1, bar_index + line_len, buy_tp1,
             color=color.green, style=line.style_dashed, width=1)
    line.new(bar_index, buy_tp2, bar_index + line_len, buy_tp2,
             color=color.teal,  style=line.style_dotted, width=1)
    label.new(bar_index + line_len, buy_sl,  "SL",
              xloc=xloc.bar_index, style=label.style_label_left,
              color=color.red,   textcolor=color.white, size=size.small)
    label.new(bar_index + line_len, buy_tp1, "TP1",
              xloc=xloc.bar_index, style=label.style_label_left,
              color=color.green, textcolor=color.white, size=size.small)
    label.new(bar_index + line_len, buy_tp2, "TP2",
              xloc=xloc.bar_index, style=label.style_label_left,
              color=color.teal,  textcolor=color.white, size=size.small)

if show_sl_tp and sell_signal
    line.new(bar_index, sell_sl,  bar_index + line_len, sell_sl,
             color=color.red,   style=line.style_dashed, width=1)
    line.new(bar_index, sell_tp1, bar_index + line_len, sell_tp1,
             color=color.green, style=line.style_dashed, width=1)
    line.new(bar_index, sell_tp2, bar_index + line_len, sell_tp2,
             color=color.teal,  style=line.style_dotted, width=1)
    label.new(bar_index + line_len, sell_sl,  "SL",
              xloc=xloc.bar_index, style=label.style_label_left,
              color=color.red,   textcolor=color.white, size=size.small)
    label.new(bar_index + line_len, sell_tp1, "TP1",
              xloc=xloc.bar_index, style=label.style_label_left,
              color=color.green, textcolor=color.white, size=size.small)
    label.new(bar_index + line_len, sell_tp2, "TP2",
              xloc=xloc.bar_index, style=label.style_label_left,
              color=color.teal,  textcolor=color.white, size=size.small)

// ═══════════════════════════════════════════════════════════════════
// INFO TABLE (top-right corner)
// ═══════════════════════════════════════════════════════════════════
if show_table and barstate.islast
    t = table.new(position.top_right, 2, 7,
                  bgcolor=color.new(color.black, 70),
                  border_color=color.new(color.gray, 50), border_width=1,
                  frame_color=color.new(color.gray, 30), frame_width=1)

    hdr = color.new(color.gray, 40)

    table.cell(t, 0, 0, "CONDITION",  bgcolor=color.new(color.blue, 30),
               text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, "STATUS",     bgcolor=color.new(color.blue, 30),
               text_color=color.white, text_size=size.small)

    table.cell(t, 0, 1, "Trend",      bgcolor=hdr, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1, uptrend ? "▲ UP" : downtrend ? "▼ DOWN" : "◆ RANGE",
               bgcolor=uptrend ? color.new(color.green, 30) : downtrend ? color.new(color.red, 30) : color.new(color.orange, 30),
               text_color=color.white, text_size=size.small)

    table.cell(t, 0, 2, "RSI (14)",   bgcolor=hdr, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(rsi, "#.##"),
               bgcolor=rsi > 70 ? color.new(color.red, 30) : rsi < 30 ? color.new(color.green, 30) : color.new(color.gray, 50),
               text_color=color.white, text_size=size.small)

    table.cell(t, 0, 3, "EMA Touch",  bgcolor=hdr, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 3, (bull_ema_touch or bear_ema_touch) ? "✓ NEAR" : "✗ FAR",
               bgcolor=(bull_ema_touch or bear_ema_touch) ? color.new(color.green, 40) : color.new(color.gray, 50),
               text_color=color.white, text_size=size.small)

    table.cell(t, 0, 4, "Pattern",    bgcolor=hdr, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 4, (bull_pattern or bear_pattern) ? "✓ FOUND" : "✗ NONE",
               bgcolor=(bull_pattern or bear_pattern) ? color.new(color.green, 40) : color.new(color.gray, 50),
               text_color=color.white, text_size=size.small)

    table.cell(t, 0, 5, "Structure",  bgcolor=hdr, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 5, hh_hl ? "HH/HL ▲" : lh_ll ? "LH/LL ▼" : "—",
               bgcolor=hh_hl ? color.new(color.green, 40) : lh_ll ? color.new(color.red, 40) : color.new(color.gray, 50),
               text_color=color.white, text_size=size.small)

    table.cell(t, 0, 6, "Volume",     bgcolor=hdr, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 6, volume > avg_vol ? "↑ HIGH" : "↓ LOW",
               bgcolor=volume > avg_vol ? color.new(color.green, 40) : color.new(color.gray, 50),
               text_color=color.white, text_size=size.small)

// ═══════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════
alertcondition(buy_signal,  "BUY Signal",  "Swing BUY — all conditions met on {{ticker}} {{interval}}")
alertcondition(sell_signal, "SELL Signal", "Swing SELL — all conditions met on {{ticker}} {{interval}}")
alertcondition(buy_signal or sell_signal, "Any Signal", "Swing signal on {{ticker}} {{interval}}")
