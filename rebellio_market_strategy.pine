// =====================================================================
//  REBELLIO MARKET — AUTOMATED STRATEGY (Pine Script v5)
//  Encodes the trading system taught across @RebellioMarket's X posts.
//
//  Two selectable modes (one script, toggle in settings):
//    1) DAY TRADE (VWAP)   -> intraday: VWAP pullback / break & retest
//    2) SWING (4H EMA+RSI) -> 200/20 EMA trend pullback + RSI confirm
//
//  Shared risk engine: 2% risk per trade, 1:2 min R:R,
//  max trades/day + daily loss limit (day mode), auto position sizing.
//
//  HOW TO USE:
//    - Open TradingView -> Pine Editor -> paste this -> "Add to chart".
//    - Day mode: use a 1m–5m chart. Swing mode: use a 4H chart.
//    - Use the "Strategy Tester" tab to backtest, and the on-chart
//      labels to SEE every entry, stop (SL) and target (TP).
//    - For TRUE automation: create an Alert -> condition = this strategy
//      -> "alert() function calls only" -> paste a broker webhook URL.
//      The alert message ships JSON your broker/connector can execute.
//
//  NOTE: Educational tool. No strategy is guaranteed profitable.
// =====================================================================

//@version=5
strategy("Rebellio Market — Auto Strategy",
     overlay              = true,
     initial_capital      = 1000,
     default_qty_type     = strategy.fixed,
     default_qty_value    = 1,
     pyramiding           = 0,
     calc_on_every_tick   = false,
     process_orders_on_close = true,
     commission_type      = strategy.commission.percent,
     commission_value     = 0.0)

// ---------------------------------------------------------------------
//  INPUTS
// ---------------------------------------------------------------------
grpMode   = "① Mode"
mode      = input.string("Day Trade (VWAP)", "Trading Mode",
             options=["Day Trade (VWAP)", "Swing (4H EMA+RSI)"], group=grpMode)
allowShort = input.bool(true, "Allow Short Trades", group=grpMode)

grpRisk   = "② Risk Management"
riskPct   = input.float(2.0, "Risk per Trade (%)", minval=0.1, step=0.1, group=grpRisk)
rrTarget  = input.float(2.0, "Reward : Risk (TP multiple)", minval=1.0, step=0.5, group=grpRisk)
maxTrades = input.int(3, "Max Trades / Day (day mode)", minval=1, group=grpRisk)
dailyLoss = input.float(4.0, "Daily Loss Limit (%) — stop trading", minval=0.5, step=0.5, group=grpRisk)

grpInd    = "③ Indicators"
emaFast   = input.int(9,  "EMA Fast",  group=grpInd)
emaMid    = input.int(20, "EMA Mid (pullback)", group=grpInd)
emaSlow   = input.int(200,"EMA Slow (trend)",   group=grpInd)
rsiLen    = input.int(14, "RSI Length", group=grpInd)
rsiThresh = input.int(50, "RSI Threshold", group=grpInd)
volLen    = input.int(20, "Volume Avg Length", group=grpInd)

grpFilt   = "④ Filters"
useIndexFilter = input.bool(false, "Require Index (SPY) Uptrend", group=grpFilt)
indexSym  = input.symbol("AMEX:SPY", "Index Symbol", group=grpFilt)

grpViz    = "⑤ Visuals"
showInd   = input.bool(true, "Show Indicators", group=grpViz)
showLabels= input.bool(true, "Show Entry/SL/TP Labels", group=grpViz)
showTable = input.bool(true, "Show Stats Table", group=grpViz)

// ---------------------------------------------------------------------
//  CORE INDICATORS
// ---------------------------------------------------------------------
ema9   = ta.ema(close, emaFast)
ema20  = ta.ema(close, emaMid)
ema200 = ta.ema(close, emaSlow)
rsi    = ta.rsi(close, rsiLen)
volAvg = ta.sma(volume, volLen)
volExp = volume > volAvg                       // volume expansion
vwap   = ta.vwap(hlc3)                          // session-anchored VWAP

isDayMode  = mode == "Day Trade (VWAP)"
isSwingMode= mode == "Swing (4H EMA+RSI)"

// Optional broad-market trend filter
indexClose = request.security(indexSym, timeframe.period, close)
indexEma   = request.security(indexSym, timeframe.period, ta.ema(close, emaMid))
indexUp    = indexClose > indexEma
indexOk    = not useIndexFilter or indexUp
indexDn    = indexClose < indexEma
indexOkS   = not useIndexFilter or indexDn

// ---------------------------------------------------------------------
//  CANDLE PATTERNS (rejection candles per their swing post)
// ---------------------------------------------------------------------
bodyHi   = math.max(open, close)
bodyLo   = math.min(open, close)
rng      = high - low
lowerWick= bodyLo - low
upperWick= high - bodyHi

bullEngulf = close > open and close[1] < open[1] and close > open[1] and open <= close[1]
bearEngulf = close < open and close[1] > open[1] and close < open[1] and open >= close[1]
hammer     = rng > 0 and lowerWick > (bodyHi - bodyLo) * 1.5 and close > open
shootStar  = rng > 0 and upperWick > (bodyHi - bodyLo) * 1.5 and close < open
bullReject = bullEngulf or hammer
bearReject = bearEngulf or shootStar

// ---------------------------------------------------------------------
//  ENTRY LOGIC
// ---------------------------------------------------------------------
// --- DAY TRADE (VWAP) ---  break/hold above VWAP with volume + trend
dayLong  = isDayMode and close > vwap and close > ema9 and ema9 > ema20 and volExp and indexOk
dayShort = isDayMode and allowShort and close < vwap and close < ema9 and ema9 < ema20 and volExp and indexOkS

// --- SWING (4H EMA+RSI) ---  trend + pullback to 20EMA + rejection + RSI
pulledBackLong  = low <= ema20 * 1.005 and close > ema20
pulledBackShort = high >= ema20 * 0.995 and close < ema20
swingLong  = isSwingMode and close > ema200 and pulledBackLong  and bullReject and rsi > rsiThresh and indexOk
swingShort = isSwingMode and allowShort and close < ema200 and pulledBackShort and bearReject and rsi < (100 - rsiThresh) and indexOkS

goLong  = dayLong  or swingLong
goShort = dayShort or swingShort

// ---------------------------------------------------------------------
//  STOP & TARGET CALCULATION
// ---------------------------------------------------------------------
swingLow  = ta.lowest(low, 5)
swingHigh = ta.highest(high, 5)

longStop  = isDayMode ? math.min(vwap, swingLow)  : swingLow
shortStop = isDayMode ? math.max(vwap, swingHigh) : swingHigh

longRisk  = close - longStop
shortRisk = shortStop - close
longTP    = close + longRisk  * rrTarget
shortTP   = close - shortRisk * rrTarget

// ---------------------------------------------------------------------
//  POSITION SIZING (risk % of equity)
// ---------------------------------------------------------------------
riskCash  = strategy.equity * (riskPct / 100.0)
longQty   = longRisk  > 0 ? riskCash / longRisk  : 0
shortQty  = shortRisk > 0 ? riskCash / shortRisk : 0

// ---------------------------------------------------------------------
//  DAILY GUARDRAILS (day mode): max trades + daily loss limit
// ---------------------------------------------------------------------
var int   tradesToday  = 0
var float dayStartEq   = strategy.equity
newDay = ta.change(time("D")) != 0
if newDay
    tradesToday := 0
    dayStartEq  := strategy.equity

dayPnLPct   = (strategy.equity - dayStartEq) / dayStartEq * 100.0
underTradeCap = not isDayMode or tradesToday < maxTrades
underLossCap  = not isDayMode or dayPnLPct > -dailyLoss
canTrade      = underTradeCap and underLossCap

// ---------------------------------------------------------------------
//  EXECUTE
// ---------------------------------------------------------------------
if goLong and longRisk > 0 and canTrade and strategy.position_size == 0
    strategy.entry("Long", strategy.long, qty=longQty)
    strategy.exit("Long Exit", "Long", stop=longStop, limit=longTP)
    tradesToday += 1
    if showLabels
        label.new(bar_index, low, "▲ LONG\nSL " + str.tostring(longStop, format.mintick) + "\nTP " + str.tostring(longTP, format.mintick),
             style=label.style_label_up, color=color.new(color.green, 20), textcolor=color.white, size=size.small)

if goShort and shortRisk > 0 and canTrade and strategy.position_size == 0
    strategy.entry("Short", strategy.short, qty=shortQty)
    strategy.exit("Short Exit", "Short", stop=shortStop, limit=shortTP)
    tradesToday += 1
    if showLabels
        label.new(bar_index, high, "▼ SHORT\nSL " + str.tostring(shortStop, format.mintick) + "\nTP " + str.tostring(shortTP, format.mintick),
             style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, size=size.small)

// ---------------------------------------------------------------------
//  PLOTS
// ---------------------------------------------------------------------
plot(showInd and isDayMode ? vwap : na,  "VWAP",   color=color.orange, linewidth=2)
plot(showInd ? ema9  : na, "EMA 9",   color=color.aqua)
plot(showInd ? ema20 : na, "EMA 20",  color=color.yellow)
plot(showInd and isSwingMode ? ema200 : na, "EMA 200", color=color.fuchsia, linewidth=2)

plotshape(goLong  and canTrade, "Buy",  shape.triangleup,   location.belowbar, color.green, size=size.tiny)
plotshape(goShort and canTrade, "Sell", shape.triangledown, location.abovebar, color.red,   size=size.tiny)

// ---------------------------------------------------------------------
//  ALERTS (webhook-ready JSON for true automation)
// ---------------------------------------------------------------------
if goLong and longRisk > 0 and canTrade and strategy.position_size == 0
    alert('{"action":"buy","symbol":"' + syminfo.ticker + '","qty":' + str.tostring(longQty, "#.##") +
          ',"stop":' + str.tostring(longStop, format.mintick) + ',"target":' + str.tostring(longTP, format.mintick) + '}',
          alert.freq_once_per_bar_close)
if goShort and shortRisk > 0 and canTrade and strategy.position_size == 0
    alert('{"action":"sell","symbol":"' + syminfo.ticker + '","qty":' + str.tostring(shortQty, "#.##") +
          ',"stop":' + str.tostring(shortStop, format.mintick) + ',"target":' + str.tostring(shortTP, format.mintick) + '}',
          alert.freq_once_per_bar_close)

// ---------------------------------------------------------------------
//  STATS TABLE
// ---------------------------------------------------------------------
if showTable and barstate.islast
    var table t = table.new(position.top_right, 2, 7, border_width=1)
    table.cell(t, 0, 0, "REBELLIO AUTO", bgcolor=color.navy, text_color=color.white, text_size=size.normal)
    table.cell(t, 1, 0, isDayMode ? "DAY/VWAP" : "SWING", bgcolor=color.navy, text_color=color.yellow, text_size=size.normal)
    table.cell(t, 0, 1, "Equity",     text_size=size.small)
    table.cell(t, 1, 1, "$" + str.tostring(strategy.equity, "#.##"), text_size=size.small)
    table.cell(t, 0, 2, "Net Profit", text_size=size.small)
    table.cell(t, 1, 2, "$" + str.tostring(strategy.netprofit, "#.##"),
         text_color = strategy.netprofit >= 0 ? color.green : color.red, text_size=size.small)
    winRate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : 0
    table.cell(t, 0, 3, "Win Rate",   text_size=size.small)
    table.cell(t, 1, 3, str.tostring(winRate, "#.#") + "%", text_size=size.small)
    table.cell(t, 0, 4, "Trades",     text_size=size.small)
    table.cell(t, 1, 4, str.tostring(strategy.closedtrades), text_size=size.small)
    table.cell(t, 0, 5, "Trades Today", text_size=size.small)
    table.cell(t, 1, 5, str.tostring(tradesToday) + " / " + str.tostring(maxTrades), text_size=size.small)
    table.cell(t, 0, 6, "Day P&L",    text_size=size.small)
    table.cell(t, 1, 6, str.tostring(dayPnLPct, "#.#") + "%",
         text_color = dayPnLPct >= 0 ? color.green : color.red, text_size=size.small)
