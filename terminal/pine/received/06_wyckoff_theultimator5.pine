f_addHistoricalDedup(array<HistSchem> _arr, HistSchem _h) =>
    bool handled = false
    if not na(_h.clT) and not na(_h.endT)
        int nHist = array.size(_arr)
        if nHist > 0
            for z = 0 to nHist - 1
                HistSchem e = array.get(_arr, z)
                bool sameSide = e.stop == _h.stop
                float a0 = e.clT
                float a1 = e.endT
                float b0 = _h.clT
                float b1 = _h.endT
                float ov = sameSide and not na(a0) and not na(a1) ? math.max(math.min(a1, b1) - math.max(a0, b0), 0.0) : 0.0
                float shortSpan = sameSide and not na(a0) and not na(a1) ? math.max(math.min(a1 - a0, b1 - b0), 1.0) : 1.0
                bool sameCampaign = sameSide and ov / shortSpan >= 0.35
                if sameCampaign
                    bool preferNew = _h.phase > e.phase or (_h.phase == e.phase and nz(_h.srcSecs, 0.0) > nz(e.srcSecs, 0.0))
                    if preferNew
                        array.set(_arr, z, _h)
                    handled := true
                    break
        if not handled
            array.push(_arr, _h)
            if array.size(_arr) > historicalSchematicLimit
                array.shift(_arr)
    true

