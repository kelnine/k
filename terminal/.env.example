# K Terminal — local development settings (copy to terminal/.env; never commit .env).
# Every setting is KT_<GROUP>__<NAME>. In containers any value can be supplied as a
# file instead: KT_<GROUP>__<NAME>_FILE=/run/secrets/<name>.

KT_ENVIRONMENT=development            # development | test | staging | production
KT_LOGGING__LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
KT_LOGGING__FORMAT=console            # json in production

# ── Database ─────────────────────────────────────────────────────────────────
KT_DATABASE__URL=postgresql+asyncpg://kterminal@localhost:5432/kterminal
KT_DATABASE__PASSWORD=change-me

# ── API ──────────────────────────────────────────────────────────────────────
KT_API__HOST=127.0.0.1
KT_API__PORT=8000
KT_API__DOCS_ENABLED=true             # always off in production

# ── Trading safety ───────────────────────────────────────────────────────────
# PAPER or DEMO. LIVE is never accepted as a default.
KT_TRADING__DEFAULT_MODE=PAPER
# Global LIVE master switch. Enabling it also requires the exact acknowledgement
# phrase below, AND (later phases) a LIVE account set by an admin with 2FA, a
# LIVE_APPROVED strategy and a live-capable broker adapter.
KT_TRADING__LIVE_ENABLED=false
# KT_TRADING__LIVE_ACKNOWLEDGEMENT=I UNDERSTAND THAT LIVE TRADING RISKS REAL MONEY

# ── Engine / worker ──────────────────────────────────────────────────────────
KT_RUNTIME__HEARTBEAT_INTERVAL_S=10
KT_RUNTIME__LEADER_RETRY_INTERVAL_S=5

# ── Market data (docs/15-market-data.md) ────────────────────────────────────
# Without Docker: KT_MARKETDATA__OANDA_TOKEN=... (or _FILE=path). With Docker the
# token goes into deploy/secrets/oanda_token instead, never into this file.
# KT_MARKETDATA__OANDA_ENVIRONMENT=practice       # live = a token of a live OANDA account (prices only)
# KT_MARKETDATA__DISABLED_PROVIDERS=binance_usdm,binance_spot,bybit_linear   # venues blocked here

# ── Docker Compose only ──────────────────────────────────────────────────────
# The Docker stack always runs as production with JSON logs; KT_ENVIRONMENT and
# KT_LOGGING__FORMAT above apply only when running without Docker.
KT_PUBLIC_DOMAIN=localhost            # your domain for automatic HTTPS
# KT_BIND_ADDRESS=0.0.0.0             # publish ports 80/443 beyond this computer (servers only)
